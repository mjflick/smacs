package main;

use lib "lib";
use Smacs::Text;
use Smacs::File;
use Smacs::Commands;
use Smacs::LargeFile;
use Smacs::Browser;
use Smacs::Term;

our int $SIGWINCH_FLAG;    # set by SIGWINCH signal handler
our int $EXIT_SIGNAL;      # set by INT/TERM/HUP signal handlers
our int $TERM_ACTIVE;      # terminal is currently in raw/alternate mode

# ===========================================================================
# Global State
# ===========================================================================

our str $E;             # ESC character
our str $CRLF;          # carriage return

our scalar $BUFFERS;    # array ref of buffer hash refs
our int $BUF_IDX;       # current buffer index
our scalar $CL;         # array ref: current buffer lines

our int $CY;            # cursor line (0-based)
our int $CX;            # cursor col  (0-based)
our int $SY;            # scroll: first visible line
our int $SX;            # scroll: first visible col

our int $ROWS;          # terminal rows
our int $COLS;          # terminal cols
our int $EDIT_ROWS;     # rows available for editing (ROWS - 2)

our int $RUNNING;       # main loop flag
our str $MSG;           # message bar text
our int $MSG_TIME;      # when message was set (unused, for future timeout)

our str $KILL;          # kill ring (single entry)
our int $LAST_KILL;     # 1 if the previous command was a kill (C-k appends)
our int $INSERT_GROUP;  # chars in current self-insert undo group (0 = none)
our str $PASTE_BUF;     # text captured from a bracketed paste
our int $MY;            # mark line
our int $MX;            # mark col
our int $MSET;          # mark active?
our int $SHIFT_MARK;    # 1 if mark was activated by Shift+Arrow
our int $GOAL_COL;      # sticky display column for vertical cursor movement (-1 = none)
our int $MB_CANCELLED;  # 1 if the most recent minibuffer prompt was cancelled

our int $DIRTY;         # current buffer dirty flag
our str $FNAME;         # current buffer filename
our str $BNAME;         # current buffer name
our str $SYNTAX;        # current buffer syntax language
our str $CONFIG_SYNTAX; # syntax override from config file
our str $MODE;          # current major mode name (e.g. "Text", "Strada", "C")
our str $FILE_EOL;      # preferred line ending for the current buffer
our int $FILE_FINAL_NL; # buffer ends with a line ending
our int $FILE_MTIME;    # disk fingerprint captured at open/save
our int $FILE_SIZE;
our int $LINES_SHARED;  # current lines are shared with an undo snapshot

our scalar $VIM_SYN;    # hash ref of loaded vim syntax defs, keyed by lang
our scalar $SYN_KEYWORDS;   # hash ref: lang -> hash ref of keyword -> color code
our scalar $SYN_EXT_MAP;    # hash ref: file extension -> language name
our scalar $SYN_BASE_MAP;   # hash ref: exact filename -> language name

our scalar $UNDO;       # array ref of undo snapshots for current buffer
our scalar $REDO;       # array ref of redo snapshots for current buffer
our int $UNDO_MAX;      # max undo entries per buffer

our int $LINUM;         # line numbers mode: 0=off, 1=on
our int $TAB_WIDTH;     # number of spaces per tab (default 4)
our int $INDENT_TABS;   # 0=spaces (default), 1=real tabs

our scalar $HISTORY;    # hash ref: category -> array ref of past inputs
our int $HIST_MAX;      # max entries per category

our int $WHICH_FUNC;    # which-function-mode: 0=off, 1=on (default on)
our int $FILL_COLUMN;   # fill-paragraph column width (default 70)
our int $RECENTER;      # C-l cycle state: 0=center, 1=top, 2=bottom
our str $LAST_SEARCH;   # last isearch query
our str $LAST_BUFFER;   # previously viewed buffer name

our int $HEX_MODE;         # 1 when hex mode active
our int $HEX_BYTE_POS;     # cursor byte offset into hex_data
our int $HEX_IN_ASCII;     # 0 = hex column, 1 = ASCII column
our int $HEX_NIBBLE;       # 0 = high nibble, 1 = low nibble
our str $HEX_PREV_MODE;    # mode to restore on leave
our str $HEX_PREV_SYNTAX;  # syntax to restore on leave

our int $LARGE_MODE;            # 1 when chunked large-file mode active
our scalar $LF_STATE;           # Smacs::LargeFile state hash for current buffer
our int $LARGE_FILE_THRESHOLD;  # auto-enable threshold in bytes (default 16 MB; 0 = manual)
our int $LARGE_CHUNK_SIZE;      # chunk window size in bytes (default 1 MB)
our int $FORCE_LARGE_OPEN;      # 1 to force large-file mode on next open
our scalar $KEY_QUEUE;          # unread key queue preserved across nonblocking cancel checks

our scalar $WINDOWS;    # array ref of window hashes
our int $WIN_IDX;       # active window index
our int $WIN_COUNT;     # number of windows

our int $COMP_ACTIVE;       # 0=inactive, 1=popup visible
our scalar $COMP_LIST;      # array ref of candidate strings
our int $COMP_IDX;          # selected index in COMP_LIST
our str $COMP_PREFIX;       # current prefix being completed
our int $COMP_ROW;          # screen row for popup anchor (1-based)
our int $COMP_COL;          # screen col for popup anchor (1-based)
our int $COMP_SCROLL;       # scroll offset for long lists
our scalar $COMP_DEFS;      # hash ref: lang -> hash ref: category -> space-separated words
our str $COMP_DIR;          # path to completion definition files
our int $COMP_MODE;         # 0=disabled, 1=enabled

# ===========================================================================
# Terminal Functions
# ===========================================================================

func winch_handler() void {
    $SIGWINCH_FLAG = 1;
}

func exit_signal_handler() void {
    $EXIT_SIGNAL = 1;
}

func terminal_restore() void {
    if ($TERM_ACTIVE == 0) { return; }
    core::write_fd(1, chr(27) . "[?2004l" . chr(27) . "[?25h" . chr(27) . "[?1049l");
    core::term_disable_raw();
    $TERM_ACTIVE = 0;
}

func enable_raw() void {
    core::term_enable_raw();
    $TERM_ACTIVE = 1;
    core::signal("WINCH", \&winch_handler);
    core::signal("HUP", \&exit_signal_handler);
    core::signal("INT", \&exit_signal_handler);
    core::signal("TERM", \&exit_signal_handler);
}

func disable_raw() void {
    terminal_restore();
}

func suspend() void {
    disable_raw();
    # Restore default SIGTSTP handler so the signal actually stops us
    core::signal("TSTP", "DEFAULT");
    # Send SIGTSTP to self
    core::kill(core::getpid(), 20);
    # When we resume (fg), re-enter raw mode and redraw
    core::signal("TSTP", "IGNORE");
    enable_raw();
    core::write_fd(1, chr(27) . "[?1049h" . chr(27) . "[?2004h");
    update_size();
    render();
}

func update_size() void {
    $ROWS = core::term_rows();
    $COLS = core::term_cols();
    $EDIT_ROWS = $ROWS - 2;
    if ($EDIT_ROWS < 1) {
        $EDIT_ROWS = 1;
    }
    if (defined($WINDOWS) && $WIN_COUNT > 0) {
        win_recalc_layout();
    }
}

func check_winch() int {
    if ($SIGWINCH_FLAG == 1) {
        $SIGWINCH_FLAG = 0;
        return 1;
    }
    return 0;
}

# ===========================================================================
# UTF-8 Helpers
# ===========================================================================

# Number of bytes in a UTF-8 sequence given its leading byte
func u8_seq_len(int $b) int {
    if ($b < 128) { return 1; }
    if ($b < 192) { return 1; }   # continuation byte (shouldn't lead)
    if ($b < 224) { return 2; }
    if ($b < 240) { return 3; }
    return 4;
}

# Advance past one UTF-8 character at byte position $pos in string $s
func u8_next(str $s, int $pos) int {
    return Smacs::Text::next_cluster($s, $pos);
}

# Move back one UTF-8 character from byte position $pos
func u8_prev(str $s, int $pos) int {
    return Smacs::Text::prev_cluster($s, $pos);
}

# Is byte at $pos a UTF-8 continuation byte?
func u8_is_cont(str $s, int $pos) int {
    return Smacs::Text::is_continuation($s, $pos);
}

# Decode the UTF-8 codepoint starting at byte position $pos
func u8_codepoint(str $s, int $pos) int {
    return Smacs::Text::codepoint($s, $pos);
}

# Display width of the character at byte position $pos (1 or 2 for wide chars)
func u8_char_width(str $s, int $pos) int {
    return Smacs::Text::cluster_width($s, $pos);
}

# Display width of the char at byte $pos given the current display column.
# Tabs advance to the next $TAB_WIDTH stop, so their width depends on $col.
func char_width_at(str $s, int $pos, int $col) int {
    return Smacs::Text::char_width_at($s, $pos, $col, $TAB_WIDTH);
}

# Expand tabs to spaces using $TAB_WIDTH stops (for rendering)
func expand_tabs(str $s) str {
    return Smacs::Text::terminal_text($s, $TAB_WIDTH);
}

func terminal_safe(str $s) str {
    return Smacs::Text::terminal_text($s, $TAB_WIDTH);
}

# Display width of a string (accounts for multi-byte, wide chars, and tabs)
func u8_str_width(str $s) int {
    return Smacs::Text::display_width($s, $TAB_WIDTH);
}

# Convert byte position to display column
func u8_byte_to_col(str $s, int $byte_pos) int {
    return Smacs::Text::byte_to_col($s, $byte_pos, $TAB_WIDTH);
}

# Convert display column to byte position (returns byte pos of char at or after target col)
func u8_col_to_byte(str $s, int $target_col) int {
    return Smacs::Text::col_to_byte($s, $target_col, $TAB_WIDTH);
}

# Truncate string to fit within max_cols display columns
func u8_truncate(str $s, int $max_cols) str {
    return Smacs::Text::truncate_cols($s, $max_cols, $TAB_WIDTH);
}

# Skip $skip_cols display columns from start of $s, return remaining string
func u8_skip_cols(str $s, int $skip_cols) str {
    return Smacs::Text::skip_cols($s, $skip_cols, $TAB_WIDTH);
}

# ===========================================================================
# Key Reading
# ===========================================================================

func read_byte() int {
    return core::read_byte(0);
}

# Read bracketed-paste data until the ESC[201~ terminator.
# Stores the text in $PASTE_BUF and returns the "PASTE" pseudo-key.
func read_paste() str {
    my str $data = "";
    my str $term = chr(27) . "[201~";
    my int $tlen = 6;
    my int $ti = 0;      # terminator bytes matched so far
    my int $misses = 0;  # consecutive read timeouts
    while (1) {
        my int $b = read_byte();
        if ($b == -1) {
            $misses = $misses + 1;
            if ($misses > 100) { last; }
            next;
        }
        $misses = 0;
        my int $expect = core::get_byte($term, $ti);
        if ($b == $expect) {
            $ti = $ti + 1;
            if ($ti >= $tlen) { last; }
        } else {
            # Flush a partial terminator match back into the data
            if ($ti > 0) {
                $data = $data . substr($term, 0, $ti);
                $ti = 0;
            }
            if ($b == 27) {
                $ti = 1;
            } else {
                $data = $data . core::pack("C", $b);
            }
        }
    }
    $PASTE_BUF = $data;
    return "PASTE";
}

func read_key_raw() str {
    my int $c = read_byte();
    if ($c == -1) {
        return "";
    }

    # C-Space / C-@ (NUL byte)
    if ($c == 0) {
        return "C- ";
    }
    # Enter
    if ($c == 13) {
        return "RET";
    }
    # Tab
    if ($c == 9) {
        return "TAB";
    }
    # Backspace
    if ($c == 127) {
        return "BACKSPACE";
    }
    # Ctrl keys: C-a(1) through C-z(26), except TAB(9) and RET(13)
    if ($c >= 1 && $c <= 26) {
        return "C-" . chr($c + 96);
    }
    # C-_ (undo) - byte 31; C-/ also sends 31 on most terminals
    if ($c == 31) {
        return "C-_";
    }
    # ESC
    if ($c == 27) {
        my int $c2 = read_byte();
        if ($c2 == -1) {
            return "ESC";
        }
        if ($c2 == 91) {
            # CSI sequence: ESC [
            my int $c3 = read_byte();
            if ($c3 == -1) {
                return "";
            }
            if ($c3 == 65) { return "UP"; }
            if ($c3 == 66) { return "DOWN"; }
            if ($c3 == 67) { return "RIGHT"; }
            if ($c3 == 68) { return "LEFT"; }
            if ($c3 == 72) { return "HOME"; }
            if ($c3 == 70) { return "END"; }
            # Extended sequences: ESC [ N ... ~ or ESC [ N ... u
            # Collect full parameter string (digits, semicolons)
            if ($c3 >= 48 && $c3 <= 57) {
                my str $params = chr($c3);
                my int $final = read_byte();
                while ($final >= 48 && $final <= 57 || $final == 59) {
                    $params = $params . chr($final);
                    $final = read_byte();
                }
                # ESC [ N ~ sequences
                if ($final == 126) {
                    if ($params eq "1" || $params eq "7") { return "HOME"; }
                    if ($params eq "3" || index($params, "3;") == 0) { return "DEL"; }
                    if ($params eq "4" || $params eq "8") { return "END"; }
                    if ($params eq "5") { return "PGUP"; }
                    if ($params eq "6") { return "PGDN"; }
                    # xterm modifyOtherKeys: ESC[27;2;13~ = Shift+Enter
                    if ($params eq "27;2;13") { return "RET"; }
                    # Bracketed paste: ESC[200~ <data> ESC[201~
                    if ($params eq "200") { return read_paste(); }
                    return "";
                }
                # kitty keyboard protocol: ESC[code;modifiersu
                if ($final == 117) {
                    # Shift+Enter: ESC[13;2u
                    if ($params eq "13;2") { return "RET"; }
                    return "";
                }
                # Shift+arrow/home/end keys: ESC[1;2A/B/C/D/H/F
                if ($params eq "1;2") {
                    if ($final == 65) { return "S-UP"; }
                    if ($final == 66) { return "S-DOWN"; }
                    if ($final == 67) { return "S-RIGHT"; }
                    if ($final == 68) { return "S-LEFT"; }
                    if ($final == 72) { return "S-HOME"; }
                    if ($final == 70) { return "S-END"; }
                }
                # Alt+arrow keys: ESC[1;3A/B/C/D
                if ($params eq "1;3") {
                    if ($final == 65) { return "M-UP"; }
                    if ($final == 66) { return "M-DOWN"; }
                    if ($final == 67) { return "M-RIGHT"; }
                    if ($final == 68) { return "M-LEFT"; }
                }
                # Ctrl+arrow keys: ESC[1;5A/B/C/D
                if ($params eq "1;5") {
                    if ($final == 65) { return "C-UP"; }
                    if ($final == 66) { return "C-DOWN"; }
                    if ($final == 67) { return "C-RIGHT"; }
                    if ($final == 68) { return "C-LEFT"; }
                }
                # Unknown parameterized sequence: swallow it
                return "";
            }
            # Unknown CSI (F-keys, mouse, etc.): swallow so the trailing
            # bytes don't leak into the buffer as literal text
            return "";
        }
        # SS3 sequences: ESC O <final> (F1-F4, application-mode cursor keys)
        if ($c2 == 79) {
            my int $c3 = read_byte();
            if ($c3 == -1) { return "M-O"; }
            if ($c3 == 65) { return "UP"; }
            if ($c3 == 66) { return "DOWN"; }
            if ($c3 == 67) { return "RIGHT"; }
            if ($c3 == 68) { return "LEFT"; }
            if ($c3 == 72) { return "HOME"; }
            if ($c3 == 70) { return "END"; }
            # F1-F4 and friends: swallow
            return "";
        }
        # Alt+Tab (ESC + TAB)
        if ($c2 == 9) {
            return "M-TAB";
        }
        # Alt+Backspace (ESC + DEL)
        if ($c2 == 127) {
            return "M-BACKSPACE";
        }
        # Alt/Meta: ESC followed by char
        if ($c2 >= 32 && $c2 <= 126) {
            return "M-" . chr($c2);
        }
        return "ESC";
    }
    # Printable characters
    if ($c >= 32 && $c <= 126) {
        return chr($c);
    }
    # UTF-8 multi-byte: read the full sequence as raw bytes.
    # (core::pack, not chr -- chr(>=128) builds a character string whose
    # length() counts codepoints, which breaks the editor's byte math
    # and double-encodes when concatenated into byte-string buffer lines)
    if ($c >= 128) {
        my int $seq_len = u8_seq_len($c);
        if ($seq_len < 2) { return ""; }  # stray continuation byte
        my str $result = core::pack("C", $c);
        my int $bi = 1;
        while ($bi < $seq_len) {
            my int $nb = read_byte();
            if ($nb < 0) { return ""; }
            $result = $result . core::pack("C", $nb);
            $bi = $bi + 1;
        }
        return $result;
    }
    return "";
}

func read_key() str {
    if (defined($KEY_QUEUE) && scalar(@$KEY_QUEUE) > 0) {
        return shift(@$KEY_QUEUE);
    }
    return read_key_raw();
}

func stdin_has_pending() int {
    if (defined($KEY_QUEUE) && scalar(@$KEY_QUEUE) > 0) { return 1; }
    my array @fds = (0);
    my scalar $rdy = core::select_fds(\@fds, 0);
    if (defined($rdy) && scalar(@$rdy) > 0) { return 1; }
    return 0;
}

# Block until a key is pressed, handling SIGWINCH and exit signals cleanly.
func wait_key() str {
    while (1) {
        if ($EXIT_SIGNAL == 1) {
            $RUNNING = 0;
            return "C-g";
        }
        if (check_winch() == 1) {
            update_size();
            render();
        }
        if (poll_all_terminals() == 1) {
            render();
        }
        my str $k = read_key();
        if (length($k) > 0) {
            return $k;
        }
    }
    return "";
}

# ===========================================================================
# Major Modes
# ===========================================================================

# Map a syntax language string to its mode name
func mode_for_syntax(str $syn) str {
    if (length($syn) == 0) { return "Text"; }
    if ($syn eq "c") { return "C"; }
    if ($syn eq "cpp") { return "C++"; }
    if ($syn eq "cs") { return "C#"; }
    if ($syn eq "objc") { return "ObjC"; }
    if ($syn eq "perl") { return "Perl"; }
    if ($syn eq "strada") { return "Strada"; }
    if ($syn eq "python") { return "Python"; }
    if ($syn eq "javascript" || $syn eq "js") { return "JavaScript"; }
    if ($syn eq "typescript" || $syn eq "ts") { return "TypeScript"; }
    if ($syn eq "html") { return "HTML"; }
    if ($syn eq "css") { return "CSS"; }
    if ($syn eq "shell" || $syn eq "sh" || $syn eq "bash") { return "Shell"; }
    if ($syn eq "makefile" || $syn eq "make") { return "Makefile"; }
    if ($syn eq "markdown" || $syn eq "md") { return "Markdown"; }
    if ($syn eq "json") { return "JSON"; }
    if ($syn eq "yaml") { return "YAML"; }
    if ($syn eq "toml") { return "TOML"; }
    if ($syn eq "xml") { return "XML"; }
    if ($syn eq "sql") { return "SQL"; }
    if ($syn eq "php") { return "PHP"; }
    if ($syn eq "cmake") { return "CMake"; }
    if ($syn eq "graphql") { return "GraphQL"; }
    if ($syn eq "fsharp") { return "F#"; }
    if ($syn eq "ocaml") { return "OCaml"; }
    if ($syn eq "purescript") { return "PureScript"; }
    if ($syn eq "powershell") { return "PowerShell"; }
    if ($syn eq "vhdl") { return "VHDL"; }
    if ($syn eq "wast") { return "Wasm"; }
    if ($syn eq "r") { return "R"; }
    if ($syn eq "d") { return "D"; }
    return ucfirst($syn);
}

# Map a mode name to its syntax language string (for highlighting)
func syntax_for_mode(str $mode) str {
    if ($mode eq "Text" || $mode eq "Help" || $mode eq "Hex") { return ""; }
    if ($mode eq "C") { return "c"; }
    if ($mode eq "C++") { return "cpp"; }
    if ($mode eq "C#") { return "cs"; }
    if ($mode eq "ObjC") { return "objc"; }
    if ($mode eq "Perl") { return "perl"; }
    if ($mode eq "Strada") { return "strada"; }
    if ($mode eq "Python") { return "python"; }
    if ($mode eq "JavaScript") { return "javascript"; }
    if ($mode eq "TypeScript") { return "typescript"; }
    if ($mode eq "HTML") { return "html"; }
    if ($mode eq "CSS") { return "css"; }
    if ($mode eq "Shell") { return "sh"; }
    if ($mode eq "Makefile") { return "make"; }
    if ($mode eq "Markdown") { return "markdown"; }
    return lc($mode);
}

# Set the current buffer's major mode
func set_mode(str $mode) void {
    if ($HEX_MODE == 1) {
        hex_leave_mode();
    }
    $MODE = $mode;
    $SYNTAX = syntax_for_mode($mode);
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    $buf->{"mode"} = $MODE;
    $buf->{"syntax"} = $SYNTAX;
    note_buffer_changed();
    set_msg($mode . " mode");
}

# ===========================================================================
# Buffer Management
# ===========================================================================

func buf_new(str $name, str $filename) void {
    my scalar $buf = {};
    my str $syn = syn_detect($filename);
    if (length($syn) == 0 && length($CONFIG_SYNTAX) > 0) {
        $syn = $CONFIG_SYNTAX;
    }
    $buf->{"name"} = $name;
    $buf->{"raw_bname"} = $name;
    $buf->{"filename"} = $filename;
    $buf->{"lines"} = [""];
    $buf->{"cy"} = 0;
    $buf->{"cx"} = 0;
    $buf->{"sy"} = 0;
    $buf->{"sx"} = 0;
    $buf->{"my"} = 0;
    $buf->{"mx"} = 0;
    $buf->{"mset"} = 0;
    $buf->{"shift_mark"} = 0;
    $buf->{"dirty"} = 0;
    $buf->{"syntax"} = $syn;
    $buf->{"mode"} = mode_for_syntax($syn);
    $buf->{"undo"} = [];
    $buf->{"redo"} = [];
    $buf->{"eol"} = "\n";
    $buf->{"final_newline"} = 0;
    $buf->{"disk_mtime"} = -1;
    $buf->{"disk_size"} = -1;
    $buf->{"generation"} = 0;
    $buf->{"highlight_cache"} = {};
    $buf->{"which_cache_key"} = "";
    $buf->{"which_cache_value"} = "";
    $buf->{"hex_mode"} = 0;
    $buf->{"hex_byte_pos"} = 0;
    $buf->{"hex_in_ascii"} = 0;
    $buf->{"hex_nibble"} = 0;
    $buf->{"hex_prev_mode"} = "";
    $buf->{"hex_prev_syntax"} = "";
    $buf->{"large_mode"} = 0;
    $buf->{"lf"} = undef;
    $buf->{"dired_dir"} = "";
    $buf->{"dired_entries"} = undef;
    $buf->{"dired_show_hidden"} = 1;
    $buf->{"bmenu_entries"} = undef;
    $buf->{"bmenu_origin"} = "";
    $buf->{"term_vt"} = 0;
    $buf->{"term_cwd"} = "";
    push(@$BUFFERS, $buf);
}

func buf_save_state() void {
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    $buf->{"cy"} = $CY;
    $buf->{"cx"} = $CX;
    $buf->{"sy"} = $SY;
    $buf->{"sx"} = $SX;
    $buf->{"my"} = $MY;
    $buf->{"mx"} = $MX;
    $buf->{"mset"} = $MSET;
    $buf->{"shift_mark"} = $SHIFT_MARK;
    $buf->{"dirty"} = $DIRTY;
    $buf->{"filename"} = $FNAME;
    $buf->{"name"} = $BNAME;
    $buf->{"syntax"} = $SYNTAX;
    $buf->{"mode"} = $MODE;
    $buf->{"undo"} = $UNDO;
    $buf->{"redo"} = $REDO;
    $buf->{"eol"} = $FILE_EOL;
    $buf->{"final_newline"} = $FILE_FINAL_NL;
    $buf->{"disk_mtime"} = $FILE_MTIME;
    $buf->{"disk_size"} = $FILE_SIZE;
    $buf->{"hex_mode"} = $HEX_MODE;
    $buf->{"hex_byte_pos"} = $HEX_BYTE_POS;
    $buf->{"hex_in_ascii"} = $HEX_IN_ASCII;
    $buf->{"hex_nibble"} = $HEX_NIBBLE;
    $buf->{"hex_prev_mode"} = $HEX_PREV_MODE;
    $buf->{"hex_prev_syntax"} = $HEX_PREV_SYNTAX;
    $buf->{"large_mode"} = $LARGE_MODE;
    $buf->{"lf"} = $LF_STATE;
}

func buf_load_state(int $idx) void {
    my scalar $buf = $BUFFERS->[$idx];
    $BUF_IDX = $idx;
    $CL = $buf->{"lines"};
    $CY = $buf->{"cy"};
    $CX = $buf->{"cx"};
    $SY = $buf->{"sy"};
    $SX = $buf->{"sx"};
    $MY = $buf->{"my"} // 0;
    $MX = $buf->{"mx"} // 0;
    $MSET = $buf->{"mset"} // 0;
    $SHIFT_MARK = $buf->{"shift_mark"} // 0;
    $GOAL_COL = -1;
    $DIRTY = $buf->{"dirty"};
    $FNAME = $buf->{"filename"};
    $BNAME = $buf->{"name"};
    $SYNTAX = $buf->{"syntax"};
    $MODE = $buf->{"mode"};
    $UNDO = $buf->{"undo"};
    if (!defined($UNDO)) {
        $UNDO = [];
    }
    $REDO = $buf->{"redo"};
    if (!defined($REDO)) {
        $REDO = [];
    }
    $FILE_EOL = $buf->{"eol"};
    if (length($FILE_EOL) == 0) { $FILE_EOL = "\n"; }
    $FILE_FINAL_NL = $buf->{"final_newline"};
    if (!defined($FILE_FINAL_NL)) { $FILE_FINAL_NL = 0; }
    $FILE_MTIME = $buf->{"disk_mtime"};
    if (!defined($FILE_MTIME)) { $FILE_MTIME = -1; }
    $FILE_SIZE = $buf->{"disk_size"};
    if (!defined($FILE_SIZE)) { $FILE_SIZE = -1; }
    $LINES_SHARED = 1;
    $HEX_MODE = $buf->{"hex_mode"};
    if (!defined($HEX_MODE)) { $HEX_MODE = 0; }
    $HEX_BYTE_POS = $buf->{"hex_byte_pos"};
    if (!defined($HEX_BYTE_POS)) { $HEX_BYTE_POS = 0; }
    $HEX_IN_ASCII = $buf->{"hex_in_ascii"};
    if (!defined($HEX_IN_ASCII)) { $HEX_IN_ASCII = 0; }
    $HEX_NIBBLE = $buf->{"hex_nibble"};
    if (!defined($HEX_NIBBLE)) { $HEX_NIBBLE = 0; }
    $HEX_PREV_MODE = $buf->{"hex_prev_mode"} // "";
    $HEX_PREV_SYNTAX = $buf->{"hex_prev_syntax"} // "";
    $LARGE_MODE = $buf->{"large_mode"} // 0;
    $LF_STATE = $buf->{"lf"};
    if (length($MODE) == 0) {
        $MODE = "Text";
    }
}

func buf_count() int {
    return scalar(@$BUFFERS);
}

func buf_find(str $name) int {
    my int $i = 0;
    while ($i < scalar(@$BUFFERS)) {
        my scalar $b = $BUFFERS->[$i];
        if ($b->{"name"} eq $name) {
            return $i;
        }
        $i = $i + 1;
    }
    return -1;
}

# ===========================================================================
# Window Management
# ===========================================================================

func win_make(int $buf_idx, int $top, int $height, int $left, int $width) scalar {
    my scalar $w = {};
    $w->{"buf_idx"} = $buf_idx;
    $w->{"top_row"} = $top;
    $w->{"height"} = $height;
    $w->{"left_col"} = $left;
    $w->{"width"} = $width;
    return $w;
}

func win_init() void {
    $WINDOWS = [];
    push(@$WINDOWS, win_make($BUF_IDX, 0, $EDIT_ROWS, 0, $COLS));
    $WIN_IDX = 0;
    $WIN_COUNT = 1;
}

func win_save_state() void {
    my scalar $w = $WINDOWS->[$WIN_IDX];
    $w->{"buf_idx"} = $BUF_IDX;
    $w->{"cy"} = $CY;
    $w->{"cx"} = $CX;
    $w->{"sy"} = $SY;
    $w->{"sx"} = $SX;
}

func win_load_state(int $idx) void {
    my scalar $w = $WINDOWS->[$idx];
    # Save current buffer state back
    buf_save_state();
    $WIN_IDX = $idx;
    my int $bi = $w->{"buf_idx"};
    # Always load the target buffer (even if same index, the window
    # may have different cursor/scroll state)
    buf_load_state($bi);
    # Restore per-window cursor/scroll (overrides buffer defaults)
    if (defined($w->{"cy"})) {
        $CY = $w->{"cy"};
        $CX = $w->{"cx"};
        $SY = $w->{"sy"};
        $SX = $w->{"sx"};
    }
}

func win_recalc_layout() void {
    # For a single window, take the full screen
    if ($WIN_COUNT == 1) {
        my scalar $w = $WINDOWS->[0];
        $w->{"top_row"} = 0;
        $w->{"height"} = $EDIT_ROWS;
        $w->{"left_col"} = 0;
        $w->{"width"} = $COLS;
        return;
    }
    # Snapshot original top_row values before mutating window geometry so
    # group keys never collide with newly assigned row positions.
    my scalar $orig_tops = [];
    my int $i = 0;
    while ($i < $WIN_COUNT) {
        push(@$orig_tops, $WINDOWS->[$i]->{"top_row"});
        $i = $i + 1;
    }

    my int $has_vsplit = 0;
    $i = 0;
    while ($i < $WIN_COUNT) {
        my int $j = $i + 1;
        while ($j < $WIN_COUNT) {
            if ($orig_tops->[$i] == $orig_tops->[$j]) {
                $has_vsplit = 1;
            }
            $j = $j + 1;
        }
        $i = $i + 1;
    }
    if ($has_vsplit == 0) {
        # All horizontal splits: redistribute heights across ROWS - 1 (excluding message bar)
        my int $avail = $ROWS - 1 - $WIN_COUNT;
        if ($avail < $WIN_COUNT) { $avail = $WIN_COUNT; }
        my int $per = $avail / $WIN_COUNT;
        if ($per < 1) { $per = 1; }
        my int $row = 0;
        $i = 0;
        while ($i < $WIN_COUNT) {
            my scalar $w = $WINDOWS->[$i];
            $w->{"top_row"} = $row;
            $w->{"left_col"} = 0;
            $w->{"width"} = $COLS;
            if ($i == $WIN_COUNT - 1) {
                $w->{"height"} = ($ROWS - 2) - $row;
            } else {
                $w->{"height"} = $per;
            }
            if ($w->{"height"} < 1) { $w->{"height"} = 1; }
            $row = $row + $w->{"height"} + 1;
            $i = $i + 1;
        }
    } else {
        # Group windows by original top_row, redistribute widths within each group
        $i = 0;
        while ($i < $WIN_COUNT) {
            my scalar $w = $WINDOWS->[$i];
            my int $row_top = $orig_tops->[$i];
            my int $group_count = 0;
            my int $k = 0;
            while ($k < $WIN_COUNT) {
                if ($orig_tops->[$k] == $row_top) {
                    $group_count = $group_count + 1;
                }
                $k = $k + 1;
            }
            if ($group_count > 1) {
                my int $avail_w = $COLS - ($group_count - 1);
                my int $per_w = $avail_w / $group_count;
                if ($per_w < 2) { $per_w = 2; }
                my int $col = 0;
                my int $gi = 0;
                $k = 0;
                while ($k < $WIN_COUNT) {
                    my scalar $wk2 = $WINDOWS->[$k];
                    if ($orig_tops->[$k] == $row_top) {
                        $wk2->{"left_col"} = $col;
                        if ($gi == $group_count - 1) {
                            $wk2->{"width"} = $COLS - $col;
                        } else {
                            $wk2->{"width"} = $per_w;
                        }
                        if ($wk2->{"width"} < 1) { $wk2->{"width"} = 1; }
                        $col = $col + $wk2->{"width"} + 1;
                        $gi = $gi + 1;
                    }
                    $k = $k + 1;
                }
            } else {
                $w->{"left_col"} = 0;
                $w->{"width"} = $COLS;
            }
            $i = $i + 1;
        }
        # Redistribute heights for horizontal groups using $orig_tops
        my int $avail_h = $ROWS - 1;
        my int $num_groups = 0;
        my scalar $seen_rows = {};
        $i = 0;
        while ($i < $WIN_COUNT) {
            my str $rk = "" . $orig_tops->[$i];
            if (!defined($seen_rows->{$rk})) {
                $seen_rows->{$rk} = "1";
                $num_groups = $num_groups + 1;
            }
            $i = $i + 1;
        }
        my int $per_h = ($avail_h - $num_groups) / $num_groups;
        if ($per_h < 1) { $per_h = 1; }
        my int $row = 0;
        my int $group_idx = 0;
        $seen_rows = {};
        $i = 0;
        while ($i < $WIN_COUNT) {
            my str $rk2 = "" . $orig_tops->[$i];
            if (!defined($seen_rows->{$rk2})) {
                $seen_rows->{$rk2} = "1";
                my int $gh = $per_h;
                if ($group_idx == $num_groups - 1) {
                    $gh = ($ROWS - 2) - $row;
                }
                if ($gh < 1) { $gh = 1; }
                my int $m = 0;
                while ($m < $WIN_COUNT) {
                    if ("" . $orig_tops->[$m] eq $rk2) {
                        my scalar $wm = $WINDOWS->[$m];
                        $wm->{"top_row"} = $row;
                        $wm->{"height"} = $gh;
                    }
                    $m = $m + 1;
                }
                $row = $row + $gh + 1;
                $group_idx = $group_idx + 1;
            }
            $i = $i + 1;
        }
    }
}

func win_split() void {
    my scalar $cur = $WINDOWS->[$WIN_IDX];
    my int $h = $cur->{"height"};
    if ($h < 4) {
        set_msg("Window too small to split.");
        return;
    }
    buf_save_state();

    # Split horizontally: current window keeps top half, new gets bottom
    my int $top_h = ($h - 1) / 2;  # -1 for separator status bar
    if ($top_h < 1) { $top_h = 1; }
    my int $bot_h = $h - $top_h - 1;
    if ($bot_h < 1) { $bot_h = 1; }

    my int $top = $cur->{"top_row"};
    my int $left = $cur->{"left_col"};
    my int $width = $cur->{"width"};

    $cur->{"height"} = $top_h;

    # If multiple buffers exist, show next buffer in new window
    my int $new_buf = $BUF_IDX;
    if (buf_count() > 1) {
        $new_buf = $BUF_IDX + 1;
        if ($new_buf >= buf_count()) { $new_buf = 0; }
    }
    my scalar $nw = win_make($new_buf, $top + $top_h + 1, $bot_h, $left, $width);
    # Set cursor state for new window
    if ($new_buf == $BUF_IDX) {
        $nw->{"cy"} = $CY;
        $nw->{"cx"} = $CX;
        $nw->{"sy"} = $SY;
        $nw->{"sx"} = $SX;
    } else {
        my scalar $nbuf = $BUFFERS->[$new_buf];
        $nw->{"cy"} = $nbuf->{"cy"};
        $nw->{"cx"} = $nbuf->{"cx"};
        $nw->{"sy"} = $nbuf->{"sy"};
        $nw->{"sx"} = $nbuf->{"sx"};
    }
    # Save current window's cursor state
    $cur->{"cy"} = $CY;
    $cur->{"cx"} = $CX;
    $cur->{"sy"} = $SY;
    $cur->{"sx"} = $SX;

    # Insert after current window
    my scalar $new_wins = [];
    my int $i = 0;
    while ($i < $WIN_COUNT) {
        push(@$new_wins, $WINDOWS->[$i]);
        if ($i == $WIN_IDX) {
            push(@$new_wins, $nw);
        }
        $i = $i + 1;
    }
    $WINDOWS = $new_wins;
    $WIN_COUNT = $WIN_COUNT + 1;
    set_msg("Split.");
}

func win_split_vertical() void {
    my scalar $cur = $WINDOWS->[$WIN_IDX];
    my int $w = $cur->{"width"};
    if ($w < 10) {
        set_msg("Window too narrow to split.");
        return;
    }
    buf_save_state();

    # Split vertically: current keeps left half, new gets right
    my int $left_w = ($w - 1) / 2;  # -1 for separator column
    if ($left_w < 4) { $left_w = 4; }
    my int $right_w = $w - $left_w - 1;
    if ($right_w < 4) { $right_w = 4; }

    my int $top = $cur->{"top_row"};
    my int $height = $cur->{"height"};
    my int $left = $cur->{"left_col"};

    $cur->{"width"} = $left_w;

    # If multiple buffers exist, show next buffer in new window
    my int $new_buf = $BUF_IDX;
    if (buf_count() > 1) {
        $new_buf = $BUF_IDX + 1;
        if ($new_buf >= buf_count()) { $new_buf = 0; }
    }
    my scalar $nw = win_make($new_buf, $top, $height, $left + $left_w + 1, $right_w);
    # Set cursor state for new window
    if ($new_buf == $BUF_IDX) {
        $nw->{"cy"} = $CY;
        $nw->{"cx"} = $CX;
        $nw->{"sy"} = $SY;
        $nw->{"sx"} = $SX;
    } else {
        my scalar $nbuf = $BUFFERS->[$new_buf];
        $nw->{"cy"} = $nbuf->{"cy"};
        $nw->{"cx"} = $nbuf->{"cx"};
        $nw->{"sy"} = $nbuf->{"sy"};
        $nw->{"sx"} = $nbuf->{"sx"};
    }
    # Save current window's cursor state
    $cur->{"cy"} = $CY;
    $cur->{"cx"} = $CX;
    $cur->{"sy"} = $SY;
    $cur->{"sx"} = $SX;

    my scalar $new_wins = [];
    my int $i = 0;
    while ($i < $WIN_COUNT) {
        push(@$new_wins, $WINDOWS->[$i]);
        if ($i == $WIN_IDX) {
            push(@$new_wins, $nw);
        }
        $i = $i + 1;
    }
    $WINDOWS = $new_wins;
    $WIN_COUNT = $WIN_COUNT + 1;
    set_msg("Split vertically.");
}

func win_delete_others() void {
    if ($WIN_COUNT <= 1) {
        set_msg("No other windows.");
        return;
    }
    buf_save_state();
    my scalar $keep = $WINDOWS->[$WIN_IDX];
    $keep->{"top_row"} = 0;
    $keep->{"height"} = $EDIT_ROWS;
    $keep->{"left_col"} = 0;
    $keep->{"width"} = $COLS;
    $WINDOWS = [];
    push(@$WINDOWS, $keep);
    $WIN_COUNT = 1;
    $WIN_IDX = 0;
    set_msg("Deleted other windows.");
}

func win_delete_current() void {
    if ($WIN_COUNT <= 1) {
        set_msg("Attempt to delete sole ordinary window.");
        return;
    }
    buf_save_state();
    win_save_state();
    splice(@$WINDOWS, $WIN_IDX, 1);
    $WIN_COUNT = $WIN_COUNT - 1;
    if ($WIN_IDX >= $WIN_COUNT) {
        $WIN_IDX = $WIN_COUNT - 1;
    }
    win_recalc_layout();
    win_load_state($WIN_IDX);
    set_msg("Deleted window.");
}

func win_other() void {
    if ($WIN_COUNT <= 1) {
        set_msg("No other window.");
        return;
    }
    buf_save_state();
    win_save_state();
    my int $next = $WIN_IDX + 1;
    if ($next >= $WIN_COUNT) { $next = 0; }
    win_load_state($next);
    set_msg("Window: " . ($WIN_IDX + 1) . "/" . $WIN_COUNT);
}

func buf_cycle(int $delta) void {
    my int $cnt = buf_count();
    if ($cnt <= 1) {
        set_msg("No other buffers.");
        return;
    }
    my str $prev = $BNAME;
    buf_save_state();
    win_save_state();
    my int $next = $BUF_IDX + $delta;
    if ($next < 0) { $next = $cnt - 1; }
    if ($next >= $cnt) { $next = 0; }
    buf_load_state($next);
    my scalar $w = $WINDOWS->[$WIN_IDX];
    $w->{"buf_idx"} = $BUF_IDX;
    $LAST_BUFFER = $prev;
    set_msg("Buffer: " . $BNAME);
}

func buf_switch(str $name) void {
    my int $idx = buf_find($name);
    if ($idx == -1) {
        set_msg("No buffer named: " . $name);
        return;
    }
    my str $prev = $BNAME;
    buf_save_state();
    win_save_state();
    buf_load_state($idx);
    my scalar $w = $WINDOWS->[$WIN_IDX];
    $w->{"buf_idx"} = $BUF_IDX;
    $LAST_BUFFER = $prev;
}

# Is any buffer (including the current one) modified?
func any_buffer_dirty() int {
    buf_save_state();
    my int $i = 0;
    while ($i < scalar(@$BUFFERS)) {
        my scalar $b = $BUFFERS->[$i];
        if (defined($b->{"dirty"}) && $b->{"dirty"} == 1) {
            return 1;
        }
        $i = $i + 1;
    }
    return 0;
}

func buf_names() str {
    my str $out = "";
    my int $i = 0;
    while ($i < scalar(@$BUFFERS)) {
        my scalar $b = $BUFFERS->[$i];
        if ($i > 0) {
            $out = $out . ", ";
        }
        $out = $out . $b->{"name"};
        $i = $i + 1;
    }
    return $out;
}

func line_count() int {
    return scalar(@$CL);
}

func get_line(int $n) str {
    if ($n < 0 || $n >= scalar(@$CL)) {
        return "";
    }
    return $CL->[$n];
}

func ensure_lines_writable() void {
    if ($LINES_SHARED == 0) { return; }
    my scalar $copy = [];
    my int $i = 0;
    while ($i < scalar(@$CL)) {
        push(@$copy, $CL->[$i]);
        $i = $i + 1;
    }
    $CL = $copy;
    $BUFFERS->[$BUF_IDX]->{"lines"} = $copy;
    $LINES_SHARED = 0;
}

func note_buffer_changed() void {
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my int $gen = $buf->{"generation"};
    if (!defined($gen)) { $gen = 0; }
    $buf->{"generation"} = $gen + 1;
    $buf->{"highlight_cache"} = {};
    $buf->{"which_cache_key"} = "";
}

func set_line(int $n, str $val) void {
    if ($n >= 0 && $n < scalar(@$CL)) {
        ensure_lines_writable();
        $CL->[$n] = $val;
        note_buffer_changed();
    }
}

func insert_line(int $at, str $val) void {
    ensure_lines_writable();
    splice(@$CL, $at, 0, $val);
    note_buffer_changed();
}

func delete_line(int $at) void {
    if (scalar(@$CL) > 1) {
        ensure_lines_writable();
        splice(@$CL, $at, 1);
        note_buffer_changed();
    }
}

# ===========================================================================
# Message Bar
# ===========================================================================

func set_msg(str $text) void {
    $MSG = terminal_safe($text);
}

# ===========================================================================
# File I/O
# ===========================================================================

func unique_dir_part(str $filepath, str $basename) str {
    # Extract the parent directory name from a filepath for disambiguation
    # e.g., "/home/user/src/main.c" with basename "main.c" -> "src"
    my int $base_len = length($basename);
    my int $path_len = length($filepath);
    # Strip the basename and trailing slash
    my int $dir_end = $path_len - $base_len - 1;
    if ($dir_end < 0) { return ""; }
    my str $dir_path = substr($filepath, 0, $dir_end);
    # Find last component
    my int $last_slash = -1;
    my int $di = 0;
    while ($di < length($dir_path)) {
        if (substr($dir_path, $di, 1) eq "/") {
            $last_slash = $di;
        }
        $di = $di + 1;
    }
    if ($last_slash >= 0 && $last_slash + 1 < length($dir_path)) {
        return substr($dir_path, $last_slash + 1);
    }
    return $dir_path;
}

func normalize_path(str $path) str {
    if (length($path) == 0) { return ""; }
    my str $real = core::realpath($path);
    if (length($real) > 0) { return $real; }
    if (substr($path, 0, 1) ne "/") {
        my str $cwd = core::getcwd();
        if (length($cwd) > 0) {
            if (index($path, "./") == 0) {
                $path = substr($path, 2);
            }
            $path = $cwd . "/" . $path;
        }
    }
    # Resolve parent directory if it exists (for not-yet-created files)
    my str $dir = path_dirname($path);
    my str $base = path_basename($path);
    my str $real_dir = core::realpath($dir);
    if (length($real_dir) > 0) {
        if ($real_dir eq "/") { return "/" . $base; }
        return $real_dir . "/" . $base;
    }
    return $path;
}

func same_file_path(str $a, str $b) int {
    if (length($a) == 0 || length($b) == 0) { return 0; }
    if ($a eq $b) { return 1; }
    return (normalize_path($a) eq normalize_path($b));
}

func uniquify_buffer_name(int $target_idx, str $filepath) str {
    my str $raw = path_basename($filepath);
    if (length($raw) == 0) { $raw = $filepath; }
    my scalar $tbuf = $BUFFERS->[$target_idx];
    $tbuf->{"raw_bname"} = $raw;

    # Check if any other buffer shares the same raw basename
    my int $conflict = 0;
    my int $bi = 0;
    while ($bi < scalar(@$BUFFERS)) {
        if ($bi != $target_idx) {
            my scalar $other = $BUFFERS->[$bi];
            my str $oraw = $other->{"raw_bname"} // $other->{"name"};
            if ($oraw eq $raw) {
                $conflict = 1;
                my str $ofname = $other->{"filename"};
                if (length($ofname) > 0) {
                    my str $odir = unique_dir_part(normalize_path($ofname), $raw);
                    if (length($odir) > 0) {
                        $other->{"name"} = $raw . "<" . $odir . ">";
                    }
                }
            }
        }
        $bi = $bi + 1;
    }

    my str $bname = $raw;
    if ($conflict == 1) {
        my str $mdir = unique_dir_part(normalize_path($filepath), $raw);
        if (length($mdir) > 0) {
            $bname = $raw . "<" . $mdir . ">";
        }
    }

    # Ensure uniqueness even if parent directory names also match
    my str $cand = $bname;
    my int $suffix = 2;
    while (1) {
        my int $dup = 0;
        my int $ci = 0;
        while ($ci < scalar(@$BUFFERS)) {
            if ($ci != $target_idx && $BUFFERS->[$ci]->{"name"} eq $cand) {
                $dup = 1;
                last;
            }
            $ci = $ci + 1;
        }
        if ($dup == 0) { last; }
        $cand = $bname . "<" . $suffix . ">";
        $suffix = $suffix + 1;
    }
    return $cand;
}

func detect_shebang_syntax(scalar $lines) str {
    if (!defined($lines) || scalar(@$lines) == 0) { return ""; }
    my str $first = $lines->[0];
    if (length($first) < 3 || substr($first, 0, 2) ne "#!") { return ""; }
    if (index($first, "strada") >= 0) { return "strada"; }
    if (index($first, "python") >= 0) { return "python"; }
    if (index($first, "perl") >= 0) { return "perl"; }
    if (index($first, "node") >= 0 || index($first, "deno") >= 0 || index($first, "bun") >= 0) { return "javascript"; }
    if (index($first, "ruby") >= 0) { return "ruby"; }
    if (index($first, "lua") >= 0) { return "lua"; }
    if (index($first, "php") >= 0) { return "php"; }
    if (index($first, "awk") >= 0) { return "awk"; }
    if (index($first, "tcl") >= 0 || index($first, "wish") >= 0) { return "tcl"; }
    if (index($first, "raku") >= 0) { return "raku"; }
    if (index($first, "sh") >= 0 || index($first, "bash") >= 0 || index($first, "zsh") >= 0 || index($first, "ksh") >= 0 || index($first, "fish") >= 0) { return "sh"; }
    return "";
}

func lf_apply_chunk_result(scalar $parsed) void {
    my scalar $lines = $parsed->{"lines"};
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    $buf->{"lines"} = $lines;
    $buf->{"generation"} = ($buf->{"generation"} // 0) + 1;
    $buf->{"highlight_cache"} = {};
    $buf->{"which_cache_key"} = "";
    $CL = $lines;
    $LINES_SHARED = 0;
    $FILE_EOL = $parsed->{"eol"};
    $FILE_FINAL_NL = $parsed->{"final_newline"};
    $CY = $parsed->{"focus_cy"} // 0;
    $CX = $parsed->{"focus_cx"} // 0;
    $SY = 0;
    $SX = 0;
    $MY = 0;
    $MX = 0;
    $MSET = 0;
    $SHIFT_MARK = 0;
    $UNDO = [];
    $REDO = [];
    if (defined($LF_STATE)) {
        $DIRTY = $LF_STATE->{"has_edits"};
    }
    clamp_cursor();
    scroll_adjust();
}

func lf_sync_active_chunk() void {
    if ($LARGE_MODE != 1 || !defined($LF_STATE)) { return; }
    $LF_STATE->{"chunk_eol"} = $FILE_EOL;
    $LF_STATE->{"chunk_final_nl"} = $FILE_FINAL_NL;
    Smacs::LargeFile::commit_chunk($LF_STATE, $CL);
    $DIRTY = $LF_STATE->{"has_edits"};
}

func lf_place_cursor_at_voff(int $voff) void {
    if (!defined($LF_STATE)) { return; }
    my int $eol_len = core::byte_length($FILE_EOL);
    if ($eol_len <= 0) { $eol_len = 1; }
    my int $cur = $LF_STATE->{"chunk_vstart"};
    my int $n = line_count();
    my int $y = 0;
    while ($y < $n) {
        my int $llen = core::byte_length(get_line($y));
        if ($voff <= $cur + $llen || $y == $n - 1) {
            $CY = $y;
            $CX = $voff - $cur;
            if ($CX < 0) { $CX = 0; }
            if ($CX > length(get_line($y))) { $CX = length(get_line($y)); }
            clamp_cursor();
            scroll_adjust();
            return;
        }
        $cur = $cur + $llen + $eol_len;
        $y = $y + 1;
    }
}

func lf_jump_to_offset(int $voff) void {
    if ($LARGE_MODE != 1 || !defined($LF_STATE)) { return; }
    lf_sync_active_chunk();
    my int $tot = Smacs::LargeFile::total_size($LF_STATE);
    if ($voff < 0) { $voff = 0; }
    if ($voff > $tot) { $voff = $tot; }
    if ($voff >= $LF_STATE->{"chunk_vstart"} && ($voff < $LF_STATE->{"chunk_vend"} || ($voff == $tot && $LF_STATE->{"chunk_vend"} == $tot))) {
        lf_place_cursor_at_voff($voff);
        return;
    }
    my scalar $parsed = Smacs::LargeFile::load_chunk_around($LF_STATE, $voff);
    lf_apply_chunk_result($parsed);
}

func lf_next_chunk() int {
    if ($LARGE_MODE != 1 || !defined($LF_STATE)) { return 0; }
    lf_sync_active_chunk();
    my int $tot = Smacs::LargeFile::total_size($LF_STATE);
    my int $vend = $LF_STATE->{"chunk_vend"};
    if ($vend >= $tot) {
        set_msg("End of large file (" . Smacs::LargeFile::format_bytes($tot) . ").");
        return 0;
    }
    my scalar $parsed = Smacs::LargeFile::load_chunk_from($LF_STATE, $vend, $vend);
    lf_apply_chunk_result($parsed);
    $CY = 0;
    $CX = 0;
    scroll_adjust();
    set_msg("Chunk @" . Smacs::LargeFile::format_bytes($LF_STATE->{"chunk_vstart"}) . " / " . Smacs::LargeFile::format_bytes($tot));
    return 1;
}

func lf_prev_chunk(int $place_at_end) int {
    if ($LARGE_MODE != 1 || !defined($LF_STATE)) { return 0; }
    lf_sync_active_chunk();
    my int $vstart = $LF_STATE->{"chunk_vstart"};
    if ($vstart <= 0) {
        set_msg("Beginning of large file.");
        return 0;
    }
    my scalar $parsed = Smacs::LargeFile::load_prev_chunk($LF_STATE, $vstart);
    lf_apply_chunk_result($parsed);
    if ($place_at_end == 1) {
        $CY = line_count() - 1;
    } else {
        $CY = 0;
    }
    $CX = 0;
    scroll_adjust();
    my int $tot = Smacs::LargeFile::total_size($LF_STATE);
    set_msg("Chunk @" . Smacs::LargeFile::format_bytes($LF_STATE->{"chunk_vstart"}) . " / " . Smacs::LargeFile::format_bytes($tot));
    return 1;
}

func lf_progress_callback(int $pos, int $tot) int {
    if ($EXIT_SIGNAL == 1) { return 1; }
    if ($TERM_ACTIVE == 1) {
        my str $msg = "Scanning large file... " . Smacs::LargeFile::format_bytes($pos) . " / " . Smacs::LargeFile::format_bytes($tot) . " (C-g to cancel)";
        my str $out = $E . "[" . $ROWS . ";1H" . $E . "[K" . u8_truncate($msg, $COLS);
        core::write_fd(1, $out);
        my array @fds = (0);
        my scalar $rdy = core::select_fds(\@fds, 0);
        if (defined($rdy) && scalar(@$rdy) > 0) {
            my str $k = read_key_raw();
            if ($k eq "C-g") {
                $KEY_QUEUE = [];
                return 1;
            }
            if (length($k) > 0) {
                push(@$KEY_QUEUE, $k);
            }
        }
    }
    return 0;
}

func lf_save_progress_callback(int $pos, int $tot) void {
    if ($TERM_ACTIVE == 1 && $tot > 0) {
        my str $msg = "Saving large file... " . Smacs::LargeFile::format_bytes($pos) . " / " . Smacs::LargeFile::format_bytes($tot);
        my str $out = $E . "[" . $ROWS . ";1H" . $E . "[K" . u8_truncate($msg, $COLS);
        core::write_fd(1, $out);
    }
}

func lf_open_file(str $path) void {
    $path = expand_tilde($path);
    if (is_directory($path) == 1) {
        dired_open_in_current_buffer($path, "");
        return;
    }
    my int $is_new = 0;
    if (file_exists($path) == 1) {
        my scalar $tfh = core::open($path, "r");
        if (!defined($tfh)) {
            set_msg("Cannot open: " . $path);
            return;
        }
        core::close($tfh);
    } else {
        $is_new = 1;
    }
    my scalar $fp = Smacs::File::fingerprint($path);
    $FILE_MTIME = $fp->{"mtime"};
    $FILE_SIZE = $fp->{"size"};
    my int $dsize = $FILE_SIZE;
    if ($dsize < 0) { $dsize = 0; }

    $LF_STATE = Smacs::LargeFile::create($path, $dsize, $LARGE_CHUNK_SIZE);
    $LARGE_MODE = 1;
    $HEX_MODE = 0;
    $HEX_BYTE_POS = 0;
    $HEX_IN_ASCII = 0;
    $HEX_NIBBLE = 0;
    $GOAL_COL = -1;
    $DIRTY = 0;

    my scalar $parsed = Smacs::LargeFile::load_chunk_from($LF_STATE, 0, 0);
    lf_apply_chunk_result($parsed);

    my str $bname = uniquify_buffer_name($BUF_IDX, $path);
    $BNAME = $bname;
    $FNAME = $path;
    my str $syn = syn_detect($path);
    if (length($syn) == 0) {
        $syn = detect_shebang_syntax($CL);
    }
    if (length($syn) == 0 && length($CONFIG_SYNTAX) > 0) {
        $syn = $CONFIG_SYNTAX;
    }
    $SYNTAX = $syn;
    $MODE = mode_for_syntax($SYNTAX);

    my scalar $b2 = $BUFFERS->[$BUF_IDX];
    $b2->{"hex_mode"} = 0;
    $b2->{"hex_data"} = undef;
    buf_save_state();

    if ($is_new == 1) {
        set_msg($path . " (New file, Large File Mode)");
    } else {
        set_msg("Opened in Large File Mode (" . Smacs::LargeFile::format_bytes($dsize) . ", chunk " . Smacs::LargeFile::format_bytes($LARGE_CHUNK_SIZE) . "): " . $path);
    }
}

func file_open(str $path) void {
    $path = expand_tilde($path);
    if (is_directory($path) == 1) {
        dired_open_in_current_buffer($path, "");
        return;
    }
    my scalar $fp0 = Smacs::File::fingerprint($path);
    if ($FORCE_LARGE_OPEN == 1 || ($fp0->{"exists"} == 1 && $LARGE_FILE_THRESHOLD > 0 && $fp0->{"size"} >= $LARGE_FILE_THRESHOLD)) {
        lf_open_file($path);
        return;
    }

    $LARGE_MODE = 0;
    $LF_STATE = undef;
    my int $is_new = 0;
    my scalar $parsed = undef;
    my scalar $data = Smacs::File::read_all($path);
    if (!defined($data)) {
        if (file_exists($path) == 1) {
            set_msg("Cannot open: " . $path);
            return;
        }
        # File doesn't exist yet: edit an empty buffer, create on save
        $is_new = 1;
        $parsed = Smacs::File::parse_text("");
    } else {
        $parsed = Smacs::File::parse_text($data);
    }
    my scalar $lines = $parsed->{"lines"};
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    $buf->{"lines"} = $lines;
    $buf->{"generation"} = $buf->{"generation"} + 1;
    $buf->{"highlight_cache"} = {};
    $buf->{"which_cache_key"} = "";
    $CL = $lines;
    $LINES_SHARED = 0;
    $FILE_EOL = $parsed->{"eol"};
    $FILE_FINAL_NL = $parsed->{"final_newline"};
    my scalar $fp = Smacs::File::fingerprint($path);
    $FILE_MTIME = $fp->{"mtime"};
    $FILE_SIZE = $fp->{"size"};
    $CY = 0;
    $CX = 0;
    $SY = 0;
    $SX = 0;
    $MY = 0;
    $MX = 0;
    $MSET = 0;
    $SHIFT_MARK = 0;
    $GOAL_COL = -1;
    $DIRTY = 0;
    $HEX_MODE = 0;
    $HEX_BYTE_POS = 0;
    $HEX_IN_ASCII = 0;
    $HEX_NIBBLE = 0;
    $UNDO = [];
    $REDO = [];
    my str $bname = uniquify_buffer_name($BUF_IDX, $path);
    $BNAME = $bname;
    $FNAME = $path;
    my str $syn = syn_detect($path);
    if (length($syn) == 0) {
        $syn = detect_shebang_syntax($lines);
    }
    if (length($syn) == 0 && length($CONFIG_SYNTAX) > 0) {
        $syn = $CONFIG_SYNTAX;
    }
    $SYNTAX = $syn;
    $MODE = mode_for_syntax($SYNTAX);
    my scalar $b2 = $BUFFERS->[$BUF_IDX];
    $b2->{"name"} = $bname;
    $b2->{"mode"} = $MODE;
    $b2->{"filename"} = $path;
    $b2->{"syntax"} = $SYNTAX;
    $b2->{"eol"} = $FILE_EOL;
    $b2->{"final_newline"} = $FILE_FINAL_NL;
    $b2->{"disk_mtime"} = $FILE_MTIME;
    $b2->{"disk_size"} = $FILE_SIZE;
    $b2->{"undo"} = $UNDO;
    $b2->{"redo"} = $REDO;
    $b2->{"hex_mode"} = 0;
    $b2->{"hex_data"} = undef;
    $b2->{"large_mode"} = 0;
    $b2->{"lf"} = undef;
    if ($is_new == 1) {
        set_msg($path . " (New file)");
    } elsif ($parsed->{"mixed_eol"} == 1) {
        set_msg("Opened: " . $path . " (mixed line endings; using the dominant style on save)");
    } else {
        set_msg("Opened: " . $path);
    }
}

func file_changed_on_disk() int {
    if (length($FNAME) == 0) { return 0; }
    my scalar $fp = Smacs::File::fingerprint($FNAME);
    if ($FILE_MTIME < 0) { return $fp->{"exists"}; }
    if ($fp->{"exists"} == 0) { return 1; }
    if ($fp->{"mtime"} != $FILE_MTIME || $fp->{"size"} != $FILE_SIZE) { return 1; }
    return 0;
}

func refresh_disk_fingerprint() void {
    my scalar $fp = Smacs::File::fingerprint($FNAME);
    $FILE_MTIME = $fp->{"mtime"};
    $FILE_SIZE = $fp->{"size"};
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    $buf->{"disk_mtime"} = $FILE_MTIME;
    $buf->{"disk_size"} = $FILE_SIZE;
}

func mark_undo_history_dirty() void {
    my int $i = 0;
    while ($i < scalar(@$UNDO)) {
        $UNDO->[$i]->{"dirty"} = 1;
        $i = $i + 1;
    }
    $i = 0;
    while ($i < scalar(@$REDO)) {
        $REDO->[$i]->{"dirty"} = 1;
        $i = $i + 1;
    }
}

func buffer_text() str {
    return Smacs::File::serialize($CL, $FILE_EOL, $FILE_FINAL_NL);
}

func lf_file_save_to(str $target_path, int $is_save_as) void {
    if (is_directory($target_path) == 1) {
        set_msg("Cannot overwrite directory: " . $target_path);
        return;
    }
    if ($is_save_as == 1) {
        if (file_exists($target_path) == 1 && same_file_path($target_path, $FNAME) == 0) {
            my int $yn = mb_read_yn("File exists; overwrite " . $target_path . "?");
            if ($yn != 1) { set_msg("Save cancelled."); return; }
        }
    } else {
        if (file_changed_on_disk() == 1) {
            my int $yn = mb_read_yn("File changed on disk; overwrite?");
            if ($yn != 1) { set_msg("Save cancelled."); return; }
        }
    }

    # Ensure newly-created non-empty large file ends with newline at EOF chunk
    if ($FILE_FINAL_NL == 0 && ($is_save_as == 1 || $FILE_SIZE <= 0)) {
        if ($LF_STATE->{"chunk_vend"} >= Smacs::LargeFile::total_size($LF_STATE)) {
            if (!(line_count() == 1 && length(get_line(0)) == 0)) {
                $FILE_FINAL_NL = 1;
            }
        }
    }

    my int $saved_sy = $SY;
    my int $saved_sx = $SX;
    lf_sync_active_chunk();
    my int $cur_voff = Smacs::LargeFile::cursor_virtual_offset($LF_STATE, $CL, $CY, $CX);
    my int $cur_vstart = $LF_STATE->{"chunk_vstart"};

    my str $err = Smacs::LargeFile::atomic_save($LF_STATE, $target_path, \&lf_save_progress_callback);
    if (length($err) > 0) {
        set_msg($err);
        return;
    }

    my int $was_unnamed = (length($FNAME) == 0);
    $FNAME = $target_path;
    if ($was_unnamed == 1 || $is_save_as == 1) {
        $BNAME = uniquify_buffer_name($BUF_IDX, $FNAME);
        my str $detected = syn_detect($FNAME);
        if (length($detected) == 0) {
            $detected = detect_shebang_syntax($CL);
        }
        if (length($detected) > 0 || $is_save_as == 1) {
            $SYNTAX = $detected;
            $MODE = mode_for_syntax($SYNTAX);
            note_buffer_changed();
        }
    }

    refresh_disk_fingerprint();
    my scalar $parsed = Smacs::LargeFile::load_chunk_from($LF_STATE, $cur_vstart, $cur_voff);
    lf_apply_chunk_result($parsed);
    $SY = $saved_sy;
    $SX = $saved_sx;
    scroll_adjust();
    $DIRTY = 0;
    buf_save_state();
    set_msg("Wrote " . Smacs::LargeFile::format_bytes($FILE_SIZE) . " to " . $FNAME);
}

func file_save_to(str $target_path, int $is_save_as) void {
    if ($LARGE_MODE == 1 && defined($LF_STATE)) {
        lf_file_save_to($target_path, $is_save_as);
        return;
    }
    if (is_directory($target_path) == 1) {
        set_msg("Cannot overwrite directory: " . $target_path);
        return;
    }
    if ($is_save_as == 1) {
        if (file_exists($target_path) == 1 && same_file_path($target_path, $FNAME) == 0) {
            my int $yn = mb_read_yn("File exists; overwrite " . $target_path . "?");
            if ($yn != 1) { set_msg("Save cancelled."); return; }
        }
    } else {
        if (file_changed_on_disk() == 1) {
            my int $yn = mb_read_yn("File changed on disk; overwrite?");
            if ($yn != 1) { set_msg("Save cancelled."); return; }
        }
    }
    # Ensure newly-created or previously 0-byte files get a trailing newline once non-empty
    if ($FILE_FINAL_NL == 0 && ($is_save_as == 1 || $FILE_SIZE <= 0)) {
        if (!(line_count() == 1 && length(get_line(0)) == 0)) {
            $FILE_FINAL_NL = 1;
        }
    }
    my str $err = Smacs::File::atomic_write($target_path, buffer_text());
    if (length($err) > 0) {
        set_msg($err);
        return;
    }
    my int $was_unnamed = (length($FNAME) == 0);
    $FNAME = $target_path;
    if ($was_unnamed == 1 || $is_save_as == 1) {
        $BNAME = uniquify_buffer_name($BUF_IDX, $FNAME);
        my str $detected = syn_detect($FNAME);
        if (length($detected) == 0) {
            $detected = detect_shebang_syntax($CL);
        }
        if (length($detected) > 0 || $is_save_as == 1) {
            $SYNTAX = $detected;
            $MODE = mode_for_syntax($SYNTAX);
            note_buffer_changed();
        }
    }
    my int $n = line_count();
    $DIRTY = 0;
    mark_undo_history_dirty();
    refresh_disk_fingerprint();
    buf_save_state();
    set_msg("Wrote " . $n . " lines to " . $FNAME);
}

func file_save() void {
    if ($MODE eq "BufferMenu") {
        bmenu_save_selected();
        return;
    }
    if ($MODE eq "Dired" || $MODE eq "Help") {
        set_msg("Buffer is not a file buffer.");
        return;
    }
    if ($HEX_MODE == 1) {
        hex_file_save();
        return;
    }
    if (length($FNAME) == 0) {
        my str $path = mb_read_file("Save as: ");
        if ($MB_CANCELLED == 1 || length($path) == 0) {
            set_msg("Save cancelled.");
            return;
        }
        file_save_to(expand_tilde($path), 1);
        return;
    }
    file_save_to($FNAME, 0);
}

func cmd_write_file() void {
    my str $path = mb_read_file("Write file: ");
    if ($MB_CANCELLED == 1 || length($path) == 0) {
        set_msg("Write cancelled.");
        return;
    }
    $path = expand_tilde($path);
    if ($HEX_MODE == 1) {
        if (is_directory($path) == 1) {
            set_msg("Cannot overwrite directory: " . $path);
            return;
        }
        if (file_exists($path) == 1 && same_file_path($path, $FNAME) == 0) {
            my int $yn = mb_read_yn("File exists; overwrite " . $path . "?");
            if ($yn != 1) { set_msg("Write cancelled."); return; }
        }
        $FNAME = $path;
        $BNAME = uniquify_buffer_name($BUF_IDX, $FNAME);
        hex_file_save();
        buf_save_state();
        return;
    }
    file_save_to($path, 1);
}

# ===========================================================================
# Config File Support
# ===========================================================================

func expand_tilde(str $p) str {
    if (length($p) > 0 && substr($p, 0, 1) eq "~") {
        my str $home = core::getenv("HOME");
        if (length($home) > 0) {
            return $home . substr($p, 1);
        }
    }
    return $p;
}

# Parse a config file with key=value pairs (lines starting with # are comments)
func load_config_file(str $path) void {
    my scalar $fh = core::open($path, "r");
    if (!defined($fh)) { return; }

    my str $line = <$fh>;
    while (defined($line)) {
        $line = trim($line);
        # Skip empty lines and comments
        if (length($line) > 0 && substr($line, 0, 1) ne "#") {
            # Find = sign
            my int $eq = index($line, "=");
            if ($eq > 0) {
                my str $key = trim(substr($line, 0, $eq));
                my str $val = trim(substr($line, $eq + 1));

                if ($key eq "line-numbers") {
                    if ($val eq "on" || $val eq "true" || $val eq "1") {
                        $LINUM = 1;
                    } else {
                        $LINUM = 0;
                    }
                } elsif ($key eq "syntax") {
                    $SYNTAX = $val;
                    $CONFIG_SYNTAX = $val;
                } elsif ($key eq "undo-max") {
                    my int $n = core::atoi($val);
                    if ($n > 0) { $UNDO_MAX = $n; }
                } elsif ($key eq "vim-syntax") {
                    vim_syntax_load(expand_tilde($val));
                } elsif ($key eq "tab-width") {
                    my int $tw = core::atoi($val);
                    if ($tw > 0 && $tw <= 16) { $TAB_WIDTH = $tw; }
                } elsif ($key eq "indent-tabs-mode") {
                    if ($val eq "on" || $val eq "true" || $val eq "1" || $val eq "tabs") {
                        $INDENT_TABS = 1;
                    } else {
                        $INDENT_TABS = 0;
                    }
                } elsif ($key eq "fill-column") {
                    my int $fc = core::atoi($val);
                    if ($fc > 0 && $fc <= 1000) { $FILL_COLUMN = $fc; }
                } elsif ($key eq "syntax-dir") {
                    load_syntax_dir(expand_tilde($val));
                } elsif ($key eq "syntax-ext") {
                    # Map extension to language: syntax-ext = rs:rust
                    my int $cp = index($val, ":");
                    if ($cp > 0) {
                        my str $ext = trim(substr($val, 0, $cp));
                        my str $lang = trim(substr($val, $cp + 1));
                        $SYN_EXT_MAP->{$ext} = $lang;
                    }
                } elsif ($key eq "completion-mode") {
                    if ($val eq "on" || $val eq "true" || $val eq "1") {
                        $COMP_MODE = 1;
                    } else {
                        $COMP_MODE = 0;
                    }
                } elsif ($key eq "complete-dir") {
                    my str $cdir = expand_tilde($val);
                    my array @cent = core::readdir($cdir);
                    if (scalar(@cent) > 0) {
                        $COMP_DIR = $cdir;
                        comp_load_dir($COMP_DIR);
                    }
                } elsif ($key eq "which-function-mode") {
                    if ($val eq "on" || $val eq "true" || $val eq "1") {
                        $WHICH_FUNC = 1;
                    } else {
                        $WHICH_FUNC = 0;
                    }
                } elsif ($key eq "large-file-threshold" || $key eq "large_file_threshold") {
                    my int $thr = Smacs::LargeFile::parse_size_spec($val);
                    if ($thr >= 0) { $LARGE_FILE_THRESHOLD = $thr; }
                } elsif ($key eq "large-file-chunk-size" || $key eq "large_file_chunk_size") {
                    my int $csz = Smacs::LargeFile::parse_size_spec($val);
                    if ($csz >= 4096) { $LARGE_CHUNK_SIZE = $csz; }
                }
            }
        }
        $line = <$fh>;
    }
    core::close($fh);
}

func load_config() void {
    # System config
    load_config_file("/etc/smacsrc");

    # A custom PREFIX install is discovered relative to PREFIX/bin/smacs.
    my str $prefix = runtime_prefix();
    if (length($prefix) > 0) {
        load_config_file($prefix . "/etc/smacsrc");
    }

    # User config: ~/.smacsrc
    my str $home = core::getenv("HOME");
    if (length($home) > 0) {
        load_config_file($home . "/.smacsrc");
    }
    my str $explicit = core::getenv("SMACS_CONFIG");
    if (length($explicit) > 0) { load_config_file(expand_tilde($explicit)); }
}

# ===========================================================================
# Code Completion
# ===========================================================================

func comp_load_file(str $path, str $lang) void {
    my scalar $fh = core::open($path, "r");
    if (!defined($fh)) { return; }
    if (!defined($COMP_DEFS->{$lang})) {
        $COMP_DEFS->{$lang} = {};
    }
    my scalar $def = $COMP_DEFS->{$lang};
    my str $line = <$fh>;
    while (defined($line)) {
        if (length($line) > 0 && substr($line, 0, 1) ne "#") {
            my int $colon = index($line, ":");
            if ($colon > 0) {
                my str $cat = trim(substr($line, 0, $colon));
                my str $words = trim(substr($line, $colon + 1));
                if (length($words) > 0) {
                    if (defined($def->{$cat}) && length($def->{$cat}) > 0) {
                        $def->{$cat} = $def->{$cat} . " " . $words;
                    } else {
                        $def->{$cat} = $words;
                    }
                }
            }
        }
        $line = <$fh>;
    }
    core::close($fh);
}

func comp_load_dir(str $dir) void {
    my array @entries = core::readdir($dir);
    my int $count = 0;
    my int $i = 0;
    while ($i < scalar(@entries)) {
        my str $name = $entries[$i];
        my int $nlen = length($name);
        if ($nlen > 9 && substr($name, $nlen - 9) eq ".complete") {
            my str $lang = substr($name, 0, $nlen - 9);
            comp_load_file($dir . "/" . $name, $lang);
            $count = $count + 1;
        }
        $i = $i + 1;
    }
    if ($count > 0) {
        set_msg("Loaded " . $count . " completion files from " . $dir);
    }
}

func comp_is_word_ch(str $ch) int {
    my int $code = ord($ch);
    # a-z
    if ($code >= 97 && $code <= 122) { return 1; }
    # A-Z
    if ($code >= 65 && $code <= 90) { return 1; }
    # 0-9
    if ($code >= 48 && $code <= 57) { return 1; }
    # underscore
    if ($code == 95) { return 1; }
    return 0;
}

func comp_find_prefix() str {
    my str $line = get_line($CY);
    my int $end = $CX;
    my int $start = $end;
    while ($start > 0) {
        my str $ch = substr($line, $start - 1, 1);
        if (comp_is_word_ch($ch) == 1) {
            $start = $start - 1;
        } elsif ($ch eq ":" && $start >= 2 && substr($line, $start - 2, 1) eq ":") {
            # Include :: for namespaced completions
            $start = $start - 2;
        } elsif ($ch eq "$" || $ch eq "@" || $ch eq "%") {
            $start = $start - 1;
            last;
        } else {
            last;
        }
    }
    if ($start >= $end) { return ""; }
    return substr($line, $start, $end - $start);
}

func comp_scan_words(scalar $lines, str $prefix, scalar $seen, scalar $results) void {
    my int $plen = length($prefix);
    my int $li = 0;
    my int $line_count = scalar(@$lines);
    if ($line_count > 5000) { $line_count = 5000; }
    while ($li < $line_count) {
        my str $line = $lines->[$li];
        my int $llen = length($line);
        my int $ci = 0;
        while ($ci < $llen) {
            my str $ch = substr($line, $ci, 1);
            if (comp_is_word_ch($ch) == 1 || $ch eq "$" || $ch eq "@" || $ch eq "%") {
                my int $ws = $ci;
                $ci = $ci + 1;
                while ($ci < $llen) {
                    my str $wch = substr($line, $ci, 1);
                    if (comp_is_word_ch($wch) == 1) {
                        $ci = $ci + 1;
                    } elsif ($wch eq ":" && $ci + 1 < $llen && substr($line, $ci + 1, 1) eq ":") {
                        $ci = $ci + 2;
                    } else {
                        last;
                    }
                }
                my str $word = "" . substr($line, $ws, $ci - $ws);
                if (length($word) >= 3 && $word ne $prefix) {
                    if ($plen == 0 || substr($word, 0, $plen) eq $prefix) {
                        my str $wkey = "" . $word;
                        if (!defined($seen->{$wkey}) || length("" . $seen->{$wkey}) == 0) {
                            $seen->{$wkey} = "1";
                            push(@$results, $word);
                        }
                    }
                }
            } else {
                $ci = $ci + 1;
            }
        }
        $li = $li + 1;
    }
}

func comp_scan_decls(scalar $lines, str $prefix, scalar $seen, scalar $results) void {
    my int $plen = length($prefix);
    my int $li = 0;
    my int $lc = scalar(@$lines);
    if ($lc > 10000) { $lc = 10000; }
    while ($li < $lc) {
        my str $line = $lines->[$li];
        my int $llen = length($line);

        # Scan for variable declarations: my/our/local TYPE? $var / @var / %var
        my int $ci = 0;
        while ($ci < $llen) {
            # Look for 'my ', 'our ', 'local '
            my int $is_decl = 0;
            if ($ci + 3 <= $llen && substr($line, $ci, 3) eq "my ") {
                $ci = $ci + 3;
                $is_decl = 1;
            } elsif ($ci + 4 <= $llen && substr($line, $ci, 4) eq "our ") {
                $ci = $ci + 4;
                $is_decl = 1;
            } elsif ($ci + 6 <= $llen && substr($line, $ci, 6) eq "local ") {
                $ci = $ci + 6;
                $is_decl = 1;
            }
            if ($is_decl == 1) {
                # Skip optional type: int, str, scalar, array, hash, num, etc.
                while ($ci < $llen && substr($line, $ci, 1) eq " ") { $ci = $ci + 1; }
                if ($ci < $llen && is_word_char(substr($line, $ci, 1)) == 1) {
                    my str $fc = substr($line, $ci, 1);
                    if (!($fc eq "$" || $fc eq "@" || $fc eq "%" || $fc eq "(")) {
                        # Skip the type word
                        while ($ci < $llen && is_word_char(substr($line, $ci, 1)) == 1) { $ci = $ci + 1; }
                        while ($ci < $llen && substr($line, $ci, 1) eq " ") { $ci = $ci + 1; }
                    }
                }
                # Now expect sigil + name
                if ($ci < $llen) {
                    my str $sigil = substr($line, $ci, 1);
                    if ($sigil eq "$" || $sigil eq "@" || $sigil eq "%") {
                        my int $vs = $ci;
                        $ci = $ci + 1;
                        while ($ci < $llen && is_word_char(substr($line, $ci, 1)) == 1) { $ci = $ci + 1; }
                        my str $var = "" . substr($line, $vs, $ci - $vs);
                        if (length($var) >= 2 && $var ne $prefix) {
                            if ($plen == 0 || substr($var, 0, $plen) eq $prefix) {
                                my str $vkey = "" . $var;
                                if (!defined($seen->{$vkey}) || length("" . $seen->{$vkey}) == 0) {
                                    $seen->{$vkey} = "1";
                                    push(@$results, $var);
                                }
                            }
                        }
                    }
                }
            } else {
                $ci = $ci + 1;
            }
        }

        # Scan for function definitions: func/fn/sub NAME
        my int $fi = 0;
        while ($fi < $llen) {
            my int $is_func = 0;
            my int $kw_end = 0;
            # Check for 'func ' or 'fn ' or 'sub '
            if ($fi + 5 <= $llen && substr($line, $fi, 5) eq "func ") {
                $is_func = 1;
                $kw_end = $fi + 5;
            } elsif ($fi + 3 <= $llen && substr($line, $fi, 3) eq "fn ") {
                $is_func = 1;
                $kw_end = $fi + 3;
            } elsif ($fi + 4 <= $llen && substr($line, $fi, 4) eq "sub ") {
                $is_func = 1;
                $kw_end = $fi + 4;
            }
            if ($is_func == 1) {
                # Must be at start of line or after whitespace/keywords
                my int $ok = 0;
                if ($fi == 0) { $ok = 1; }
                elsif (substr($line, $fi - 1, 1) eq " " || substr($line, $fi - 1, 1) eq "\t") { $ok = 1; }
                if ($ok == 1) {
                    while ($kw_end < $llen && substr($line, $kw_end, 1) eq " ") { $kw_end = $kw_end + 1; }
                    if ($kw_end < $llen && is_word_char(substr($line, $kw_end, 1)) == 1) {
                        my int $ns = $kw_end;
                        while ($kw_end < $llen && is_word_char(substr($line, $kw_end, 1)) == 1) { $kw_end = $kw_end + 1; }
                        my str $fname = "" . substr($line, $ns, $kw_end - $ns);
                        if (length($fname) >= 2 && $fname ne $prefix) {
                            if ($plen == 0 || substr($fname, 0, $plen) eq $prefix) {
                                my str $fkey = "" . $fname;
                                if (!defined($seen->{$fkey}) || length("" . $seen->{$fkey}) == 0) {
                                    $seen->{$fkey} = "1";
                                    push(@$results, $fname);
                                }
                            }
                        }
                    }
                }
                $fi = $kw_end;
            } else {
                $fi = $fi + 1;
            }
        }

        # Scan for C-style function definitions: type name( or type *name(
        # Heuristic: line starts (after optional qualifiers) with word(s), then name(
        my int $pi = 0;
        # Skip leading whitespace
        while ($pi < $llen && (substr($line, $pi, 1) eq " " || substr($line, $pi, 1) eq "\t")) { $pi = $pi + 1; }
        # Skip preprocessor lines and comments
        if ($pi < $llen && substr($line, $pi, 1) ne "#" && substr($line, $pi, 1) ne "/" && substr($line, $pi, 1) ne "*") {
            # Collect words before a '(' — the last word before '(' is the function name
            my int $paren = index($line, "(");
            if ($paren > 0) {
                # Walk backward from '(' to find function name
                my int $pe = $paren;
                # Skip * for pointer returns
                while ($pe > $pi && substr($line, $pe - 1, 1) eq "*") { $pe = $pe - 1; }
                # The function name is the word right before '('
                my int $ne = $pe;
                while ($ne > $pi && substr($line, $ne - 1, 1) eq " ") { $ne = $ne - 1; }
                my int $ns = $ne;
                while ($ns > $pi && is_word_char(substr($line, $ns - 1, 1)) == 1) { $ns = $ns - 1; }
                if ($ns < $ne && $ns > $pi) {
                    # There must be a return type before the name (at least one word before it)
                    my str $fname = "" . substr($line, $ns, $ne - $ns);
                    # Exclude control flow keywords
                    if ($fname ne "if" && $fname ne "while" && $fname ne "for" && $fname ne "switch" && $fname ne "return" && $fname ne "sizeof" && $fname ne "else" && $fname ne "do" && $fname ne "case" && $fname ne "defined") {
                        if (length($fname) >= 2 && $fname ne $prefix) {
                            if ($plen == 0 || substr($fname, 0, $plen) eq $prefix) {
                                my str $fkey = "" . $fname;
                                if (!defined($seen->{$fkey}) || length("" . $seen->{$fkey}) == 0) {
                                    $seen->{$fkey} = "1";
                                    push(@$results, $fname);
                                }
                            }
                        }
                    }
                }
            }
        }

        $li = $li + 1;
    }
}

func comp_gather(str $prefix) scalar {
    my scalar $seen = {};
    my scalar $results = [];
    my int $plen = length($prefix);

    # 1. Language definition words first
    if (length($SYNTAX) > 0 && defined($COMP_DEFS->{$SYNTAX})) {
        my scalar $def = $COMP_DEFS->{$SYNTAX};
        my array @cats = keys(%$def);
        my int $ci = 0;
        while ($ci < scalar(@cats)) {
            my str $cat = $cats[$ci];
            my str $words_str = $def->{$cat};
            my array @words = split(" ", $words_str);
            my int $wi = 0;
            while ($wi < scalar(@words)) {
                my str $w = $words[$wi];
                if (length($w) > 0 && ($plen == 0 || substr($w, 0, $plen) eq $prefix)) {
                    if (!defined($seen->{$w}) || length("" . $seen->{$w}) == 0) {
                        $seen->{$w} = "1";
                        push(@$results, $w);
                    }
                }
                $wi = $wi + 1;
            }
            $ci = $ci + 1;
        }
    }

    # 2. Syntax keywords (from syn_init / loaded vim syntax)
    if (defined($SYN_KEYWORDS) && defined($SYN_KEYWORDS->{$SYNTAX})) {
        my scalar $kw_hash = $SYN_KEYWORDS->{$SYNTAX};
        my array @kws = keys(%$kw_hash);
        my int $ki = 0;
        while ($ki < scalar(@kws)) {
            my str $kw = $kws[$ki];
            if (length($kw) >= 2 && $kw ne $prefix && ($plen == 0 || substr($kw, 0, $plen) eq $prefix)) {
                if (!defined($seen->{$kw}) || length("" . $seen->{$kw}) == 0) {
                    $seen->{$kw} = "1";
                    push(@$results, $kw);
                }
            }
            $ki = $ki + 1;
        }
    }
    if (length($SYNTAX) > 0 && defined($VIM_SYN) && defined($VIM_SYN->{$SYNTAX})) {
        my scalar $vkw_groups = $VIM_SYN->{$SYNTAX}->{"keywords"};
        if (defined($vkw_groups)) {
            my array @grps = keys(%$vkw_groups);
            my int $gi = 0;
            while ($gi < scalar(@grps)) {
                my str $gwords = $vkw_groups->{$grps[$gi]};
                my array @gws = split(" ", $gwords);
                my int $wi = 0;
                while ($wi < scalar(@gws)) {
                    my str $kw2 = $gws[$wi];
                    if (length($kw2) >= 2 && $kw2 ne $prefix && ($plen == 0 || substr($kw2, 0, $plen) eq $prefix)) {
                        if (!defined($seen->{$kw2}) || length("" . $seen->{$kw2}) == 0) {
                            $seen->{$kw2} = "1";
                            push(@$results, $kw2);
                        }
                    }
                    $wi = $wi + 1;
                }
                $gi = $gi + 1;
            }
        }
    }

    # 3. Variables and function names from current buffer
    comp_scan_decls($CL, $prefix, $seen, $results);

    # 4. Current buffer words
    comp_scan_words($CL, $prefix, $seen, $results);

    # 5. Other open buffers (declarations then words)
    my int $bi = 0;
    while ($bi < scalar(@$BUFFERS)) {
        if ($bi != $BUF_IDX) {
            my scalar $buf = $BUFFERS->[$bi];
            my scalar $blines = $buf->{"lines"};
            comp_scan_decls($blines, $prefix, $seen, $results);
            comp_scan_words($blines, $prefix, $seen, $results);
        }
        $bi = $bi + 1;
    }

    return $results;
}

func comp_anchor() void {
    # Compute popup screen position from cursor
    my scalar $win = $WINDOWS->[$WIN_IDX];
    my int $win_top = $win->{"top_row"};
    my int $win_left = $win->{"left_col"};
    my str $cur_line = get_line($CY);
    my int $cursor_col = u8_byte_to_col($cur_line, $CX);
    my int $prefix_start_col = $cursor_col - u8_str_width($COMP_PREFIX);
    my int $gutter = linum_width();
    $COMP_ROW = $CY - $SY + $win_top + 2;
    $COMP_COL = $prefix_start_col - $SX + 1 + $gutter + $win_left;
    if ($COMP_COL < 1) { $COMP_COL = 1; }
}

func comp_start() void {
    if ($COMP_MODE == 0) {
        set_msg("Completion mode is off. M-x completion-mode to enable.");
        return;
    }
    $COMP_PREFIX = comp_find_prefix();
    if (length($COMP_PREFIX) == 0) {
        set_msg("No prefix at cursor.");
        return;
    }
    $COMP_LIST = comp_gather($COMP_PREFIX);
    my int $n = scalar(@$COMP_LIST);
    if ($n == 0) {
        set_msg("No completions.");
        return;
    }
    if ($n == 1 && $COMP_LIST->[0] eq $COMP_PREFIX) {
        set_msg("Sole completion.");
        return;
    }
    if ($n == 1) {
        $COMP_IDX = 0;
        my str $sole = $COMP_LIST->[0];
        comp_accept();
        set_msg("Completed: " . $sole);
        return;
    }
    $COMP_ACTIVE = 1;
    $COMP_IDX = 0;
    $COMP_SCROLL = 0;
    comp_anchor();
    set_msg("Completions: " . $n);
}

func comp_accept() void {
    if (scalar(@$COMP_LIST) == 0) {
        $COMP_ACTIVE = 0;
        return;
    }
    undo_save();
    $INSERT_GROUP = 0;
    my str $word = $COMP_LIST->[$COMP_IDX];
    my str $line = get_line($CY);
    my int $ps = $CX - length($COMP_PREFIX);
    my str $before = substr($line, 0, $ps);
    my str $after = "";
    if ($CX < length($line)) { $after = substr($line, $CX); }
    set_line($CY, $before . $word . $after);
    $CX = $ps + length($word);
    $DIRTY = 1;
    $COMP_ACTIVE = 0;
    set_msg("");
}

func comp_dismiss() void {
    $COMP_ACTIVE = 0;
    $COMP_LIST = [];
    $COMP_IDX = 0;
    set_msg("");
}

func comp_update() void {
    $COMP_PREFIX = comp_find_prefix();
    if (length($COMP_PREFIX) == 0) {
        comp_dismiss();
        return;
    }
    $COMP_LIST = comp_gather($COMP_PREFIX);
    if (scalar(@$COMP_LIST) == 0) {
        comp_dismiss();
        return;
    }
    $COMP_IDX = 0;
    $COMP_SCROLL = 0;
    comp_anchor();
}

# ===========================================================================
# Syntax Highlighting
# ===========================================================================

func syn_init() void {
    $SYN_KEYWORDS = {};
}

func syn_detect(str $filename) str {
    if (length($filename) == 0) {
        return "";
    }
    # Check basename for extensionless/special files (e.g. Makefile, Dockerfile, .bashrc)
    my str $basename = path_basename($filename);
    if (defined($SYN_BASE_MAP) && defined($SYN_BASE_MAP->{$basename}) && length($SYN_BASE_MAP->{$basename}) > 0) {
        return $SYN_BASE_MAP->{$basename};
    }
    if ($basename eq "Makefile" || $basename eq "makefile" || $basename eq "GNUmakefile") {
        return "make";
    }
    if ($basename eq "Dockerfile" || index($basename, "Dockerfile.") == 0) {
        return "dockerfile";
    }
    if ($basename eq "CMakeLists.txt") {
        return "cmake";
    }

    my int $dot = -1;
    my int $i = length($basename) - 1;
    while ($i > 0) {
        if (substr($basename, $i, 1) eq ".") {
            $dot = $i;
            last;
        }
        $i = $i - 1;
    }
    if ($dot == -1) {
        return "";
    }
    my str $ext = substr($basename, $dot + 1);
    # Check dynamic extension map first (from ftdetect files / smacsrc)
    if (defined($SYN_EXT_MAP) && defined($SYN_EXT_MAP->{$ext}) && length("" . $SYN_EXT_MAP->{$ext}) > 0) {
        return $SYN_EXT_MAP->{$ext};
    }
    if ($ext eq "c" || $ext eq "h") {
        return "c";
    }
    if ($ext eq "pl" || $ext eq "pm" || $ext eq "t") {
        return "perl";
    }
    if ($ext eq "strada" || $ext eq "st") {
        return "strada";
    }
    if ($ext eq "py") {
        return "python";
    }
    if ($ext eq "js") {
        return "javascript";
    }
    if ($ext eq "html" || $ext eq "htm") {
        return "html";
    }
    if ($ext eq "css") {
        return "css";
    }
    if ($ext eq "sh" || $ext eq "bash") {
        return "sh";
    }
    if ($ext eq "mk") {
        return "make";
    }
    if ($ext eq "md" || $ext eq "markdown") {
        return "markdown";
    }
    return "";
}

func is_word_char(str $ch) int {
    if (length($ch) == 0) { return 0; }
    my int $code = ord($ch);
    if ($code >= 97 && $code <= 122) { return 1; }
    if ($code >= 65 && $code <= 90) { return 1; }
    if ($code >= 48 && $code <= 57) { return 1; }
    if ($code == 95) { return 1; }
    # Multi-byte UTF-8 chars (accented letters, CJK, etc.) are word chars
    if ($code >= 128) { return 1; }
    return 0;
}

# Extract a single UTF-8 character from string at byte position
func u8_char_at(str $s, int $pos) str {
    my int $len = length($s);
    if ($pos >= $len) { return ""; }
    my int $next = u8_next($s, $pos);
    return substr($s, $pos, $next - $pos);
}

func is_digit(str $ch) int {
    if (length($ch) == 0) { return 0; }
    my int $code = ord($ch);
    return ($code >= 48 && $code <= 57);
}

func highlight_line_uncached(str $line, str $lang) str {
    if (length($lang) == 0 || !defined($SYN_KEYWORDS)) {
        return $line;
    }

    # Check for vim syntax first
    if (defined($VIM_SYN)) {
        my str $vresult = vim_highlight($line, $lang);
        if (length($vresult) > 0) {
            return $vresult;
        }
    }

    my scalar $kw_map = $SYN_KEYWORDS->{$lang};
    if (!defined($kw_map)) {
        return $line;
    }

    my str $reset = $E . "[0m";
    my str $out = "";
    my int $i = 0;
    my int $len = length($line);
    my int $in_str = 0;
    my int $in_char = 0;

    while ($i < $len) {
        my str $ch = substr($line, $i, 1);

        # Line comments
        if ($in_str == 0 && $in_char == 0) {
            if ($lang eq "c" && $i + 1 < $len && substr($line, $i, 2) eq "//") {
                $out = $out . $E . "[90m" . substr($line, $i) . $reset;
                return $out;
            }
            if (($lang eq "perl" || $lang eq "strada") && $ch eq "#") {
                $out = $out . $E . "[90m" . substr($line, $i) . $reset;
                return $out;
            }
            # C preprocessor lines
            if ($lang eq "c" && $ch eq "#" && $i == 0) {
                # Highlight the directive word
                my int $j = 0;
                while ($j < $len && substr($line, $j, 1) eq " ") {
                    $j = $j + 1;
                }
                if ($j < $len && substr($line, $j, 1) eq "#") {
                    $out = $out . $E . "[34m" . $line . $reset;
                    return $out;
                }
            }
        }

        # Double-quoted strings
        if ($in_char == 0 && $in_str == 0 && $ch eq "\"") {
            $in_str = 1;
            $out = $out . $E . "[32m\"";
            $i = $i + 1;
            while ($i < $len) {
                $ch = substr($line, $i, 1);
                if ($ch eq "\\" && $i + 1 < $len) {
                    $out = $out . $ch . substr($line, $i + 1, 1);
                    $i = $i + 2;
                } elsif ($ch eq "\"") {
                    $out = $out . "\"" . $reset;
                    $in_str = 0;
                    $i = $i + 1;
                    last;
                } else {
                    $out = $out . $ch;
                    $i = $i + 1;
                }
            }
            if ($in_str == 1) {
                $out = $out . $reset;
                $in_str = 0;
            }
            next;
        }

        # Single-quoted strings
        if ($in_str == 0 && $in_char == 0 && $ch eq "'") {
            $in_char = 1;
            $out = $out . $E . "[32m'";
            $i = $i + 1;
            while ($i < $len) {
                $ch = substr($line, $i, 1);
                if ($ch eq "\\" && $i + 1 < $len) {
                    $out = $out . $ch . substr($line, $i + 1, 1);
                    $i = $i + 2;
                } elsif ($ch eq "'") {
                    $out = $out . "'" . $reset;
                    $in_char = 0;
                    $i = $i + 1;
                    last;
                } else {
                    $out = $out . $ch;
                    $i = $i + 1;
                }
            }
            if ($in_char == 1) {
                $out = $out . $reset;
                $in_char = 0;
            }
            next;
        }

        # Sigils for Perl/Strada
        if (($lang eq "perl" || $lang eq "strada") && ($ch eq "$" || $ch eq "@" || $ch eq "%")) {
            my str $sigil = $ch;
            $i = $i + 1;
            my str $varname = "";
            while ($i < $len && is_word_char(u8_char_at($line, $i)) == 1) {
                my int $vnext = u8_next($line, $i);
                $varname = $varname . substr($line, $i, $vnext - $i);
                $i = $vnext;
            }
            if (length($varname) > 0) {
                $out = $out . $E . "[36;1m" . $sigil . $varname . $reset;
            } else {
                $out = $out . $sigil;
            }
            next;
        }

        # Keywords / identifiers
        if (is_word_char($ch) == 1) {
            my int $start = $i;
            while ($i < $len && is_word_char(u8_char_at($line, $i)) == 1) {
                $i = u8_next($line, $i);
            }
            my str $word = substr($line, $start, $i - $start);
            my str $color = "";
            if (defined($kw_map->{$word})) {
                $color = $kw_map->{$word};
            }
            if (length($color) > 0) {
                $out = $out . $E . "[" . $color . "m" . $word . $reset;
            } else {
                $out = $out . $word;
            }
            next;
        }

        # Numbers
        if (is_digit($ch) == 1) {
            my int $start = $i;
            while ($i < $len) {
                my str $nc = substr($line, $i, 1);
                if (is_digit($nc) == 1 || $nc eq "." || $nc eq "x" || $nc eq "X") {
                    $i = $i + 1;
                } else {
                    last;
                }
            }
            $out = $out . $E . "[35m" . substr($line, $start, $i - $start) . $reset;
            next;
        }

        # Advance by full UTF-8 character
        my int $nxi = u8_next($line, $i);
        $out = $out . substr($line, $i, $nxi - $i);
        $i = $nxi;
    }
    return $out;
}

func highlight_line_cached(str $line, str $lang, int $row) str {
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my scalar $cache = $buf->{"highlight_cache"};
    if (!defined($cache)) { $cache = {}; $buf->{"highlight_cache"} = $cache; }
    my str $key = $buf->{"generation"} . ":" . $row . ":" . $TAB_WIDTH . ":" . $lang;
    if (defined($cache->{$key})) { return $cache->{$key}; }
    my str $colored = highlight_line_uncached($line, $lang);
    $cache->{$key} = $colored;
    return $colored;
}

# ===========================================================================
# Vim Syntax File Loading
# ===========================================================================

func load_ftdetect_dir(str $dir) void {
    # Read ftdetect/*.vim files for extension and basename mappings
    # Handles lines like: au BufRead,BufNewFile *.ext,Makefile setfiletype lang
    my str $ftdir = $dir . "/ftdetect";
    my array @entries = core::readdir($ftdir);
    my int $i = 0;
    while ($i < scalar(@entries)) {
        my str $name = $entries[$i];
        my int $nlen = length($name);
        if ($nlen > 4 && substr($name, $nlen - 4) eq ".vim") {
            my scalar $fh = core::open($ftdir . "/" . $name, "r");
            if (defined($fh)) {
                my str $line = <$fh>;
                while (defined($line)) {
                    $line = trim($line);
                    my str $lang = "";
                    my str $before = "";
                    my int $sft = index($line, "setfiletype ");
                    if ($sft >= 0) {
                        $lang = trim(substr($line, $sft + 12));
                        $before = trim(substr($line, 0, $sft));
                    } else {
                        my int $sft2 = index($line, "set ft=");
                        if ($sft2 >= 0) {
                            $lang = trim(substr($line, $sft2 + 7));
                            $before = trim(substr($line, 0, $sft2));
                        } else {
                            my int $sft3 = index($line, "set filetype=");
                            if ($sft3 >= 0) {
                                $lang = trim(substr($line, $sft3 + 13));
                                $before = trim(substr($line, 0, $sft3));
                            }
                        }
                    }
                    if (length($lang) > 0 && length($before) > 0) {
                        # Find the file pattern list (last whitespace-separated token in $before)
                        my int $last_ws = -1;
                        my int $wi = 0;
                        while ($wi < length($before)) {
                            my str $wch = substr($before, $wi, 1);
                            if ($wch eq " " || $wch eq "\t") { $last_ws = $wi; }
                            $wi = $wi + 1;
                        }
                        if ($last_ws >= 0 && $last_ws + 1 < length($before)) {
                            my str $pat_list = substr($before, $last_ws + 1);
                            my array @pats = split(",", $pat_list);
                            my int $pi = 0;
                            while ($pi < scalar(@pats)) {
                                my str $pat = trim($pats[$pi]);
                                if (length($pat) > 2 && substr($pat, 0, 2) eq "*.") {
                                    my str $ext = substr($pat, 2);
                                    if (index($ext, "*") < 0 && index($ext, "/") < 0) {
                                        $SYN_EXT_MAP->{$ext} = $lang;
                                    }
                                } elsif (length($pat) > 0 && index($pat, "*") < 0 && index($pat, "/") < 0) {
                                    $SYN_BASE_MAP->{$pat} = $lang;
                                }
                                $pi = $pi + 1;
                            }
                        }
                    }
                    $line = <$fh>;
                }
                core::close($fh);
            }
        }
        $i = $i + 1;
    }
}

func vim_extract_delimited(str $s) str {
    my str $p = trim($s);
    # Skip leading option words such as 'contained', 'display', 'transparent', 'nextgroup=...'
    while (length($p) > 0) {
        my str $fc = substr($p, 0, 1);
        if (($fc ge "a" && $fc le "z") || ($fc ge "A" && $fc le "Z")) {
            my int $wi = 0;
            while ($wi < length($p) && substr($p, $wi, 1) ne " " && substr($p, $wi, 1) ne "\t") {
                $wi = $wi + 1;
            }
            $p = trim(substr($p, $wi));
        } else {
            last;
        }
    }
    if (length($p) < 2) { return ""; }
    my str $delim = substr($p, 0, 1);
    my int $j = 1;
    while ($j < length($p)) {
        my str $ch = substr($p, $j, 1);
        if ($ch eq "\\" && $j + 1 < length($p)) {
            $j = $j + 2;
            next;
        }
        if ($ch eq $delim) {
            return substr($p, 1, $j - 1);
        }
        $j = $j + 1;
    }
    return "";
}

func load_syntax_dir(str $dir) void {
    # First load ftdetect mappings if available
    load_ftdetect_dir($dir);

    # Then load syntax/*.vim files, or *.vim files directly in dir
    my str $syndir = $dir . "/syntax";
    my array @entries = core::readdir($syndir);
    my int $count = 0;
    if (scalar(@entries) > 0) {
        # Has syntax/ subdirectory (standard vim layout)
        my int $i = 0;
        while ($i < scalar(@entries)) {
            my str $name = $entries[$i];
            my int $nlen = length($name);
            if ($nlen > 4 && substr($name, $nlen - 4) eq ".vim") {
                vim_syntax_load($syndir . "/" . $name);
                $count = $count + 1;
            }
            $i = $i + 1;
        }
    } else {
        # Flat directory of .vim files
        @entries = core::readdir($dir);
        my int $i = 0;
        while ($i < scalar(@entries)) {
            my str $name = $entries[$i];
            my int $nlen = length($name);
            if ($nlen > 4 && substr($name, $nlen - 4) eq ".vim") {
                vim_syntax_load($dir . "/" . $name);
                $count = $count + 1;
            }
            $i = $i + 1;
        }
    }
    if ($count > 0) {
        set_msg("Loaded " . $count . " syntax files from " . $dir);
    }
}

func vim_syntax_load(str $path) void {
    my scalar $fh = core::open($path, "r");
    if (!defined($fh)) {
        set_msg("Cannot load vim syntax: " . $path);
        return;
    }
    if (!defined($VIM_SYN)) {
        $VIM_SYN = {};
    }

    my scalar $syn = {};
    $syn->{"keywords"} = {};
    $syn->{"matches"} = {};
    $syn->{"regions"} = {};
    $syn->{"links"} = {};
    $syn->{"case_ignore"} = 0;

    my str $line = <$fh>;
    while (defined($line)) {
        # Remove leading/trailing whitespace
        $line = trim($line);

        if ($line eq "syn case ignore" || $line eq "syntax case ignore") {
            $syn->{"case_ignore"} = 1;
        } elsif ($line eq "syn case match" || $line eq "syntax case match") {
            $syn->{"case_ignore"} = 0;
        }

        # syn keyword GroupName word1 word2 ...
        if (index($line, "syn keyword ") == 0 || index($line, "syntax keyword ") == 0) {
            my str $rest = "";
            if (index($line, "syn keyword ") == 0) {
                $rest = substr($line, 12);
            } else {
                $rest = substr($line, 15);
            }
            my int $sp = index($rest, " ");
            if ($sp > 0) {
                my str $group = substr($rest, 0, $sp);
                my str $words = substr($rest, $sp + 1);
                # Remove contained, nextgroup, etc.
                my int $cpos = index($words, " contained");
                if ($cpos >= 0) {
                    $words = substr($words, 0, $cpos);
                }
                my scalar $kw_hash = $syn->{"keywords"};
                if (defined($kw_hash->{$group})) {
                    $kw_hash->{$group} = $kw_hash->{$group} . " " . $words;
                } else {
                    $kw_hash->{$group} = $words;
                }
            }
        }

        # syn match GroupName /pattern/ or "pattern" or +pattern+
        if (index($line, "syn match ") == 0 || index($line, "syntax match ") == 0) {
            my str $rest = "";
            if (index($line, "syn match ") == 0) {
                $rest = substr($line, 10);
            } else {
                $rest = substr($line, 13);
            }
            my int $sp = index($rest, " ");
            if ($sp > 0) {
                my str $group = substr($rest, 0, $sp);
                my str $pstr = substr($rest, $sp + 1);
                my str $pat = vim_extract_delimited($pstr);
                if (length($pat) > 0) {
                    my scalar $mh = $syn->{"matches"};
                    if (!defined($mh->{$group})) {
                        $mh->{$group} = [];
                    }
                    my scalar $plist = $mh->{$group};
                    push(@$plist, $pat);
                }
            }
        }

        # syn region GroupName start=/pat/ end=/pat/
        if (index($line, "syn region ") == 0 || index($line, "syntax region ") == 0) {
            my str $rest = "";
            if (index($line, "syn region ") == 0) {
                $rest = substr($line, 11);
            } else {
                $rest = substr($line, 14);
            }
            my int $sp = index($rest, " ");
            if ($sp > 0) {
                my str $group = substr($rest, 0, $sp);
                my str $opts = substr($rest, $sp + 1);
                my str $start_pat = "";
                my str $end_pat = "";
                my int $si = index($opts, "start=");
                if ($si >= 0) {
                    $start_pat = vim_extract_delimited(substr($opts, $si + 6));
                }
                my int $ei = index($opts, "end=");
                if ($ei >= 0) {
                    $end_pat = vim_extract_delimited(substr($opts, $ei + 4));
                }
                if (length($start_pat) > 0 && length($end_pat) > 0) {
                    my scalar $rh = $syn->{"regions"};
                    if (!defined($rh->{$group})) {
                        $rh->{$group} = [];
                    }
                    my scalar $reg = {};
                    $reg->{"start"} = $start_pat;
                    $reg->{"end"} = $end_pat;
                    my scalar $rlist = $rh->{$group};
                    push(@$rlist, $reg);
                }
            }
        }

        # hi def link GroupName HighlightGroup
        # hi link GroupName HighlightGroup
        if (index($line, "hi def link ") == 0 || index($line, "hi link ") == 0 || index($line, "highlight def link ") == 0 || index($line, "HiLink ") == 0) {
            my str $rest = $line;
            if (index($rest, "hi def link ") == 0) {
                $rest = substr($rest, 12);
            } elsif (index($rest, "hi link ") == 0) {
                $rest = substr($rest, 8);
            } elsif (index($rest, "highlight def link ") == 0) {
                $rest = substr($rest, 19);
            } else {
                $rest = substr($rest, 7);
            }
            $rest = trim($rest);
            my int $sp = index($rest, " ");
            if ($sp == -1) {
                $sp = index($rest, "\t");
            }
            if ($sp > 0) {
                my str $group = substr($rest, 0, $sp);
                my str $target = trim(substr($rest, $sp + 1));
                my scalar $lh = $syn->{"links"};
                $lh->{$group} = $target;
            }
        }

        $line = <$fh>;
    }
    core::close($fh);

    # Compute highlighter metadata from loaded syntax data
    $syn->{"line_comment"} = "";
    $syn->{"has_block_comment"} = 0;
    $syn->{"has_preproc"} = 0;
    $syn->{"has_sigils"} = 0;

    my scalar $s_links = $syn->{"links"};
    my scalar $s_matches = $syn->{"matches"};
    my scalar $s_regions = $syn->{"regions"};
    my array @lk = keys(%$s_links);
    my int $li = 0;
    while ($li < scalar(@lk)) {
        my str $gname = $lk[$li];
        my str $target = $s_links->{$gname};
        # Follow one level of link indirection
        my str $terminal = $target;
        if (defined($s_links->{$terminal})) {
            $terminal = $s_links->{$terminal};
        }

        # Detect comment style
        if ($terminal eq "Comment" || $target eq "Comment") {
            if (defined($s_matches->{$gname})) {
                my scalar $plist = $s_matches->{$gname};
                my int $pi = 0;
                while ($pi < scalar(@$plist)) {
                    my str $pat = $plist->[$pi];
                    if (index($pat, "//") == 0 || index($pat, "\\/\\/") == 0) {
                        $syn->{"line_comment"} = "//";
                    } elsif (index($pat, "--") == 0) {
                        $syn->{"line_comment"} = "--";
                    } elsif (index($pat, "#") == 0) {
                        if (length($syn->{"line_comment"}) == 0) { $syn->{"line_comment"} = "#"; }
                    } elsif (index($pat, ";") == 0) {
                        if (length($syn->{"line_comment"}) == 0) { $syn->{"line_comment"} = ";"; }
                    } elsif (index($pat, "%") == 0) {
                        if (length($syn->{"line_comment"}) == 0) { $syn->{"line_comment"} = "%"; }
                    }
                    $pi = $pi + 1;
                }
            }
            if (defined($s_regions->{$gname})) {
                my scalar $rlist = $s_regions->{$gname};
                my int $ri = 0;
                while ($ri < scalar(@$rlist)) {
                    my scalar $reg = $rlist->[$ri];
                    my str $sp = $reg->{"start"};
                    my str $ep = $reg->{"end"};
                    if (index($sp, "/*") >= 0 || index($sp, "/\\*") >= 0) {
                        $syn->{"has_block_comment"} = 1;
                    } elsif ($ep eq "$") {
                        if (index($sp, "//") == 0 || index($sp, "\\/\\/") == 0) {
                            $syn->{"line_comment"} = "//";
                        } elsif (index($sp, "--") == 0) {
                            $syn->{"line_comment"} = "--";
                        } elsif (index($sp, "#") == 0 && length($syn->{"line_comment"}) == 0) {
                            $syn->{"line_comment"} = "#";
                        }
                    }
                    $ri = $ri + 1;
                }
            }
        }

        # Detect preprocessor
        if ($terminal eq "PreProc" || $target eq "PreProc") {
            $syn->{"has_preproc"} = 1;
        }

        # Detect sigil variables
        if ($terminal eq "Identifier" || $target eq "Identifier") {
            if (defined($s_matches->{$gname})) {
                my scalar $plist2 = $s_matches->{$gname};
                my int $pi2 = 0;
                while ($pi2 < scalar(@$plist2)) {
                    my str $pat = $plist2->[$pi2];
                    if (index($pat, "$") >= 0 || index($pat, "@") >= 0 || index($pat, "%") >= 0) {
                        $syn->{"has_sigils"} = 1;
                    }
                    $pi2 = $pi2 + 1;
                }
            }
        }

        $li = $li + 1;
    }

    # Detect language from the .vim filename stem (e.g. rust.vim -> rust)
    my str $base = path_basename($path);
    my str $lang = $base;
    my int $dpos = index($base, ".");
    if ($dpos > 0) {
        $lang = substr($base, 0, $dpos);
    }

    $VIM_SYN->{$lang} = $syn;
    set_msg("Loaded vim syntax for: " . $lang);
}

func vim_group_to_ansi(str $group) str {
    if ($group eq "Comment") { return "90"; }
    if ($group eq "Constant") { return "31"; }
    if ($group eq "String") { return "32"; }
    if ($group eq "Character") { return "32"; }
    if ($group eq "Number") { return "35"; }
    if ($group eq "Float") { return "35"; }
    if ($group eq "Boolean") { return "35"; }
    if ($group eq "Identifier") { return "36;1"; }
    if ($group eq "Function") { return "33;1"; }
    if ($group eq "Statement") { return "33"; }
    if ($group eq "Conditional") { return "33"; }
    if ($group eq "Repeat") { return "33"; }
    if ($group eq "Label") { return "33"; }
    if ($group eq "Operator") { return "33"; }
    if ($group eq "Keyword") { return "33"; }
    if ($group eq "Exception") { return "31;1"; }
    if ($group eq "PreProc") { return "34"; }
    if ($group eq "Include") { return "34"; }
    if ($group eq "Define") { return "34"; }
    if ($group eq "Macro") { return "34"; }
    if ($group eq "PreCondit") { return "34"; }
    if ($group eq "Type") { return "36"; }
    if ($group eq "StorageClass") { return "36"; }
    if ($group eq "Structure") { return "36"; }
    if ($group eq "Typedef") { return "36"; }
    if ($group eq "Special") { return "35"; }
    if ($group eq "SpecialChar") { return "35"; }
    if ($group eq "Tag") { return "35"; }
    if ($group eq "Delimiter") { return "35"; }
    if ($group eq "SpecialComment") { return "90;1"; }
    if ($group eq "Debug") { return "31"; }
    if ($group eq "Error") { return "37;41"; }
    if ($group eq "Todo") { return "33;1"; }
    return "";
}

func vim_resolve_color(scalar $syn, str $group) str {
    my scalar $links = $syn->{"links"};
    my int $depth = 0;
    my str $cur = $group;
    while ($depth < 10) {
        my str $ansi = vim_group_to_ansi($cur);
        if (length($ansi) > 0) {
            return $ansi;
        }
        if (defined($links->{$cur})) {
            $cur = $links->{$cur};
        } else {
            return "";
        }
        $depth = $depth + 1;
    }
    return "";
}

func vim_highlight(str $line, str $lang) str {
    if (!defined($VIM_SYN)) { return ""; }
    if (!defined($VIM_SYN->{$lang})) { return ""; }

    my scalar $syn = $VIM_SYN->{$lang};
    my scalar $kw_groups = $syn->{"keywords"};
    my str $line_comment = $syn->{"line_comment"};
    my int $has_block = $syn->{"has_block_comment"};
    my int $has_preproc = $syn->{"has_preproc"};
    my int $has_sigils = $syn->{"has_sigils"};
    my int $lc_len = length($line_comment);

    my str $reset = $E . "[0m";
    # Resolve standard colors once
    my str $col_comment = vim_resolve_color($syn, "Comment");
    my str $col_string = vim_resolve_color($syn, "String");
    my str $col_number = vim_resolve_color($syn, "Number");
    my str $col_special = vim_resolve_color($syn, "Special");
    my str $col_ident = vim_resolve_color($syn, "Identifier");
    my str $col_func = vim_resolve_color($syn, "Function");
    my str $col_preproc = vim_resolve_color($syn, "PreProc");
    my str $col_label = vim_resolve_color($syn, "Label");
    # Fallbacks
    if (length($col_comment) == 0) { $col_comment = "90"; }
    if (length($col_string) == 0) { $col_string = "32"; }
    if (length($col_number) == 0) { $col_number = "35"; }
    if (length($col_special) == 0) { $col_special = "35"; }
    if (length($col_ident) == 0) { $col_ident = "36;1"; }
    if (length($col_func) == 0) { $col_func = "33;1"; }
    if (length($col_preproc) == 0) { $col_preproc = "34"; }
    if (length($col_label) == 0) { $col_label = "33"; }

    my str $out = "";
    my int $i = 0;
    my int $len = length($line);

    # Shebang (#!) on first line, or C-style # preprocessor when # is not the line comment
    if ($len >= 2 && substr($line, 0, 2) eq "#!") {
        return $E . "[" . $col_preproc . "m" . $line . $reset;
    }
    if ($has_preproc == 1 && $line_comment ne "#") {
        my int $ti = 0;
        while ($ti < $len && (substr($line, $ti, 1) eq " " || substr($line, $ti, 1) eq "\t")) {
            $ti = $ti + 1;
        }
        if ($ti < $len && substr($line, $ti, 1) eq "#") {
            return $E . "[" . $col_preproc . "m" . $line . $reset;
        }
    }

    while ($i < $len) {
        my str $ch = substr($line, $i, 1);

        # ---- Line comments ----
        if ($lc_len == 1 && $ch eq $line_comment) {
            $out = $out . $E . "[" . $col_comment . "m" . substr($line, $i) . $reset;
            return $out;
        }
        if ($lc_len == 2 && $i + 1 < $len && substr($line, $i, 2) eq $line_comment) {
            $out = $out . $E . "[" . $col_comment . "m" . substr($line, $i) . $reset;
            return $out;
        }

        # ---- Block comments /* ... */ ----
        if ($has_block == 1 && $ch eq "/" && $i + 1 < $len && substr($line, $i + 1, 1) eq "*") {
            my str $bc = $E . "[" . $col_comment . "m/*";
            my int $bi = $i + 2;
            my int $closed = 0;
            while ($bi < $len) {
                if ($bi + 1 < $len && substr($line, $bi, 1) eq "*" && substr($line, $bi + 1, 1) eq "/") {
                    $bc = $bc . "*/" . $reset;
                    $bi = $bi + 2;
                    $closed = 1;
                    last;
                }
                my int $bni = u8_next($line, $bi);
                $bc = $bc . substr($line, $bi, $bni - $bi);
                $bi = $bni;
            }
            if ($closed == 0) { $bc = $bc . $reset; }
            $out = $out . $bc;
            $i = $bi;
            next;
        }

        # ---- Double-quoted strings ----
        if ($ch eq "\"") {
            my str $sc = $E . "[" . $col_string . "m\"";
            $i = $i + 1;
            my int $str_done = 0;
            while ($i < $len) {
                my str $sch = substr($line, $i, 1);
                if ($sch eq "\\" && $i + 1 < $len) {
                    # Escape sequence
                    $sc = $sc . $reset . $E . "[" . $col_special . "m" . $sch . substr($line, $i + 1, 1) . $reset . $E . "[" . $col_string . "m";
                    $i = $i + 2;
                } elsif ($sch eq "\"") {
                    $sc = $sc . "\"" . $reset;
                    $i = $i + 1;
                    $str_done = 1;
                    last;
                } elsif ($has_sigils == 1 && ($sch eq "$" || $sch eq "@") && $i + 1 < $len && is_word_char(u8_char_at($line, $i + 1)) == 1) {
                    # Interpolated variable inside string
                    my int $vs = $i;
                    $i = $i + 1;
                    while ($i < $len && is_word_char(u8_char_at($line, $i)) == 1) {
                        $i = u8_next($line, $i);
                    }
                    $sc = $sc . $reset . $E . "[" . $col_special . "m" . substr($line, $vs, $i - $vs) . $reset . $E . "[" . $col_string . "m";
                } else {
                    my int $sni = u8_next($line, $i);
                    $sc = $sc . substr($line, $i, $sni - $i);
                    $i = $sni;
                }
            }
            if ($str_done == 0) { $sc = $sc . $reset; }
            $out = $out . $sc;
            next;
        }

        # ---- Single-quoted strings ----
        if ($ch eq "'") {
            my str $sc = $E . "[" . $col_string . "m'";
            $i = $i + 1;
            my int $str_done = 0;
            while ($i < $len) {
                my str $sch = substr($line, $i, 1);
                if ($sch eq "\\" && $i + 1 < $len) {
                    $sc = $sc . $sch . substr($line, $i + 1, 1);
                    $i = $i + 2;
                } elsif ($sch eq "'" && $lang eq "sql" && $i + 1 < $len && substr($line, $i + 1, 1) eq "'") {
                    # SQL doubled single-quote escape ('')
                    $sc = $sc . "''";
                    $i = $i + 2;
                } elsif ($sch eq "'") {
                    $sc = $sc . "'" . $reset;
                    $i = $i + 1;
                    $str_done = 1;
                    last;
                } else {
                    my int $sni = u8_next($line, $i);
                    $sc = $sc . substr($line, $i, $sni - $i);
                    $i = $sni;
                }
            }
            if ($str_done == 0) { $sc = $sc . $reset; }
            $out = $out . $sc;
            next;
        }

        # ---- Backtick identifiers in SQL (`table_name`) ----
        if ($ch eq "`" && $lang eq "sql") {
            my str $bq = $E . "[" . $col_ident . "m`";
            $i = $i + 1;
            my int $bq_done = 0;
            while ($i < $len) {
                my str $bch = substr($line, $i, 1);
                if ($bch eq "`" && $i + 1 < $len && substr($line, $i + 1, 1) eq "`") {
                    $bq = $bq . "``";
                    $i = $i + 2;
                } elsif ($bch eq "`") {
                    $bq = $bq . "`" . $reset;
                    $i = $i + 1;
                    $bq_done = 1;
                    last;
                } else {
                    my int $bni = u8_next($line, $i);
                    $bq = $bq . substr($line, $i, $bni - $i);
                    $i = $bni;
                }
            }
            if ($bq_done == 0) { $bq = $bq . $reset; }
            $out = $out . $bq;
            next;
        }

        # ---- References: \$var, \@arr, \%hash ----
        if ($has_sigils == 1 && $ch eq "\\" && $i + 2 < $len) {
            my str $nch = substr($line, $i + 1, 1);
            if (($nch eq "$" || $nch eq "@" || $nch eq "%") && is_word_char(u8_char_at($line, $i + 2)) == 1) {
                my int $ni = $i + 2;
                while ($ni < $len && is_word_char(u8_char_at($line, $ni)) == 1) {
                    $ni = u8_next($line, $ni);
                }
                $out = $out . $E . "[" . $col_special . "m" . substr($line, $i, $ni - $i) . $reset;
                $i = $ni;
                next;
            }
        }

        # ---- Sigil variables: $name, @name, %name ----
        if ($has_sigils == 1 && ($ch eq "$" || $ch eq "@" || $ch eq "%")) {
            my int $ni = $i + 1;
            if ($ni < $len && is_word_char(u8_char_at($line, $ni)) == 1) {
                while ($ni < $len && is_word_char(u8_char_at($line, $ni)) == 1) {
                    $ni = u8_next($line, $ni);
                }
                $out = $out . $E . "[" . $col_ident . "m" . substr($line, $i, $ni - $i) . $reset;
                $i = $ni;
                next;
            }
            # Special variables: $_, @_, $!, $@, $/, $0
            if ($ch eq "$" && $ni < $len) {
                my str $snch = substr($line, $ni, 1);
                if ($snch eq "_" || $snch eq "!" || $snch eq "@" || $snch eq "/" || $snch eq "0" || $snch eq "{") {
                    $out = $out . $E . "[" . $col_special . "m" . $ch . $snch . $reset;
                    $i = $ni + 1;
                    next;
                }
            }
            if ($ch eq "@" && $ni < $len && substr($line, $ni, 1) eq "_") {
                $out = $out . $E . "[" . $col_special . "m" . "@_" . $reset;
                $i = $ni + 1;
                next;
            }
        }

        # ---- Method calls: ->name ----
        if ($ch eq "-" && $i + 2 < $len && substr($line, $i + 1, 1) eq ">") {
            my int $ni = $i + 2;
            if (is_word_char(u8_char_at($line, $ni)) == 1) {
                while ($ni < $len && is_word_char(u8_char_at($line, $ni)) == 1) {
                    $ni = u8_next($line, $ni);
                }
                $out = $out . "->" . $E . "[" . $col_func . "m" . substr($line, $i + 2, $ni - $i - 2) . $reset;
                $i = $ni;
                next;
            }
        }

        # ---- Words: keywords, numbers, namespaces, labels ----
        if (is_word_char($ch) == 1) {
            my int $start = $i;
            while ($i < $len && is_word_char(u8_char_at($line, $i)) == 1) {
                $i = u8_next($line, $i);
            }
            my str $word = substr($line, $start, $i - $start);
            my str $fc = substr($word, 0, 1);

            # Numbers: starts with digit
            if ($fc ge "0" && $fc le "9") {
                $out = $out . $E . "[" . $col_number . "m" . $word . $reset;
                # Consume float: .digits after number
                if ($i < $len && substr($line, $i, 1) eq ".") {
                    my int $di = $i + 1;
                    if ($di < $len && substr($line, $di, 1) ge "0" && substr($line, $di, 1) le "9") {
                        while ($di < $len && is_word_char(u8_char_at($line, $di)) == 1) {
                            $di = u8_next($line, $di);
                        }
                        $out = $out . $E . "[" . $col_number . "m" . substr($line, $i, $di - $i) . $reset;
                        $i = $di;
                    }
                }
                next;
            }

            # Namespace calls: word::word
            if ($i + 1 < $len && substr($line, $i, 2) eq "::") {
                my int $ni = $i + 2;
                if ($ni < $len && is_word_char(u8_char_at($line, $ni)) == 1) {
                    while ($ni < $len && is_word_char(u8_char_at($line, $ni)) == 1) {
                        $ni = u8_next($line, $ni);
                    }
                    my str $fname = substr($line, $i + 2, $ni - $i - 2);
                    $out = $out . $E . "[" . $col_special . "m" . $word . "::" . $reset . $E . "[" . $col_func . "m" . $fname . $reset;
                    $i = $ni;
                    next;
                }
            }

            # Labels: ALLCAPS: at start of line
            if ($start == 0 && $i < $len && substr($line, $i, 1) eq ":") {
                my int $is_label = 1;
                my int $ci = 0;
                while ($ci < length($word)) {
                    my str $wc = substr($word, $ci, 1);
                    if (!(($wc ge "A" && $wc le "Z") || $wc eq "_" || ($wc ge "0" && $wc le "9"))) {
                        $is_label = 0;
                        last;
                    }
                    $ci = $ci + 1;
                }
                if ($is_label == 1) {
                    $out = $out . $E . "[" . $col_label . "m" . $word . ":" . $reset;
                    $i = $i + 1;
                    next;
                }
            }

            # Function definitions: func/fn/sub followed by space and name
            if ($word eq "func" || $word eq "fn" || $word eq "sub") {
                my str $kw_color = "";
                my array @groups = keys(%$kw_groups);
                my int $gi = 0;
                while ($gi < scalar(@groups)) {
                    my str $grp = $groups[$gi];
                    my str $words = $kw_groups->{$grp};
                    if (index(" " . $words . " ", " " . $word . " ") >= 0) {
                        $kw_color = vim_resolve_color($syn, $grp);
                        last;
                    }
                    $gi = $gi + 1;
                }
                if (length($kw_color) == 0) { $kw_color = "33"; }
                $out = $out . $E . "[" . $kw_color . "m" . $word . $reset;
                # Consume whitespace
                my int $wi = $i;
                while ($wi < $len && substr($line, $wi, 1) eq " ") {
                    $wi = $wi + 1;
                }
                if ($wi > $i && $wi < $len && is_word_char(u8_char_at($line, $wi)) == 1) {
                    $out = $out . substr($line, $i, $wi - $i);
                    my int $ni = $wi;
                    while ($ni < $len && is_word_char(u8_char_at($line, $ni)) == 1) {
                        $ni = u8_next($line, $ni);
                    }
                    $out = $out . $E . "[" . $col_func . "m" . substr($line, $wi, $ni - $wi) . $reset;
                    $i = $ni;
                }
                next;
            }

            # Keywords: check each keyword group
            my str $kw_lookup = $word;
            if (($syn->{"case_ignore"} // 0) == 1) {
                $kw_lookup = uc($word);
            }
            my str $found_color = "";
            my array @groups = keys(%$kw_groups);
            my int $gi = 0;
            while ($gi < scalar(@groups)) {
                my str $grp = $groups[$gi];
                my str $words = $kw_groups->{$grp};
                if (index(" " . $words . " ", " " . $kw_lookup . " ") >= 0) {
                    $found_color = vim_resolve_color($syn, $grp);
                    last;
                }
                $gi = $gi + 1;
            }
            if (length($found_color) > 0) {
                $out = $out . $E . "[" . $found_color . "m" . $word . $reset;
            } else {
                $out = $out . $word;
            }
            next;
        }

        # ---- Non-word: advance by full UTF-8 character ----
        my int $ni = u8_next($line, $i);
        $out = $out . substr($line, $i, $ni - $i);
        $i = $ni;
    }
    return $out;
}

# ===========================================================================
# Display / Rendering
# ===========================================================================

func clamp_cursor() void {
    my int $n = line_count();
    if ($CY >= $n) {
        $CY = $n - 1;
    }
    if ($CY < 0) {
        $CY = 0;
    }
    my str $cur = get_line($CY);
    my int $ll = length($cur);
    if ($CX > $ll) {
        $CX = $ll;
    }
    if ($CX < 0) {
        $CX = 0;
    }
    # Never leave the cursor inside a multi-byte UTF-8 sequence
    while ($CX > 0 && $CX < $ll && u8_is_cont($cur, $CX) == 1) {
        $CX = $CX - 1;
    }
}

func win_edit_rows() int {
    if ($WIN_COUNT <= 1) { return $EDIT_ROWS; }
    my scalar $w = $WINDOWS->[$WIN_IDX];
    return $w->{"height"};
}

func win_text_cols() int {
    my int $w = $COLS;
    if ($WIN_COUNT > 1) {
        $w = $WINDOWS->[$WIN_IDX]->{"width"};
    }
    my int $g = linum_width();
    if ($g < $w) {
        $w = $w - $g;
    }
    if ($w < 1) { $w = 1; }
    return $w;
}

func recenter() void {
    my int $vis = win_edit_rows();
    if ($RECENTER == 0) {
        # Center cursor line on screen
        $SY = $CY - $vis / 2;
        $RECENTER = 1;
    } elsif ($RECENTER == 1) {
        # Cursor line at top of screen
        $SY = $CY;
        $RECENTER = 2;
    } else {
        # Cursor line at bottom of screen
        $SY = $CY - $vis + 1;
        $RECENTER = 0;
    }
    if ($SY < 0) {
        $SY = 0;
    }
}

func scroll_adjust() void {
    my int $vis_rows = win_edit_rows();
    if ($CY < $SY) {
        $SY = $CY;
    }
    if ($CY >= $SY + $vis_rows) {
        $SY = $CY - $vis_rows + 1;
    }
    if ($SY < 0) {
        $SY = 0;
    }
    # Horizontal scroll uses display columns (accounting for line number gutter)
    my int $vis_cols = win_text_cols();
    my int $cursor_col = u8_byte_to_col(get_line($CY), $CX);
    if ($cursor_col < $SX) {
        $SX = $cursor_col;
    }
    my int $margin = 4;
    if ($vis_cols <= 8) { $margin = 1; }
    if ($cursor_col >= $SX + $vis_cols - $margin) {
        my int $lead = 8;
        if ($lead >= $vis_cols) { $lead = 1; }
        $SX = $cursor_col - $vis_cols + $lead;
    }
    if ($cursor_col >= $SX + $vis_cols) {
        $SX = $cursor_col - $vis_cols + 1;
    }
    if ($SX < 0) {
        $SX = 0;
    }
}

# Replace string literals and line comments with spaces of equal byte length so
# bracket matching and enclosing-function scans ignore quoted/commented braces.
func code_mask_line(str $line) str {
    my int $len = length($line);
    if ($len == 0) { return ""; }
    # Avoid expensive character-by-character masking on multi-KB SQL dump INSERT lines
    if ($len > 8192) { return $line; }
    my str $lc = "";
    if (defined($VIM_SYN) && length($SYNTAX) > 0 && defined($VIM_SYN->{$SYNTAX})) {
        $lc = $VIM_SYN->{$SYNTAX}->{"line_comment"} // "";
    }
    if (length($lc) == 0) {
        if ($SYNTAX eq "c" || $SYNTAX eq "cpp" || $SYNTAX eq "javascript" || $SYNTAX eq "typescript") {
            $lc = "//";
        } elsif ($SYNTAX eq "strada" || $SYNTAX eq "perl" || $SYNTAX eq "python" || $SYNTAX eq "sh" || $SYNTAX eq "make") {
            $lc = "#";
        }
    }
    my int $lc_len = length($lc);
    my str $out = "";
    my int $i = 0;
    while ($i < $len) {
        my str $ch = substr($line, $i, 1);
        if ($lc_len == 1 && $ch eq $lc) {
            return $out . (" " x ($len - $i));
        }
        if ($lc_len == 2 && $i + 1 < $len && substr($line, $i, 2) eq $lc) {
            return $out . (" " x ($len - $i));
        }
        if ($ch eq "\"" || $ch eq "'") {
            my str $q = $ch;
            my int $start = $i;
            $i = $i + 1;
            while ($i < $len) {
                my str $sc = substr($line, $i, 1);
                if ($sc eq "\\" && $i + 1 < $len) {
                    $i = $i + 2;
                } elsif ($sc eq $q) {
                    $i = $i + 1;
                    last;
                } else {
                    $i = $i + 1;
                }
            }
            $out = $out . (" " x ($i - $start));
            next;
        }
        $out = $out . $ch;
        $i = $i + 1;
    }
    return $out;
}

# Find matching bracket. Returns "line,col" or "" if no match.
# Searches forward for opening brackets, backward for closing brackets.
func find_matching_bracket(int $y, int $x) str {
    my str $masked_start = code_mask_line(get_line($y));
    if ($x < 0 || $x >= length($masked_start)) { return ""; }
    my str $ch = substr($masked_start, $x, 1);

    my str $open = "";
    my str $close = "";
    my int $dir = 0;

    if ($ch eq "(") { $open = "("; $close = ")"; $dir = 1; }
    elsif ($ch eq ")") { $open = "("; $close = ")"; $dir = -1; }
    elsif ($ch eq "{") { $open = "{"; $close = "}"; $dir = 1; }
    elsif ($ch eq "}") { $open = "{"; $close = "}"; $dir = -1; }
    elsif ($ch eq "[") { $open = "["; $close = "]"; $dir = 1; }
    elsif ($ch eq "]") { $open = "["; $close = "]"; $dir = -1; }

    if ($dir == 0) { return ""; }

    my int $depth = 0;
    my int $cy = $y;
    my int $cx = $x;
    my int $max_lines = line_count();
    # Limit search to 1000 lines in either direction
    my int $searched = 0;

    if ($dir == 1) {
        # Forward search
        while ($cy < $max_lines && $searched < 1000) {
            my str $l = code_mask_line(get_line($cy));
            my int $llen = length($l);
            while ($cx < $llen) {
                my str $c = substr($l, $cx, 1);
                if ($c eq $open) {
                    $depth = $depth + 1;
                } elsif ($c eq $close) {
                    $depth = $depth - 1;
                    if ($depth == 0) {
                        return "" . $cy . "," . $cx;
                    }
                }
                $cx = $cx + 1;
            }
            $cy = $cy + 1;
            $cx = 0;
            $searched = $searched + 1;
        }
    } else {
        # Backward search
        while ($cy >= 0 && $searched < 1000) {
            my str $l = code_mask_line(get_line($cy));
            while ($cx >= 0) {
                my str $c = substr($l, $cx, 1);
                if ($c eq $close) {
                    $depth = $depth + 1;
                } elsif ($c eq $open) {
                    $depth = $depth - 1;
                    if ($depth == 0) {
                        return "" . $cy . "," . $cx;
                    }
                }
                $cx = $cx - 1;
            }
            $cy = $cy - 1;
            if ($cy >= 0) {
                $cx = length(get_line($cy)) - 1;
            }
            $searched = $searched + 1;
        }
    }
    return "";
}


# Find the name of the function enclosing the cursor line.
# Scans backward from $CY looking for function definition patterns.
func which_function_scan() str {
    if ($WHICH_FUNC == 0) { return ""; }
    my int $y = $CY;
    my int $brace_depth = 0;
    my int $cursor_indent = -1;
    if ($SYNTAX eq "python") {
        my str $cline = get_line($CY);
        my int $ci = 0;
        while ($ci < length($cline) && (substr($cline, $ci, 1) eq " " || substr($cline, $ci, 1) eq "\t")) {
            $ci = $ci + 1;
        }
        if ($ci < length($cline)) { $cursor_indent = $ci; }
    }

    while ($y >= 0) {
        my str $line = get_line($y);
        my str $masked = code_mask_line($line);
        my int $len = length($masked);

        # Count braces on lines above cursor to track enclosing block depth
        if ($y < $CY) {
            my int $bi = 0;
            while ($bi < $len) {
                my str $bc = substr($masked, $bi, 1);
                if ($bc eq "{") { $brace_depth = $brace_depth - 1; }
                elsif ($bc eq "}") { $brace_depth = $brace_depth + 1; }
                $bi = $bi + 1;
            }
        }

        # On $CY itself brace_depth == 0; above $CY we require brace_depth < 0
        # so functions that already closed above the cursor are not reported.
        my int $in_scope = 0;
        if ($SYNTAX eq "python") {
            $in_scope = 1;
        } elsif ($y == $CY || $brace_depth < 0) {
            $in_scope = 1;
        }

        if ($in_scope == 1) {
            if ($SYNTAX eq "c" || $SYNTAX eq "cpp") {
                if ($len > 0 && substr($line, 0, 1) ne "#" && substr($line, 0, 1) ne " " && substr($line, 0, 1) ne "\t" && substr($line, 0, 1) ne "/") {
                    my int $paren = index($masked, "(");
                    if ($paren > 0) {
                        my int $end = $paren;
                        while ($end > 0 && substr($line, $end - 1, 1) eq " ") { $end = $end - 1; }
                        my int $start = $end - 1;
                        while ($start >= 0 && is_word_char(substr($line, $start, 1)) == 1) {
                            $start = $start - 1;
                        }
                        $start = $start + 1;
                        if ($start < $end) {
                            my str $name = substr($line, $start, $end - $start);
                            if ($name ne "if" && $name ne "while" && $name ne "for" && $name ne "switch" && $name ne "return") {
                                return $name;
                            }
                        }
                    }
                }
            } elsif ($SYNTAX eq "strada" || $SYNTAX eq "perl") {
                my str $trimmed = ltrim($line);
                my int $is_func = 0;
                my str $after = "";
                if (index($trimmed, "func ") == 0) {
                    $is_func = 1; $after = ltrim(substr($trimmed, 5));
                } elsif (index($trimmed, "fn ") == 0) {
                    $is_func = 1; $after = ltrim(substr($trimmed, 3));
                } elsif (index($trimmed, "sub ") == 0) {
                    $is_func = 1; $after = ltrim(substr($trimmed, 4));
                } elsif (index($trimmed, "async func ") == 0) {
                    $is_func = 1; $after = ltrim(substr($trimmed, 11));
                } elsif (index($trimmed, "private func ") == 0) {
                    $is_func = 1; $after = ltrim(substr($trimmed, 13));
                } elsif (index($trimmed, "async fn ") == 0) {
                    $is_func = 1; $after = ltrim(substr($trimmed, 9));
                } elsif (index($trimmed, "private fn ") == 0) {
                    $is_func = 1; $after = ltrim(substr($trimmed, 11));
                }
                if ($is_func == 1 && length($after) > 0) {
                    my int $ni = 0;
                    while ($ni < length($after) && is_word_char(substr($after, $ni, 1)) == 1) {
                        $ni = $ni + 1;
                    }
                    if ($ni > 0) {
                        return substr($after, 0, $ni);
                    }
                }
            } elsif ($SYNTAX eq "python") {
                my int $ti = 0;
                while ($ti < length($line) && (substr($line, $ti, 1) eq " " || substr($line, $ti, 1) eq "\t")) {
                    $ti = $ti + 1;
                }
                if ($y == $CY || $cursor_indent < 0 || $ti < $cursor_indent) {
                    my str $trimmed = substr($line, $ti);
                    my str $after = "";
                    if (index($trimmed, "def ") == 0) {
                        $after = ltrim(substr($trimmed, 4));
                    } elsif (index($trimmed, "async def ") == 0) {
                        $after = ltrim(substr($trimmed, 10));
                    }
                    if (length($after) > 0) {
                        my int $ni = 0;
                        while ($ni < length($after) && is_word_char(substr($after, $ni, 1)) == 1) {
                            $ni = $ni + 1;
                        }
                        if ($ni > 0) {
                            return substr($after, 0, $ni);
                        }
                    }
                }
            } elsif ($SYNTAX eq "javascript" || $SYNTAX eq "typescript") {
                my str $trimmed = ltrim($line);
                my str $after = "";
                if (index($trimmed, "function ") == 0) {
                    $after = ltrim(substr($trimmed, 9));
                } elsif (index($trimmed, "async function ") == 0) {
                    $after = ltrim(substr($trimmed, 15));
                } elsif (index($trimmed, "export function ") == 0) {
                    $after = ltrim(substr($trimmed, 16));
                } elsif (index($trimmed, "export async function ") == 0) {
                    $after = ltrim(substr($trimmed, 22));
                }
                if (length($after) > 0) {
                    my int $ni = 0;
                    while ($ni < length($after) && is_word_char(substr($after, $ni, 1)) == 1) {
                        $ni = $ni + 1;
                    }
                    if ($ni > 0) {
                        return substr($after, 0, $ni);
                    }
                }
            } elsif ($SYNTAX eq "sh" || $SYNTAX eq "shell") {
                my str $trimmed = ltrim($line);
                if (index($trimmed, "function ") == 0) {
                    my str $after = ltrim(substr($trimmed, 9));
                    my int $ni = 0;
                    while ($ni < length($after) && is_word_char(substr($after, $ni, 1)) == 1) {
                        $ni = $ni + 1;
                    }
                    if ($ni > 0) {
                        return substr($after, 0, $ni);
                    }
                }
                my int $paren = index($trimmed, "()");
                if ($paren > 0) {
                    my int $ni = 0;
                    while ($ni < $paren && is_word_char(substr($trimmed, $ni, 1)) == 1) {
                        $ni = $ni + 1;
                    }
                    if ($ni == $paren && $ni > 0) {
                        return substr($trimmed, 0, $ni);
                    }
                }
            }
        }
        $y = $y - 1;
    }
    return "";
}

func which_function() str {
    if ($WHICH_FUNC == 0) { return ""; }
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my str $key = $buf->{"generation"} . ":" . $CY . ":" . $SYNTAX;
    if ($buf->{"which_cache_key"} eq $key) { return $buf->{"which_cache_value"}; }
    my str $value = which_function_scan();
    $buf->{"which_cache_key"} = $key;
    $buf->{"which_cache_value"} = $value;
    return $value;
}

func linum_width() int {
    if ($LINUM == 0) { return 0; }
    # Width = digits of max line number + 1 space
    my int $maxln = line_count();
    my int $digits = 1;
    while ($maxln >= 10) {
        $maxln = ($maxln - $maxln % 10) / 10;
        $digits = $digits + 1;
    }
    if ($digits < 3) { $digits = 3; }
    return $digits + 1;  # +1 for separator space
}

func render_status_bar(str $bname, str $mode, int $dirty, int $cy, int $cx, int $lcount, int $is_active, int $bar_width) str {
    if ($bar_width <= 0) { return ""; }
    my str $out = "";
    if ($is_active == 1) {
        $out = $out . $E . "[7m";
    } else {
        $out = $out . $E . "[7;2m";
    }
    my str $left = " ";
    if ($dirty == 1) {
        $left = $left . "**";
    } else {
        $left = $left . "--";
    }
    # Show full path / directory / terminal cwd on active window
    if ($is_active == 1 && $mode eq "Dired") {
        my str $dd = $BUFFERS->[$BUF_IDX]->{"dired_dir"} // "";
        if (length($dd) > 0) {
            $left = $left . " " . terminal_safe($bname) . " (" . terminal_safe($dd) . ")";
        } else {
            $left = $left . " " . terminal_safe($bname);
        }
    } elsif ($is_active == 1 && ($mode eq "Term" || $mode eq "Term-Copy")) {
        my str $tcwd = $BUFFERS->[$BUF_IDX]->{"term_cwd"} // "";
        if (length($tcwd) > 0) {
            $left = $left . " " . terminal_safe($bname) . " (" . terminal_safe($tcwd) . ")";
        } else {
            $left = $left . " " . terminal_safe($bname);
        }
    } elsif ($is_active == 1 && length($FNAME) > 0) {
        $left = $left . " " . terminal_safe($FNAME);
    } else {
        $left = $left . " " . terminal_safe($bname);
    }
    if ($is_active == 1 && $mode ne "Term" && $mode ne "Dired" && $mode ne "BufferMenu") {
        my str $wf = which_function();
        if (length($wf) > 0) {
            $left = $left . "  " . $wf . "()";
        }
    }
    my str $right = "";
    my str $disp_mode = terminal_safe($mode);
    if ($mode eq "Hex" && $is_active == 1) {
        my str $area = "hex";
        if ($HEX_IN_ASCII == 1) { $area = "ascii"; }
        $right = " 0x" . hex_offset_str($HEX_BYTE_POS) . " [" . $area . "] " . hex_data_len() . " bytes ";
    } elsif ($mode eq "Term") {
        my int $tvt = $BUFFERS->[$BUF_IDX]->{"term_vt"} // 0;
        my str $tstate = ($tvt != 0 && Smacs::Term::is_alive($tvt) == 1) ? "running" : "exited";
        $disp_mode = "Term:" . $tstate;
        my int $tr = ($tvt != 0) ? (Smacs::Term::cursor_row($tvt) + 1) : 1;
        my int $tc = ($tvt != 0) ? (Smacs::Term::cursor_col($tvt) + 1) : 1;
        $right = " R" . $tr . " C" . $tc . " ";
    } elsif ($LARGE_MODE == 1 && $is_active == 1 && defined($LF_STATE)) {
        $disp_mode = $disp_mode . "/Large";
        my int $tot = Smacs::LargeFile::total_size($LF_STATE);
        my int $voff = Smacs::LargeFile::cursor_virtual_offset($LF_STATE, $CL, $cy, $cx);
        my int $pct = 0;
        if ($tot > 0) {
            if ($LF_STATE->{"chunk_vend"} >= $tot && $cy >= $lcount - 1 && $cx >= length(get_line($cy))) {
                $pct = 100;
            } else {
                $pct = int(($voff * 100) / $tot);
            }
        }
        my int $display_col_lf = u8_byte_to_col(get_line($cy), $cx) + 1;
        $right = " @" . Smacs::LargeFile::format_bytes($voff) . "/" . Smacs::LargeFile::format_bytes($tot) . " (" . $pct . "%) L" . ($cy + 1) . "/" . $lcount . " C" . $display_col_lf . " ";
    } else {
        my int $display_col = u8_byte_to_col(get_line($cy), $cx) + 1;
        $right = " L" . ($cy + 1) . "/" . $lcount . " C" . $display_col . " ";
    }
    $right = "(" . $disp_mode . ") " . $right;

    # Fit cleanly within $bar_width so narrow split windows never overflow
    my int $lw = u8_str_width($left);
    my int $rw = u8_str_width($right);
    if ($lw + $rw > $bar_width) {
        my int $avail_l = $bar_width - $rw - 1;
        if ($avail_l >= 6) {
            $left = u8_truncate($left, $avail_l) . " ";
        } else {
            my str $merged = u8_truncate($left . " " . $right, $bar_width);
            my int $mpad = $bar_width - u8_str_width($merged);
            if ($mpad > 0) { $merged = $merged . (" " x $mpad); }
            return $out . $merged . $E . "[0m";
        }
    }
    my int $pad = $bar_width - u8_str_width($left) - u8_str_width($right);
    if ($pad < 0) { $pad = 0; }
    $out = $out . $left . (" " x $pad) . $right . $E . "[0m";
    return $out;
}

func render() void {
    clamp_cursor();
    scroll_adjust();

    my int $base_gutter = linum_width();

    # Bracket matching (active window: check char at cursor, or closing bracket before cursor)
    my int $match_y = -1;
    my int $match_x = -1;
    my int $bracket_x = -1;
    my int $cursor_is_bracket = 0;
    my str $cursor_masked = code_mask_line(get_line($CY));
    if ($CX < length($cursor_masked)) {
        my str $cch = substr($cursor_masked, $CX, 1);
        if ($cch eq "(" || $cch eq ")" || $cch eq "{" || $cch eq "}" || $cch eq "[" || $cch eq "]") {
            $cursor_is_bracket = 1;
            $bracket_x = $CX;
        }
    }
    if ($cursor_is_bracket == 0 && $CX > 0 && $CX - 1 < length($cursor_masked)) {
        my str $pch = substr($cursor_masked, $CX - 1, 1);
        if ($pch eq ")" || $pch eq "}" || $pch eq "]") {
            $cursor_is_bracket = 1;
            $bracket_x = $CX - 1;
        }
    }
    if ($cursor_is_bracket == 1 && $bracket_x >= 0) {
        my str $match_str = find_matching_bracket($CY, $bracket_x);
        if (length($match_str) > 0) {
            my int $comma = index($match_str, ",");
            if ($comma > 0) {
                $match_y = core::atoi(substr($match_str, 0, $comma));
                $match_x = core::atoi(substr($match_str, $comma + 1));
            }
        }
    }

    my str $out = "";
    $out = $out . $E . "[?25l";

    # Save active window state
    my int $save_buf_idx = $BUF_IDX;
    my int $save_cy = $CY;
    my int $save_cx = $CX;
    my int $save_sy = $SY;
    my int $save_sx = $SX;
    my int $save_dirty = $DIRTY;
    my str $save_bname = $BNAME;
    my str $save_syntax = $SYNTAX;
    my str $save_mode = $MODE;
    my scalar $save_cl = $CL;

    # Active window geometry for cursor positioning later
    my int $active_top = 0;
    my int $active_left = 0;
    my int $active_width = $COLS;
    my int $active_height = $EDIT_ROWS;
    my int $active_gutter = $base_gutter;

    my int $wi = 0;
    while ($wi < $WIN_COUNT) {
        my scalar $win = $WINDOWS->[$wi];
        my int $win_height = $win->{"height"};
        my int $win_left = $win->{"left_col"};
        my int $win_width = $win->{"width"};
        my int $win_top = $win->{"top_row"};
        my int $is_active = 0;
        if ($wi == $WIN_IDX) { $is_active = 1; }
        my int $reaches_right = ($win_left + $win_width >= $COLS);

        # Load this window's buffer state
        my int $wbi = $win->{"buf_idx"};
        if ($is_active == 1) {
            $BUF_IDX = $save_buf_idx;
            $CL = $save_cl;
            $CY = $save_cy;
            $CX = $save_cx;
            $SY = $save_sy;
            $SX = $save_sx;
            $DIRTY = $save_dirty;
            $BNAME = $save_bname;
            $SYNTAX = $save_syntax;
            $MODE = $save_mode;
        } else {
            my scalar $wbuf = $BUFFERS->[$wbi];
            $BUF_IDX = $wbi;
            $CL = $wbuf->{"lines"};
            $DIRTY = $wbuf->{"dirty"};
            $BNAME = $wbuf->{"name"};
            $SYNTAX = $wbuf->{"syntax"};
            $MODE = $wbuf->{"mode"};
            if (length($MODE) == 0) { $MODE = "Text"; }
            if (defined($win->{"cy"})) {
                $CY = $win->{"cy"};
                $CX = $win->{"cx"};
                $SY = $win->{"sy"};
                $SX = $win->{"sx"};
            } else {
                $CY = $wbuf->{"cy"};
                $CX = $wbuf->{"cx"};
                $SY = $wbuf->{"sy"};
                $SX = $wbuf->{"sx"};
            }
            clamp_cursor();
            if ($SY >= line_count()) { $SY = line_count() - 1; }
            if ($SY < 0) { $SY = 0; }
        }

        my int $w_vt = $BUFFERS->[$wbi]->{"term_vt"} // 0;
        my int $is_term_live = ($MODE eq "Term" && $w_vt != 0) ? 1 : 0;

        my int $gutter = ($is_term_live == 1 || $MODE eq "Dired" || $MODE eq "BufferMenu") ? 0 : linum_width();
        if ($gutter >= $win_width) { $gutter = 0; }
        my int $text_cols = $win_width - $gutter;
        if ($text_cols < 1) { $text_cols = 1; }

        if ($is_term_live == 1) {
            Smacs::Term::resize($w_vt, $win_height, $win_width);
        }

        if ($is_active == 1) {
            $active_top = $win_top;
            $active_left = $win_left;
            $active_width = $win_width;
            $active_height = $win_height;
            $active_gutter = $gutter;
        }

        # Draw text rows for this window using absolute positioning
        my int $r = 0;
        while ($r < $win_height) {
            my int $filerow = $r + $SY;
            my int $scr_row = $win_top + $r + 1;
            my int $scr_col = $win_left + 1;
            $out = $out . $E . "[" . $scr_row . ";" . $scr_col . "H";

            if ($is_term_live == 1) {
                my str $trow = Smacs::Term::render_row($w_vt, $r, $win_width);
                if ($reaches_right == 1) {
                    $out = $out . $trow . $E . "[K";
                } else {
                    $out = $out . $trow;
                }
                $r = $r + 1;
                next;
            }

            my str $row_content = "";
            my int $drawn_cols = 0;
            if ($filerow < line_count()) {
                if ($gutter > 0) {
                    my str $num = "" . ($filerow + 1);
                    my int $pad_len = $gutter - 1 - length($num);
                    my str $pad_str = "";
                    if ($pad_len > 0) { $pad_str = " " x $pad_len; }
                    $row_content = $row_content . $E . "[90m" . $pad_str . $num . " " . $E . "[0m";
                    $drawn_cols = $gutter;
                }
                my str $raw = get_line($filerow);
                my str $display = "";
                my int $vis_w = 0;
                if (length($raw) <= 4096) {
                    my str $expanded = expand_tabs($raw);
                    my str $vis_plain = $expanded;
                    if ($SX > 0) {
                        $vis_plain = u8_skip_cols($vis_plain, $SX);
                    }
                    $vis_plain = u8_truncate($vis_plain, $text_cols);
                    $vis_w = u8_str_width($vis_plain);
                    $display = $vis_plain;
                    if (length($SYNTAX) > 0) {
                        my str $colored = highlight_line_cached($expanded, $SYNTAX, $filerow);
                        if ($SX == 0 && u8_str_width($expanded) <= $text_cols) {
                            $display = $colored;
                        } else {
                            $display = Smacs::Text::ansi_slice_cols($colored, $SX, $text_cols);
                        }
                    } elsif ($MODE eq "Dired" || $MODE eq "BufferMenu") {
                        my str $bcolored = Smacs::Browser::highlight_browser_line($expanded, $MODE, $filerow);
                        if ($SX == 0 && u8_str_width($expanded) <= $text_cols) {
                            $display = $bcolored;
                        } else {
                            $display = Smacs::Text::ansi_slice_cols($bcolored, $SX, $text_cols);
                        }
                    }
                } else {
                    # Fast path for multi-KB/MB lines (e.g. SQL dump extended INSERT statements):
                    # slice only the visible column window instead of lexing megabytes per frame.
                    my int $bstart = 0;
                    if ($SX > 0) {
                        $bstart = u8_col_to_byte($raw, $SX);
                    }
                    my int $max_slice_bytes = ($text_cols + 4) * 4;
                    my str $raw_slice = substr($raw, $bstart, $max_slice_bytes);
                    my str $vis_plain = u8_truncate(expand_tabs($raw_slice), $text_cols);
                    $vis_w = u8_str_width($vis_plain);
                    $display = $vis_plain;
                    if (length($SYNTAX) > 0) {
                        $display = highlight_line_uncached($vis_plain, $SYNTAX);
                    }
                }
                $row_content = $row_content . $display;
                $drawn_cols = $drawn_cols + $vis_w;
            } else {
                if ($gutter > 0) {
                    my str $gpad = " " x ($gutter - 1);
                    $row_content = $row_content . $E . "[90m" . $gpad . "~" . $E . "[0m";
                    $drawn_cols = $gutter;
                } else {
                    $row_content = $row_content . $E . "[90m~" . $E . "[0m";
                    $drawn_cols = 1;
                }
            }
            if ($reaches_right == 1) {
                $out = $out . $row_content . $E . "[K";
            } else {
                my int $rem_pad = $win_width - $drawn_cols;
                if ($rem_pad > 0) {
                    $out = $out . $row_content . (" " x $rem_pad);
                } else {
                    $out = $out . $row_content;
                }
            }
            $r = $r + 1;
        }

        # Draw status bar for this window
        my int $bar_row = $win_top + $win_height + 1;
        $out = $out . $E . "[" . $bar_row . ";" . ($win_left + 1) . "H";
        $out = $out . render_status_bar($BNAME, $MODE, $DIRTY, $CY, $CX, line_count(), $is_active, $win_width);

        $wi = $wi + 1;
    }

    # Draw vertical separators to the right of any window that doesn't reach $COLS
    if ($WIN_COUNT > 1) {
        my str $vline = core::pack("C", 0xE2) . core::pack("C", 0x94) . core::pack("C", 0x82);
        my int $si = 0;
        while ($si < $WIN_COUNT) {
            my scalar $sw = $WINDOWS->[$si];
            if ($sw->{"left_col"} + $sw->{"width"} < $COLS) {
                my int $sep_col = $sw->{"left_col"} + $sw->{"width"} + 1;
                my int $sep_top = $sw->{"top_row"};
                my int $sep_height = $sw->{"height"};
                my int $sr = 0;
                while ($sr <= $sep_height) {
                    $out = $out . $E . "[" . ($sep_top + $sr + 1) . ";" . $sep_col . "H";
                    if ($sr == $sep_height) {
                        $out = $out . $E . "[7m|" . $E . "[0m";
                    } else {
                        $out = $out . $E . "[90m" . $vline . $E . "[0m";
                    }
                    $sr = $sr + 1;
                }
            }
            $si = $si + 1;
        }
    }

    # Restore active window state
    $BUF_IDX = $save_buf_idx;
    $CY = $save_cy;
    $CX = $save_cx;
    $SY = $save_sy;
    $SX = $save_sx;
    $DIRTY = $save_dirty;
    $BNAME = $save_bname;
    $SYNTAX = $save_syntax;
    $MODE = $save_mode;
    $CL = $save_cl;

    # Message bar (always at bottom row)
    my int $msg_row = $ROWS;
    $out = $out . $E . "[" . $msg_row . ";1H" . $E . "[K";
    if (length($MSG) > 0) {
        $out = $out . u8_truncate($MSG, $COLS);
    }

    # Per-window text_cols for active window (for bracket/region highlighting)
    my int $gutter = $active_gutter;
    my int $text_cols = $active_width - $gutter;
    if ($text_cols < 1) { $text_cols = 1; }

    # Bracket match highlighting (active window only)
    if ($cursor_is_bracket == 1 && $bracket_x >= 0) {
        my str $hl = $E . "[1;33;44m";
        my str $rst = $E . "[0m";
        my int $cy_screen = $CY - $SY + $active_top;
        my int $cx_screen = u8_byte_to_col(get_line($CY), $bracket_x) - $SX;
        if ($cy_screen >= $active_top && $cy_screen < $active_top + $active_height && $cx_screen >= 0 && $cx_screen < $text_cols) {
            my str $bch = substr(get_line($CY), $bracket_x, 1);
            my int $brow = $cy_screen + 1;
            my int $bcol = $cx_screen + 1 + $gutter + $active_left;
            $out = $out . $E . "[" . $brow . ";" . $bcol . "H" . $hl . $bch . $rst;
        }
        if ($match_y >= 0) {
            my int $my_screen = $match_y - $SY + $active_top;
            my int $mx_screen = u8_byte_to_col(get_line($match_y), $match_x) - $SX;
            if ($my_screen >= $active_top && $my_screen < $active_top + $active_height && $mx_screen >= 0 && $mx_screen < $text_cols) {
                my str $mch = substr(get_line($match_y), $match_x, 1);
                my int $mrow = $my_screen + 1;
                my int $mcol = $mx_screen + 1 + $gutter + $active_left;
                $out = $out . $E . "[" . $mrow . ";" . $mcol . "H" . $hl . $mch . $rst;
            }
        }
    }

    # Region highlight (active window only)
    if ($MSET == 1) {
        my int $rsy = $MY;
        my int $rsx = $MX;
        if ($rsy >= line_count()) { $rsy = line_count() - 1; }
        if ($rsy < 0) { $rsy = 0; }
        if ($rsx > length(get_line($rsy))) { $rsx = length(get_line($rsy)); }
        if ($rsx < 0) { $rsx = 0; }
        my int $rey = $CY;
        my int $rex = $CX;
        if ($rsy > $rey || ($rsy == $rey && $rsx > $rex)) {
            my int $tmp = $rsy;
            $rsy = $rey;
            $rey = $tmp;
            $tmp = $rsx;
            $rsx = $rex;
            $rex = $tmp;
        }
        my str $rhl = $E . "[7m";
        my str $rrst = $E . "[0m";
        my int $ry = $rsy;
        while ($ry <= $rey) {
            my int $scr_y = $ry - $SY + $active_top;
            if ($scr_y >= $active_top && $scr_y < $active_top + $active_height) {
                my str $rline = get_line($ry);
                my int $byte_start = 0;
                my int $byte_end = length($rline);
                if ($ry == $rsy) { $byte_start = $rsx; }
                if ($ry == $rey) { $byte_end = $rex; }
                my int $bp = 0;
                my int $rcl = 0;
                while ($bp < $byte_start && $bp < length($rline)) {
                    $rcl = $rcl + char_width_at($rline, $bp, $rcl);
                    if (core::get_byte($rline, $bp) == 9) { $bp = $bp + 1; }
                    else { $bp = u8_next($rline, $bp); }
                }
                while ($bp < $byte_end && $bp < length($rline)) {
                    my int $w = char_width_at($rline, $bp, $rcl);
                    my int $nx = 0;
                    my str $rch = "";
                    if (core::get_byte($rline, $bp) == 9) {
                        $nx = $bp + 1;
                        $rch = " " x $w;
                    } else {
                        $nx = u8_next($rline, $bp);
                        $rch = terminal_safe(substr($rline, $bp, $nx - $bp));
                    }
                    my int $scr_x = $rcl - $SX;
                    if ($scr_x >= 0 && $scr_x + $w <= $text_cols) {
                        my int $rrow = $scr_y + 1;
                        my int $rcol = $scr_x + 1 + $gutter + $active_left;
                        $out = $out . $E . "[" . $rrow . ";" . $rcol . "H" . $rhl . $rch . $rrst;
                    }
                    $rcl = $rcl + $w;
                    $bp = $nx;
                }
            }
            $ry = $ry + 1;
        }
    }

    # Completion popup overlay
    if ($COMP_ACTIVE == 1 && scalar(@$COMP_LIST) > 0) {
        my int $max_visible = 8;
        my int $total = scalar(@$COMP_LIST);
        my int $visible = $total;
        if ($visible > $max_visible) { $visible = $max_visible; }

        my int $pop_row = $COMP_ROW;
        my int $pop_col = $COMP_COL;

        # Find max width of candidates for uniform popup (clamped to screen width)
        my int $max_w = 0;
        my int $mwi = 0;
        while ($mwi < $total) {
            my int $wlen = u8_str_width(terminal_safe($COMP_LIST->[$mwi]));
            if ($wlen > $max_w) { $max_w = $wlen; }
            $mwi = $mwi + 1;
        }
        $max_w = $max_w + 2;
        if ($max_w < 12) { $max_w = 12; }
        if ($max_w > $COLS) { $max_w = $COLS; }

        # Clamp to screen bounds
        if ($pop_col + $max_w - 1 > $COLS) {
            $pop_col = $COLS - $max_w + 1;
            if ($pop_col < 1) { $pop_col = 1; }
        }
        # Flip above cursor if no room below
        if ($pop_row + $visible > $ROWS - 1) {
            $pop_row = $COMP_ROW - $visible - 1;
            if ($pop_row < 1) { $pop_row = 1; }
        }

        my int $ri = 0;
        while ($ri < $visible) {
            my int $idx = $COMP_SCROLL + $ri;
            if ($idx < $total) {
                my str $entry = u8_truncate(terminal_safe($COMP_LIST->[$idx]), $max_w - 2);
                my int $scr_r = $pop_row + $ri;
                $out = $out . $E . "[" . $scr_r . ";" . $pop_col . "H";

                if ($idx == $COMP_IDX) {
                    $out = $out . $E . "[7m";
                } else {
                    $out = $out . $E . "[46;30m";
                }

                my int $ew = u8_str_width($entry);
                my int $pad = $max_w - $ew - 1;
                if ($pad < 0) { $pad = 0; }
                $out = $out . " " . $entry . (" " x $pad) . $E . "[0m";
            }
            $ri = $ri + 1;
        }
    }

    # Position cursor in active window (clamp to valid screen range)
    my int $screen_y = 1;
    my int $screen_x = 1;
    my int $act_vt = $BUFFERS->[$BUF_IDX]->{"term_vt"} // 0;
    if ($MODE eq "Term" && $act_vt != 0) {
        $screen_y = $active_top + Smacs::Term::cursor_row($act_vt) + 1;
        $screen_x = $active_left + Smacs::Term::cursor_col($act_vt) + 1;
    } else {
        $screen_y = $CY - $SY + $active_top + 1;
        my str $cur_line = get_line($CY);
        my int $cursor_col = u8_byte_to_col($cur_line, $CX);
        $screen_x = $cursor_col - $SX + 1 + $gutter + $active_left;
    }
    if ($screen_y < 1) { $screen_y = 1; }
    if ($screen_y > $ROWS) { $screen_y = $ROWS; }
    if ($screen_x < 1) { $screen_x = 1; }
    if ($screen_x > $COLS) { $screen_x = $COLS; }
    $out = $out . $E . "[" . $screen_y . ";" . $screen_x . "H";

    $out = $out . $E . "[?25h";

    core::write_fd(1, $out);
}

# ===========================================================================
# Cursor Movement
# ===========================================================================

func move_forward() void {
    my str $line = get_line($CY);
    my int $ll = length($line);
    if ($CX < $ll) {
        $CX = u8_next($line, $CX);
    } elsif ($CY < line_count() - 1) {
        $CY = $CY + 1;
        $CX = 0;
    }
}

func move_backward() void {
    if ($CX > 0) {
        $CX = u8_prev(get_line($CY), $CX);
    } elsif ($CY > 0) {
        $CY = $CY - 1;
        $CX = length(get_line($CY));
    }
}

func move_up() void {
    if ($GOAL_COL < 0) {
        $GOAL_COL = u8_byte_to_col(get_line($CY), $CX);
    }
    if ($CY > 0) {
        $CY = $CY - 1;
        $CX = u8_col_to_byte(get_line($CY), $GOAL_COL);
    } elsif ($LARGE_MODE == 1 && $MSET == 0 && defined($LF_STATE) && $LF_STATE->{"chunk_vstart"} > 0) {
        my int $gc = $GOAL_COL;
        if (lf_prev_chunk(1) == 1) {
            $GOAL_COL = $gc;
            $CX = u8_col_to_byte(get_line($CY), $GOAL_COL);
        }
    }
}

func move_down() void {
    if ($GOAL_COL < 0) {
        $GOAL_COL = u8_byte_to_col(get_line($CY), $CX);
    }
    if ($CY < line_count() - 1) {
        $CY = $CY + 1;
        $CX = u8_col_to_byte(get_line($CY), $GOAL_COL);
    } elsif ($LARGE_MODE == 1 && $MSET == 0 && defined($LF_STATE) && $LF_STATE->{"chunk_vend"} < Smacs::LargeFile::total_size($LF_STATE)) {
        my int $gc = $GOAL_COL;
        if (lf_next_chunk() == 1) {
            $GOAL_COL = $gc;
            $CX = u8_col_to_byte(get_line($CY), $GOAL_COL);
        }
    }
}

func move_bol() void {
    $CX = 0;
}

func move_eol() void {
    $CX = length(get_line($CY));
}

func move_page_down() void {
    if ($GOAL_COL < 0) {
        $GOAL_COL = u8_byte_to_col(get_line($CY), $CX);
    }
    if ($LARGE_MODE == 1 && $MSET == 0 && $CY >= line_count() - 1 && defined($LF_STATE) && $LF_STATE->{"chunk_vend"} < Smacs::LargeFile::total_size($LF_STATE)) {
        my int $gc = $GOAL_COL;
        if (lf_next_chunk() == 1) {
            $GOAL_COL = $gc;
            $CX = u8_col_to_byte(get_line($CY), $GOAL_COL);
        }
        return;
    }
    $CY = $CY + win_edit_rows();
    if ($CY >= line_count()) {
        $CY = line_count() - 1;
    }
    $CX = u8_col_to_byte(get_line($CY), $GOAL_COL);
}

func move_page_up() void {
    if ($GOAL_COL < 0) {
        $GOAL_COL = u8_byte_to_col(get_line($CY), $CX);
    }
    if ($LARGE_MODE == 1 && $MSET == 0 && $CY <= 0 && defined($LF_STATE) && $LF_STATE->{"chunk_vstart"} > 0) {
        my int $gc = $GOAL_COL;
        if (lf_prev_chunk(1) == 1) {
            $GOAL_COL = $gc;
            $CX = u8_col_to_byte(get_line($CY), $GOAL_COL);
        }
        return;
    }
    $CY = $CY - win_edit_rows();
    if ($CY < 0) {
        $CY = 0;
    }
    $CX = u8_col_to_byte(get_line($CY), $GOAL_COL);
}

func move_buf_start() void {
    if ($LARGE_MODE == 1 && $MSET == 0 && defined($LF_STATE) && $LF_STATE->{"chunk_vstart"} > 0) {
        lf_sync_active_chunk();
        my scalar $parsed = Smacs::LargeFile::load_chunk_from($LF_STATE, 0, 0);
        lf_apply_chunk_result($parsed);
    }
    $CY = 0;
    $CX = 0;
}

func move_buf_end() void {
    if ($LARGE_MODE == 1 && $MSET == 0 && defined($LF_STATE)) {
        my int $tot = Smacs::LargeFile::total_size($LF_STATE);
        if ($LF_STATE->{"chunk_vend"} < $tot) {
            lf_sync_active_chunk();
            my scalar $parsed = Smacs::LargeFile::load_prev_chunk($LF_STATE, $tot);
            lf_apply_chunk_result($parsed);
        }
    }
    $CY = line_count() - 1;
    $CX = length(get_line($CY));
}

func move_forward_paragraph() void {
    my int $n = line_count();
    while ($CY < $n - 1 && length(trim(get_line($CY))) == 0) {
        $CY = $CY + 1;
    }
    while ($CY < $n - 1 && length(trim(get_line($CY))) > 0) {
        $CY = $CY + 1;
    }
    if (length(trim(get_line($CY))) > 0) {
        $CX = length(get_line($CY));
    } else {
        $CX = 0;
    }
}

func move_backward_paragraph() void {
    while ($CY > 0 && length(trim(get_line($CY))) == 0) {
        $CY = $CY - 1;
    }
    while ($CY > 0 && length(trim(get_line($CY))) > 0) {
        $CY = $CY - 1;
    }
    $CX = 0;
}

func move_forward_word() void {
    my int $n = line_count();
    # 1. Skip non-word chars (crossing lines as needed)
    while (1) {
        my str $line = get_line($CY);
        my int $ll = length($line);
        while ($CX < $ll && is_word_char(u8_char_at($line, $CX)) == 0) {
            $CX = u8_next($line, $CX);
        }
        if ($CX < $ll || $CY >= $n - 1) {
            last;
        }
        $CY = $CY + 1;
        $CX = 0;
    }
    # 2. Advance to end of word
    my str $wline = get_line($CY);
    my int $wlen = length($wline);
    while ($CX < $wlen && is_word_char(u8_char_at($wline, $CX)) == 1) {
        $CX = u8_next($wline, $CX);
    }
}

func move_backward_word() void {
    # 1. Skip non-word chars backward (crossing lines as needed)
    while (1) {
        my str $line = get_line($CY);
        while ($CX > 0) {
            my int $prev = u8_prev($line, $CX);
            if (is_word_char(u8_char_at($line, $prev)) == 1) {
                last;
            }
            $CX = $prev;
        }
        if ($CX > 0 || $CY <= 0) {
            last;
        }
        $CY = $CY - 1;
        $CX = length(get_line($CY));
    }
    # 2. Move back to beginning of word
    my str $wline = get_line($CY);
    while ($CX > 0) {
        my int $prev = u8_prev($wline, $CX);
        if (is_word_char(u8_char_at($wline, $prev)) == 0) {
            last;
        }
        $CX = $prev;
    }
}

# ===========================================================================
# Editing
# ===========================================================================

# Insert text at the cursor without touching the undo stack
func insert_raw(str $ch) void {
    my str $line = get_line($CY);
    my str $before = "";
    if ($CX > 0) {
        $before = substr($line, 0, $CX);
    }
    my str $after = "";
    if ($CX < length($line)) {
        $after = substr($line, $CX);
    }
    set_line($CY, $before . $ch . $after);
    $CX = $CX + length($ch);
    $DIRTY = 1;
}

func edit_insert(str $ch) void {
    # Group runs of consecutive self-inserts into one undo entry
    # (snapshot at the start of each run, and every 20 chars)
    if ($INSERT_GROUP == 0 || $INSERT_GROUP >= 20) {
        undo_save();
        $INSERT_GROUP = 0;
    }
    $INSERT_GROUP = $INSERT_GROUP + 1;
    insert_raw($ch);
}

func edit_newline() void {
    undo_save();
    my str $line = get_line($CY);
    my str $before = "";
    if ($CX > 0) {
        $before = substr($line, 0, $CX);
    }
    my str $after = "";
    if ($CX < length($line)) {
        $after = substr($line, $CX);
    }
    set_line($CY, $before);
    $CY = $CY + 1;
    insert_line($CY, $after);
    $CX = 0;
    $DIRTY = 1;
}

func edit_newline_indent() void {
    undo_save();
    my str $line = get_line($CY);
    my int $ind = 0;
    while ($ind < $CX && $ind < length($line)) {
        my str $ic = substr($line, $ind, 1);
        if ($ic eq " " || $ic eq "\t") { $ind = $ind + 1; }
        else { last; }
    }
    my str $indent = "";
    if ($ind > 0) { $indent = substr($line, 0, $ind); }
    my str $before = "";
    if ($CX > 0) { $before = substr($line, 0, $CX); }
    my str $after = "";
    if ($CX < length($line)) { $after = ltrim(substr($line, $CX)); }
    set_line($CY, $before);
    $CY = $CY + 1;
    insert_line($CY, $indent . $after);
    $CX = length($indent);
    $DIRTY = 1;
}

func edit_open_line() void {
    undo_save();
    my str $line = get_line($CY);
    my str $before = "";
    if ($CX > 0) { $before = substr($line, 0, $CX); }
    my str $after = "";
    if ($CX < length($line)) { $after = substr($line, $CX); }
    set_line($CY, $before);
    insert_line($CY + 1, $after);
    $DIRTY = 1;
}

func edit_backspace() void {
    if ($CX == 0 && $CY == 0) { return; }
    undo_save();
    if ($CX > 0) {
        my str $line = get_line($CY);
        my int $prev = u8_prev($line, $CX);
        my str $before = "";
        if ($prev > 0) {
            $before = substr($line, 0, $prev);
        }
        my str $after = "";
        if ($CX < length($line)) {
            $after = substr($line, $CX);
        }
        set_line($CY, $before . $after);
        $CX = $prev;
        $DIRTY = 1;
    } elsif ($CY > 0) {
        # Join with previous line
        my str $cur = get_line($CY);
        delete_line($CY);
        $CY = $CY - 1;
        $CX = length(get_line($CY));
        set_line($CY, get_line($CY) . $cur);
        $DIRTY = 1;
    }
}

func edit_backward_kill_word() void {
    if ($CX == 0) {
        # At beginning of line — join with previous line
        if ($CY == 0) { return; }
        undo_save();
        my str $cur = get_line($CY);
        my str $prev = get_line($CY - 1);
        my int $plen = length($prev);
        set_line($CY - 1, $prev . $cur);
        delete_line($CY);
        $CY = $CY - 1;
        $CX = $plen;
        $KILL = "\n";
        $DIRTY = 1;
        return;
    }
    undo_save();
    my str $line = get_line($CY);
    my int $end = $CX;

    # Skip non-word characters
    while ($CX > 0) {
        my int $prev = u8_prev($line, $CX);
        if (is_word_char(u8_char_at($line, $prev)) == 1) { last; }
        $CX = $prev;
    }
    # Skip word characters
    while ($CX > 0) {
        my int $prev = u8_prev($line, $CX);
        if (is_word_char(u8_char_at($line, $prev)) == 0) { last; }
        $CX = $prev;
    }

    my str $before = "";
    if ($CX > 0) { $before = substr($line, 0, $CX); }
    my str $after = "";
    if ($end < length($line)) { $after = substr($line, $end); }
    $KILL = substr($line, $CX, $end - $CX);
    set_line($CY, $before . $after);
    $DIRTY = 1;
}

func edit_forward_kill_word() void {
    my str $line = get_line($CY);
    if ($CX >= length($line)) {
        if ($CY >= line_count() - 1) { return; }
        undo_save();
        my str $nxt = get_line($CY + 1);
        set_line($CY, $line . $nxt);
        delete_line($CY + 1);
        $KILL = "\n";
        $DIRTY = 1;
        return;
    }
    undo_save();
    my int $start = $CX;
    my int $len = length($line);

    # Skip non-word characters first, then word characters (Emacs kill-word)
    while ($CX < $len && is_word_char(u8_char_at($line, $CX)) == 0) {
        $CX = u8_next($line, $CX);
    }
    while ($CX < $len && is_word_char(u8_char_at($line, $CX)) == 1) {
        $CX = u8_next($line, $CX);
    }

    my str $before = "";
    if ($start > 0) { $before = substr($line, 0, $start); }
    my str $after = "";
    if ($CX < $len) { $after = substr($line, $CX); }
    $KILL = substr($line, $start, $CX - $start);
    $CX = $start;
    set_line($CY, $before . $after);
    $DIRTY = 1;
}

func edit_delete() void {
    my str $line = get_line($CY);
    if ($CX >= length($line) && $CY >= line_count() - 1) { return; }
    undo_save();
    if ($CX < length($line)) {
        my str $before = "";
        if ($CX > 0) {
            $before = substr($line, 0, $CX);
        }
        my int $next = u8_next($line, $CX);
        my str $after = "";
        if ($next < length($line)) {
            $after = substr($line, $next);
        }
        set_line($CY, $before . $after);
        $DIRTY = 1;
    } elsif ($CY < line_count() - 1) {
        # Join with next line
        my str $next = get_line($CY + 1);
        set_line($CY, $line . $next);
        delete_line($CY + 1);
        $DIRTY = 1;
    }
}

func edit_kill_line() void {
    my str $line = get_line($CY);
    my str $killed = "";
    if ($CX < length($line)) {
        undo_save();
        $killed = substr($line, $CX);
        my str $before = "";
        if ($CX > 0) {
            $before = substr($line, 0, $CX);
        }
        set_line($CY, $before);
    } elsif ($CY < line_count() - 1) {
        undo_save();
        $killed = "\n";
        my str $next = get_line($CY + 1);
        set_line($CY, $line . $next);
        delete_line($CY + 1);
    } else {
        # End of buffer: nothing to kill
        return;
    }
    # Consecutive kills accumulate so C-k C-k ... C-y moves whole blocks
    if ($LAST_KILL == 1) {
        $KILL = $KILL . $killed;
    } else {
        $KILL = $killed;
    }
    $LAST_KILL = 1;
    $DIRTY = 1;
}

func insert_multiline_text(str $text) void {
    my array @parts = split("\n", $text, -1);
    my str $line = get_line($CY);
    my str $before = "";
    if ($CX > 0) { $before = substr($line, 0, $CX); }
    my str $after = "";
    if ($CX < length($line)) { $after = substr($line, $CX); }
    if (scalar(@parts) <= 1) {
        set_line($CY, $before . $text . $after);
        $CX = $CX + length($text);
    } else {
        set_line($CY, $before . $parts[0]);
        my int $pi = 1;
        while ($pi < scalar(@parts) - 1) {
            insert_line($CY + $pi, $parts[$pi]);
            $pi = $pi + 1;
        }
        my int $last_idx = scalar(@parts) - 1;
        my str $last_part = $parts[$last_idx];
        insert_line($CY + $last_idx, $last_part . $after);
        $CY = $CY + $last_idx;
        $CX = length($last_part);
    }
}

func edit_yank() void {
    if (length($KILL) == 0) {
        set_msg("Kill ring empty.");
        return;
    }
    undo_save();
    insert_multiline_text($KILL);
    $DIRTY = 1;
}

# Insert bracketed-paste text at the cursor as a single undoable edit
func paste_insert() void {
    my str $text = $PASTE_BUF;
    $PASTE_BUF = "";
    if (length($text) == 0) { return; }
    # Normalize line endings (\r\n and \r -> \n) and strip control bytes
    my str $norm = "";
    my int $i = 0;
    my int $len = length($text);
    while ($i < $len) {
        my int $b = core::get_byte($text, $i);
        if ($b == 13) {
            $norm = $norm . "\n";
            if ($i + 1 < $len && core::get_byte($text, $i + 1) == 10) {
                $i = $i + 1;
            }
        } elsif ($b < 32 && $b != 9 && $b != 10) {
            # drop other control bytes
        } else {
            $norm = $norm . substr($text, $i, 1);
        }
        $i = $i + 1;
    }
    if (length($norm) == 0) { return; }
    undo_save();
    $INSERT_GROUP = 0;
    insert_multiline_text($norm);
    $DIRTY = 1;
    set_msg("Pasted " . length($norm) . " bytes.");
}

func clamp_mark() void {
    my int $n = line_count();
    if ($MY >= $n) { $MY = $n - 1; }
    if ($MY < 0) { $MY = 0; }
    my str $mline = get_line($MY);
    if ($MX > length($mline)) { $MX = length($mline); }
    if ($MX < 0) { $MX = 0; }
    while ($MX > 0 && $MX < length($mline) && u8_is_cont($mline, $MX) == 1) {
        $MX = $MX - 1;
    }
}

func edit_set_mark() void {
    if ($MSET == 1 && $SHIFT_MARK == 0 && $MY == $CY && $MX == $CX) {
        $MSET = 0;
        set_msg("Mark deactivated.");
        return;
    }
    $MY = $CY;
    $MX = $CX;
    $MSET = 1;
    $SHIFT_MARK = 0;
    set_msg("Mark set.");
}

func get_region_text() str {
    if ($MSET == 0) {
        set_msg("No mark set.");
        return "";
    }
    clamp_mark();
    my int $sy = $MY;
    my int $sx = $MX;
    my int $ey = $CY;
    my int $ex = $CX;
    if ($sy > $ey || ($sy == $ey && $sx > $ex)) {
        my int $tmp = $sy;
        $sy = $ey;
        $ey = $tmp;
        $tmp = $sx;
        $sx = $ex;
        $ex = $tmp;
    }
    if ($sy == $ey) {
        return substr(get_line($sy), $sx, $ex - $sx);
    }
    my str $text = substr(get_line($sy), $sx) . "\n";
    my int $r = $sy + 1;
    while ($r < $ey) {
        $text = $text . get_line($r) . "\n";
        $r = $r + 1;
    }
    $text = $text . substr(get_line($ey), 0, $ex);
    return $text;
}

func edit_kill_region() void {
    if ($MSET == 0) {
        set_msg("No mark set.");
        return;
    }
    clamp_mark();
    if ($MY == $CY && $MX == $CX) {
        $MSET = 0;
        $SHIFT_MARK = 0;
        set_msg("Empty region.");
        return;
    }
    undo_save();
    $KILL = get_region_text();
    my int $sy = $MY;
    my int $sx = $MX;
    my int $ey = $CY;
    my int $ex = $CX;
    if ($sy > $ey || ($sy == $ey && $sx > $ex)) {
        my int $tmp = $sy;
        $sy = $ey;
        $ey = $tmp;
        $tmp = $sx;
        $sx = $ex;
        $ex = $tmp;
    }
    if ($sy == $ey) {
        my str $line = get_line($sy);
        my str $before = "";
        if ($sx > 0) { $before = substr($line, 0, $sx); }
        my str $after = "";
        if ($ex < length($line)) { $after = substr($line, $ex); }
        set_line($sy, $before . $after);
    } else {
        my str $first = get_line($sy);
        my str $last = get_line($ey);
        my str $before = "";
        if ($sx > 0) { $before = substr($first, 0, $sx); }
        my str $after = "";
        if ($ex < length($last)) { $after = substr($last, $ex); }
        set_line($sy, $before . $after);
        ensure_lines_writable();
        splice(@$CL, $sy + 1, $ey - $sy);
        note_buffer_changed();
    }
    $CY = $sy;
    $CX = $sx;
    $MSET = 0;
    $SHIFT_MARK = 0;
    $DIRTY = 1;
    set_msg("Region killed.");
}

func edit_copy_region() void {
    if ($MSET == 0) {
        set_msg("No mark set.");
        return;
    }
    $KILL = get_region_text();
    $MSET = 0;
    $SHIFT_MARK = 0;
    set_msg("Region copied.");
}

func get_comment_prefix() str {
    # Try vim syntax line_comment first
    if (defined($VIM_SYN) && length($SYNTAX) > 0 && defined($VIM_SYN->{$SYNTAX})) {
        my str $lc = $VIM_SYN->{$SYNTAX}->{"line_comment"};
        if (length($lc) > 0) {
            return $lc;
        }
    }
    # Fallback based on mode
    if ($MODE eq "C" || $MODE eq "C++" || $MODE eq "C#" || $MODE eq "ObjC" || $MODE eq "JavaScript" || $MODE eq "TypeScript") {
        return "//";
    }
    if ($MODE eq "SQL") {
        return "--";
    }
    if ($MODE eq "Strada" || $MODE eq "Perl" || $MODE eq "Python" || $MODE eq "Shell" || $MODE eq "Makefile") {
        return "#";
    }
    if ($MODE eq "HTML" || $MODE eq "CSS" || $MODE eq "JSON" || $MODE eq "Markdown") {
        return "";
    }
    return "#";
}

func comment_region() void {
    if ($MSET == 0) {
        set_msg("No mark set.");
        return;
    }
    my str $prefix = get_comment_prefix();
    if (length($prefix) == 0) {
        set_msg("No line comment style for this mode.");
        return;
    }
    clamp_mark();
    undo_save();
    my int $sy = $MY;
    my int $sx = $MX;
    my int $ey = $CY;
    my int $ex = $CX;
    if ($sy > $ey || ($sy == $ey && $sx > $ex)) {
        my int $tmp = $sy; $sy = $ey; $ey = $tmp;
        $tmp = $sx; $sx = $ex; $ex = $tmp;
    }
    if ($ey > $sy && $ex == 0) {
        $ey = $ey - 1;
    }
    my str $cmt = $prefix . " ";
    my int $r = $sy;
    while ($r <= $ey) {
        set_line($r, $cmt . get_line($r));
        $r = $r + 1;
    }
    $MSET = 0;
    $SHIFT_MARK = 0;
    $DIRTY = 1;
    set_msg("Region commented.");
}

func uncomment_region() void {
    if ($MSET == 0) {
        set_msg("No mark set.");
        return;
    }
    my str $prefix = get_comment_prefix();
    if (length($prefix) == 0) {
        set_msg("No line comment style for this mode.");
        return;
    }
    clamp_mark();
    undo_save();
    my int $sy = $MY;
    my int $sx = $MX;
    my int $ey = $CY;
    my int $ex = $CX;
    if ($sy > $ey || ($sy == $ey && $sx > $ex)) {
        my int $tmp = $sy; $sy = $ey; $ey = $tmp;
        $tmp = $sx; $sx = $ex; $ex = $tmp;
    }
    if ($ey > $sy && $ex == 0) {
        $ey = $ey - 1;
    }
    my int $plen = length($prefix);
    my int $r = $sy;
    while ($r <= $ey) {
        my str $line = get_line($r);
        my int $ws = 0;
        while ($ws < length($line) && (substr($line, $ws, 1) eq " " || substr($line, $ws, 1) eq "\t")) {
            $ws = $ws + 1;
        }
        if ($ws + $plen <= length($line) && substr($line, $ws, $plen) eq $prefix) {
            my int $strip = $plen;
            if ($ws + $plen < length($line) && substr($line, $ws + $plen, 1) eq " ") {
                $strip = $plen + 1;
            }
            my str $before = "";
            if ($ws > 0) { $before = substr($line, 0, $ws); }
            set_line($r, $before . substr($line, $ws + $strip));
        }
        $r = $r + 1;
    }
    $MSET = 0;
    $SHIFT_MARK = 0;
    $DIRTY = 1;
    set_msg("Region uncommented.");
}

func fill_paragraph() void {
    if (length(trim(get_line($CY))) == 0) {
        set_msg("Nothing to fill on blank line.");
        return;
    }
    my int $lc = line_count();

    # Find start of paragraph (search backward for blank/whitespace-only line or BOF)
    my int $para_start = $CY;
    while ($para_start > 0) {
        if (length(trim(get_line($para_start - 1))) == 0) {
            last;
        }
        $para_start = $para_start - 1;
    }

    # Find end of paragraph (search forward for blank/whitespace-only line or EOF)
    my int $para_end = $CY;
    while ($para_end < $lc - 1) {
        if (length(trim(get_line($para_end + 1))) == 0) {
            last;
        }
        $para_end = $para_end + 1;
    }

    if ($para_start > $para_end) { return; }

    # Detect leading indent from first line
    my str $first = get_line($para_start);
    my int $indent_len = 0;
    while ($indent_len < length($first)) {
        my str $ic = substr($first, $indent_len, 1);
        if ($ic eq " " || $ic eq "\t") {
            $indent_len = $indent_len + 1;
        } else {
            last;
        }
    }
    my str $indent = "";
    if ($indent_len > 0) {
        $indent = substr($first, 0, $indent_len);
    }

    # Join all paragraph lines into one string, stripping outer whitespace
    my str $text = "";
    my int $li = $para_start;
    while ($li <= $para_end) {
        my str $stripped = trim(get_line($li));
        if (length($text) > 0 && length($stripped) > 0) {
            $text = $text . " " . $stripped;
        } else {
            $text = $text . $stripped;
        }
        $li = $li + 1;
    }

    if (length($text) == 0) { return; }

    undo_save();

    # Reflow text into lines of at most $FILL_COLUMN display columns
    my int $fill = $FILL_COLUMN - u8_str_width($indent);
    if ($fill < 10) { $fill = 10; }

    my scalar $new_lines = [];
    my str $cur_line = "";
    my int $cur_w = 0;
    my int $pos = 0;
    my int $tlen = length($text);

    while ($pos < $tlen) {
        while ($pos < $tlen && (substr($text, $pos, 1) eq " " || substr($text, $pos, 1) eq "\t")) {
            $pos = $pos + 1;
        }
        if ($pos >= $tlen) { last; }
        my int $word_start = $pos;
        while ($pos < $tlen && substr($text, $pos, 1) ne " " && substr($text, $pos, 1) ne "\t") {
            $pos = $pos + 1;
        }
        my str $word = substr($text, $word_start, $pos - $word_start);
        my int $ww = u8_str_width($word);

        if ($cur_w == 0) {
            $cur_line = $word;
            $cur_w = $ww;
        } elsif ($cur_w + 1 + $ww <= $fill) {
            $cur_line = $cur_line . " " . $word;
            $cur_w = $cur_w + 1 + $ww;
        } else {
            push(@$new_lines, $indent . $cur_line);
            $cur_line = $word;
            $cur_w = $ww;
        }
    }
    if (length($cur_line) > 0) {
        push(@$new_lines, $indent . $cur_line);
    }
    if (scalar(@$new_lines) == 0) {
        push(@$new_lines, "");
    }

    ensure_lines_writable();
    splice(@$CL, $para_start, $para_end - $para_start + 1, @$new_lines);
    if (scalar(@$CL) == 0) {
        push(@$CL, "");
    }
    note_buffer_changed();

    $DIRTY = 1;
    $CY = $para_start + scalar(@$new_lines) - 1;
    $CX = length(get_line($CY));
    set_msg("Filled paragraph (column " . $FILL_COLUMN . ").");
}

func edit_tab() void {
    undo_save();
    $INSERT_GROUP = 0;
    if ($INDENT_TABS == 1) {
        insert_raw("\t");
    } else {
        my int $col = u8_byte_to_col(get_line($CY), $CX);
        my int $tw = $TAB_WIDTH;
        if ($tw < 1) { $tw = 4; }
        my int $spaces = $tw - ($col % $tw);
        insert_raw(" " x $spaces);
    }
}

func undo_save() void {
    my scalar $snap = {};
    $snap->{"cy"} = $CY;
    $snap->{"cx"} = $CX;
    $snap->{"dirty"} = $DIRTY;
    # Persistent line arrays: snapshots share immutable line strings. The
    # first following mutation clones only the array of references.
    $snap->{"lines"} = $CL;
    $snap->{"eol"} = $FILE_EOL;
    $snap->{"final_newline"} = $FILE_FINAL_NL;
    push(@$UNDO, $snap);
    $LINES_SHARED = 1;
    # Trim oldest entries if over limit
    while (scalar(@$UNDO) > $UNDO_MAX) {
        shift(@$UNDO);
    }
    # Any edit invalidates the redo stack
    $REDO = [];
}

func edit_undo() void {
    if (scalar(@$UNDO) == 0) {
        set_msg("No further undo information.");
        return;
    }
    # Save current state to redo stack before restoring
    my scalar $rsnap = {};
    $rsnap->{"cy"} = $CY;
    $rsnap->{"cx"} = $CX;
    $rsnap->{"dirty"} = $DIRTY;
    $rsnap->{"lines"} = $CL;
    $rsnap->{"eol"} = $FILE_EOL;
    $rsnap->{"final_newline"} = $FILE_FINAL_NL;
    push(@$REDO, $rsnap);

    my scalar $snap = pop(@$UNDO);
    $CY = $snap->{"cy"};
    $CX = $snap->{"cx"};
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    $buf->{"lines"} = $snap->{"lines"};
    $CL = $snap->{"lines"};
    $FILE_EOL = $snap->{"eol"};
    $FILE_FINAL_NL = $snap->{"final_newline"};
    $LINES_SHARED = 1;
    note_buffer_changed();
    $DIRTY = $snap->{"dirty"} // 1;
    if ($LARGE_MODE == 1 && defined($LF_STATE) && $LF_STATE->{"has_edits"} == 1) {
        $DIRTY = 1;
    }
    set_msg("Undo.");
}

func edit_redo() void {
    if (scalar(@$REDO) == 0) {
        set_msg("No further redo information.");
        return;
    }
    # Save current state to undo stack before restoring
    my scalar $usnap = {};
    $usnap->{"cy"} = $CY;
    $usnap->{"cx"} = $CX;
    $usnap->{"dirty"} = $DIRTY;
    $usnap->{"lines"} = $CL;
    $usnap->{"eol"} = $FILE_EOL;
    $usnap->{"final_newline"} = $FILE_FINAL_NL;
    push(@$UNDO, $usnap);

    my scalar $snap = pop(@$REDO);
    $CY = $snap->{"cy"};
    $CX = $snap->{"cx"};
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    $buf->{"lines"} = $snap->{"lines"};
    $CL = $snap->{"lines"};
    $FILE_EOL = $snap->{"eol"};
    $FILE_FINAL_NL = $snap->{"final_newline"};
    $LINES_SHARED = 1;
    note_buffer_changed();
    $DIRTY = $snap->{"dirty"} // 1;
    if ($LARGE_MODE == 1 && defined($LF_STATE) && $LF_STATE->{"has_edits"} == 1) {
        $DIRTY = 1;
    }
    set_msg("Redo.");
}

# ===========================================================================
# Hex Mode
# ===========================================================================

func hex_nibble_char(int $n) str {
    if ($n == 0) { return "0"; }
    if ($n == 1) { return "1"; }
    if ($n == 2) { return "2"; }
    if ($n == 3) { return "3"; }
    if ($n == 4) { return "4"; }
    if ($n == 5) { return "5"; }
    if ($n == 6) { return "6"; }
    if ($n == 7) { return "7"; }
    if ($n == 8) { return "8"; }
    if ($n == 9) { return "9"; }
    if ($n == 10) { return "a"; }
    if ($n == 11) { return "b"; }
    if ($n == 12) { return "c"; }
    if ($n == 13) { return "d"; }
    if ($n == 14) { return "e"; }
    if ($n == 15) { return "f"; }
    return "0";
}

func hex_byte_str(int $b) str {
    my int $hi = ($b - ($b % 16)) / 16;
    my int $lo = $b % 16;
    return hex_nibble_char($hi) . hex_nibble_char($lo);
}

func hex_offset_str(int $val) str {
    # 8-digit hex offset
    my str $out = "";
    my int $i = 0;
    while ($i < 8) {
        my int $nibble = $val % 16;
        $out = hex_nibble_char($nibble) . $out;
        $val = ($val - $nibble) / 16;
        $i = $i + 1;
    }
    return $out;
}

func hex_format_line(str $data, int $offset, int $total) str {
    my str $line = hex_offset_str($offset) . "  ";
    my str $ascii = "|";
    my int $i = 0;
    while ($i < 16) {
        my int $pos = $offset + $i;
        if ($i == 8) {
            $line = $line . " ";
        }
        if ($pos < $total) {
            my int $b = core::get_byte($data, $pos);
            $line = $line . hex_byte_str($b) . " ";
            if ($b >= 32 && $b <= 126) {
                $ascii = $ascii . chr($b);
            } else {
                $ascii = $ascii . ".";
            }
        } else {
            $line = $line . "   ";
            $ascii = $ascii . " ";
        }
        $i = $i + 1;
    }
    $ascii = $ascii . "|";
    return $line . " " . $ascii;
}

func hex_rebuild_lines() void {
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my str $data = $buf->{"hex_data"};
    if (!defined($data)) { $data = ""; }
    my int $total = core::byte_length($data);
    my scalar $lines = [];
    my int $off = 0;
    while ($off < $total) {
        push(@$lines, hex_format_line($data, $off, $total));
        $off = $off + 16;
    }
    if (scalar(@$lines) == 0) {
        push(@$lines, hex_format_line("", 0, 0));
    }
    $buf->{"lines"} = $lines;
    $CL = $lines;
}

func hex_data_len() int {
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my str $data = $buf->{"hex_data"};
    if (!defined($data)) { return 0; }
    return core::byte_length($data);
}

func hex_pos_to_cursor() void {
    my int $total = hex_data_len();
    if ($HEX_BYTE_POS < 0) { $HEX_BYTE_POS = 0; }
    if ($total > 0 && $HEX_BYTE_POS >= $total) { $HEX_BYTE_POS = $total - 1; }
    if ($total == 0) { $HEX_BYTE_POS = 0; }
    my int $row = ($HEX_BYTE_POS - ($HEX_BYTE_POS % 16)) / 16;
    my int $col_in_row = $HEX_BYTE_POS % 16;
    $CY = $row;
    if ($HEX_IN_ASCII == 1) {
        # ASCII area: offset(8) + 2 + hex_area(49) + 1 + pipe(1) = 61, then col_in_row
        $CX = 61 + $col_in_row;
    } else {
        # Hex area: offset(8) + 2 = 10, each byte is 3 chars, extra space after byte 7
        my int $extra = 0;
        if ($col_in_row >= 8) { $extra = 1; }
        $CX = 10 + $col_in_row * 3 + $extra + $HEX_NIBBLE;
    }
}

func hex_enter_mode() void {
    if ($HEX_MODE == 1) { return; }
    if ($LARGE_MODE == 1) {
        set_msg("Hex mode is not available in Large File Mode (use M-x large-goto-offset).");
        return;
    }
    $HEX_PREV_MODE = $MODE;
    $HEX_PREV_SYNTAX = $SYNTAX;

    # Always use the in-memory buffer. Re-reading $FNAME here used to discard
    # unsaved text edits when entering hex mode.
    my str $data = buffer_text();

    my scalar $buf = $BUFFERS->[$BUF_IDX];
    $buf->{"hex_data"} = $data;
    # Hex undo entries are byte deltas and intentionally start a fresh stack.
    $UNDO = [];
    $REDO = [];
    $buf->{"undo"} = $UNDO;
    $buf->{"redo"} = $REDO;

    $HEX_MODE = 1;
    $HEX_BYTE_POS = 0;
    $HEX_IN_ASCII = 0;
    $HEX_NIBBLE = 0;
    $MSET = 0;
    $SHIFT_MARK = 0;
    $MODE = "Hex";
    $SYNTAX = "";
    $SX = 0;
    $SY = 0;

    hex_rebuild_lines();
    hex_pos_to_cursor();
    buf_save_state();
    set_msg("Hex mode. TAB toggles hex/ascii. M-x hex-mode to leave.");
}

func hex_leave_mode() void {
    if ($HEX_MODE == 0) { return; }
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my str $data = $buf->{"hex_data"};
    if (!defined($data)) { $data = ""; }

    my scalar $parsed = Smacs::File::parse_text($data);
    my scalar $lines = $parsed->{"lines"};

    # Clear byte-level hex undo/redo snapshots so text-mode undo cannot pop incompatible entries
    $UNDO = [];
    $REDO = [];
    $buf->{"undo"} = $UNDO;
    $buf->{"redo"} = $REDO;
    $buf->{"lines"} = $lines;
    $buf->{"hex_data"} = undef;
    $buf->{"generation"} = $buf->{"generation"} + 1;
    $buf->{"highlight_cache"} = {};
    $buf->{"which_cache_key"} = "";
    $CL = $lines;
    $LINES_SHARED = 0;
    $FILE_EOL = $parsed->{"eol"};
    $FILE_FINAL_NL = $parsed->{"final_newline"};
    $buf->{"eol"} = $FILE_EOL;
    $buf->{"final_newline"} = $FILE_FINAL_NL;

    $HEX_MODE = 0;
    $MODE = $HEX_PREV_MODE;
    $SYNTAX = $HEX_PREV_SYNTAX;
    if (length($MODE) == 0) { $MODE = "Text"; }
    $CY = 0;
    $CX = 0;
    $SY = 0;
    $SX = 0;
    $GOAL_COL = -1;
    buf_save_state();
    set_msg("Left hex mode.");
}

func hex_set_byte(int $pos, int $byte_val) void {
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my str $data = $buf->{"hex_data"};
    if (!defined($data)) { return; }
    my int $total = core::byte_length($data);
    if ($pos < 0 || $pos >= $total) { return; }
    my str $before = "";
    if ($pos > 0) {
        $before = substr($data, 0, $pos);
    }
    my str $after = "";
    if ($pos + 1 < $total) {
        $after = substr($data, $pos + 1);
    }
    $buf->{"hex_data"} = $before . core::pack("C", $byte_val) . $after;
}

func hex_char_to_nibble(str $ch) int {
    if ($ch eq "0") { return 0; }
    if ($ch eq "1") { return 1; }
    if ($ch eq "2") { return 2; }
    if ($ch eq "3") { return 3; }
    if ($ch eq "4") { return 4; }
    if ($ch eq "5") { return 5; }
    if ($ch eq "6") { return 6; }
    if ($ch eq "7") { return 7; }
    if ($ch eq "8") { return 8; }
    if ($ch eq "9") { return 9; }
    if ($ch eq "a" || $ch eq "A") { return 10; }
    if ($ch eq "b" || $ch eq "B") { return 11; }
    if ($ch eq "c" || $ch eq "C") { return 12; }
    if ($ch eq "d" || $ch eq "D") { return 13; }
    if ($ch eq "e" || $ch eq "E") { return 14; }
    if ($ch eq "f" || $ch eq "F") { return 15; }
    return -1;
}

func hex_is_hex_char(str $ch) int {
    if (hex_char_to_nibble($ch) >= 0) { return 1; }
    return 0;
}

func hex_undo_save() void {
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my str $data = $buf->{"hex_data"};
    if (!defined($data) || $HEX_BYTE_POS >= core::byte_length($data)) { return; }
    my scalar $snap = {};
    $snap->{"hex_byte_pos"} = $HEX_BYTE_POS;
    $snap->{"hex_nibble"} = $HEX_NIBBLE;
    $snap->{"old_byte"} = core::get_byte($data, $HEX_BYTE_POS);
    $snap->{"dirty"} = $DIRTY;
    push(@$UNDO, $snap);
    while (scalar(@$UNDO) > $UNDO_MAX) {
        shift(@$UNDO);
    }
    $REDO = [];
}

func hex_undo_restore() void {
    if (scalar(@$UNDO) == 0) {
        set_msg("No further undo information.");
        return;
    }
    my scalar $snap = pop(@$UNDO);
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my str $data = $buf->{"hex_data"};
    my int $pos = $snap->{"hex_byte_pos"};
    if (defined($data) && $pos < core::byte_length($data)) {
        my scalar $rsnap = {};
        $rsnap->{"hex_byte_pos"} = $pos;
        $rsnap->{"hex_nibble"} = $HEX_NIBBLE;
        $rsnap->{"old_byte"} = core::get_byte($data, $pos);
        $rsnap->{"dirty"} = $DIRTY;
        push(@$REDO, $rsnap);
    }
    hex_set_byte($pos, $snap->{"old_byte"});
    $HEX_BYTE_POS = $pos;
    $HEX_NIBBLE = $snap->{"hex_nibble"};
    hex_rebuild_lines();
    hex_pos_to_cursor();
    $DIRTY = $snap->{"dirty"} // 1;
    set_msg("Undo.");
}

func hex_redo_restore() void {
    if (scalar(@$REDO) == 0) {
        set_msg("No further redo information.");
        return;
    }
    my scalar $snap = pop(@$REDO);
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my str $data = $buf->{"hex_data"};
    my int $pos = $snap->{"hex_byte_pos"};
    if (defined($data) && $pos < core::byte_length($data)) {
        my scalar $usnap = {};
        $usnap->{"hex_byte_pos"} = $pos;
        $usnap->{"hex_nibble"} = $HEX_NIBBLE;
        $usnap->{"old_byte"} = core::get_byte($data, $pos);
        $usnap->{"dirty"} = $DIRTY;
        push(@$UNDO, $usnap);
    }
    hex_set_byte($pos, $snap->{"old_byte"});
    $HEX_BYTE_POS = $pos;
    $HEX_NIBBLE = $snap->{"hex_nibble"};
    hex_rebuild_lines();
    hex_pos_to_cursor();
    $DIRTY = $snap->{"dirty"} // 1;
    set_msg("Redo.");
}

func hex_edit_hex(str $ch) void {
    my int $nib = hex_char_to_nibble($ch);
    if ($nib < 0) { return; }
    my int $total = hex_data_len();
    if ($total == 0) { return; }
    hex_undo_save();

    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my str $data = $buf->{"hex_data"};
    my int $cur_byte = core::get_byte($data, $HEX_BYTE_POS);
    my int $new_byte = 0;
    if ($HEX_NIBBLE == 0) {
        # Replace high nibble
        $new_byte = $nib * 16 + ($cur_byte % 16);
        hex_set_byte($HEX_BYTE_POS, $new_byte);
        $HEX_NIBBLE = 1;
    } else {
        # Replace low nibble
        $new_byte = ($cur_byte - ($cur_byte % 16)) + $nib;
        hex_set_byte($HEX_BYTE_POS, $new_byte);
        $HEX_NIBBLE = 0;
        # Advance to next byte
        if ($HEX_BYTE_POS < $total - 1) {
            $HEX_BYTE_POS = $HEX_BYTE_POS + 1;
        }
    }
    hex_rebuild_lines();
    hex_pos_to_cursor();
    $DIRTY = 1;
}

func hex_edit_ascii(str $ch) void {
    my int $total = hex_data_len();
    if ($total == 0) { return; }
    hex_undo_save();
    my int $byte_val = ord($ch);
    hex_set_byte($HEX_BYTE_POS, $byte_val);
    if ($HEX_BYTE_POS < $total - 1) {
        $HEX_BYTE_POS = $HEX_BYTE_POS + 1;
    }
    hex_rebuild_lines();
    hex_pos_to_cursor();
    $DIRTY = 1;
}

func hex_move_up() void {
    if ($HEX_BYTE_POS >= 16) {
        $HEX_BYTE_POS = $HEX_BYTE_POS - 16;
    }
    $HEX_NIBBLE = 0;
    hex_pos_to_cursor();
}

func hex_move_down() void {
    my int $total = hex_data_len();
    if ($HEX_BYTE_POS + 16 < $total) {
        $HEX_BYTE_POS = $HEX_BYTE_POS + 16;
    }
    $HEX_NIBBLE = 0;
    hex_pos_to_cursor();
}

func hex_move_left() void {
    if ($HEX_IN_ASCII == 0) {
        if ($HEX_NIBBLE == 1) {
            $HEX_NIBBLE = 0;
        } elsif ($HEX_BYTE_POS > 0) {
            $HEX_BYTE_POS = $HEX_BYTE_POS - 1;
            $HEX_NIBBLE = 1;
        }
    } else {
        if ($HEX_BYTE_POS > 0) {
            $HEX_BYTE_POS = $HEX_BYTE_POS - 1;
        }
    }
    hex_pos_to_cursor();
}

func hex_move_right() void {
    my int $total = hex_data_len();
    if ($HEX_IN_ASCII == 0) {
        if ($HEX_NIBBLE == 0) {
            $HEX_NIBBLE = 1;
        } elsif ($HEX_BYTE_POS < $total - 1) {
            $HEX_BYTE_POS = $HEX_BYTE_POS + 1;
            $HEX_NIBBLE = 0;
        }
    } else {
        if ($HEX_BYTE_POS < $total - 1) {
            $HEX_BYTE_POS = $HEX_BYTE_POS + 1;
        }
    }
    hex_pos_to_cursor();
}

func hex_move_bol() void {
    $HEX_BYTE_POS = $HEX_BYTE_POS - ($HEX_BYTE_POS % 16);
    $HEX_NIBBLE = 0;
    hex_pos_to_cursor();
}

func hex_move_eol() void {
    my int $total = hex_data_len();
    my int $row_start = $HEX_BYTE_POS - ($HEX_BYTE_POS % 16);
    my int $row_end = $row_start + 15;
    if ($row_end >= $total) { $row_end = $total - 1; }
    $HEX_BYTE_POS = $row_end;
    $HEX_NIBBLE = 0;
    hex_pos_to_cursor();
}

func hex_page_down() void {
    my int $total = hex_data_len();
    my int $page = win_edit_rows() * 16;
    $HEX_BYTE_POS = $HEX_BYTE_POS + $page;
    if ($HEX_BYTE_POS >= $total) {
        $HEX_BYTE_POS = $total - 1;
        if ($HEX_BYTE_POS < 0) { $HEX_BYTE_POS = 0; }
    }
    $HEX_NIBBLE = 0;
    hex_pos_to_cursor();
}

func hex_page_up() void {
    my int $page = win_edit_rows() * 16;
    $HEX_BYTE_POS = $HEX_BYTE_POS - $page;
    if ($HEX_BYTE_POS < 0) { $HEX_BYTE_POS = 0; }
    $HEX_NIBBLE = 0;
    hex_pos_to_cursor();
}

func hex_toggle_area() void {
    if ($HEX_IN_ASCII == 0) {
        $HEX_IN_ASCII = 1;
    } else {
        $HEX_IN_ASCII = 0;
    }
    $HEX_NIBBLE = 0;
    hex_pos_to_cursor();
}

func hex_file_save() void {
    my str $target_path = $FNAME;
    my int $was_unnamed = 0;
    if (length($target_path) == 0) {
        my str $path = mb_read_file("Save as: ");
        if ($MB_CANCELLED == 1 || length($path) == 0) {
            set_msg("Save cancelled.");
            return;
        }
        $target_path = expand_tilde($path);
        $was_unnamed = 1;
    }
    if (is_directory($target_path) == 1) {
        set_msg("Cannot overwrite directory: " . $target_path);
        return;
    }
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my str $data = $buf->{"hex_data"};
    if (!defined($data)) { $data = ""; }
    if ($was_unnamed == 1) {
        if (file_exists($target_path) == 1) {
            my int $yn2 = mb_read_yn("File exists; overwrite " . $target_path . "?");
            if ($yn2 != 1) { set_msg("Save cancelled."); return; }
        }
    } elsif (file_changed_on_disk() == 1) {
        my int $yn = mb_read_yn("File changed on disk; overwrite?");
        if ($yn != 1) { set_msg("Save cancelled."); return; }
    }
    my str $err = Smacs::File::atomic_write($target_path, $data);
    if (length($err) > 0) { set_msg($err); return; }
    $FNAME = $target_path;
    if ($was_unnamed == 1) {
        $BNAME = uniquify_buffer_name($BUF_IDX, $FNAME);
    }
    $DIRTY = 0;
    mark_undo_history_dirty();
    refresh_disk_fingerprint();
    buf_save_state();
    my int $total = core::byte_length($data);
    set_msg("Wrote " . $total . " bytes to " . $FNAME);
}

func hex_goto_offset() void {
    my str $input = mb_read("Goto byte offset (hex): ");
    if ($MB_CANCELLED == 1 || length($input) == 0) { return; }
    my int $val = 0;
    my int $i = 0;
    # Skip optional 0x prefix
    if (length($input) > 2 && (substr($input, 0, 2) eq "0x" || substr($input, 0, 2) eq "0X")) {
        $i = 2;
    }
    while ($i < length($input)) {
        my str $ch = substr($input, $i, 1);
        my int $nib = hex_char_to_nibble($ch);
        if ($nib < 0) {
            set_msg("Invalid hex offset.");
            return;
        }
        $val = $val * 16 + $nib;
        $i = $i + 1;
    }
    my int $total = hex_data_len();
    if ($val >= $total) { $val = $total - 1; }
    if ($val < 0) { $val = 0; }
    $HEX_BYTE_POS = $val;
    $HEX_NIBBLE = 0;
    hex_pos_to_cursor();
    set_msg("Offset: 0x" . hex_offset_str($val));
}

func hex_handle_key(str $key) void {
    # Hex mode doesn't take pasted text
    if ($key eq "PASTE") {
        $PASTE_BUF = "";
        set_msg("Paste ignored in hex mode.");
        return;
    }

    # ESC as Meta prefix
    if ($key eq "ESC") {
        set_msg("ESC-");
        render();
        my str $next = wait_key();
        if ($next eq "ESC" || $next eq "C-g") {
            set_msg("Quit");
            return;
        }
        if (length($next) == 1) {
            hex_handle_key("M-" . $next);
        } elsif ($next eq "TAB") {
            hex_handle_key("M-TAB");
        } elsif ($next eq "BACKSPACE") {
            hex_handle_key("M-BACKSPACE");
        } else {
            hex_handle_key($next);
        }
        return;
    }

    # C-x prefix
    if ($key eq "C-x") {
        set_msg("C-x-");
        render();
        my str $next = wait_key();
        if ($next eq "C-s") {
            hex_file_save();
        } elsif ($next eq "C-w") {
            cmd_write_file();
        } elsif ($next eq "C-f") {
            cmd_find_file();
        } elsif ($next eq "b") {
            cmd_switch_buffer();
        } elsif ($next eq "k") {
            cmd_kill_buffer();
        } elsif ($next eq "C-b") {
            cmd_list_buffers();
        } elsif ($next eq "RIGHT") {
            buf_cycle(1);
        } elsif ($next eq "LEFT") {
            buf_cycle(-1);
        } elsif ($next eq "u") {
            hex_undo_restore();
        } elsif ($next eq "C-c") {
            if (any_buffer_dirty() == 1) {
                my int $yn = mb_read_yn("Modified buffers exist; exit anyway?");
                if ($yn != 1) { set_msg("Cancelled."); return; }
            }
            $RUNNING = 0;
        } elsif ($next eq "o") {
            win_other();
        } elsif ($next eq "2") {
            win_split();
        } elsif ($next eq "3") {
            win_split_vertical();
        } elsif ($next eq "1") {
            win_delete_others();
        } elsif ($next eq "0") {
            win_delete_current();
        } else {
            set_msg("C-x " . $next . " is undefined in hex mode.");
        }
        return;
    }

    # Navigation
    if ($key eq "C-f" || $key eq "RIGHT") { hex_move_right(); return; }
    if ($key eq "C-b" || $key eq "LEFT") { hex_move_left(); return; }
    if ($key eq "C-n" || $key eq "DOWN") { hex_move_down(); return; }
    if ($key eq "C-p" || $key eq "UP") { hex_move_up(); return; }
    if ($key eq "C-a" || $key eq "HOME") { hex_move_bol(); return; }
    if ($key eq "C-e" || $key eq "END") { hex_move_eol(); return; }
    if ($key eq "C-v" || $key eq "PGDN") { hex_page_down(); return; }
    if ($key eq "M-v" || $key eq "PGUP") { hex_page_up(); return; }
    if ($key eq "M-<") { $HEX_BYTE_POS = 0; $HEX_NIBBLE = 0; hex_pos_to_cursor(); return; }
    if ($key eq "M->") {
        my int $t = hex_data_len();
        if ($t > 0) { $HEX_BYTE_POS = $t - 1; }
        $HEX_NIBBLE = 0;
        hex_pos_to_cursor();
        return;
    }

    # Toggle hex/ascii
    if ($key eq "TAB") { hex_toggle_area(); return; }

    # Undo / Redo
    if ($key eq "C-_") { hex_undo_restore(); return; }
    if ($key eq "M-/") { hex_redo_restore(); return; }

    # Cancel / Suspend / Help
    if ($key eq "C-g") { set_msg("Quit"); return; }
    if ($key eq "C-z") { suspend(); return; }
    if ($key eq "C-l") { recenter(); return; }
    if ($key eq "C-h") { handle_help_prefix(); return; }

    # M-x for commands (including leaving hex mode)
    if ($key eq "M-x") { cmd_mx(); return; }

    # M-g for goto offset
    if ($key eq "M-g") { hex_goto_offset(); return; }

    # C-o for other window
    if ($key eq "C-o") {
        if ($WIN_COUNT > 1) { win_other(); }
        return;
    }

    # Editing: single printable characters
    if (length($key) == 1) {
        my int $code = ord($key);
        if ($HEX_IN_ASCII == 0) {
            if (hex_is_hex_char($key) == 1) {
                hex_edit_hex($key);
            }
        } else {
            if ($code >= 32 && $code <= 126) {
                hex_edit_ascii($key);
            }
        }
        return;
    }
}

# ===========================================================================
# Directory Listing and Path Helpers
# ===========================================================================

func list_dir(str $path) array {
    my array @entries = ();
    my scalar $dh = core::opendir($path);
    if (!defined($dh)) { return @entries; }
    my str $name = core::readdir_next($dh);
    while (defined($name)) {
        my str $full = $path . "/" . $name;
        if (core::is_dir($full) == 1) {
            push(@entries, $name . "/");
        } else {
            push(@entries, $name);
        }
        $name = core::readdir_next($dh);
    }
    core::closedir($dh);
    return @entries;
}

func is_directory(str $path) int {
    return core::is_dir($path);
}

func file_exists(str $path) int {
    return core::file_exists($path);
}

func path_dirname(str $path) str {
    my int $last_slash = -1;
    my int $i = 0;
    while ($i < length($path)) {
        if (substr($path, $i, 1) eq "/") {
            $last_slash = $i;
        }
        $i = $i + 1;
    }
    if ($last_slash == -1) { return "."; }
    if ($last_slash == 0) { return "/"; }
    return substr($path, 0, $last_slash);
}

func path_basename(str $path) str {
    my int $last_slash = -1;
    my int $i = 0;
    while ($i < length($path)) {
        if (substr($path, $i, 1) eq "/") {
            $last_slash = $i;
        }
        $i = $i + 1;
    }
    if ($last_slash == -1) { return $path; }
    return substr($path, $last_slash + 1);
}

func exe_dir() str {
    my str $program = $0;
    my str $real = core::realpath($program);
    if (length($real) == 0) { return ""; }
    return path_dirname($real);
}

func runtime_prefix() str {
    my str $bindir = exe_dir();
    if (length($bindir) == 0) { return ""; }
    if (path_basename($bindir) ne "bin") { return ""; }
    return path_dirname($bindir);
}

# Find common prefix among an array of strings
func common_prefix(array @strs) str {
    if (scalar(@strs) == 0) { return ""; }
    my str $prefix = $strs[0];
    my int $i = 1;
    while ($i < scalar(@strs)) {
        my str $s = $strs[$i];
        my int $j = 0;
        my int $max = length($prefix);
        if (length($s) < $max) { $max = length($s); }
        while ($j < $max && substr($prefix, $j, 1) eq substr($s, $j, 1)) {
            $j = $j + 1;
        }
        $prefix = substr($prefix, 0, $j);
        $i = $i + 1;
    }
    return $prefix;
}

# Get file completions for a partial path, reusing $cache hash for the scanned directory
func complete_file_cached(str $input, scalar $cache) array {
    my array @matches = ();
    if (length($input) == 0) {
        $input = "./";
    }

    my str $dir = "";
    my str $prefix = "";

    if ($input eq "~") {
        $dir = "~/";
        $prefix = "";
    } elsif (substr($input, length($input) - 1, 1) eq "/") {
        $dir = $input;
        $prefix = "";
    } else {
        $dir = path_dirname($input);
        $prefix = path_basename($input);
        if (substr($dir, length($dir) - 1) ne "/") {
            $dir = $dir . "/";
        }
    }

    my str $fs_dir = expand_tilde($dir);
    my scalar $sorted_ref = undef;
    if (defined($cache) && ($cache->{"dir"} // "") eq $fs_dir && defined($cache->{"entries"})) {
        $sorted_ref = $cache->{"entries"};
    } else {
        my array @entries = list_dir($fs_dir);
        my array @sorted = sort { $a cmp $b; } @entries;
        $sorted_ref = \@sorted;
        if (defined($cache)) {
            $cache->{"dir"} = $fs_dir;
            $cache->{"entries"} = $sorted_ref;
        }
    }

    my int $i = 0;
    my int $plen = length($prefix);
    while ($i < scalar(@$sorted_ref)) {
        my str $entry = $sorted_ref->[$i];
        if ($plen == 0 || (length($entry) >= $plen && substr($entry, 0, $plen) eq $prefix)) {
            push(@matches, $dir . $entry);
        }
        $i = $i + 1;
    }
    return @matches;
}

# Get file completions for a partial path
func complete_file(str $input) array {
    return complete_file_cached($input, undef);
}

# Get buffer name completions
func complete_buffer(str $input) array {
    my array @matches = ();
    my int $i = 0;
    while ($i < scalar(@$BUFFERS)) {
        my scalar $b = $BUFFERS->[$i];
        my str $name = $b->{"name"};
        if (length($input) == 0 || substr($name, 0, length($input)) eq $input) {
            push(@matches, $name);
        }
        $i = $i + 1;
    }
    return @matches;
}

# Get M-x command completions
func complete_mx(str $input) array {
    my array @cmds = Smacs::Commands::mx_commands();
    my array @sorted = sort { $a cmp $b; } @cmds;
    my array @matches = ();
    my int $i = 0;
    while ($i < scalar(@sorted)) {
        my str $cmd = $sorted[$i];
        if (length($input) == 0 || substr($cmd, 0, length($input)) eq $input) {
            push(@matches, $cmd);
        }
        $i = $i + 1;
    }
    return @matches;
}

# ===========================================================================
# Minibuffer History
# ===========================================================================

func hist_add(str $cat, str $val) void {
    if (length($val) == 0) { return; }
    if (!defined($HISTORY->{$cat})) {
        $HISTORY->{$cat} = [];
    }
    my scalar $list = $HISTORY->{$cat};
    # Don't add duplicates of the most recent entry
    my int $n = scalar(@$list);
    if ($n > 0 && $list->[$n - 1] eq $val) { return; }
    push(@$list, $val);
    # Trim to max
    while (scalar(@$list) > $HIST_MAX) {
        splice(@$list, 0, 1);
    }
}

func hist_get(str $cat) scalar {
    if (!defined($HISTORY->{$cat})) {
        return [];
    }
    return $HISTORY->{$cat};
}

# ===========================================================================
# Minibuffer Input
# ===========================================================================

func mb_render_line(str $prompt, str $input, int $pos, str $notice) str {
    my str $p_safe = terminal_safe($prompt);
    my int $pw = u8_str_width($p_safe);
    my str $n_safe = "";
    my int $nw = 0;
    if (length($notice) > 0) {
        $n_safe = " " . terminal_safe($notice);
        $nw = u8_str_width($n_safe);
    }
    my int $avail = $COLS - $pw - $nw - 1;
    if ($avail < 4) {
        $n_safe = "";
        $nw = 0;
        $avail = $COLS - $pw - 1;
        if ($avail < 4) { $avail = 4; }
    }
    my str $full_disp = terminal_safe($input);
    my int $full_w = u8_str_width($full_disp);
    my int $cur_off = u8_str_width(substr($input, 0, $pos));
    my str $disp = $full_disp;
    my int $cursor_col = $pw + $cur_off + 1;

    if ($full_w > $avail && $avail > 4) {
        my int $win_start = 0;
        if ($cur_off >= $avail - 3) {
            $win_start = $cur_off - ($avail - 4);
            if ($win_start < 0) { $win_start = 0; }
        }
        if ($win_start > 0) {
            $disp = "..." . u8_truncate(u8_skip_cols($full_disp, $win_start + 3), $avail - 3);
            $cursor_col = $pw + 3 + ($cur_off - ($win_start + 3)) + 1;
        } else {
            $disp = u8_truncate($full_disp, $avail - 3) . "...";
            $cursor_col = $pw + $cur_off + 1;
        }
    }

    if ($cursor_col < 1) { $cursor_col = 1; }
    if ($cursor_col > $COLS) { $cursor_col = $COLS; }

    my str $out = $E . "[" . $ROWS . ";1H" . $E . "[K";
    $out = $out . $p_safe . $disp;
    if ($nw > 0) {
        $out = $out . $E . "[90m" . $n_safe . $E . "[0m";
    }
    $out = $out . $E . "[" . $ROWS . ";" . $cursor_col . "H" . $E . "[?25h";
    return $out;
}

# Minibuffer with tab-completion and history
# $mode: "file", "buffer", "mx", or "" (no completion)
# $hist_cat: history category name, or "" for no history
func mb_read_complete_hist(str $prompt, str $mode, str $hist_cat) str {
    $MB_CANCELLED = 0;
    my str $input = "";
    my int $pos = 0;
    my int $show_completions = 0;
    my int $comp_scroll = 0;
    my str $saved_input = "";  # what user typed before browsing history
    my int $hist_idx = -1;     # -1 = not browsing, 0..n = index from end
    my scalar $hist_list = hist_get($hist_cat);
    my int $hist_len = scalar(@$hist_list);
    my str $notice = "";
    my int $need_redraw = 1;
    my array @comp_list = ();

    while (1) {
        if ($EXIT_SIGNAL == 1) {
            $RUNNING = 0;
            $MB_CANCELLED = 1;
            return "";
        }
        if (check_winch() == 1) {
            update_size();
            $need_redraw = 1;
        }

        if ($need_redraw == 1) {
            $need_redraw = 0;
            @comp_list = ();
            if (length($mode) > 0) {
                if ($mode eq "file") {
                    @comp_list = complete_file($input);
                } elsif ($mode eq "buffer") {
                    @comp_list = complete_buffer($input);
                } elsif ($mode eq "mx") {
                    @comp_list = complete_mx($input);
                }
            }

            my int $panel_rows = 0;
            if ($show_completions == 1 && scalar(@comp_list) > 0) {
                $panel_rows = $ROWS - 3;
                if ($panel_rows > scalar(@comp_list) + 1) {
                    $panel_rows = scalar(@comp_list) + 1;
                }
                if ($panel_rows < 3) { $panel_rows = 3; }
            }

            render();

            my str $out = $E . "[?25l";

            if ($panel_rows > 0) {
                my int $max_w = 0;
                my int $ei = 0;
                while ($ei < scalar(@comp_list)) {
                    my int $elen = u8_str_width(terminal_safe($comp_list[$ei]));
                    if ($elen > $max_w) { $max_w = $elen; }
                    $ei = $ei + 1;
                }
                $max_w = $max_w + 2;
                if ($max_w < 12) { $max_w = 12; }
                if ($max_w > $COLS) { $max_w = $COLS; }
                my int $num_cols = $COLS / $max_w;
                if ($num_cols < 1) { $num_cols = 1; }

                my int $start_row = $ROWS - 1 - $panel_rows;
                if ($start_row < 1) { $start_row = 1; }
                $out = $out . $E . "[" . $start_row . ";1H" . $E . "[K" . $E . "[7m";
                my str $hdr = u8_truncate(" Completions", $COLS);
                my int $hpad = $COLS - u8_str_width($hdr);
                if ($hpad < 0) { $hpad = 0; }
                $out = $out . $hdr . (" " x $hpad) . $E . "[0m";

                my int $data_rows = $panel_rows - 1;
                my int $total = scalar(@comp_list);
                my int $visible = $data_rows * $num_cols;
                if ($comp_scroll > $total - $visible) {
                    $comp_scroll = $total - $visible;
                }
                if ($comp_scroll < 0) { $comp_scroll = 0; }

                my int $ri = 0;
                while ($ri < $data_rows) {
                    my int $screen_row = $start_row + 1 + $ri;
                    $out = $out . $E . "[" . $screen_row . ";1H" . $E . "[K";
                    my int $ci = 0;
                    while ($ci < $num_cols) {
                        my int $idx = $comp_scroll + $ri + $ci * $data_rows;
                        if ($idx < $total) {
                            my str $entry = u8_truncate(terminal_safe($comp_list[$idx]), $max_w - 1);
                            my int $ew = u8_str_width($entry);
                            my int $pad = $max_w - $ew;
                            if ($pad < 0) { $pad = 0; }
                            $out = $out . $entry . (" " x $pad);
                        }
                        $ci = $ci + 1;
                    }
                    $ri = $ri + 1;
                }
            }

            $out = $out . mb_render_line($prompt, $input, $pos, $notice);
            core::write_fd(1, $out);
        }

        my str $key = read_key();
        if (length($key) == 0) { next; }
        $notice = "";
        $need_redraw = 1;

        if ($key eq "RET") {
            if (($mode eq "mx" || $show_completions == 1) && scalar(@comp_list) == 1) {
                $input = $comp_list[0];
            }
            if ($show_completions == 1) { render(); }
            if (length($hist_cat) > 0 && length($input) > 0) {
                hist_add($hist_cat, $input);
            }
            return $input;
        }
        if ($key eq "C-g" || $key eq "ESC") {
            $MB_CANCELLED = 1;
            if ($show_completions == 1) { render(); }
            set_msg("Cancelled.");
            return "";
        }
        # History navigation
        if (($key eq "UP" || $key eq "C-p") && $show_completions == 0 && length($hist_cat) > 0 && $hist_len > 0) {
            if ($hist_idx == -1) {
                $saved_input = $input;
                $hist_idx = 0;
            } else {
                if ($hist_idx < $hist_len - 1) { $hist_idx = $hist_idx + 1; }
            }
            $input = $hist_list->[$hist_len - 1 - $hist_idx];
            $pos = length($input);
            next;
        }
        if (($key eq "UP" || $key eq "C-p") && $show_completions == 1) {
            if ($comp_scroll > 0) { $comp_scroll = $comp_scroll - 1; }
            next;
        }
        if (($key eq "DOWN" || $key eq "C-n") && $show_completions == 1) {
            $comp_scroll = $comp_scroll + 1;
            next;
        }
        if (($key eq "DOWN" || $key eq "C-n") && $hist_idx >= 0) {
            $hist_idx = $hist_idx - 1;
            if ($hist_idx < 0) {
                $hist_idx = -1;
                $input = $saved_input;
            } else {
                $input = $hist_list->[$hist_len - 1 - $hist_idx];
            }
            $pos = length($input);
            next;
        }
        if ($key eq "TAB" && length($mode) > 0) {
            if (scalar(@comp_list) == 0) {
                $notice = "[No match]";
            } elsif (scalar(@comp_list) == 1) {
                $input = $comp_list[0];
                $pos = length($input);
                $show_completions = 0;
            } else {
                my str $cp = common_prefix(@comp_list);
                if (length($cp) > length($input)) {
                    $input = $cp;
                    $pos = length($input);
                }
                $show_completions = 1;
                $comp_scroll = 0;
            }
            next;
        }
        # Hide panel on non-navigation keys
        if ($show_completions == 1 && $key ne "TAB" && $key ne "UP" && $key ne "DOWN" && $key ne "C-p" && $key ne "C-n") {
            $show_completions = 0;
        }
        if ($key eq "BACKSPACE" || $key eq "C-h") {
            if ($pos > 0) {
                my int $pp = u8_prev($input, $pos);
                $input = substr($input, 0, $pp) . substr($input, $pos);
                $pos = $pp;
            }
            next;
        }
        if ($key eq "DEL" || $key eq "C-d") {
            if ($pos < length($input)) {
                my int $np = u8_next($input, $pos);
                $input = substr($input, 0, $pos) . substr($input, $np);
            }
            next;
        }
        if ($key eq "C-a" || $key eq "HOME") { $pos = 0; next; }
        if ($key eq "C-e" || $key eq "END") { $pos = length($input); next; }
        if ($key eq "LEFT" || $key eq "C-b") {
            if ($pos > 0) { $pos = u8_prev($input, $pos); }
            next;
        }
        if ($key eq "RIGHT" || $key eq "C-f") {
            if ($pos < length($input)) { $pos = u8_next($input, $pos); }
            next;
        }
        if ($key eq "C-k") { $input = substr($input, 0, $pos); next; }
        if ($key eq "C-u") { $input = substr($input, $pos); $pos = 0; next; }
        if ($key eq "PASTE") {
            my str $ptxt = $PASTE_BUF;
            $PASTE_BUF = "";
            my int $pnl = index($ptxt, "\n");
            if ($pnl >= 0) { $ptxt = substr($ptxt, 0, $pnl); }
            my int $pcr = index($ptxt, "\r");
            if ($pcr >= 0) { $ptxt = substr($ptxt, 0, $pcr); }
            if (length($ptxt) > 0) {
                my str $pb = "";
                if ($pos > 0) { $pb = substr($input, 0, $pos); }
                my str $pa = "";
                if ($pos < length($input)) { $pa = substr($input, $pos); }
                $input = $pb . $ptxt . $pa;
                $pos = $pos + length($ptxt);
            }
            next;
        }
        if ($key eq "M-BACKSPACE") {
            if ($pos > 0) {
                my int $end = $pos;
                while ($pos > 0 && is_word_char(substr($input, $pos - 1, 1)) == 0) {
                    $pos = $pos - 1;
                }
                while ($pos > 0 && is_word_char(substr($input, $pos - 1, 1)) == 1) {
                    $pos = $pos - 1;
                }
                my str $bef = "";
                if ($pos > 0) { $bef = substr($input, 0, $pos); }
                my str $aft = "";
                if ($end < length($input)) { $aft = substr($input, $end); }
                $input = $bef . $aft;
            }
            next;
        }
        # Insert printable character (ASCII or multi-byte UTF-8)
        my int $ins_ok = 0;
        if (length($key) == 1) {
            my int $code = ord($key);
            if ($code >= 32 && $code <= 126) { $ins_ok = 1; }
        } elsif (length($key) > 1) {
            if (core::get_byte($key, 0) >= 128) { $ins_ok = 1; }
        }
        if ($ins_ok == 1) {
            my str $before = "";
            if ($pos > 0) { $before = substr($input, 0, $pos); }
            my str $after = "";
            if ($pos < length($input)) { $after = substr($input, $pos); }
            $input = $before . $key . $after;
            $pos = $pos + length($key);
        }
    }
    return "";
}

func mb_read_with_complete(str $prompt, str $mode) str {
    return mb_read_complete_hist($prompt, $mode, $mode);
}

func mb_read(str $prompt) str {
    return mb_read_complete_hist($prompt, "", "general");
}

func mb_read_yn(str $prompt) int {
    my int $need_draw = 1;
    while (1) {
        if ($EXIT_SIGNAL == 1) {
            $RUNNING = 0;
            return -1;
        }
        if (check_winch() == 1) {
            update_size();
            render();
            $need_draw = 1;
        }
        if ($need_draw == 1) {
            $need_draw = 0;
            my str $out = $E . "[" . $ROWS . ";1H" . $E . "[K";
            $out = $out . u8_truncate(terminal_safe($prompt) . " (y/n) ", $COLS);
            core::write_fd(1, $out);
        }
        my str $key = read_key();
        if (length($key) == 0) { next; }
        if ($key eq "y" || $key eq "Y") { return 1; }
        if ($key eq "n" || $key eq "N") { return 0; }
        if ($key eq "C-g" || $key eq "ESC") { return -1; }
    }
    return 0;
}

# ===========================================================================
# Search
# ===========================================================================

func render_match_highlight(int $y, int $x, int $qlen) str {
    if ($qlen <= 0) { return ""; }
    my scalar $win = $WINDOWS->[$WIN_IDX];
    my int $win_top = $win->{"top_row"};
    my int $win_left = $win->{"left_col"};
    my int $win_width = $win->{"width"};
    my int $win_height = $win->{"height"};
    my int $gutter = linum_width();
    if ($gutter >= $win_width) { $gutter = 0; }
    my int $text_cols = $win_width - $gutter;
    if ($text_cols < 1) { $text_cols = 1; }

    my int $scr_y = $y - $SY + $win_top;
    if ($scr_y < $win_top || $scr_y >= $win_top + $win_height) {
        return "";
    }
    my str $out = "";
    my str $hl = $E . "[1;33;44m";
    my str $rst = $E . "[0m";
    my str $mline = get_line($y);
    my int $mlen = length($mline);
    my int $bp = 0;
    my int $mcl = 0;
    while ($bp < $x && $bp < $mlen) {
        $mcl = $mcl + char_width_at($mline, $bp, $mcl);
        if (core::get_byte($mline, $bp) == 9) { $bp = $bp + 1; }
        else { $bp = u8_next($mline, $bp); }
    }
    my int $mend = $x + $qlen;
    while ($bp < $mend && $bp < $mlen) {
        my int $w = char_width_at($mline, $bp, $mcl);
        my int $nx = 0;
        my str $mch = "";
        if (core::get_byte($mline, $bp) == 9) {
            $nx = $bp + 1;
            $mch = " " x $w;
        } else {
            $nx = u8_next($mline, $bp);
            $mch = terminal_safe(substr($mline, $bp, $nx - $bp));
        }
        my int $scol = $mcl - $SX;
        if ($scol >= 0 && $scol + $w <= $text_cols) {
            my int $mrow = $scr_y + 1;
            my int $mcol = $scol + 1 + $gutter + $win_left;
            $out = $out . $E . "[" . $mrow . ";" . $mcol . "H" . $hl . $mch . $rst;
        }
        $mcl = $mcl + $w;
        $bp = $nx;
    }
    return $out;
}

func cmd_isearch(int $init_dir) void {
    my str $query = "";
    my int $orig_cy = $CY;
    my int $orig_cx = $CX;
    my int $orig_sy = $SY;
    my int $orig_sx = $SX;
    my int $orig_voff = 0;
    if ($LARGE_MODE == 1 && defined($LF_STATE)) {
        $orig_voff = Smacs::LargeFile::cursor_virtual_offset($LF_STATE, $CL, $CY, $CX);
    }
    my int $dir = $init_dir;
    my int $status = 1;  # 1 = ok, 2 = wrapped, 0 = failing
    my int $need_redraw = 1;

    while (1) {
        if ($EXIT_SIGNAL == 1) {
            $RUNNING = 0;
            return;
        }
        if (check_winch() == 1) {
            update_size();
            $need_redraw = 1;
        }

        if ($need_redraw == 1) {
            $need_redraw = 0;
            $MSG = "";
            render();

            my str $out = "";
            if (length($query) > 0 && $status > 0) {
                my str $cur_l = get_line($CY);
                if ($CX + length($query) <= length($cur_l) && substr($cur_l, $CX, length($query)) eq $query) {
                    $out = $out . render_match_highlight($CY, $CX, length($query));
                }
            }

            my str $prefix = "";
            if ($status == 0 && length($query) > 0) {
                $prefix = "Failing ";
            } elsif ($status == 2 && length($query) > 0) {
                $prefix = "Wrapped ";
            }
            my str $prompt = $prefix . "I-search: ";
            if ($dir == -1) {
                $prompt = $prefix . "I-search backward: ";
            }
            $out = $out . mb_render_line($prompt, $query, length($query), "");
            core::write_fd(1, $out);
        }

        my str $key = read_key();
        if (length($key) == 0) {
            next;
        }
        $need_redraw = 1;

        if ($key eq "RET" || $key eq "ESC" || $key eq "UP" || $key eq "DOWN" || $key eq "C-n" || $key eq "C-p" || $key eq "LEFT" || $key eq "RIGHT" || $key eq "C-f" || $key eq "C-b") {
            if (length($query) > 0) {
                $LAST_SEARCH = $query;
            }
            set_msg("Search done.");
            return;
        }
        if ($key eq "C-g") {
            if ($LARGE_MODE == 1 && defined($LF_STATE)) {
                lf_jump_to_offset($orig_voff);
            }
            $CY = $orig_cy;
            $CX = $orig_cx;
            $SY = $orig_sy;
            $SX = $orig_sx;
            set_msg("Search cancelled.");
            return;
        }
        if ($key eq "C-s") {
            $dir = 1;
            if (length($query) == 0 && length($LAST_SEARCH) > 0) {
                $query = $LAST_SEARCH;
                $status = search_next($query, $dir, 0);
            } else {
                $status = search_next($query, $dir, 1);
            }
            next;
        }
        if ($key eq "C-r") {
            $dir = -1;
            if (length($query) == 0 && length($LAST_SEARCH) > 0) {
                $query = $LAST_SEARCH;
                $status = search_next($query, $dir, 0);
            } else {
                $status = search_next($query, $dir, 1);
            }
            next;
        }
        if ($key eq "BACKSPACE" || $key eq "C-h") {
            if (length($query) > 0) {
                $query = substr($query, 0, u8_prev($query, length($query)));
            }
            if ($LARGE_MODE == 1 && defined($LF_STATE)) {
                lf_jump_to_offset($orig_voff);
            }
            $CY = $orig_cy;
            $CX = $orig_cx;
            $SY = $orig_sy;
            $SX = $orig_sx;
            if (length($query) > 0) {
                $status = search_next($query, $dir, 0);
            } else {
                $status = 1;
            }
            next;
        }
        if ($key eq "PASTE") {
            my str $ptxt = $PASTE_BUF;
            $PASTE_BUF = "";
            my int $pnl = index($ptxt, "\n");
            if ($pnl >= 0) { $ptxt = substr($ptxt, 0, $pnl); }
            my int $pcr = index($ptxt, "\r");
            if ($pcr >= 0) { $ptxt = substr($ptxt, 0, $pcr); }
            if (length($ptxt) > 0) {
                my int $was_failing = ($status == 0 && length($query) > 0);
                $query = $query . $ptxt;
                if ($was_failing == 0) {
                    $status = search_next($query, $dir, 0);
                }
            }
            next;
        }
        # Printable chars (ASCII or multi-byte UTF-8)
        my int $append_ok = 0;
        if (length($key) == 1) {
            my int $code = ord($key);
            if ($code >= 32 && $code <= 126) { $append_ok = 1; }
        } elsif (length($key) > 1) {
            if (core::get_byte($key, 0) >= 128) { $append_ok = 1; }
        }
        if ($append_ok == 1) {
            my int $was_failing = ($status == 0 && length($query) > 0);
            $query = $query . $key;
            # Coalesce rapid/buffered printable characters in Large File Mode so fast typing
            # doesn't trigger redundant multi-GB disk scans on every intermediate character.
            if ($LARGE_MODE == 1) {
                while (stdin_has_pending() == 1) {
                    my str $nk = read_key();
                    if (length($nk) == 0) { last; }
                    my int $nk_print = 0;
                    if (length($nk) == 1 && ord($nk) >= 32 && ord($nk) <= 126) { $nk_print = 1; }
                    elsif (length($nk) > 1 && core::get_byte($nk, 0) >= 128) { $nk_print = 1; }
                    if ($nk_print == 1) {
                        $query = $query . $nk;
                    } else {
                        unshift(@$KEY_QUEUE, $nk);
                        last;
                    }
                }
            }
            if ($was_failing == 0) {
                $status = search_next($query, $dir, 0);
            }
        }
    }
}

# Returns 1 on direct match, 2 on wrapped match, 0 on not found.
func search_next(str $query, int $dir, int $advance) int {
    my int $qlen = length($query);
    if ($qlen == 0) { return 1; }
    my int $n = line_count();
    my int $start_y = $CY;
    my int $start_x = $CX;

    if ($dir == 1) {
        # Forward search in active lines
        my int $y = $start_y;
        my int $x = $start_x + $advance;
        while ($y < $n) {
            my str $line = get_line($y);
            if ($x <= length($line)) {
                my int $pos = index(substr($line, $x), $query);
                if ($pos >= 0) {
                    $CY = $y;
                    $CX = $x + $pos;
                    scroll_adjust();
                    return 1;
                }
            }
            $y = $y + 1;
            $x = 0;
        }
        if ($LARGE_MODE == 1 && defined($LF_STATE)) {
            lf_sync_active_chunk();
            my int $cur_voff = Smacs::LargeFile::cursor_virtual_offset($LF_STATE, $CL, $start_y, $start_x);
            my int $vend = $LF_STATE->{"chunk_vend"};
            my int $tot = Smacs::LargeFile::total_size($LF_STATE);
            if ($vend < $tot) {
                my scalar $sr = Smacs::LargeFile::search_range($LF_STATE, $query, $vend, $tot, 1, \&lf_progress_callback);
                if ($sr->{"cancelled"} == 1) { return 0; }
                if ($sr->{"found"} == 1) {
                    lf_jump_to_offset($sr->{"voff"});
                    return 1;
                }
            }
            my int $wrap_end = $cur_voff + core::byte_length($query);
            if ($wrap_end > $tot) { $wrap_end = $tot; }
            my scalar $sw = Smacs::LargeFile::search_range($LF_STATE, $query, 0, $wrap_end, 1, \&lf_progress_callback);
            if ($sw->{"found"} == 1 && $sw->{"voff"} <= $cur_voff) {
                lf_jump_to_offset($sw->{"voff"});
                return 2;
            }
            return 0;
        }
        # Wrap around from top
        $y = 0;
        while ($y <= $start_y) {
            my str $line = get_line($y);
            my int $pos = index($line, $query);
            if ($pos >= 0 && ($y < $start_y || $pos <= $start_x)) {
                $CY = $y;
                $CX = $pos;
                scroll_adjust();
                return 2;
            }
            $y = $y + 1;
        }
        return 0;
    } else {
        # Backward search: on $start_y, allow matches starting at <= $start_x - $advance
        my int $y = $start_y;
        while ($y >= 0) {
            my str $line = get_line($y);
            my int $limit_end = length($line);
            if ($y == $start_y) {
                my int $max_start = $start_x - $advance;
                if ($max_start < 0) {
                    $limit_end = 0;
                } else {
                    $limit_end = $max_start + $qlen;
                    if ($limit_end > length($line)) { $limit_end = length($line); }
                }
            }
            if ($limit_end >= $qlen) {
                my str $region = substr($line, 0, $limit_end);
                my int $pos = -1;
                my int $search_from = 0;
                while ($search_from <= length($region) - $qlen) {
                    my int $found = index(substr($region, $search_from), $query);
                    if ($found == -1) { last; }
                    $pos = $search_from + $found;
                    $search_from = $pos + 1;
                }
                if ($pos >= 0) {
                    $CY = $y;
                    $CX = $pos;
                    scroll_adjust();
                    return 1;
                }
            }
            $y = $y - 1;
        }
        if ($LARGE_MODE == 1 && defined($LF_STATE)) {
            lf_sync_active_chunk();
            my int $cur_voff = Smacs::LargeFile::cursor_virtual_offset($LF_STATE, $CL, $start_y, $start_x);
            my int $vstart = $LF_STATE->{"chunk_vstart"};
            my int $tot = Smacs::LargeFile::total_size($LF_STATE);
            if ($vstart > 0) {
                my scalar $sr = Smacs::LargeFile::search_range($LF_STATE, $query, 0, $vstart, -1, \&lf_progress_callback);
                if ($sr->{"cancelled"} == 1) { return 0; }
                if ($sr->{"found"} == 1) {
                    lf_jump_to_offset($sr->{"voff"});
                    return 1;
                }
            }
            my scalar $sw = Smacs::LargeFile::search_range($LF_STATE, $query, $cur_voff, $tot, -1, \&lf_progress_callback);
            if ($sw->{"found"} == 1 && $sw->{"voff"} >= $cur_voff) {
                lf_jump_to_offset($sw->{"voff"});
                return 2;
            }
            return 0;
        }
        # Wrap around from bottom (including positions >= $start_x on $start_y)
        $y = $n - 1;
        while ($y >= $start_y) {
            my str $line = get_line($y);
            my int $min_start = 0;
            if ($y == $start_y) { $min_start = $start_x; }
            if ($min_start <= length($line) - $qlen) {
                my int $pos = -1;
                my int $search_from = $min_start;
                while ($search_from <= length($line) - $qlen) {
                    my int $found = index(substr($line, $search_from), $query);
                    if ($found == -1) { last; }
                    $pos = $search_from + $found;
                    $search_from = $pos + 1;
                }
                if ($pos >= 0) {
                    $CY = $y;
                    $CX = $pos;
                    scroll_adjust();
                    return 2;
                }
            }
            $y = $y - 1;
        }
        return 0;
    }
}

# ===========================================================================
# Replace
# ===========================================================================

func replace_in_line_count(str $line, str $search, str $repl, int $start_x) scalar {
    my int $slen = length($search);
    my int $cnt = 0;
    my str $prefix = "";
    my str $work = $line;
    if ($start_x > 0 && $start_x <= length($line)) {
        $prefix = substr($line, 0, $start_x);
        $work = substr($line, $start_x);
    }
    if (index($work, $search) < 0) {
        my scalar $r0 = {};
        $r0->{"count"} = 0;
        $r0->{"line"} = $line;
        return $r0;
    }
    my int $pos = 0;
    my int $wlen = length($work);
    while ($pos <= $wlen - $slen) {
        my int $hit = index(substr($work, $pos), $search);
        if ($hit < 0) { last; }
        $cnt = $cnt + 1;
        $pos = $pos + $hit + $slen;
    }
    my str $replaced = $prefix . replace_all($work, $search, $repl);
    my scalar $res = {};
    $res->{"count"} = $cnt;
    $res->{"line"} = $replaced;
    return $res;
}

# Streaming literal replace from ($start_y, $start_x) through the rest of a Large File Mode buffer.
func lf_replace_all_from(str $search, str $repl, int $start_y, int $start_x, int $undo_already_saved) int {
    my int $count = 0;
    my int $undo_saved = $undo_already_saved;
    my int $y = $start_y;
    while ($y < line_count()) {
        my int $sx = 0;
        if ($y == $start_y) { $sx = $start_x; }
        my scalar $rr = replace_in_line_count(get_line($y), $search, $repl, $sx);
        if ($rr->{"count"} > 0) {
            if ($undo_saved == 0) {
                undo_save();
                $undo_saved = 1;
            }
            set_line($y, $rr->{"line"});
            $count = $count + $rr->{"count"};
            $CY = $y;
            $DIRTY = 1;
        }
        $y = $y + 1;
    }

    if ($LARGE_MODE != 1 || !defined($LF_STATE)) {
        return $count;
    }

    lf_sync_active_chunk();
    my int $scan_from = $LF_STATE->{"chunk_vend"};
    while ($scan_from < Smacs::LargeFile::total_size($LF_STATE)) {
        my int $tot = Smacs::LargeFile::total_size($LF_STATE);
        my scalar $sr = Smacs::LargeFile::search_range($LF_STATE, $search, $scan_from, $tot, 1, \&lf_progress_callback);
        if ($sr->{"cancelled"} == 1 || $sr->{"found"} == 0) {
            last;
        }
        my int $hit_voff = $sr->{"voff"};
        my int $load_from = $scan_from;
        if ($hit_voff - $load_from > $LARGE_CHUNK_SIZE) {
            $load_from = $hit_voff;
        }
        my scalar $parsed = Smacs::LargeFile::load_chunk_from($LF_STATE, $load_from, $hit_voff);
        lf_apply_chunk_result($parsed);
        my int $ly = 0;
        while ($ly < line_count()) {
            my scalar $lrr = replace_in_line_count(get_line($ly), $search, $repl, 0);
            if ($lrr->{"count"} > 0) {
                set_line($ly, $lrr->{"line"});
                $count = $count + $lrr->{"count"};
                $CY = $ly;
            }
            $ly = $ly + 1;
        }
        lf_sync_active_chunk();
        $scan_from = $LF_STATE->{"chunk_vend"};
    }
    scroll_adjust();
    return $count;
}

func cmd_large_replace_all() void {
    my str $search = mb_read_complete_hist("Replace all (streaming from cursor): ", "", "search");
    if ($MB_CANCELLED == 1 || length($search) == 0) { return; }
    my str $repl = mb_read_complete_hist("Replace with: ", "", "replace");
    if ($MB_CANCELLED == 1) { return; }
    my int $count = lf_replace_all_from($search, $repl, $CY, $CX, 0);
    set_msg("Replaced " . $count . " occurrences.");
}

func cmd_query_replace() void {
    my str $search = mb_read_complete_hist("Query replace: ", "", "search");
    if ($MB_CANCELLED == 1 || length($search) == 0) { return; }
    my str $repl = mb_read_complete_hist("Replace with: ", "", "replace");
    if ($MB_CANCELLED == 1) { return; }

    my int $count = 0;
    my int $undo_saved = 0;
    my int $y = $CY;
    my int $x = $CX;

    while (1) {
        while ($y < line_count()) {
            my str $line = get_line($y);
            my int $pos = -1;
            if ($x <= length($line)) {
                $pos = index(substr($line, $x), $search);
            }
            if ($pos >= 0) {
                $CY = $y;
                $CX = $x + $pos;
                my str $key = "";
                while (length($key) == 0) {
                    if ($EXIT_SIGNAL == 1) { $RUNNING = 0; return; }
                    render();
                    my str $out = render_match_highlight($CY, $CX, length($search));
                    $out = $out . $E . "[" . $ROWS . ";1H" . $E . "[K";
                    $out = $out . "Replace? (y/n/./!/q) ";
                    core::write_fd(1, $out);
                    $key = wait_key();
                }

                if ($key eq "q" || $key eq "C-g" || $key eq "ESC" || $key eq "RET") {
                    if ($LARGE_MODE == 1) { lf_sync_active_chunk(); }
                    set_msg("Replaced " . $count . " occurrences.");
                    return;
                }
                if ($key eq "!") {
                    $count = $count + lf_replace_all_from($search, $repl, $y, $x, $undo_saved);
                    set_msg("Replaced " . $count . " occurrences.");
                    return;
                }
                if ($key eq "y" || $key eq "Y" || $key eq " " || $key eq ".") {
                    if ($undo_saved == 0) {
                        undo_save();
                        $undo_saved = 1;
                    }
                    my int $real_pos = $x + $pos;
                    my str $before = "";
                    if ($real_pos > 0) { $before = substr($line, 0, $real_pos); }
                    my str $after = "";
                    if ($real_pos + length($search) < length($line)) {
                        $after = substr($line, $real_pos + length($search));
                    }
                    set_line($y, $before . $repl . $after);
                    $x = $real_pos + length($repl);
                    $CX = $x;
                    $count = $count + 1;
                    $DIRTY = 1;
                    if ($key eq ".") {
                        if ($LARGE_MODE == 1) { lf_sync_active_chunk(); }
                        set_msg("Replaced " . $count . " occurrences.");
                        return;
                    }
                } else {
                    # Skip (n, DEL, Backspace, or anything else)
                    $x = $x + $pos + length($search);
                }
            } else {
                $y = $y + 1;
                $x = 0;
            }
        }

        if ($LARGE_MODE == 1 && defined($LF_STATE)) {
            lf_sync_active_chunk();
            # If user already queued a quit key (e.g. typed 'yq' quickly), honor it immediately
            # without scanning remaining gigabytes or leaking 'q' into the buffer.
            if (stdin_has_pending() == 1) {
                my str $pk = read_key();
                if ($pk eq "q" || $pk eq "C-g" || $pk eq "ESC" || $pk eq "RET") {
                    set_msg("Replaced " . $count . " occurrences.");
                    return;
                }
                if (length($pk) > 0) {
                    unshift(@$KEY_QUEUE, $pk);
                }
            }
            my int $vend = $LF_STATE->{"chunk_vend"};
            my int $tot = Smacs::LargeFile::total_size($LF_STATE);
            if ($vend >= $tot) { last; }
            my scalar $sr = Smacs::LargeFile::search_range($LF_STATE, $search, $vend, $tot, 1, \&lf_progress_callback);
            if ($sr->{"cancelled"} == 1 || $sr->{"found"} == 0) { last; }
            my int $hit = $sr->{"voff"};
            my int $lfrom = $vend;
            if ($hit - $lfrom > $LARGE_CHUNK_SIZE) { $lfrom = $hit; }
            my scalar $parsed = Smacs::LargeFile::load_chunk_from($LF_STATE, $lfrom, $hit);
            lf_apply_chunk_result($parsed);
            $undo_saved = 0;
            $y = $CY;
            $x = $CX;
        } else {
            last;
        }
    }
    set_msg("Replaced " . $count . " occurrences.");
}

func cmd_replace_regexp() void {
    my str $pattern = mb_read_complete_hist("Replace regexp: ", "", "search");
    if ($MB_CANCELLED == 1 || length($pattern) == 0) { return; }
    my str $repl = mb_read_complete_hist("Replace with: ", "", "replace");
    if ($MB_CANCELLED == 1) { return; }

    my int $count = 0;
    my int $undo_saved = 0;
    my int $y = $CY;
    while ($y < line_count()) {
        my str $line = get_line($y);
        my str $new_line = re::replace_all($line, $pattern, $repl);
        if ($new_line ne $line) {
            if ($undo_saved == 0) {
                undo_save();
                $undo_saved = 1;
            }
            set_line($y, $new_line);
            $count = $count + 1;
            $DIRTY = 1;
        }
        $y = $y + 1;
    }
    set_msg("Replaced in " . $count . " lines.");
}

# ===========================================================================
# M-x Commands
# ===========================================================================

func lf_goto_percent_spec(str $spec) void {
    my str $s = trim($spec);
    if (length($s) > 0 && substr($s, length($s) - 1, 1) eq "%") {
        $s = trim(substr($s, 0, length($s) - 1));
    }
    if (length($s) == 0) { return; }
    my int $pct = core::atoi($s);
    if ($pct < 0) { $pct = 0; }
    if ($pct > 100) { $pct = 100; }
    my int $tot = Smacs::LargeFile::total_size($LF_STATE);
    my int $voff = int(($tot * $pct) / 100);
    lf_jump_to_offset($voff);
    set_msg("Jumped to " . $pct . "% (@" . Smacs::LargeFile::format_bytes($voff) . " / " . Smacs::LargeFile::format_bytes($tot) . ")");
}

func goto_line_spec(str $spec) void {
    $spec = trim($spec);
    if (length($spec) == 0) { return; }
    if ($LARGE_MODE == 1 && defined($LF_STATE)) {
        if (substr($spec, length($spec) - 1, 1) eq "%") {
            lf_goto_percent_spec($spec);
            return;
        }
        if (substr($spec, 0, 1) eq "@" || (length($spec) > 2 && (substr($spec, 0, 2) eq "0x" || substr($spec, 0, 2) eq "0X"))) {
            my int $boff = Smacs::LargeFile::parse_size_spec($spec);
            if ($boff >= 0) {
                lf_jump_to_offset($boff);
                set_msg("Jumped to byte offset " . Smacs::LargeFile::format_bytes($boff));
                return;
            }
        }
        my str $last_ch = uc(substr($spec, length($spec) - 1, 1));
        if ($last_ch eq "B" || $last_ch eq "K" || $last_ch eq "M" || $last_ch eq "G" || $last_ch eq "T") {
            my int $uoff = Smacs::LargeFile::parse_size_spec($spec);
            if ($uoff >= 0) {
                lf_jump_to_offset($uoff);
                set_msg("Jumped to byte offset " . Smacs::LargeFile::format_bytes($uoff));
                return;
            }
        }
    }
    if (substr($spec, 0, 1) eq "+") {
        $spec = substr($spec, 1);
    }
    my int $colon = index($spec, ":");
    my int $target_line = 0;
    my int $target_col = 1;
    if ($colon > 0) {
        $target_line = core::atoi(substr($spec, 0, $colon));
        $target_col = core::atoi(substr($spec, $colon + 1));
    } else {
        $target_line = core::atoi($spec);
    }
    if ($target_line > 0) {
        $CY = $target_line - 1;
        clamp_cursor();
        if ($target_col > 1) {
            $CX = u8_col_to_byte(get_line($CY), $target_col - 1);
        } else {
            $CX = 0;
        }
        clamp_cursor();
    }
}

func any_terminal_running() int {
    my int $i = 0;
    while ($i < buf_count()) {
        my int $vt = $BUFFERS->[$i]->{"term_vt"} // 0;
        if ($vt != 0 && Smacs::Term::is_alive($vt) == 1) {
            return 1;
        }
        $i = $i + 1;
    }
    return 0;
}

func cmd_quit_editor() void {
    if (any_buffer_dirty() == 1) {
        my int $yn = mb_read_yn("Modified buffers exist; exit anyway?");
        if ($yn != 1) {
            set_msg("Cancelled.");
            return;
        }
    }
    if (any_terminal_running() == 1) {
        my int $tyn = mb_read_yn("Active terminal session(s) exist; exit anyway?");
        if ($tyn != 1) {
            set_msg("Cancelled.");
            return;
        }
    }
    $RUNNING = 0;
}

func cmd_mx() void {
    my str $cmd = mb_read_with_complete("M-x ", "mx");
    if ($MB_CANCELLED == 1 || length($cmd) == 0) { return; }

    # Guard text-mutating commands in Hex or Help read-only mode
    if ($HEX_MODE == 1) {
        if ($cmd eq "replace-regexp" || $cmd eq "query-replace" || $cmd eq "replace-string" ||
            $cmd eq "tabify" || $cmd eq "untabify" || $cmd eq "fill-paragraph" ||
            $cmd eq "comment-region" || $cmd eq "uncomment-region") {
            set_msg("Command not available in hex mode.");
            return;
        }
    }
    if ($MODE eq "Help" || $MODE eq "Dired" || $MODE eq "BufferMenu" || $MODE eq "Term" || $MODE eq "Term-Copy") {
        if ($cmd eq "replace-regexp" || $cmd eq "query-replace" || $cmd eq "replace-string" ||
            $cmd eq "large-replace-all" || $cmd eq "tabify" || $cmd eq "untabify" ||
            $cmd eq "fill-paragraph" || $cmd eq "comment-region" || $cmd eq "uncomment-region") {
            set_msg("Buffer is read-only.");
            return;
        }
    }

    if ($cmd eq "replace-regexp") {
        cmd_replace_regexp();
        return;
    }
    if ($cmd eq "refresh-buffer" || $cmd eq "revert-buffer") {
        if ($MODE eq "Dired") {
            dired_refresh("");
            set_msg("Directory refreshed.");
            return;
        }
        if ($MODE eq "BufferMenu") {
            bmenu_rebuild_lines("");
            set_msg("Buffer list refreshed.");
            return;
        }
        if (length($FNAME) == 0) {
            set_msg("Buffer has no file.");
            return;
        }
        if (file_exists($FNAME) != 1) {
            set_msg("File no longer exists on disk: " . $FNAME);
            return;
        }
        if ($DIRTY == 1) {
            my int $yn = mb_read_yn("Buffer modified; revert?");
            if ($yn != 1) {
                set_msg("Revert cancelled.");
                return;
            }
        }
        if ($LARGE_MODE == 1) {
            lf_open_file($FNAME);
        } else {
            file_open($FNAME);
        }
        set_msg("Refreshed from: " . $FNAME);
        return;
    }
    if ($cmd eq "large-file-mode") {
        if ($LARGE_MODE == 1) {
            my int $tot_sz = Smacs::LargeFile::total_size($LF_STATE);
            set_msg("Large File Mode is active (" . Smacs::LargeFile::format_bytes($tot_sz) . ", chunk " . Smacs::LargeFile::format_bytes($LARGE_CHUNK_SIZE) . ").");
            return;
        }
        if (length($FNAME) == 0) {
            set_msg("Save buffer to a file first before enabling Large File Mode.");
            return;
        }
        if ($DIRTY == 1) {
            my int $yn_lf = mb_read_yn("Discard unsaved edits and reopen in Large File Mode?");
            if ($yn_lf != 1) { return; }
        }
        lf_open_file($FNAME);
        return;
    }
    if ($cmd eq "find-file-large") {
        cmd_find_file_large();
        return;
    }
    if ($cmd eq "large-next-chunk") {
        if ($LARGE_MODE != 1) { set_msg("Not in Large File Mode."); return; }
        lf_next_chunk();
        return;
    }
    if ($cmd eq "large-prev-chunk") {
        if ($LARGE_MODE != 1) { set_msg("Not in Large File Mode."); return; }
        lf_prev_chunk(0);
        return;
    }
    if ($cmd eq "large-goto-offset") {
        if ($LARGE_MODE != 1) { set_msg("Not in Large File Mode."); return; }
        my str $ospec = mb_read("Goto byte offset (e.g. 1048576, 500M, 2G, 0x1000): ");
        if ($MB_CANCELLED == 0 && length($ospec) > 0) {
            my int $boff = Smacs::LargeFile::parse_size_spec($ospec);
            if ($boff >= 0) {
                lf_jump_to_offset($boff);
                set_msg("Jumped to byte offset " . Smacs::LargeFile::format_bytes($boff));
            } else {
                set_msg("Invalid byte offset: " . $ospec);
            }
        }
        return;
    }
    if ($cmd eq "large-goto-percent") {
        if ($LARGE_MODE != 1) { set_msg("Not in Large File Mode."); return; }
        my str $pspec = mb_read("Goto percentage (0-100): ");
        if ($MB_CANCELLED == 0 && length($pspec) > 0) {
            lf_goto_percent_spec($pspec);
        }
        return;
    }
    if ($cmd eq "large-replace-all") {
        cmd_large_replace_all();
        return;
    }
    if ($cmd eq "query-replace" || $cmd eq "replace-string") {
        cmd_query_replace();
        return;
    }
    if ($cmd eq "goto-line") {
        if ($HEX_MODE == 1) { hex_goto_offset(); return; }
        my str $gprompt = "Goto line: ";
        if ($LARGE_MODE == 1) { $gprompt = "Goto (50%, @offset, 500M, 2G, or chunk line): "; }
        my str $linestr = mb_read($gprompt);
        if ($MB_CANCELLED == 0 && length($linestr) > 0) {
            goto_line_spec($linestr);
        }
        return;
    }
    if ($cmd eq "set-syntax") {
        my str $lang = mb_read("Syntax language (e.g. strada/c/python/none): ");
        if ($MB_CANCELLED == 1 || length($lang) == 0) { return; }
        if ($lang eq "none") {
            set_mode("Text");
        } else {
            if ($HEX_MODE == 1) { hex_leave_mode(); }
            my str $m = mode_for_syntax($lang);
            $SYNTAX = $lang;
            $MODE = $m;
            my scalar $buf = $BUFFERS->[$BUF_IDX];
            $buf->{"syntax"} = $SYNTAX;
            $buf->{"mode"} = $MODE;
            note_buffer_changed();
            set_msg($m . " mode (" . $lang . ")");
        }
        return;
    }
    if ($cmd eq "load-completions") {
        my str $cpath = mb_read_file("Completion file: ");
        if ($MB_CANCELLED == 0 && length($cpath) > 0) {
            $cpath = expand_tilde($cpath);
            my str $cbase = path_basename($cpath);
            my int $cdot = index($cbase, ".");
            my str $clang = $cbase;
            if ($cdot > 0) { $clang = substr($cbase, 0, $cdot); }
            comp_load_file($cpath, $clang);
            set_msg("Loaded completions for: " . $clang);
        }
        return;
    }
    if ($cmd eq "load-vim-syntax") {
        my str $path = mb_read_file("Vim syntax file: ");
        if ($MB_CANCELLED == 0 && length($path) > 0) {
            vim_syntax_load(expand_tilde($path));
            note_buffer_changed();
        }
        return;
    }
    if ($cmd eq "what-cursor-position") {
        my str $line = get_line($CY);
        my int $dcol = u8_byte_to_col($line, $CX) + 1;
        if ($CX < length($line)) {
            my str $ch = u8_char_at($line, $CX);
            my int $cp = u8_codepoint($line, $CX);
            my str $hex_cp = sprintf("U+%04X", $cp);
            set_msg("Char: " . terminal_safe($ch) . " (" . $cp . ", " . $hex_cp . ") Line " . ($CY + 1) . " Col " . $dcol . " (byte " . ($CX + 1) . ")");
        } else {
            set_msg("End of line. Line " . ($CY + 1) . " Col " . $dcol . " (byte " . ($CX + 1) . ")");
        }
        return;
    }
    if ($cmd eq "save-buffer") { file_save(); return; }
    if ($cmd eq "write-file") { cmd_write_file(); return; }
    if ($cmd eq "kill-buffer") { cmd_kill_buffer(); return; }
    if ($cmd eq "find-file") { cmd_find_file(); return; }
    if ($cmd eq "dired") { cmd_dired(); return; }
    if ($cmd eq "dired-jump") { cmd_dired_jump(); return; }
    if ($cmd eq "create-terminal") { cmd_create_terminal(); return; }
    if ($cmd eq "term-copy-mode") {
        if ($MODE eq "Term") {
            term_enter_copy_mode();
        } elsif ($MODE eq "Term-Copy") {
            term_leave_copy_mode();
        } else {
            set_msg("Not in a terminal buffer.");
        }
        return;
    }
    if ($cmd eq "switch-buffer") { cmd_switch_buffer(); return; }
    if ($cmd eq "list-buffers" || $cmd eq "buffer-menu") { cmd_list_buffers(); return; }
    if ($cmd eq "next-buffer") { buf_cycle(1); return; }
    if ($cmd eq "previous-buffer") { buf_cycle(-1); return; }
    if ($cmd eq "split-window") { win_split(); return; }
    if ($cmd eq "split-window-right") { win_split_vertical(); return; }
    if ($cmd eq "delete-window") { win_delete_current(); return; }
    if ($cmd eq "delete-other-windows") { win_delete_others(); return; }
    if ($cmd eq "other-window") { win_other(); return; }
    if ($cmd eq "undo") {
        if ($HEX_MODE == 1) { hex_undo_restore(); } else { edit_undo(); }
        return;
    }
    if ($cmd eq "redo") {
        if ($HEX_MODE == 1) { hex_redo_restore(); } else { edit_redo(); }
        return;
    }
    if ($cmd eq "save-buffers-kill-terminal") { cmd_quit_editor(); return; }

    if ($cmd eq "line-numbers-mode") {
        if ($LINUM == 0) {
            $LINUM = 1;
            set_msg("Line numbers enabled.");
        } else {
            $LINUM = 0;
            set_msg("Line numbers disabled.");
        }
        return;
    }
    if ($cmd eq "which-function-mode") {
        if ($WHICH_FUNC == 0) {
            $WHICH_FUNC = 1;
            set_msg("Which-function mode enabled.");
        } else {
            $WHICH_FUNC = 0;
            set_msg("Which-function mode disabled.");
        }
        return;
    }
    if ($cmd eq "indent-tabs-mode") {
        if ($INDENT_TABS == 0) {
            $INDENT_TABS = 1;
            set_msg("Indent with tabs.");
        } else {
            $INDENT_TABS = 0;
            set_msg("Indent with spaces (" . $TAB_WIDTH . ").");
        }
        return;
    }
    if ($cmd eq "set-tab-width") {
        my str $val = mb_read("Tab width (1-16): ");
        if ($MB_CANCELLED == 0 && length($val) > 0) {
            my int $tw = core::atoi($val);
            if ($tw > 0 && $tw <= 16) {
                $TAB_WIDTH = $tw;
                note_buffer_changed();
                set_msg("Tab width set to " . $tw . ".");
            } else {
                set_msg("Invalid tab width.");
            }
        }
        return;
    }
    if ($cmd eq "tabify") {
        my int $orig_col = u8_byte_to_col(get_line($CY), $CX);
        my int $li = 0;
        my int $converted = 0;
        my int $undo_done = 0;
        while ($li < line_count()) {
            my str $line = get_line($li);
            my str $new_line = "";
            my int $ci = 0;
            my int $spaces = 0;
            my int $line_conv = 0;
            while ($ci < length($line) && substr($line, $ci, 1) eq " ") {
                $spaces = $spaces + 1;
                if ($spaces == $TAB_WIDTH) {
                    $new_line = $new_line . "\t";
                    $spaces = 0;
                    $line_conv = $line_conv + 1;
                }
                $ci = $ci + 1;
            }
            if ($line_conv > 0) {
                if ($undo_done == 0) {
                    undo_save();
                    $undo_done = 1;
                }
                $new_line = $new_line . (" " x $spaces);
                if ($ci < length($line)) {
                    $new_line = $new_line . substr($line, $ci);
                }
                set_line($li, $new_line);
                $converted = $converted + $line_conv;
            }
            $li = $li + 1;
        }
        if ($converted > 0) {
            $CX = u8_col_to_byte(get_line($CY), $orig_col);
            $DIRTY = 1;
        }
        set_msg("Tabified: " . $converted . " tab stops converted.");
        return;
    }
    if ($cmd eq "untabify") {
        my int $orig_col = u8_byte_to_col(get_line($CY), $CX);
        my int $li = 0;
        my int $converted = 0;
        my int $undo_done = 0;
        while ($li < line_count()) {
            my str $line = get_line($li);
            if (index($line, "\t") >= 0) {
                if ($undo_done == 0) {
                    undo_save();
                    $undo_done = 1;
                }
                my str $new_line = "";
                my int $ci = 0;
                my int $col = 0;
                while ($ci < length($line)) {
                    if (core::get_byte($line, $ci) == 9) {
                        my int $w = char_width_at($line, $ci, $col);
                        $new_line = $new_line . (" " x $w);
                        $col = $col + $w;
                        $converted = $converted + 1;
                        $ci = $ci + 1;
                    } else {
                        my int $nx = u8_next($line, $ci);
                        $col = $col + char_width_at($line, $ci, $col);
                        $new_line = $new_line . substr($line, $ci, $nx - $ci);
                        $ci = $nx;
                    }
                }
                set_line($li, $new_line);
            }
            $li = $li + 1;
        }
        if ($converted > 0) {
            $CX = u8_col_to_byte(get_line($CY), $orig_col);
            $DIRTY = 1;
        }
        set_msg("Untabified: " . $converted . " tabs expanded to tab stops.");
        return;
    }

    if ($cmd eq "hex-mode") {
        if ($HEX_MODE == 1) {
            hex_leave_mode();
        } else {
            hex_enter_mode();
        }
        return;
    }
    if ($cmd eq "completion-mode") {
        if ($COMP_MODE == 0) {
            $COMP_MODE = 1;
            set_msg("Completion mode enabled.");
        } else {
            $COMP_MODE = 0;
            comp_dismiss();
            set_msg("Completion mode disabled.");
        }
        return;
    }
    if ($cmd eq "reload-completions") {
        if (length($COMP_DIR) > 0) {
            $COMP_DEFS = {};
            comp_load_dir($COMP_DIR);
        } else {
            set_msg("No complete-dir configured.");
        }
        return;
    }
    if ($cmd eq "fill-paragraph") {
        fill_paragraph();
        return;
    }
    if ($cmd eq "set-fill-column") {
        my str $val = mb_read("Fill column (default " . $FILL_COLUMN . "): ");
        if ($MB_CANCELLED == 0 && length($val) > 0) {
            my int $fc = core::atoi($val);
            if ($fc > 0 && $fc <= 1000) {
                $FILL_COLUMN = $fc;
                set_msg("Fill column set to " . $fc . ".");
            } else {
                set_msg("Invalid fill column.");
            }
        }
        return;
    }

    # Major mode commands: *-mode
    if ($cmd eq "text-mode") { set_mode("Text"); return; }
    if ($cmd eq "count-words") {
        my int $words = 0;
        my int $chars = 0;
        my int $li = 0;
        my int $lines = line_count();
        while ($li < $lines) {
            my str $line = get_line($li);
            my int $len = length($line);
            my int $pos = 0;
            my int $in_word = 0;
            while ($pos < $len) {
                my str $ch = u8_char_at($line, $pos);
                $chars = $chars + 1;
                if (is_word_char($ch) == 1) {
                    if ($in_word == 0) {
                        $words = $words + 1;
                        $in_word = 1;
                    }
                } else {
                    $in_word = 0;
                }
                $pos = u8_next($line, $pos);
            }
            $li = $li + 1;
        }
        set_msg("Lines: " . $lines . "  Words: " . $words . "  Chars: " . $chars);
        return;
    }
    if ($cmd eq "count-lines") {
        set_msg("Buffer has " . line_count() . " lines.");
        return;
    }
    if ($cmd eq "sql-mode") { set_mode("SQL"); return; }
    if ($cmd eq "strada-mode") { set_mode("Strada"); return; }
    if ($cmd eq "c-mode") { set_mode("C"); return; }
    if ($cmd eq "perl-mode") { set_mode("Perl"); return; }
    if ($cmd eq "python-mode") { set_mode("Python"); return; }
    if ($cmd eq "javascript-mode") { set_mode("JavaScript"); return; }
    if ($cmd eq "html-mode") { set_mode("HTML"); return; }
    if ($cmd eq "css-mode") { set_mode("CSS"); return; }
    if ($cmd eq "shell-mode") { set_mode("Shell"); return; }
    if ($cmd eq "makefile-mode") { set_mode("Makefile"); return; }
    if ($cmd eq "markdown-mode") { set_mode("Markdown"); return; }
    if ($cmd eq "comment-region") { comment_region(); return; }
    if ($cmd eq "uncomment-region") { uncomment_region(); return; }

    set_msg("Unknown command: " . $cmd);
}

# ===========================================================================
# Buffer Commands
# ===========================================================================

func mb_read_file(str $prompt) str {
    return mb_read_file_ex($prompt, 0);
}

# Emacs-style file finder with completions panel ($allow_dir == 1 returns directory paths on RET)
func mb_read_file_ex(str $prompt, int $allow_dir) str {
    $MB_CANCELLED = 0;
    my str $input = core::getcwd() . "/";
    if ($MODE eq "Dired") {
        my str $dd = $BUFFERS->[$BUF_IDX]->{"dired_dir"} // "";
        if (length($dd) > 0) {
            $input = ($dd eq "/") ? "/" : ($dd . "/");
        }
    } elsif (length($FNAME) > 0) {
        my str $fdir = path_dirname($FNAME);
        if ($fdir eq ".") {
            $input = core::getcwd() . "/";
        } elsif ($fdir eq "/") {
            $input = "/";
        } else {
            $input = $fdir . "/";
        }
    }
    my int $pos = length($input);
    my int $show_completions = 1;
    my int $comp_scroll = 0;
    my str $saved_input = "";
    my int $hist_idx = -1;
    my scalar $hist_list = hist_get("file");
    my int $hist_len = scalar(@$hist_list);
    my str $notice = "";
    my int $need_redraw = 1;
    my array @comp_list = ();
    my scalar $dir_cache = {};

    while (1) {
        if ($EXIT_SIGNAL == 1) {
            $RUNNING = 0;
            $MB_CANCELLED = 1;
            return "";
        }
        if (check_winch() == 1) {
            update_size();
            $need_redraw = 1;
        }

        if ($need_redraw == 1) {
            $need_redraw = 0;
            @comp_list = complete_file_cached($input, $dir_cache);

            my int $panel_rows = 0;
            if ($show_completions == 1 && scalar(@comp_list) > 0) {
                $panel_rows = $ROWS - 3;
                if ($panel_rows > scalar(@comp_list) + 1) {
                    $panel_rows = scalar(@comp_list) + 1;
                }
                if ($panel_rows < 3) { $panel_rows = 3; }
            }

            render();

            my str $out = $E . "[?25l";

            if ($panel_rows > 0) {
                my str $strip_dir = $input;
                if ($strip_dir eq "~") {
                    $strip_dir = "~/";
                } elsif (length($strip_dir) > 0 && substr($strip_dir, length($strip_dir) - 1, 1) ne "/") {
                    $strip_dir = path_dirname($strip_dir);
                    if (substr($strip_dir, length($strip_dir) - 1, 1) ne "/") {
                        $strip_dir = $strip_dir . "/";
                    }
                }
                my int $max_w = 0;
                my int $ei = 0;
                while ($ei < scalar(@comp_list)) {
                    my str $ename = $comp_list[$ei];
                    if (length($ename) > length($strip_dir) && substr($ename, 0, length($strip_dir)) eq $strip_dir) {
                        $ename = substr($ename, length($strip_dir));
                    }
                    my int $ew = u8_str_width(terminal_safe($ename));
                    if ($ew > $max_w) { $max_w = $ew; }
                    $ei = $ei + 1;
                }
                $max_w = $max_w + 2;
                if ($max_w < 12) { $max_w = 12; }
                if ($max_w > $COLS) { $max_w = $COLS; }
                my int $num_cols = $COLS / $max_w;
                if ($num_cols < 1) { $num_cols = 1; }

                my int $start_row = $ROWS - 1 - $panel_rows;
                if ($start_row < 1) { $start_row = 1; }
                $out = $out . $E . "[" . $start_row . ";1H" . $E . "[K" . $E . "[7m";
                my str $hdr = u8_truncate(" Completions", $COLS);
                my int $hpad = $COLS - u8_str_width($hdr);
                if ($hpad < 0) { $hpad = 0; }
                $out = $out . $hdr . (" " x $hpad) . $E . "[0m";

                my int $data_rows = $panel_rows - 1;
                my int $total = scalar(@comp_list);
                my int $visible = $data_rows * $num_cols;
                if ($comp_scroll > $total - $visible) {
                    $comp_scroll = $total - $visible;
                }
                if ($comp_scroll < 0) { $comp_scroll = 0; }

                my int $ri = 0;
                while ($ri < $data_rows) {
                    my int $screen_row = $start_row + 1 + $ri;
                    $out = $out . $E . "[" . $screen_row . ";1H" . $E . "[K";

                    my int $ci = 0;
                    while ($ci < $num_cols) {
                        my int $idx = $comp_scroll + $ri + $ci * $data_rows;
                        if ($idx < $total) {
                            my str $entry = $comp_list[$idx];
                            if (length($entry) > length($strip_dir) && substr($entry, 0, length($strip_dir)) eq $strip_dir) {
                                $entry = substr($entry, length($strip_dir));
                            }
                            my int $is_dir = 0;
                            if (length($entry) > 0 && substr($entry, length($entry) - 1, 1) eq "/") {
                                $is_dir = 1;
                            }
                            my str $safe_entry = u8_truncate(terminal_safe($entry), $max_w - 1);
                            if ($is_dir == 1) {
                                $out = $out . $E . "[1;34m" . $safe_entry . $E . "[0m";
                            } else {
                                $out = $out . $safe_entry;
                            }
                            my int $pad = $max_w - u8_str_width($safe_entry);
                            if ($pad < 0) { $pad = 0; }
                            $out = $out . (" " x $pad);
                        }
                        $ci = $ci + 1;
                    }
                    $ri = $ri + 1;
                }
            }

            $out = $out . mb_render_line($prompt, $input, $pos, $notice);
            core::write_fd(1, $out);
        }

        my str $key = read_key();
        if (length($key) == 0) {
            next;
        }
        $notice = "";
        # Coalesce rapid/pasted keystrokes before redrawing the completions panel
        $need_redraw = (stdin_has_pending() == 0) ? 1 : 0;

        if ($key eq "RET") {
            my str $expanded = expand_tilde($input);
            if (length($expanded) == 0) {
                $notice = "[Enter a filename]";
                next;
            }
            if (is_directory($expanded) == 1) {
                if ($allow_dir == 1) {
                    if ($show_completions == 1) {
                        render();
                    }
                    hist_add("file", $input);
                    return $input;
                }
                if (substr($input, length($input) - 1, 1) ne "/") {
                    $input = $input . "/";
                    $pos = length($input);
                    $show_completions = 1;
                    $comp_scroll = 0;
                } else {
                    $notice = "[Directory - enter a filename]";
                }
                next;
            }
            if ($show_completions == 1) {
                render();
            }
            hist_add("file", $input);
            return $input;
        }
        if ($key eq "C-g" || $key eq "ESC") {
            $MB_CANCELLED = 1;
            if ($show_completions == 1) {
                render();
            }
            set_msg("Cancelled.");
            return "";
        }
        if ($key eq "TAB") {
            @comp_list = complete_file_cached($input, $dir_cache);
            $need_redraw = 1;
            if (scalar(@comp_list) == 0) {
                $notice = "[No match]";
            } elsif (scalar(@comp_list) == 1) {
                $input = $comp_list[0];
                $pos = length($input);
                $comp_scroll = 0;
            } else {
                my str $cp = common_prefix(@comp_list);
                if (length($cp) > length($input)) {
                    $input = $cp;
                    $pos = length($input);
                }
                $show_completions = 1;
                $comp_scroll = 0;
            }
            next;
        }
        if ($key eq "BACKSPACE" || $key eq "C-h") {
            if ($pos > 0) {
                my int $pp = u8_prev($input, $pos);
                $input = substr($input, 0, $pp) . substr($input, $pos);
                $pos = $pp;
                $comp_scroll = 0;
            }
            next;
        }
        if ($key eq "DEL" || $key eq "C-d") {
            if ($pos < length($input)) {
                my int $np = u8_next($input, $pos);
                $input = substr($input, 0, $pos) . substr($input, $np);
                $comp_scroll = 0;
            }
            next;
        }
        if ($key eq "M-BACKSPACE") {
            if ($pos > 0) {
                my int $end = $pos;
                while ($pos > 0 && is_word_char(substr($input, $pos - 1, 1)) == 0) {
                    $pos = $pos - 1;
                }
                while ($pos > 0 && is_word_char(substr($input, $pos - 1, 1)) == 1) {
                    $pos = $pos - 1;
                }
                my str $bef = "";
                if ($pos > 0) { $bef = substr($input, 0, $pos); }
                my str $aft = "";
                if ($end < length($input)) { $aft = substr($input, $end); }
                $input = $bef . $aft;
                $comp_scroll = 0;
            }
            next;
        }
        if ($key eq "C-a" || $key eq "HOME") { $pos = 0; next; }
        if ($key eq "C-e" || $key eq "END") { $pos = length($input); next; }
        if ($key eq "LEFT" || $key eq "C-b") {
            if ($pos > 0) { $pos = u8_prev($input, $pos); }
            next;
        }
        if ($key eq "RIGHT" || $key eq "C-f") {
            if ($pos < length($input)) { $pos = u8_next($input, $pos); }
            next;
        }
        if ($key eq "C-k") {
            $input = substr($input, 0, $pos);
            $comp_scroll = 0;
            next;
        }
        if ($key eq "C-u") {
            $input = substr($input, $pos);
            $pos = 0;
            $comp_scroll = 0;
            next;
        }
        if ($key eq "PASTE") {
            my str $ptxt = $PASTE_BUF;
            $PASTE_BUF = "";
            my int $pnl = index($ptxt, "\n");
            if ($pnl >= 0) { $ptxt = substr($ptxt, 0, $pnl); }
            my int $pcr = index($ptxt, "\r");
            if ($pcr >= 0) { $ptxt = substr($ptxt, 0, $pcr); }
            if (length($ptxt) > 0) {
                my str $pb = "";
                if ($pos > 0) { $pb = substr($input, 0, $pos); }
                my str $pa = "";
                if ($pos < length($input)) { $pa = substr($input, $pos); }
                $input = $pb . $ptxt . $pa;
                $pos = $pos + length($ptxt);
                $comp_scroll = 0;
            }
            next;
        }
        if ($key eq "PGUP") {
            if ($show_completions == 1 && $comp_scroll > 0) {
                $comp_scroll = $comp_scroll - 5;
                if ($comp_scroll < 0) { $comp_scroll = 0; }
            }
            next;
        }
        if ($key eq "PGDN") {
            if ($show_completions == 1) {
                $comp_scroll = $comp_scroll + 5;
            }
            next;
        }
        # Scroll completions or browse history
        if ($key eq "UP" || $key eq "C-p") {
            if ($show_completions == 1 && $comp_scroll > 0 && $hist_idx < 0) {
                $comp_scroll = $comp_scroll - 1;
            } elsif ($hist_len > 0) {
                if ($hist_idx == -1) {
                    $saved_input = $input;
                    $hist_idx = 0;
                } elsif ($hist_idx < $hist_len - 1) {
                    $hist_idx = $hist_idx + 1;
                }
                $input = $hist_list->[$hist_len - 1 - $hist_idx];
                $pos = length($input);
                $comp_scroll = 0;
            }
            next;
        }
        if ($key eq "DOWN" || $key eq "C-n") {
            if ($hist_idx >= 0) {
                $hist_idx = $hist_idx - 1;
                if ($hist_idx < 0) {
                    $hist_idx = -1;
                    $input = $saved_input;
                } else {
                    $input = $hist_list->[$hist_len - 1 - $hist_idx];
                }
                $pos = length($input);
                $comp_scroll = 0;
            } elsif ($show_completions == 1) {
                $comp_scroll = $comp_scroll + 1;
            }
            next;
        }
        # Insert printable character (ASCII or multi-byte UTF-8)
        my int $ins_ok = 0;
        if (length($key) == 1) {
            my int $code = ord($key);
            if ($code >= 32 && $code <= 126) { $ins_ok = 1; }
        } elsif (length($key) > 1) {
            if (core::get_byte($key, 0) >= 128) { $ins_ok = 1; }
        }
        if ($ins_ok == 1) {
            my str $before = "";
            if ($pos > 0) { $before = substr($input, 0, $pos); }
            my str $after = "";
            if ($pos < length($input)) { $after = substr($input, $pos); }
            $input = $before . $key . $after;
            $pos = $pos + length($key);
            $comp_scroll = 0;
            $show_completions = 1;
        }
    }
    return "";
}

func switch_to_buffer_idx(int $idx, int $other_win, int $keep_focus) void {
    if ($idx < 0 || $idx >= buf_count()) { return; }
    if ($other_win == 0) {
        my str $prev = $BNAME;
        buf_save_state();
        win_save_state();
        buf_load_state($idx);
        my scalar $cw = $WINDOWS->[$WIN_IDX];
        $cw->{"buf_idx"} = $BUF_IDX;
        $cw->{"cy"} = $CY;
        $cw->{"cx"} = $CX;
        $cw->{"sy"} = $SY;
        $cw->{"sx"} = $SX;
        if ($prev ne $BNAME) { $LAST_BUFFER = $prev; }
        return;
    }

    my int $orig_win = $WIN_IDX;
    my str $orig_bname = $BNAME;
    if ($WIN_COUNT <= 1) {
        win_split();
    }
    win_other();
    buf_save_state();
    buf_load_state($idx);
    my scalar $tw = $WINDOWS->[$WIN_IDX];
    $tw->{"buf_idx"} = $BUF_IDX;
    $tw->{"cy"} = $CY;
    $tw->{"cx"} = $CX;
    $tw->{"sy"} = $SY;
    $tw->{"sx"} = $SX;
    if ($orig_bname ne $BNAME) { $LAST_BUFFER = $orig_bname; }
    if ($keep_focus == 1) {
        win_load_state($orig_win);
    }
}

func open_file_target(str $path, int $force_large, int $other_win, int $keep_focus) void {
    $path = expand_tilde($path);
    if (length($path) > 1 && substr($path, length($path) - 1, 1) eq "/" && is_directory($path) != 1) {
        $path = substr($path, 0, length($path) - 1);
    }
    if (is_directory($path) == 1) {
        dired_open($path, "", $other_win, $keep_focus);
        return;
    }

    # Check if already open in a buffer (comparing canonical paths)
    my int $i = 0;
    while ($i < buf_count()) {
        my scalar $b = $BUFFERS->[$i];
        if (same_file_path($b->{"filename"}, $path) == 1) {
            switch_to_buffer_idx($i, $other_win, $keep_focus);
            if ($force_large == 1 && $keep_focus == 0 && $LARGE_MODE == 0 && $DIRTY == 0) {
                lf_open_file($path);
            } elsif ($keep_focus == 0) {
                set_msg("Switched to: " . $BNAME);
            } else {
                set_msg("Displayed in other window: " . $BUFFERS->[$i]->{"name"});
            }
            return;
        }
        $i = $i + 1;
    }

    # O(1) readability check without slurping potentially multi-GB files into RAM
    if (file_exists($path) == 1) {
        my scalar $tfh = core::open($path, "r");
        if (!defined($tfh)) {
            set_msg("Cannot open: " . $path);
            return;
        }
        core::close($tfh);
    }

    my int $orig_win = $WIN_IDX;
    my str $prev = $BNAME;
    if ($other_win == 1) {
        if ($WIN_COUNT <= 1) { win_split(); }
        win_other();
    }
    buf_save_state();
    win_save_state();
    buf_new(path_basename($path), $path);
    buf_load_state(buf_count() - 1);
    if ($force_large == 1) {
        lf_open_file($path);
    } else {
        file_open($path);
    }
    my scalar $cw = $WINDOWS->[$WIN_IDX];
    $cw->{"buf_idx"} = $BUF_IDX;
    $cw->{"cy"} = $CY;
    $cw->{"cx"} = $CX;
    $cw->{"sy"} = $SY;
    $cw->{"sx"} = $SX;
    $LAST_BUFFER = $prev;
    if ($other_win == 1 && $keep_focus == 1) {
        win_load_state($orig_win);
        set_msg("Opened in other window: " . path_basename($path));
    }
}

func find_file_with_mode(str $prompt, int $force_large) void {
    my str $path = mb_read_file_ex($prompt, 1);
    if ($MB_CANCELLED == 1 || length($path) == 0) { return; }
    open_file_target($path, $force_large, 0, 0);
}

func cmd_find_file() void {
    find_file_with_mode("Find file: ", 0);
}

func cmd_find_file_large() void {
    find_file_with_mode("Find large file: ", 1);
}

func cmd_switch_buffer() void {
    my str $prompt = "Switch to buffer: ";
    if (length($LAST_BUFFER) > 0 && buf_find($LAST_BUFFER) >= 0) {
        $prompt = "Switch to buffer (default " . $LAST_BUFFER . "): ";
    }
    my str $name = mb_read_with_complete($prompt, "buffer");
    if ($MB_CANCELLED == 1) {
        return;
    }
    if (length($name) == 0) {
        if (length($LAST_BUFFER) > 0 && buf_find($LAST_BUFFER) >= 0) {
            $name = $LAST_BUFFER;
        } else {
            return;
        }
    }
    my str $prev = $BNAME;
    my int $idx = buf_find($name);
    if ($idx == -1) {
        buf_save_state();
        win_save_state();
        buf_new($name, "");
        buf_load_state(buf_count() - 1);
        my scalar $cw = $WINDOWS->[$WIN_IDX];
        $cw->{"buf_idx"} = $BUF_IDX;
        set_msg("New buffer: " . $name);
    } else {
        buf_save_state();
        win_save_state();
        buf_load_state($idx);
        my scalar $cw = $WINDOWS->[$WIN_IDX];
        $cw->{"buf_idx"} = $BUF_IDX;
        set_msg("Buffer: " . $name);
    }
    if ($prev ne $BNAME) {
        $LAST_BUFFER = $prev;
    }
}

func kill_buffer_at(int $kidx, int $silent) int {
    if ($kidx < 0 || $kidx >= buf_count()) { return 0; }
    buf_save_state();
    my scalar $kb = $BUFFERS->[$kidx];
    my str $kbname = $kb->{"name"};
    if (($kb->{"dirty"} // 0) == 1) {
        my int $yn = mb_read_yn("Buffer " . $kbname . " modified; kill anyway?");
        if ($yn != 1) {
            if ($silent == 0) { set_msg("Not killed."); }
            return 0;
        }
    }
    my int $vtp = $kb->{"term_vt"} // 0;
    if ($vtp != 0) {
        if (Smacs::Term::is_alive($vtp) == 1) {
            my int $tyn = mb_read_yn("Terminal process in " . $kbname . " is running; kill anyway?");
            if ($tyn != 1) {
                if ($silent == 0) { set_msg("Not killed."); }
                return 0;
            }
        }
        Smacs::Term::destroy($vtp);
        $kb->{"term_vt"} = 0;
    }

    if (buf_count() <= 1) {
        if ($kbname eq "*scratch*" && length($kb->{"filename"} // "") == 0 && ($kb->{"dirty"} // 0) == 0 && ($kb->{"mode"} // "Text") eq "Text" && scalar(@{$kb->{"lines"}}) == 1 && length($kb->{"lines"}->[0]) == 0) {
            if ($silent == 0) { set_msg("Already in empty *scratch* buffer."); }
            return 0;
        }
        $BUFFERS = [];
        buf_new("*scratch*", "");
        buf_load_state(0);
        my int $swi = 0;
        while ($swi < $WIN_COUNT) {
            my scalar $sw = $WINDOWS->[$swi];
            $sw->{"buf_idx"} = 0;
            $sw->{"cy"} = 0;
            $sw->{"cx"} = 0;
            $sw->{"sy"} = 0;
            $sw->{"sx"} = 0;
            $swi = $swi + 1;
        }
        $LAST_BUFFER = "";
        if ($silent == 0) { set_msg("Killed buffer: " . $kbname); }
        return 1;
    }

    splice(@$BUFFERS, $kidx, 1);
    if ($kidx < $BUF_IDX) {
        $BUF_IDX = $BUF_IDX - 1;
    } elsif ($kidx == $BUF_IDX) {
        my int $next_idx = -1;
        if (length($LAST_BUFFER) > 0 && $LAST_BUFFER ne $kbname) {
            $next_idx = buf_find($LAST_BUFFER);
        }
        if ($next_idx >= 0) {
            $BUF_IDX = $next_idx;
        } elsif ($BUF_IDX >= buf_count()) {
            $BUF_IDX = buf_count() - 1;
        }
    }
    if ($LAST_BUFFER eq $kbname) {
        $LAST_BUFFER = "";
    }
    my int $wi = 0;
    while ($wi < $WIN_COUNT) {
        my scalar $w = $WINDOWS->[$wi];
        my int $wb = $w->{"buf_idx"};
        if ($wb == $kidx) {
            $w->{"buf_idx"} = $BUF_IDX;
            my scalar $nb = $BUFFERS->[$BUF_IDX];
            $w->{"cy"} = $nb->{"cy"};
            $w->{"cx"} = $nb->{"cx"};
            $w->{"sy"} = $nb->{"sy"};
            $w->{"sx"} = $nb->{"sx"};
        } elsif ($wb > $kidx) {
            $w->{"buf_idx"} = $wb - 1;
        }
        $wi = $wi + 1;
    }
    buf_load_state($BUF_IDX);
    if ($silent == 0) {
        set_msg("Killed buffer: " . $kbname);
    }
    return 1;
}

func cmd_kill_buffer() void {
    kill_buffer_at($BUF_IDX, 0);
}

# ===========================================================================
# Interactive *Buffers* (BufferMenu)
# ===========================================================================

func bmenu_rebuild_lines(str $prefer_bname) void {
    buf_save_state();
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my scalar $old_entries = $buf->{"bmenu_entries"};
    my scalar $del_map = {};
    if (defined($old_entries)) {
        my int $oi = 0;
        while ($oi < scalar(@$old_entries)) {
            my scalar $oe = $old_entries->[$oi];
            if (($oe->{"del"} // 0) == 1) {
                $del_map->{$oe->{"name"}} = 1;
            }
            $oi = $oi + 1;
        }
    }

    my str $cur_row_bname = $prefer_bname;
    if (length($cur_row_bname) == 0 && defined($old_entries) && $CY >= 2 && ($CY - 2) < scalar(@$old_entries)) {
        $cur_row_bname = $old_entries->[$CY - 2]->{"name"};
    }

    my scalar $new_entries = [];
    my int $bi = 0;
    while ($bi < buf_count()) {
        my str $nm = $BUFFERS->[$bi]->{"name"};
        if ($nm ne "*Buffers*") {
            my scalar $item = {};
            $item->{"name"} = $nm;
            $item->{"del"} = $del_map->{$nm} // 0;
            push(@$new_entries, $item);
        }
        $bi = $bi + 1;
    }
    # Place *Buffers* itself at the bottom
    my scalar $self_item = {};
    $self_item->{"name"} = "*Buffers*";
    $self_item->{"del"} = $del_map->{"*Buffers*"} // 0;
    push(@$new_entries, $self_item);

    $buf->{"bmenu_entries"} = $new_entries;
    my str $origin = $buf->{"bmenu_origin"} // "";
    my scalar $lines = Smacs::Browser::format_buffer_menu_lines($new_entries, $BUFFERS, $origin);
    $buf->{"lines"} = $lines;
    $buf->{"generation"} = ($buf->{"generation"} // 0) + 1;
    $buf->{"highlight_cache"} = {};
    $CL = $lines;
    $LINES_SHARED = 0;

    my int $target_cy = 2;
    if (length($cur_row_bname) > 0) {
        my int $ei = 0;
        while ($ei < scalar(@$new_entries)) {
            if ($new_entries->[$ei]->{"name"} eq $cur_row_bname) {
                $target_cy = 2 + $ei;
                last;
            }
            $ei = $ei + 1;
        }
    }
    $CY = $target_cy;
    if ($CY >= line_count()) { $CY = line_count() - 1; }
    if ($CY < 0) { $CY = 0; }
    $CX = 4;
    clamp_cursor();
    scroll_adjust();
    buf_save_state();
}

func cmd_list_buffers() void {
    my str $prev = $BNAME;
    buf_save_state();
    win_save_state();
    my int $idx = buf_find("*Buffers*");
    if ($idx < 0) {
        buf_new("*Buffers*", "");
        $idx = buf_count() - 1;
    }
    my scalar $mbuf = $BUFFERS->[$idx];
    $mbuf->{"mode"} = "BufferMenu";
    $mbuf->{"syntax"} = "";
    $mbuf->{"filename"} = "";
    $mbuf->{"dirty"} = 0;
    $mbuf->{"undo"} = [];
    $mbuf->{"redo"} = [];
    if ($prev ne "*Buffers*") {
        $mbuf->{"bmenu_origin"} = $prev;
        $LAST_BUFFER = $prev;
    }
    buf_load_state($idx);
    my scalar $cw = $WINDOWS->[$WIN_IDX];
    $cw->{"buf_idx"} = $BUF_IDX;
    bmenu_rebuild_lines($mbuf->{"bmenu_origin"} // "");
    set_msg("RET:switch  o:other-win  s:save  d:mark-del  u:unmark  x:kill-marked  g:refresh  q:quit");
}

func bmenu_selected_entry() scalar {
    my scalar $entries = $BUFFERS->[$BUF_IDX]->{"bmenu_entries"};
    if (!defined($entries)) { return undef; }
    my int $eidx = $CY - 2;
    if ($eidx < 0 || $eidx >= scalar(@$entries)) { return undef; }
    return $entries->[$eidx];
}

func bmenu_save_selected() void {
    my scalar $ent = bmenu_selected_entry();
    if (!defined($ent)) {
        set_msg("Move cursor onto a buffer line.");
        return;
    }
    my str $tname = $ent->{"name"};
    my int $tidx = buf_find($tname);
    if ($tidx < 0) { return; }
    my str $tmode = $BUFFERS->[$tidx]->{"mode"} // "Text";
    if ($tmode eq "BufferMenu" || $tmode eq "Dired" || $tmode eq "Help" || $tmode eq "Term" || $tmode eq "Term-Copy") {
        set_msg("Buffer " . $tname . " is not a file-backed text buffer.");
        return;
    }

    my int $saved_cy = $CY;
    my int $saved_sy = $SY;
    buf_save_state();
    buf_load_state($tidx);
    file_save();
    my str $save_msg = $MSG;
    my str $after_name = $BNAME;
    buf_save_state();

    my int $bm_idx = buf_find("*Buffers*");
    if ($bm_idx >= 0) {
        buf_load_state($bm_idx);
        $WINDOWS->[$WIN_IDX]->{"buf_idx"} = $BUF_IDX;
        bmenu_rebuild_lines($after_name);
        $CY = $saved_cy;
        $SY = $saved_sy;
        clamp_cursor();
        $CX = 4;
        scroll_adjust();
    }
    set_msg($save_msg);
}

func bmenu_execute_marks() void {
    my scalar $entries = $BUFFERS->[$BUF_IDX]->{"bmenu_entries"};
    if (!defined($entries)) { return; }
    my array @to_kill = ();
    my int $i = 0;
    while ($i < scalar(@$entries)) {
        if (($entries->[$i]->{"del"} // 0) == 1) {
            push(@to_kill, $entries->[$i]->{"name"});
        }
        $i = $i + 1;
    }
    if (scalar(@to_kill) == 0) {
        set_msg("No buffers marked for deletion (press d to mark).");
        return;
    }
    my int $killed_count = 0;
    my int $ki = 0;
    while ($ki < scalar(@to_kill)) {
        my str $kn = $to_kill[$ki];
        my int $kidx = buf_find($kn);
        if ($kidx >= 0) {
            if (kill_buffer_at($kidx, 1) == 1) {
                $killed_count = $killed_count + 1;
            }
        }
        $ki = $ki + 1;
    }
    my int $bm_idx = buf_find("*Buffers*");
    if ($bm_idx >= 0 && $BUF_IDX == $bm_idx) {
        bmenu_rebuild_lines("");
    }
    set_msg("Killed " . $killed_count . " buffer(s).");
}

func bmenu_handle_key(str $key) int {
    if ($key eq "q") { cmd_kill_buffer(); return 1; }
    if ($key eq "g") {
        bmenu_rebuild_lines("");
        set_msg("Buffer list refreshed.");
        return 1;
    }
    if ($key eq "n" || $key eq " " || $key eq "DOWN" || $key eq "C-n") {
        if ($CY < 2 && line_count() > 2) { $CY = 2; }
        elsif ($CY < line_count() - 1) { $CY = $CY + 1; }
        $CX = 4;
        return 1;
    }
    if ($key eq "p" || $key eq "UP" || $key eq "C-p") {
        if ($CY > 2) { $CY = $CY - 1; }
        elsif (line_count() > 2) { $CY = 2; }
        $CX = 4;
        return 1;
    }
    if ($key eq "RET" || $key eq "f" || $key eq "e") {
        my scalar $ent = bmenu_selected_entry();
        if (!defined($ent)) { set_msg("Move cursor onto a buffer line."); return 1; }
        my int $tidx = buf_find($ent->{"name"});
        if ($tidx >= 0) {
            switch_to_buffer_idx($tidx, 0, 0);
            set_msg("Buffer: " . $BNAME);
        }
        return 1;
    }
    if ($key eq "o") {
        my scalar $ent = bmenu_selected_entry();
        if (!defined($ent)) { set_msg("Move cursor onto a buffer line."); return 1; }
        my int $tidx = buf_find($ent->{"name"});
        if ($tidx >= 0) {
            switch_to_buffer_idx($tidx, 1, 0);
            set_msg("Buffer: " . $BNAME);
        }
        return 1;
    }
    if ($key eq "C-o") {
        my scalar $ent = bmenu_selected_entry();
        if (!defined($ent)) { return 1; }
        my int $tidx = buf_find($ent->{"name"});
        if ($tidx >= 0) {
            switch_to_buffer_idx($tidx, 1, 1);
            set_msg("Displayed in other window: " . $ent->{"name"});
        }
        return 1;
    }
    if ($key eq "s") {
        bmenu_save_selected();
        return 1;
    }
    if ($key eq "d" || $key eq "k" || $key eq "C-d") {
        my scalar $ent = bmenu_selected_entry();
        if (!defined($ent)) { set_msg("Move cursor onto a buffer line."); return 1; }
        $ent->{"del"} = 1;
        my int $next_cy = ($CY < line_count() - 1) ? ($CY + 1) : $CY;
        bmenu_rebuild_lines("");
        $CY = $next_cy;
        clamp_cursor();
        $CX = 4;
        return 1;
    }
    if ($key eq "D") {
        my scalar $ent = bmenu_selected_entry();
        if (!defined($ent)) { set_msg("Move cursor onto a buffer line."); return 1; }
        my int $kidx = buf_find($ent->{"name"});
        if ($kidx >= 0) {
            kill_buffer_at($kidx, 0);
            if ($MODE eq "BufferMenu") {
                bmenu_rebuild_lines("");
            }
        }
        return 1;
    }
    if ($key eq "u") {
        my scalar $ent = bmenu_selected_entry();
        if (!defined($ent)) { return 1; }
        $ent->{"del"} = 0;
        my int $next_cy = ($CY < line_count() - 1) ? ($CY + 1) : $CY;
        bmenu_rebuild_lines("");
        $CY = $next_cy;
        clamp_cursor();
        $CX = 4;
        return 1;
    }
    if ($key eq "BACKSPACE") {
        if ($CY > 2) { $CY = $CY - 1; }
        my scalar $ent = bmenu_selected_entry();
        if (defined($ent)) {
            $ent->{"del"} = 0;
            my int $cur_cy = $CY;
            bmenu_rebuild_lines("");
            $CY = $cur_cy;
            clamp_cursor();
            $CX = 4;
        }
        return 1;
    }
    if ($key eq "U") {
        my scalar $entries = $BUFFERS->[$BUF_IDX]->{"bmenu_entries"};
        if (defined($entries)) {
            my int $ui = 0;
            while ($ui < scalar(@$entries)) {
                $entries->[$ui]->{"del"} = 0;
                $ui = $ui + 1;
            }
            bmenu_rebuild_lines("");
            set_msg("All marks cleared.");
        }
        return 1;
    }
    if ($key eq "x") {
        bmenu_execute_marks();
        return 1;
    }
    return 0;
}

# ===========================================================================
# Dired Directory Browser
# ===========================================================================

func uniquify_dired_name(int $target_idx, str $cdir) str {
    my str $raw = "/";
    if ($cdir ne "/") {
        $raw = path_basename($cdir) . "/";
    }
    $BUFFERS->[$target_idx]->{"raw_bname"} = $raw;
    my int $bi = 0;
    while ($bi < buf_count()) {
        if ($bi != $target_idx && ($BUFFERS->[$bi]->{"raw_bname"} // "") eq $raw) {
            my str $pdir = path_basename(Smacs::File::dirname($cdir));
            if (length($pdir) > 0 && $pdir ne "/") {
                return $raw . "<" . $pdir . ">";
            }
        }
        $bi = $bi + 1;
    }
    return $raw;
}

func dired_populate_current(str $dir, str $focus_name) void {
    my str $cdir = Smacs::Browser::clean_dir_path($dir);
    my scalar $dh = core::opendir($cdir);
    if (!defined($dh)) {
        set_msg("Cannot read directory: " . $cdir);
        return;
    }
    core::closedir($dh);

    my scalar $buf = $BUFFERS->[$BUF_IDX];
    my int $show_hidden = $buf->{"dired_show_hidden"} // 1;

    # Preserve existing delete marks if refreshing the same directory
    my scalar $del_set = {};
    my str $cur_entry_name = $focus_name;
    if (($buf->{"dired_dir"} // "") eq $cdir && defined($buf->{"dired_entries"})) {
        my scalar $old_e = $buf->{"dired_entries"};
        if (length($cur_entry_name) == 0 && $CY >= 2 && ($CY - 2) < scalar(@$old_e)) {
            $cur_entry_name = $old_e->[$CY - 2]->{"name"};
        }
        my int $oi = 0;
        while ($oi < scalar(@$old_e)) {
            if (($old_e->[$oi]->{"del"} // 0) == 1) {
                $del_set->{$old_e->[$oi]->{"name"}} = 1;
            }
            $oi = $oi + 1;
        }
    }

    my scalar $entries = Smacs::Browser::read_directory($cdir, $show_hidden);
    my int $ei = 0;
    while ($ei < scalar(@$entries)) {
        my str $enm = $entries->[$ei]->{"name"};
        if (($del_set->{$enm} // 0) == 1) {
            $entries->[$ei]->{"del"} = 1;
        }
        $ei = $ei + 1;
    }

    my scalar $lines = Smacs::Browser::format_dired_lines($cdir, $entries, $show_hidden);
    my str $dname = uniquify_dired_name($BUF_IDX, $cdir);

    $buf->{"dired_dir"} = $cdir;
    $buf->{"dired_entries"} = $entries;
    $buf->{"lines"} = $lines;
    $buf->{"generation"} = ($buf->{"generation"} // 0) + 1;
    $buf->{"highlight_cache"} = {};
    $CL = $lines;
    $LINES_SHARED = 0;
    $LARGE_MODE = 0;
    $LF_STATE = undef;
    $HEX_MODE = 0;
    $DIRTY = 0;
    $FNAME = "";
    $BNAME = $dname;
    $SYNTAX = "";
    $MODE = "Dired";
    $UNDO = [];
    $REDO = [];
    $MSET = 0;
    $SHIFT_MARK = 0;

    my int $target_cy = (scalar(@$entries) > 1) ? 3 : 2;
    if (length($cur_entry_name) > 0) {
        my int $fi = 0;
        while ($fi < scalar(@$entries)) {
            if ($entries->[$fi]->{"name"} eq $cur_entry_name) {
                $target_cy = 2 + $fi;
                last;
            }
            $fi = $fi + 1;
        }
    }
    $CY = $target_cy;
    if ($CY >= line_count()) { $CY = line_count() - 1; }
    if ($CY < 0) { $CY = 0; }
    $CX = 41;
    clamp_cursor();
    scroll_adjust();
    buf_save_state();
}

func dired_open_in_current_buffer(str $dir, str $focus_name) void {
    dired_populate_current($dir, $focus_name);
    if ($MODE eq "Dired") {
        set_msg("Dired: " . ($BUFFERS->[$BUF_IDX]->{"dired_dir"} // $dir));
    }
}

func dired_refresh(str $focus_name) void {
    my str $cdir = $BUFFERS->[$BUF_IDX]->{"dired_dir"} // "";
    if (length($cdir) > 0) {
        dired_populate_current($cdir, $focus_name);
    }
}

func dired_open(str $dir, str $focus_name, int $other_win, int $keep_focus) void {
    my str $cdir = Smacs::Browser::clean_dir_path(expand_tilde($dir));
    my scalar $dh = core::opendir($cdir);
    if (!defined($dh)) {
        set_msg("Cannot open directory: " . $cdir);
        return;
    }
    core::closedir($dh);

    # Check if already open in an existing Dired buffer
    my int $bi = 0;
    while ($bi < buf_count()) {
        my scalar $b = $BUFFERS->[$bi];
        if (($b->{"mode"} // "") eq "Dired" && ($b->{"dired_dir"} // "") eq $cdir) {
            my int $orig_win = $WIN_IDX;
            switch_to_buffer_idx($bi, $other_win, 0);
            dired_populate_current($cdir, $focus_name);
            $WINDOWS->[$WIN_IDX]->{"cy"} = $CY;
            $WINDOWS->[$WIN_IDX]->{"cx"} = $CX;
            $WINDOWS->[$WIN_IDX]->{"sy"} = $SY;
            $WINDOWS->[$WIN_IDX]->{"sx"} = $SX;
            if ($other_win == 1 && $keep_focus == 1) {
                win_load_state($orig_win);
            }
            set_msg("Dired: " . $cdir);
            return;
        }
        $bi = $bi + 1;
    }

    my int $orig_win2 = $WIN_IDX;
    my str $prev = $BNAME;
    if ($other_win == 1) {
        if ($WIN_COUNT <= 1) { win_split(); }
        win_other();
    }
    buf_save_state();
    win_save_state();
    buf_new(path_basename($cdir) . "/", "");
    buf_load_state(buf_count() - 1);
    dired_open_in_current_buffer($cdir, $focus_name);
    my scalar $cw = $WINDOWS->[$WIN_IDX];
    $cw->{"buf_idx"} = $BUF_IDX;
    $cw->{"cy"} = $CY;
    $cw->{"cx"} = $CX;
    $cw->{"sy"} = $SY;
    $cw->{"sx"} = $SX;
    if ($prev ne $BNAME) { $LAST_BUFFER = $prev; }
    if ($other_win == 1 && $keep_focus == 1) {
        win_load_state($orig_win2);
    }
}

func cmd_dired() void {
    my str $path = mb_read_file_ex("Dired (directory): ", 1);
    if ($MB_CANCELLED == 1 || length($path) == 0) { return; }
    $path = expand_tilde($path);
    if (is_directory($path) == 1) {
        dired_open($path, "", 0, 0);
    } else {
        dired_open(path_dirname($path), path_basename($path), 0, 0);
    }
}

func cmd_dired_jump() void {
    if ($MODE eq "Dired") {
        my str $cdir = $BUFFERS->[$BUF_IDX]->{"dired_dir"} // core::getcwd();
        if ($cdir ne "/") {
            dired_populate_current(Smacs::File::dirname($cdir), path_basename($cdir));
            set_msg("Dired: " . ($BUFFERS->[$BUF_IDX]->{"dired_dir"} // ""));
        }
        return;
    }
    if (length($FNAME) > 0) {
        dired_open(path_dirname($FNAME), path_basename($FNAME), 0, 0);
    } else {
        dired_open(core::getcwd(), "", 0, 0);
    }
}

func dired_selected_entry() scalar {
    my scalar $entries = $BUFFERS->[$BUF_IDX]->{"dired_entries"};
    if (!defined($entries)) { return undef; }
    my int $eidx = $CY - 2;
    if ($eidx < 0 || $eidx >= scalar(@$entries)) { return undef; }
    return $entries->[$eidx];
}

func dired_delete_one_path(scalar $ent) str {
    my str $fp = $ent->{"full_path"};
    if (($ent->{"is_dir"} // 0) == 1 && ($ent->{"is_link"} // 0) == 0) {
        if (core::rmdir($fp) != 0) {
            return Smacs::File::error_text("Cannot remove directory " . $ent->{"name"});
        }
        return "";
    }
    if (core::unlink($fp) != 0) {
        return Smacs::File::error_text("Cannot delete " . $ent->{"name"});
    }
    return "";
}

func dired_handle_key(str $key) int {
    if ($key eq "q") { cmd_kill_buffer(); return 1; }
    if ($key eq "g") {
        dired_refresh("");
        set_msg("Directory refreshed.");
        return 1;
    }
    if ($key eq ".") {
        my scalar $buf = $BUFFERS->[$BUF_IDX];
        my int $sh = ($buf->{"dired_show_hidden"} // 1) == 1 ? 0 : 1;
        $buf->{"dired_show_hidden"} = $sh;
        dired_refresh("");
        set_msg(($sh == 1) ? "Showing hidden dotfiles." : "Hiding dotfiles.");
        return 1;
    }
    if ($key eq "n" || $key eq " " || $key eq "DOWN" || $key eq "C-n") {
        if ($CY < 2 && line_count() > 2) { $CY = 2; }
        elsif ($CY < line_count() - 1) { $CY = $CY + 1; }
        $CX = 41;
        clamp_cursor();
        return 1;
    }
    if ($key eq "p" || $key eq "UP" || $key eq "C-p") {
        if ($CY > 2) { $CY = $CY - 1; }
        elsif (line_count() > 2) { $CY = 2; }
        $CX = 41;
        clamp_cursor();
        return 1;
    }
    if ($key eq "^") {
        my str $cdir = $BUFFERS->[$BUF_IDX]->{"dired_dir"} // "";
        if (length($cdir) > 0 && $cdir ne "/") {
            my str $child = path_basename($cdir);
            dired_populate_current(Smacs::File::dirname($cdir), $child);
            set_msg("Dired: " . ($BUFFERS->[$BUF_IDX]->{"dired_dir"} // ""));
        } else {
            set_msg("Already at root directory /");
        }
        return 1;
    }
    if ($key eq "RET" || $key eq "f" || $key eq "e") {
        my scalar $ent = dired_selected_entry();
        if (!defined($ent)) { set_msg("Move cursor onto a directory entry."); return 1; }
        if (($ent->{"is_dir"} // 0) == 1) {
            my str $cdir = $BUFFERS->[$BUF_IDX]->{"dired_dir"} // "";
            my str $focus = "";
            if ($ent->{"name"} eq ".." && $cdir ne "/") {
                $focus = path_basename($cdir);
            }
            dired_populate_current($ent->{"full_path"}, $focus);
            set_msg("Dired: " . ($BUFFERS->[$BUF_IDX]->{"dired_dir"} // ""));
        } else {
            open_file_target($ent->{"full_path"}, 0, 0, 0);
        }
        return 1;
    }
    if ($key eq "L") {
        my scalar $ent = dired_selected_entry();
        if (!defined($ent)) { return 1; }
        if (($ent->{"is_dir"} // 0) == 1) {
            set_msg("Entry is a directory.");
            return 1;
        }
        open_file_target($ent->{"full_path"}, 1, 0, 0);
        return 1;
    }
    if ($key eq "o") {
        my scalar $ent = dired_selected_entry();
        if (!defined($ent)) { set_msg("Move cursor onto a directory entry."); return 1; }
        open_file_target($ent->{"full_path"}, 0, 1, 0);
        return 1;
    }
    if ($key eq "C-o") {
        my scalar $ent = dired_selected_entry();
        if (!defined($ent)) { return 1; }
        open_file_target($ent->{"full_path"}, 0, 1, 1);
        return 1;
    }
    if ($key eq "+") {
        my str $cdir = $BUFFERS->[$BUF_IDX]->{"dired_dir"} // core::getcwd();
        my str $nm = mb_read("Create directory in " . $cdir . ": ");
        if ($MB_CANCELLED == 1 || length(trim($nm)) == 0) { return 1; }
        $nm = expand_tilde(trim($nm));
        my str $full = (substr($nm, 0, 1) eq "/") ? $nm : Smacs::Browser::join_dir_entry($cdir, $nm);
        if (core::mkdir($full, 0777) != 0) {
            set_msg(Smacs::File::error_text("mkdir failed"));
            return 1;
        }
        dired_refresh(path_basename($full));
        set_msg("Created directory: " . $full);
        return 1;
    }
    if ($key eq "R") {
        my scalar $ent = dired_selected_entry();
        if (!defined($ent) || $ent->{"name"} eq "..") {
            set_msg("Cannot rename '..'");
            return 1;
        }
        my str $src = $ent->{"full_path"};
        my str $dst = mb_read_file_ex("Rename " . $ent->{"name"} . " to: ", 1);
        if ($MB_CANCELLED == 1 || length(trim($dst)) == 0) { return 1; }
        $dst = expand_tilde(trim($dst));
        if (is_directory($dst) == 1) {
            $dst = Smacs::Browser::join_dir_entry(Smacs::Browser::clean_dir_path($dst), $ent->{"name"});
        }
        if (same_file_path($src, $dst) == 1) {
            set_msg("Source and destination are the same.");
            return 1;
        }
        if (file_exists($dst) == 1) {
            if (mb_read_yn("Overwrite existing " . $dst . "?") != 1) {
                set_msg("Rename cancelled.");
                return 1;
            }
        }
        if (core::rename($src, $dst) != 0) {
            set_msg(Smacs::File::error_text("Rename failed"));
            return 1;
        }
        # Update any open buffer pointing to $src
        my int $bi = 0;
        while ($bi < buf_count()) {
            if (same_file_path($BUFFERS->[$bi]->{"filename"} // "", $src) == 1) {
                $BUFFERS->[$bi]->{"filename"} = $dst;
                $BUFFERS->[$bi]->{"name"} = uniquify_buffer_name($bi, $dst);
            }
            $bi = $bi + 1;
        }
        dired_refresh(path_basename($dst));
        set_msg("Renamed to " . $dst);
        return 1;
    }
    if ($key eq "C") {
        my scalar $ent = dired_selected_entry();
        if (!defined($ent) || ($ent->{"is_dir"} // 0) == 1) {
            set_msg("Move cursor onto a regular file to copy.");
            return 1;
        }
        my str $src = $ent->{"full_path"};
        my str $dst = mb_read_file_ex("Copy " . $ent->{"name"} . " to: ", 1);
        if ($MB_CANCELLED == 1 || length(trim($dst)) == 0) { return 1; }
        $dst = expand_tilde(trim($dst));
        if (is_directory($dst) == 1) {
            $dst = Smacs::Browser::join_dir_entry(Smacs::Browser::clean_dir_path($dst), $ent->{"name"});
        }
        if (same_file_path($src, $dst) == 1) {
            set_msg("Source and destination are the same.");
            return 1;
        }
        if (file_exists($dst) == 1) {
            if (mb_read_yn("Overwrite existing " . $dst . "?") != 1) {
                set_msg("Copy cancelled.");
                return 1;
            }
        }
        my str $cerr = Smacs::Browser::copy_file_streaming($src, $dst);
        if (length($cerr) > 0) {
            set_msg($cerr);
            return 1;
        }
        dired_refresh(path_basename($dst));
        set_msg("Copied to " . $dst);
        return 1;
    }
    if ($key eq "d") {
        my scalar $ent = dired_selected_entry();
        if (!defined($ent)) { return 1; }
        if ($ent->{"name"} eq "..") {
            set_msg("Cannot mark '..' for deletion.");
            return 1;
        }
        $ent->{"del"} = 1;
        my str $cdir = $BUFFERS->[$BUF_IDX]->{"dired_dir"} // "";
        my int $sh = $BUFFERS->[$BUF_IDX]->{"dired_show_hidden"} // 1;
        my scalar $lines = Smacs::Browser::format_dired_lines($cdir, $BUFFERS->[$BUF_IDX]->{"dired_entries"}, $sh);
        $BUFFERS->[$BUF_IDX]->{"lines"} = $lines;
        $CL = $lines;
        note_buffer_changed();
        if ($CY < line_count() - 1) { $CY = $CY + 1; }
        $CX = 41;
        clamp_cursor();
        return 1;
    }
    if ($key eq "u") {
        my scalar $ent = dired_selected_entry();
        if (!defined($ent)) { return 1; }
        $ent->{"del"} = 0;
        my str $cdir = $BUFFERS->[$BUF_IDX]->{"dired_dir"} // "";
        my int $sh = $BUFFERS->[$BUF_IDX]->{"dired_show_hidden"} // 1;
        my scalar $lines = Smacs::Browser::format_dired_lines($cdir, $BUFFERS->[$BUF_IDX]->{"dired_entries"}, $sh);
        $BUFFERS->[$BUF_IDX]->{"lines"} = $lines;
        $CL = $lines;
        note_buffer_changed();
        if ($CY < line_count() - 1) { $CY = $CY + 1; }
        $CX = 41;
        clamp_cursor();
        return 1;
    }
    if ($key eq "BACKSPACE") {
        if ($CY > 2) { $CY = $CY - 1; }
        my scalar $ent = dired_selected_entry();
        if (defined($ent)) {
            $ent->{"del"} = 0;
            my str $cdir = $BUFFERS->[$BUF_IDX]->{"dired_dir"} // "";
            my int $sh = $BUFFERS->[$BUF_IDX]->{"dired_show_hidden"} // 1;
            my scalar $lines = Smacs::Browser::format_dired_lines($cdir, $BUFFERS->[$BUF_IDX]->{"dired_entries"}, $sh);
            $BUFFERS->[$BUF_IDX]->{"lines"} = $lines;
            $CL = $lines;
            note_buffer_changed();
            $CX = 41;
            clamp_cursor();
        }
        return 1;
    }
    if ($key eq "U") {
        my scalar $entries = $BUFFERS->[$BUF_IDX]->{"dired_entries"};
        if (defined($entries)) {
            my int $ui = 0;
            while ($ui < scalar(@$entries)) {
                $entries->[$ui]->{"del"} = 0;
                $ui = $ui + 1;
            }
            dired_refresh("");
            set_msg("All marks cleared.");
        }
        return 1;
    }
    if ($key eq "D") {
        my scalar $ent = dired_selected_entry();
        if (!defined($ent) || $ent->{"name"} eq "..") {
            set_msg("Cannot delete '..'");
            return 1;
        }
        if (mb_read_yn("Delete " . $ent->{"name"} . "?") != 1) {
            set_msg("Delete cancelled.");
            return 1;
        }
        my str $derr = dired_delete_one_path($ent);
        dired_refresh("");
        if (length($derr) > 0) { set_msg($derr); }
        else { set_msg("Deleted " . $ent->{"name"}); }
        return 1;
    }
    if ($key eq "x") {
        my scalar $entries = $BUFFERS->[$BUF_IDX]->{"dired_entries"};
        if (!defined($entries)) { return 1; }
        my scalar $marked = [];
        my str $names_preview = "";
        my int $mi = 0;
        while ($mi < scalar(@$entries)) {
            if (($entries->[$mi]->{"del"} // 0) == 1) {
                push(@$marked, $entries->[$mi]);
                if (scalar(@$marked) <= 3) {
                    if (length($names_preview) > 0) { $names_preview = $names_preview . ", "; }
                    $names_preview = $names_preview . $entries->[$mi]->{"name"};
                }
            }
            $mi = $mi + 1;
        }
        my int $mcnt = scalar(@$marked);
        if ($mcnt == 0) {
            set_msg("No entries marked for deletion (press d to mark).");
            return 1;
        }
        if ($mcnt > 3) { $names_preview = $names_preview . ", ..."; }
        if (mb_read_yn("Delete " . $mcnt . " marked item(s) [" . $names_preview . "]?") != 1) {
            set_msg("Delete cancelled.");
            return 1;
        }
        my int $ok = 0;
        my str $first_err = "";
        my int $di = 0;
        while ($di < $mcnt) {
            my str $err = dired_delete_one_path($marked->[$di]);
            if (length($err) == 0) {
                $ok = $ok + 1;
            } elsif (length($first_err) == 0) {
                $first_err = $err;
            }
            $di = $di + 1;
        }
        dired_refresh("");
        if (length($first_err) > 0) {
            set_msg("Deleted " . $ok . "/" . $mcnt . " (" . $first_err . ")");
        } else {
            set_msg("Deleted " . $ok . " item(s).");
        }
        return 1;
    }
    return 0;
}

# ===========================================================================
# Embedded Terminal Session Buffers (M-x create-terminal)
# ===========================================================================

func next_terminal_buffer_name() str {
    if (buf_find("*terminal*") < 0) {
        return "*terminal*";
    }
    my int $n = 2;
    while (1) {
        my str $cand = "*terminal<" . $n . ">*";
        if (buf_find($cand) < 0) {
            return $cand;
        }
        $n = $n + 1;
    }
    return "*terminal*";
}

func cmd_create_terminal() void {
    my str $cwd = core::getcwd();
    if ($MODE eq "Dired") {
        my str $dd = $BUFFERS->[$BUF_IDX]->{"dired_dir"} // "";
        if (length($dd) > 0) { $cwd = $dd; }
    } elsif (length($FNAME) > 0) {
        my str $fd = path_dirname($FNAME);
        if (length($fd) > 0 && $fd ne ".") { $cwd = $fd; }
    }

    my int $r = win_edit_rows();
    my int $c = $WINDOWS->[$WIN_IDX]->{"width"};
    if ($r < 2) { $r = 24; }
    if ($c < 4) { $c = 80; }

    my int $vt = Smacs::Term::spawn($r, $c, "", $cwd);
    if ($vt == 0) {
        set_msg("Failed to spawn PTY terminal session.");
        return;
    }

    my str $prev = $BNAME;
    my str $tname = next_terminal_buffer_name();
    buf_save_state();
    win_save_state();
    buf_new($tname, "");
    my int $tidx = buf_count() - 1;
    my scalar $tbuf = $BUFFERS->[$tidx];
    $tbuf->{"mode"} = "Term";
    $tbuf->{"syntax"} = "";
    $tbuf->{"dirty"} = 0;
    $tbuf->{"term_vt"} = $vt;
    $tbuf->{"term_cwd"} = $cwd;
    buf_load_state($tidx);
    my scalar $cw = $WINDOWS->[$WIN_IDX];
    $cw->{"buf_idx"} = $BUF_IDX;
    if ($prev ne $BNAME) { $LAST_BUFFER = $prev; }
    set_msg("Terminal " . $tname . " started in " . $cwd . " (C-x for editor commands, C-x [ for scroll/copy)");
}

func term_enter_copy_mode() void {
    my int $vt = $BUFFERS->[$BUF_IDX]->{"term_vt"} // 0;
    if ($vt == 0) { return; }
    my scalar $lines = Smacs::Term::snapshot_lines($vt);
    if (scalar(@$lines) == 0) { push(@$lines, ""); }
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    $buf->{"lines"} = $lines;
    $buf->{"generation"} = ($buf->{"generation"} // 0) + 1;
    $buf->{"highlight_cache"} = {};
    $CL = $lines;
    $LINES_SHARED = 0;
    $MODE = "Term-Copy";
    $buf->{"mode"} = "Term-Copy";
    $CY = line_count() - 1;
    $CX = 0;
    $MSET = 0;
    $SHIFT_MARK = 0;
    scroll_adjust();
    buf_save_state();
    set_msg("Terminal Copy/Scroll mode: arrows/PgUp/C-s/C-SPC/M-w to copy; press q or i to resume terminal");
}

func term_leave_copy_mode() void {
    my scalar $buf = $BUFFERS->[$BUF_IDX];
    $MODE = "Term";
    $buf->{"mode"} = "Term";
    $MSET = 0;
    $SHIFT_MARK = 0;
    buf_save_state();
    set_msg("Resumed live terminal input.");
}

func term_key_to_bytes(int $vt, str $key) str {
    my int $app = Smacs::Term::app_cursor_keys($vt);
    if ($key eq "RET") { return "\r"; }
    if ($key eq "TAB") { return "\t"; }
    if ($key eq "BACKSPACE") { return core::pack("C", 127); }
    if ($key eq "DEL") { return $E . "[3~"; }
    if ($key eq "ESC") { return $E; }
    if ($key eq "UP") { return ($app == 1) ? ($E . "OA") : ($E . "[A"); }
    if ($key eq "DOWN") { return ($app == 1) ? ($E . "OB") : ($E . "[B"); }
    if ($key eq "RIGHT") { return ($app == 1) ? ($E . "OC") : ($E . "[C"); }
    if ($key eq "LEFT") { return ($app == 1) ? ($E . "OD") : ($E . "[D"); }
    if ($key eq "HOME") { return ($app == 1) ? ($E . "OH") : ($E . "[H"); }
    if ($key eq "END") { return ($app == 1) ? ($E . "OF") : ($E . "[F"); }
    if ($key eq "PGUP") { return $E . "[5~"; }
    if ($key eq "PGDN") { return $E . "[6~"; }
    if ($key eq "M-UP") { return $E . "[1;3A"; }
    if ($key eq "M-DOWN") { return $E . "[1;3B"; }
    if ($key eq "M-RIGHT") { return $E . "[1;3C"; }
    if ($key eq "M-LEFT") { return $E . "[1;3D"; }
    if ($key eq "C-UP") { return $E . "[1;5A"; }
    if ($key eq "C-DOWN") { return $E . "[1;5B"; }
    if ($key eq "C-RIGHT") { return $E . "[1;5C"; }
    if ($key eq "C-LEFT") { return $E . "[1;5D"; }
    if ($key eq "M-TAB") { return $E . "\t"; }
    if ($key eq "M-BACKSPACE") { return $E . core::pack("C", 127); }
    if ($key eq "C- ") { return core::pack("C", 0); }
    if ($key eq "C-_") { return core::pack("C", 31); }
    if ($key eq "PASTE") {
        my str $p = $PASTE_BUF;
        $PASTE_BUF = "";
        if (Smacs::Term::bracketed_paste_enabled($vt) == 1) {
            return $E . "[200~" . $p . $E . "[201~";
        }
        return $p;
    }
    if (length($key) == 3 && substr($key, 0, 2) eq "C-") {
        my int $cc = ord(substr($key, 2, 1));
        if ($cc >= 97 && $cc <= 122) {
            return core::pack("C", $cc - 96);
        }
    }
    if (length($key) == 3 && substr($key, 0, 2) eq "M-") {
        return $E . substr($key, 2, 1);
    }
    if (length($key) == 1) {
        return $key;
    }
    if (length($key) > 1 && core::get_byte($key, 0) >= 128) {
        return $key;
    }
    return "";
}

func term_handle_key(str $key) void {
    my int $vt = $BUFFERS->[$BUF_IDX]->{"term_vt"} // 0;
    if ($vt == 0) { return; }

    # Allow M-x editor commands from terminal mode (and slow ESC + key)
    if ($key eq "M-x") {
        cmd_mx();
        return;
    }
    if ($key eq "ESC") {
        # Wait briefly via wait_key? No: allow ESC prefix for M-x or send ESC + key to terminal!
        set_msg("ESC- (x for M-x, ESC to send literal ESC)");
        render();
        my str $next = wait_key();
        if ($next eq "x") {
            cmd_mx();
            return;
        }
        if ($next eq "ESC") {
            Smacs::Term::send_bytes($vt, $E);
            return;
        }
        if (length($next) == 1) {
            Smacs::Term::send_bytes($vt, $E . $next);
            return;
        }
        my str $mapped = term_key_to_bytes($vt, $next);
        if (length($mapped) > 0) {
            Smacs::Term::send_bytes($vt, $E . $mapped);
        }
        return;
    }

    # C-x prefix: escape hatch to all editor window/buffer/file commands
    if ($key eq "C-x") {
        set_msg("C-x- (o:win b:buf C-b:list d:dired [:copy y:paste C-x:send-C-x)");
        render();
        my str $cxk = wait_key();
        if ($cxk eq "C-x") {
            Smacs::Term::send_bytes($vt, core::pack("C", 24));
            return;
        }
        if ($cxk eq "[") {
            term_enter_copy_mode();
            return;
        }
        if ($cxk eq "y") {
            if (length($KILL) > 0) {
                if (Smacs::Term::bracketed_paste_enabled($vt) == 1) {
                    Smacs::Term::send_bytes($vt, $E . "[200~" . $KILL . $E . "[201~");
                } else {
                    Smacs::Term::send_bytes($vt, $KILL);
                }
            }
            return;
        }
        handle_cx($cxk);
        return;
    }

    if (Smacs::Term::is_alive($vt) == 0) {
        if ($key eq "q" || $key eq "RET") {
            cmd_kill_buffer();
            return;
        }
        set_msg("Terminal process has exited (press q or C-x k to close, C-x [ to scroll/copy).");
        return;
    }

    my str $raw = term_key_to_bytes($vt, $key);
    if (length($raw) > 0) {
        Smacs::Term::send_bytes($vt, $raw);
        # Brief 2ms yield so fast echo (local typing / prompt) renders in the very same turn!
        core::usleep(2000);
        Smacs::Term::poll_output($vt);
    }
}

func poll_all_terminals() int {
    if (!defined($BUFFERS)) { return 0; }
    my int $vis_changed = 0;
    my int $bi = 0;
    while ($bi < buf_count()) {
        my scalar $b = $BUFFERS->[$bi];
        my int $vt = $b->{"term_vt"} // 0;
        if ($vt != 0) {
            if (Smacs::Term::poll_output($vt) == 1) {
                my int $wi = 0;
                while ($wi < $WIN_COUNT) {
                    if ($WINDOWS->[$wi]->{"buf_idx"} == $bi && ($b->{"mode"} // "") eq "Term") {
                        $vis_changed = 1;
                    }
                    $wi = $wi + 1;
                }
            }
        }
        $bi = $bi + 1;
    }
    return $vis_changed;
}

func collect_watch_fds() scalar {
    my scalar $fds = [0];
    if (!defined($BUFFERS)) { return $fds; }
    my int $bi = 0;
    while ($bi < buf_count()) {
        my int $vt = $BUFFERS->[$bi]->{"term_vt"} // 0;
        if ($vt != 0) {
            my int $mfd = Smacs::Term::master_fd($vt);
            if ($mfd >= 0) {
                push(@$fds, $mfd);
            }
        }
        $bi = $bi + 1;
    }
    return $fds;
}

func cleanup_all_terminals() void {
    if (!defined($BUFFERS)) { return; }
    my int $bi = 0;
    while ($bi < buf_count()) {
        my int $vt = $BUFFERS->[$bi]->{"term_vt"} // 0;
        if ($vt != 0) {
            Smacs::Term::destroy($vt);
            $BUFFERS->[$bi]->{"term_vt"} = 0;
        }
        $bi = $bi + 1;
    }
}

# ===========================================================================
# Key Dispatch
# ===========================================================================

func handle_cx(str $key) void {
    if ($key eq "C-s") {
        file_save();
    } elsif ($key eq "C-w") {
        cmd_write_file();
    } elsif ($key eq "C-f") {
        cmd_find_file();
    } elsif ($key eq "d") {
        cmd_dired();
    } elsif ($key eq "C-j") {
        cmd_dired_jump();
    } elsif ($key eq "t") {
        cmd_create_terminal();
    } elsif ($key eq "C-c") {
        cmd_quit_editor();
    } elsif ($key eq "b") {
        cmd_switch_buffer();
    } elsif ($key eq "k") {
        cmd_kill_buffer();
    } elsif ($key eq "RIGHT") {
        buf_cycle(1);
    } elsif ($key eq "LEFT") {
        buf_cycle(-1);
    } elsif ($key eq "u") {
        edit_undo();
    } elsif ($key eq "o") {
        win_other();
    } elsif ($key eq "C-b") {
        cmd_list_buffers();
    } elsif ($key eq "2") {
        win_split();
    } elsif ($key eq "3") {
        win_split_vertical();
    } elsif ($key eq "1") {
        win_delete_others();
    } elsif ($key eq "0") {
        win_delete_current();
    } elsif ($key eq "]") {
        if ($LARGE_MODE == 1) { lf_next_chunk(); } else { move_page_down(); }
    } elsif ($key eq "[") {
        if ($LARGE_MODE == 1) { lf_prev_chunk(0); } else { move_page_up(); }
    } elsif ($key eq "h") {
        # Select all (mark whole buffer / active chunk)
        move_bol();
        $CY = 0;
        $CX = 0;
        $MY = 0;
        $MX = 0;
        $MSET = 1;
        $SHIFT_MARK = 0;
        $CY = line_count() - 1;
        $CX = length(get_line($CY));
        if ($LARGE_MODE == 1) {
            set_msg("Current chunk selected.");
        } else {
            set_msg("Buffer selected.");
        }
    } else {
        set_msg("C-x " . $key . " is undefined.");
    }
}

func describe_cx_key(str $ck) void {
    if ($ck eq "C-s") { set_msg("C-x C-s: save-buffer"); return; }
    if ($ck eq "C-w") { set_msg("C-x C-w: write-file (save as)"); return; }
    if ($ck eq "C-f") { set_msg("C-x C-f: find-file (or directory in Dired)"); return; }
    if ($ck eq "d") { set_msg("C-x d: dired (directory browser)"); return; }
    if ($ck eq "C-j") { set_msg("C-x C-j: dired-jump (current file's directory)"); return; }
    if ($ck eq "t") { set_msg("C-x t: create-terminal"); return; }
    if ($ck eq "C-c") { set_msg("C-x C-c: save-buffers-kill-terminal (quit)"); return; }
    if ($ck eq "b") { set_msg("C-x b: switch-buffer"); return; }
    if ($ck eq "k") { set_msg("C-x k: kill-buffer"); return; }
    if ($ck eq "C-b") { set_msg("C-x C-b: list-buffers (*Buffers* menu)"); return; }
    if ($ck eq "RIGHT") { set_msg("C-x RIGHT: next-buffer"); return; }
    if ($ck eq "LEFT") { set_msg("C-x LEFT: previous-buffer"); return; }
    if ($ck eq "u") { set_msg("C-x u: undo"); return; }
    if ($ck eq "o") { set_msg("C-x o: other-window"); return; }
    if ($ck eq "2") { set_msg("C-x 2: split-window (horizontal)"); return; }
    if ($ck eq "3") { set_msg("C-x 3: split-window-right (vertical)"); return; }
    if ($ck eq "1") { set_msg("C-x 1: delete-other-windows"); return; }
    if ($ck eq "0") { set_msg("C-x 0: delete-window"); return; }
    if ($ck eq "]") { set_msg("C-x ]: large-next-chunk / page-down"); return; }
    if ($ck eq "[") { set_msg("C-x [: large-prev-chunk / page-up"); return; }
    if ($ck eq "h") { set_msg("C-x h: mark-whole-buffer"); return; }
    set_msg("C-x " . $ck . " is not bound");
}

func describe_key(str $dk) void {
    if ($dk eq "C-x") {
        set_msg("Describe key: C-x-");
        render();
        my str $ck = wait_key();
        describe_cx_key($ck);
        return;
    }
    if ($dk eq "ESC") {
        set_msg("Describe key: ESC-");
        render();
        my str $mk = wait_key();
        if (length($mk) == 1) {
            $dk = "M-" . $mk;
        } elsif ($mk eq "TAB") {
            $dk = "M-TAB";
        } elsif ($mk eq "BACKSPACE") {
            $dk = "M-BACKSPACE";
        } else {
            $dk = $mk;
        }
    }
    if ($dk eq "C-f" || $dk eq "RIGHT") { set_msg($dk . ": move-forward"); return; }
    if ($dk eq "C-b" || $dk eq "LEFT") { set_msg($dk . ": move-backward"); return; }
    if ($dk eq "C-n" || $dk eq "DOWN") { set_msg($dk . ": move-down"); return; }
    if ($dk eq "C-p" || $dk eq "UP") { set_msg($dk . ": move-up"); return; }
    if ($dk eq "C-a" || $dk eq "HOME") { set_msg($dk . ": move-beginning-of-line"); return; }
    if ($dk eq "C-e" || $dk eq "END") { set_msg($dk . ": move-end-of-line"); return; }
    if ($dk eq "C-v" || $dk eq "PGDN") { set_msg($dk . ": page-down"); return; }
    if ($dk eq "C-d" || $dk eq "DEL") { set_msg($dk . ": delete-char"); return; }
    if ($dk eq "C-j") { set_msg("C-j: newline-and-indent"); return; }
    if ($dk eq "C-k") { set_msg("C-k: kill-line"); return; }
    if ($dk eq "C-y") { set_msg("C-y: yank"); return; }
    if ($dk eq "C-w") { set_msg("C-w: kill-region"); return; }
    if ($dk eq "C-s") { set_msg("C-s: isearch-forward"); return; }
    if ($dk eq "C-r") { set_msg("C-r: isearch-backward"); return; }
    if ($dk eq "C-g") { set_msg("C-g: keyboard-quit"); return; }
    if ($dk eq "C-l") { set_msg("C-l: recenter-top-bottom (cycles center/top/bottom)"); return; }
    if ($dk eq "C-o") { set_msg("C-o: other-window (split) / open-line (single)"); return; }
    if ($dk eq "C-z") { set_msg("C-z: suspend-editor"); return; }
    if ($dk eq "C-_") { set_msg("C-_: undo"); return; }
    if ($dk eq "C- ") { set_msg("C-SPC: set-mark"); return; }
    if ($dk eq "C-h") { set_msg("C-h: help prefix (b=bindings, k=describe-key, l=license)"); return; }
    if ($dk eq "M-v" || $dk eq "PGUP") { set_msg($dk . ": page-up"); return; }
    if ($dk eq "M-f" || $dk eq "M-RIGHT" || $dk eq "C-RIGHT") { set_msg($dk . ": forward-word"); return; }
    if ($dk eq "M-b" || $dk eq "M-LEFT" || $dk eq "C-LEFT") { set_msg($dk . ": backward-word"); return; }
    if ($dk eq "M-UP" || $dk eq "C-UP") { set_msg($dk . ": backward-paragraph"); return; }
    if ($dk eq "M-DOWN" || $dk eq "C-DOWN") { set_msg($dk . ": forward-paragraph"); return; }
    if ($dk eq "M-<") { set_msg("M-<: beginning-of-buffer"); return; }
    if ($dk eq "M->") { set_msg("M->: end-of-buffer"); return; }
    if ($dk eq "M-w") { set_msg("M-w: copy-region"); return; }
    if ($dk eq "M-d") { set_msg("M-d: kill-word"); return; }
    if ($dk eq "M-q") { set_msg("M-q: fill-paragraph"); return; }
    if ($dk eq "M-TAB") { set_msg("M-TAB: autocomplete"); return; }
    if ($dk eq "M-/") { set_msg("M-/: redo"); return; }
    if ($dk eq "M-x") { set_msg("M-x: execute-command"); return; }
    if ($dk eq "M-%") { set_msg("M-%: query-replace"); return; }
    if ($dk eq "M-g") { set_msg("M-g: goto-line"); return; }
    if ($dk eq "M-BACKSPACE") { set_msg("M-Backspace: backward-kill-word"); return; }
    if ($dk eq "BACKSPACE") { set_msg("Backspace: backward-delete-char"); return; }
    if ($dk eq "RET") { set_msg("RET: newline"); return; }
    if ($dk eq "TAB") { set_msg("TAB: indent"); return; }
    set_msg($dk . " is not bound");
}

func open_help_buffer(str $name, scalar $lines) void {
    my str $prev = $BNAME;
    buf_save_state();
    win_save_state();
    my int $idx = buf_find($name);
    if ($idx < 0) {
        buf_new($name, "");
        $idx = buf_count() - 1;
    }
    my scalar $hbuf = $BUFFERS->[$idx];
    $hbuf->{"lines"} = $lines;
    $hbuf->{"mode"} = "Help";
    $hbuf->{"syntax"} = "";
    $hbuf->{"dirty"} = 0;
    $hbuf->{"cy"} = 0;
    $hbuf->{"cx"} = 0;
    $hbuf->{"sy"} = 0;
    $hbuf->{"sx"} = 0;
    $hbuf->{"mset"} = 0;
    $hbuf->{"undo"} = [];
    $hbuf->{"redo"} = [];
    $hbuf->{"generation"} = ($hbuf->{"generation"} // 0) + 1;
    $hbuf->{"highlight_cache"} = {};
    $hbuf->{"which_cache_key"} = "";
    buf_load_state($idx);
    my scalar $cw = $WINDOWS->[$WIN_IDX];
    $cw->{"buf_idx"} = $BUF_IDX;
    if ($prev ne $name) {
        $LAST_BUFFER = $prev;
    }
    set_msg("Press q or C-x k to close, SPC/Bksp to scroll");
}

