}

func handle_help_prefix() void {
    set_msg("C-h (b=bindings, k=describe-key, l=license/about)");
    render();
    my str $hk = wait_key();
    if ($hk eq "b" || $hk eq "C-h" || $hk eq "?") {
        show_help_bindings();
    } elsif ($hk eq "l") {
        show_help_about();
    } elsif ($hk eq "k") {
        set_msg("Describe key: ");
        render();
        my str $dk = wait_key();
        describe_key($dk);
    } elsif ($hk eq "C-g" || $hk eq "ESC") {
        set_msg("Quit");
    } else {
        set_msg("C-h " . $hk . " is undefined");
    }
}

func start_shift_select() void {
    if ($MSET == 0) {
        $MY = $CY;
        $MX = $CX;
        $MSET = 1;
        $SHIFT_MARK = 1;
    }
}

func clear_shift_select() void {
    if ($SHIFT_MARK == 1) {
        $MSET = 0;
        $SHIFT_MARK = 0;
    }
}

func handle_key(str $key) void {
    if (length($key) == 0) { return; }

    # Clear message on any key
    $MSG = "";

    # Reset recenter cycle on any key except C-l
    if ($key ne "C-l") {
        $RECENTER = 0;
    }

    # Preserve sticky goal column only across vertical cursor motions and recenter
    if ($key ne "C-n" && $key ne "C-p" && $key ne "UP" && $key ne "DOWN" &&
        $key ne "C-v" && $key ne "M-v" && $key ne "PGDN" && $key ne "PGUP" &&
        $key ne "S-UP" && $key ne "S-DOWN" && $key ne "C-l") {
        $GOAL_COL = -1;
    }

    # Track self-insert runs (undo grouping) and kill runs (C-k append):
    # any other key ends the current run
    my int $self_insert = 0;
    if (length($key) == 1) {
        my int $kc = ord($key);
        if ($kc >= 32 && $kc <= 126) { $self_insert = 1; }
    } elsif (length($key) > 1) {
        if (core::get_byte($key, 0) >= 128) { $self_insert = 1; }
    }
    if ($self_insert == 0) { $INSERT_GROUP = 0; }
    if ($key ne "C-k") { $LAST_KILL = 0; }

    # Hex mode takes over all key handling
    if ($HEX_MODE == 1) {
        hex_handle_key($key);
        return;
    }

    # Live terminal session mode takes over key handling (C-x / M-x escape to editor)
    if ($MODE eq "Term") {
        term_handle_key($key);
        return;
    }

    # Completion popup active - intercept keys
    if ($COMP_ACTIVE == 1) {
        if ($key eq "C-n" || $key eq "DOWN") {
            if ($COMP_IDX < scalar(@$COMP_LIST) - 1) {
                $COMP_IDX = $COMP_IDX + 1;
            }
            my int $max_vis = 8;
            if ($COMP_IDX >= $COMP_SCROLL + $max_vis) {
                $COMP_SCROLL = $COMP_IDX - $max_vis + 1;
            }
            return;
        }
        if ($key eq "C-p" || $key eq "UP") {
            if ($COMP_IDX > 0) {
                $COMP_IDX = $COMP_IDX - 1;
            }
            if ($COMP_IDX < $COMP_SCROLL) {
                $COMP_SCROLL = $COMP_IDX;
            }
            return;
        }
        if ($key eq "RET" || $key eq "TAB") {
            comp_accept();
            return;
        }
        if ($key eq "M-TAB") {
            if ($COMP_IDX < scalar(@$COMP_LIST) - 1) {
                $COMP_IDX = $COMP_IDX + 1;
            } else {
                $COMP_IDX = 0;
                $COMP_SCROLL = 0;
            }
            my int $max_vis = 8;
            if ($COMP_IDX >= $COMP_SCROLL + $max_vis) {
                $COMP_SCROLL = $COMP_IDX - $max_vis + 1;
            }
            if ($COMP_IDX < $COMP_SCROLL) {
                $COMP_SCROLL = $COMP_IDX;
            }
            return;
        }
        if ($key eq "C-g" || $key eq "ESC") {
            comp_dismiss();
            return;
        }
        if ($key eq "BACKSPACE") {
            edit_backspace();
            comp_update();
            return;
        }
        if (length($key) == 1) {
            my int $kcode = ord($key);
            if ($kcode >= 32 && $kcode <= 126) {
                edit_insert($key);
                comp_update();
                return;
            }
        }
        comp_dismiss();
    }

    # ESC as pending Meta prefix (for slow ESC + key)
    if ($key eq "ESC") {
        set_msg("ESC-");
        render();
        my str $next = wait_key();
        if ($next eq "ESC" || $next eq "C-g") {
            $MSET = 0;
            $SHIFT_MARK = 0;
            set_msg("Quit");
            return;
        }
        if (length($next) == 1) {
            handle_key("M-" . $next);
        } elsif ($next eq "TAB") {
            handle_key("M-TAB");
        } elsif ($next eq "BACKSPACE") {
            handle_key("M-BACKSPACE");
        } elsif ($next eq "UP" || $next eq "DOWN" || $next eq "LEFT" || $next eq "RIGHT") {
            handle_key("M-" . $next);
        } else {
            handle_key($next);
        }
        return;
    }

    # Ctrl-x prefix
    if ($key eq "C-x") {
        set_msg("C-x-");
        render();
        my str $next = wait_key();
        handle_cx($next);
        return;
    }

    # Interactive *Buffers* menu
    if ($MODE eq "BufferMenu") {
        if (bmenu_handle_key($key) == 1) { return; }
        if ($key eq "PASTE" || $key eq "TAB" || $key eq "C-j" || $key eq "DEL" ||
            $key eq "C-k" || $key eq "C-y" || $key eq "C-w" || $key eq "M-d" ||
            $key eq "M-BACKSPACE" || $key eq "M-q" || $key eq "C-_" || $key eq "M-/" ||
            $self_insert == 1) {
            $PASTE_BUF = "";
            set_msg("BufferMenu: RET:switch o:other-win s:save d:mark-del u:unmark x:execute g:refresh q:quit");
            return;
        }
    }

    # Interactive Dired directory browser
    if ($MODE eq "Dired") {
        if (dired_handle_key($key) == 1) { return; }
        if ($key eq "PASTE" || $key eq "TAB" || $key eq "C-j" || $key eq "DEL" ||
            $key eq "C-k" || $key eq "C-y" || $key eq "C-w" || $key eq "M-d" ||
            $key eq "M-BACKSPACE" || $key eq "M-q" || $key eq "C-_" || $key eq "M-/" ||
            $self_insert == 1) {
            $PASTE_BUF = "";
            set_msg("Dired: RET:open o:other-win ^:up +:mkdir R:rename C:copy d/x:delete .:dotfiles g:refresh q:quit");
            return;
        }
    }

    # Terminal Copy/Scroll mode
    if ($MODE eq "Term-Copy") {
        if ($key eq "q" || $key eq "i" || $key eq "RET") {
            term_leave_copy_mode();
            return;
        }
        if ($key eq " ") { move_page_down(); return; }
        if ($key eq "BACKSPACE") { move_page_up(); return; }
        if ($key eq "PASTE" || $key eq "TAB" || $key eq "C-j" || $key eq "C-d" ||
            $key eq "DEL" || $key eq "C-k" || $key eq "C-y" || $key eq "C-w" ||
            $key eq "M-d" || $key eq "M-BACKSPACE" || $key eq "M-q" ||
            $key eq "C-_" || $key eq "M-/" || $self_insert == 1) {
            $PASTE_BUF = "";
            set_msg("Term-Copy is read-only (M-w to copy selection, q or i to resume live terminal).");
            return;
        }
    }

    # Read-only Help viewer shortcuts (*Help*, *About*)
    if ($MODE eq "Help") {
        if ($key eq "q") { cmd_kill_buffer(); return; }
        if ($key eq " ") { move_page_down(); return; }
        if ($key eq "BACKSPACE") { move_page_up(); return; }
        if ($key eq "PASTE" || $key eq "RET" || $key eq "TAB" || $key eq "C-j" ||
            $key eq "C-d" || $key eq "DEL" || $key eq "C-k" || $key eq "C-y" ||
            $key eq "C-w" || $key eq "M-d" || $key eq "M-BACKSPACE" || $key eq "M-q" ||
            $key eq "C-_" || $key eq "M-/" || ($key eq "C-o" && $WIN_COUNT <= 1) ||
            $self_insert == 1) {
            $PASTE_BUF = "";
            set_msg("Buffer is read-only (press q to close).");
            return;
        }
    }

    # Bracketed paste
    if ($key eq "PASTE") {
        paste_insert();
        return;
    }

    # Shift-selection movement
    if ($key eq "S-UP") { start_shift_select(); move_up(); return; }
    if ($key eq "S-DOWN") { start_shift_select(); move_down(); return; }
    if ($key eq "S-LEFT") { start_shift_select(); move_backward(); return; }
    if ($key eq "S-RIGHT") { start_shift_select(); move_forward(); return; }
    if ($key eq "S-HOME") { start_shift_select(); move_bol(); return; }
    if ($key eq "S-END") { start_shift_select(); move_eol(); return; }

    if ($key eq "C-f") { clear_shift_select(); move_forward(); return; }
    if ($key eq "C-b") { clear_shift_select(); move_backward(); return; }
    if ($key eq "C-n") { clear_shift_select(); move_down(); return; }
    if ($key eq "C-p") { clear_shift_select(); move_up(); return; }
    if ($key eq "C-a") { clear_shift_select(); move_bol(); return; }
    if ($key eq "C-e") { clear_shift_select(); move_eol(); return; }
    if ($key eq "C-v") { clear_shift_select(); move_page_down(); return; }
    if ($key eq "C-d") { edit_delete(); return; }
    if ($key eq "C-j") { edit_newline_indent(); return; }
    if ($key eq "C-k") { edit_kill_line(); return; }
    if ($key eq "C-y") { edit_yank(); return; }
    if ($key eq "C-w") { edit_kill_region(); return; }
    if ($key eq "C-s") { cmd_isearch(1); return; }
    if ($key eq "C-r") { cmd_isearch(-1); return; }
    if ($key eq "C-g") { $MSET = 0; $SHIFT_MARK = 0; set_msg("Quit"); return; }
    if ($key eq "C-l") { recenter(); return; }
    if ($key eq "C-o") {
        if ($WIN_COUNT > 1) { win_other(); } else { edit_open_line(); }
        return;
    }

    if ($key eq "C-z") { suspend(); return; }

    # C-_ = undo (also C-/ on most terminals)
    if ($key eq "C-_") { edit_undo(); return; }

    # C-h = help prefix
    if ($key eq "C-h") { handle_help_prefix(); return; }

    # C-space = set mark
    if ($key eq "C- ") { edit_set_mark(); return; }

    # Alt/Meta and Ctrl+Arrow keys
    if ($key eq "M-v") { clear_shift_select(); move_page_up(); return; }
    if ($key eq "M-f" || $key eq "M-RIGHT" || $key eq "C-RIGHT") { clear_shift_select(); move_forward_word(); return; }
    if ($key eq "M-b" || $key eq "M-LEFT" || $key eq "C-LEFT") { clear_shift_select(); move_backward_word(); return; }
    if ($key eq "M-UP" || $key eq "C-UP") { clear_shift_select(); move_backward_paragraph(); return; }
    if ($key eq "M-DOWN" || $key eq "C-DOWN") { clear_shift_select(); move_forward_paragraph(); return; }
    if ($key eq "M-<") { clear_shift_select(); move_buf_start(); return; }
    if ($key eq "M->") { clear_shift_select(); move_buf_end(); return; }
    if ($key eq "M-w") { edit_copy_region(); return; }
    if ($key eq "M-BACKSPACE") { edit_backward_kill_word(); return; }
    if ($key eq "M-d") { edit_forward_kill_word(); return; }
    if ($key eq "M-q") { fill_paragraph(); return; }
    if ($key eq "M-TAB") { comp_start(); return; }
    if ($key eq "M-/") { edit_redo(); return; }
    if ($key eq "M-x") { cmd_mx(); return; }
    if ($key eq "M-%") { cmd_query_replace(); return; }
    if ($key eq "M-g") {
        my str $gprompt = "Goto line: ";
        if ($LARGE_MODE == 1) { $gprompt = "Goto (50%, @offset, 500M, 2G, or chunk line): "; }
        my str $linestr = mb_read($gprompt);
        if ($MB_CANCELLED == 0 && length($linestr) > 0) {
            goto_line_spec($linestr);
        }
        return;
    }

    # Arrow keys
    if ($key eq "UP") { clear_shift_select(); move_up(); return; }
    if ($key eq "DOWN") { clear_shift_select(); move_down(); return; }
    if ($key eq "LEFT") { clear_shift_select(); move_backward(); return; }
    if ($key eq "RIGHT") { clear_shift_select(); move_forward(); return; }
    if ($key eq "HOME") { clear_shift_select(); move_bol(); return; }
    if ($key eq "END") { clear_shift_select(); move_eol(); return; }
    if ($key eq "PGUP") { clear_shift_select(); move_page_up(); return; }
    if ($key eq "PGDN") { clear_shift_select(); move_page_down(); return; }
    if ($key eq "DEL") { edit_delete(); return; }

    # Special keys
    if ($key eq "BACKSPACE") { edit_backspace(); return; }
    if ($key eq "RET") { edit_newline(); return; }
    if ($key eq "TAB") { edit_tab(); return; }

    # Printable characters
    if (length($key) == 1) {
        my int $code = ord($key);
        if ($code >= 32 && $code <= 126) {
            edit_insert($key);
            return;
        }
    }

    # Multi-byte UTF-8 characters
    if (length($key) > 1) {
        if (core::get_byte($key, 0) >= 128) {
            edit_insert($key);
            return;
        }
    }

    # Unknown key
    if (length($key) > 0) {
        set_msg("Unbound key: " . $key);
    }
}

func is_plus_line_arg(str $arg) int {
    if (length($arg) < 2 || substr($arg, 0, 1) ne "+") { return 0; }
    my int $i = 1;
    while ($i < length($arg)) {
        my str $c = substr($arg, $i, 1);
        if (!(($c ge "0" && $c le "9") || $c eq ":")) { return 0; }
        $i = $i + 1;
    }
    return 1;
}

# ===========================================================================
# Main
# ===========================================================================

func main() int {
    $E = "\e";
    $BUFFERS = [];
    $BUF_IDX = 0;
    $RUNNING = 1;
    $MSG = "";
    $KILL = "";
    $LAST_KILL = 0;
    $INSERT_GROUP = 0;
    $PASTE_BUF = "";
    $MSET = 0;
    $SHIFT_MARK = 0;
    $GOAL_COL = -1;
    $MB_CANCELLED = 0;
    $DIRTY = 0;
    $FNAME = "";
    $BNAME = "*scratch*";
    $SYNTAX = "";
    $CONFIG_SYNTAX = "";
    $SY = 0;
    $SX = 0;
    $CY = 0;
    $CX = 0;
    $MY = 0;
    $MX = 0;
    $EXIT_SIGNAL = 0;
    $TERM_ACTIVE = 0;
    $FILE_EOL = "\n";
    $FILE_FINAL_NL = 0;
    $FILE_MTIME = -1;
    $FILE_SIZE = -1;
    $LINES_SHARED = 0;

    $UNDO = [];
    $REDO = [];
    $UNDO_MAX = 100;
    $LINUM = 0;
    $TAB_WIDTH = 4;
    $INDENT_TABS = 0;
    $MODE = "Text";
    $HISTORY = {};
    $HIST_MAX = 50;
    $WHICH_FUNC = 1;
    $FILL_COLUMN = 70;
    $RECENTER = 0;
    $LAST_SEARCH = "";
    $LAST_BUFFER = "";
    $SYN_EXT_MAP = {};
    $SYN_BASE_MAP = {};
    $COMP_ACTIVE = 0;
    $COMP_LIST = [];
    $COMP_IDX = 0;
    $COMP_PREFIX = "";
    $COMP_ROW = 0;
    $COMP_COL = 0;
    $COMP_SCROLL = 0;
    $COMP_DEFS = {};
    $COMP_DIR = "";
    $COMP_MODE = 0;
    $HEX_MODE = 0;
    $HEX_BYTE_POS = 0;
    $HEX_IN_ASCII = 0;
    $HEX_NIBBLE = 0;
    $HEX_PREV_MODE = "";
    $HEX_PREV_SYNTAX = "";
    $LARGE_MODE = 0;
    $LF_STATE = undef;
    $LARGE_FILE_THRESHOLD = 16777216; # 16 MB auto-enable threshold
    $LARGE_CHUNK_SIZE = 1048576;      # 1 MB chunk window
    $FORCE_LARGE_OPEN = 0;
    $KEY_QUEUE = [];

    # Open files from command line args
    my array @args = core::argv();
    my int $argc = scalar(@args);

    # Validate options before raw mode. -- makes all remaining arguments files.
    my int $ci = 0;
    my int $options_done = 0;
    while ($ci < $argc && $options_done == 0) {
        my str $arg = $args[$ci];
        if ($arg eq "--") {
            $options_done = 1;
        } elsif ($arg eq "--help" || $arg eq "-h" || $arg eq "--version" || $arg eq "-v") {
            $args[0] = $arg;
            last;
        } elsif ($arg eq "--syntax" || $arg eq "--complete") {
            if ($ci + 1 >= $argc) {
                say(STDERR, "smacs: " . $arg . " requires a file argument");
                return 2;
            }
            $ci = $ci + 1;
        } elsif ($arg eq "--chunk-size") {
            if ($ci + 1 >= $argc) {
                say(STDERR, "smacs: --chunk-size requires a size argument (e.g. 1M, 4M)");
                return 2;
            }
            my int $cs_val = Smacs::LargeFile::parse_size_spec($args[$ci + 1]);
            if ($cs_val < 4096) {
                say(STDERR, "smacs: --chunk-size must be at least 4096 bytes");
                return 2;
            }
            $ci = $ci + 1;
        } elsif ($arg eq "--large" || $arg eq "-L" || $arg eq "--completion-mode" || is_plus_line_arg($arg) == 1) {
            # valid option / +LINE[:COL]
        } elsif (length($arg) > 0 && substr($arg, 0, 1) eq "-") {
            say(STDERR, "smacs: unknown option: " . $arg);
            say(STDERR, "Try 'smacs --help' for usage.");
            return 2;
        }
        $ci = $ci + 1;
    }

    # Check for --help / --version before entering TUI
    if ($argc > 0) {
        if ($args[0] eq "--help" || $args[0] eq "-h") {
            say("smacs - a lightweight Emacs-like text editor");
            say("");
            say("Usage: smacs [OPTIONS] [+LINE[:COL]] [FILE ...]");
            say("");
            say("Options:");
            say("  -h, --help              Show this help and exit");
            say("  -v, --version           Show version and exit");
            say("  +LINE[:COL]             Jump to line (and column) in the next file");
            say("  -L, --large             Open files in chunked Large File Mode");
            say("  --chunk-size SIZE       Set Large File Mode chunk size (default 1M)");
            say("  --syntax FILE.vim       Load a vim syntax highlighting file");
            say("  --complete FILE.complete  Load a completion definition file");
            say("  --completion-mode       Enable code completion (M-TAB)");
            say("  --                      Treat remaining arguments as filenames");
            say("");
            say("Configuration:");
            say("  /etc/smacsrc            System-wide config");
            say("  ~/.smacsrc              User config (key = value format)");
            say("  ~/.smacs/complete/      Default completion definitions directory");
            say("");
            say("Key bindings (partial list):");
            say("  C-x C-s    Save          C-x C-f    Open file");
            say("  C-x C-w    Save as       C-x b      Switch buffer");
            say("  C-x C-c    Quit          C-s / C-r  Search fwd / back");
            say("  M-%        Query replace M-q        Fill paragraph");
            say("  C-x 2      Split horiz   C-x 3      Split vertical");
            say("  C-x o      Other window  M-TAB      Autocomplete");
            say("  C-z        Suspend       C-h b      Full key list");
            say("  M-x        Run command");
            say("");
            say("Report bugs: https://github.com/strada-lang/smacs");
            return 0;
        }
        if ($args[0] eq "--version" || $args[0] eq "-v") {
            say("smacs " . Smacs::Commands::release_version());
            return 0;
        }
    }

    syn_init();
    load_config();

    # Auto-load syntax files from standard locations (if not already loaded via config)
    if (!defined($VIM_SYN)) {
        my array @syn_dirs = ();
        my str $data_env = core::getenv("SMACS_DATADIR");
        if (length($data_env) > 0) { push(@syn_dirs, expand_tilde($data_env) . "/syntax"); }
        my str $prefix = runtime_prefix();
        if (length($prefix) > 0) { push(@syn_dirs, $prefix . "/share/smacs/syntax"); }
        my str $edir = exe_dir();
        if (length($edir) > 0 && length($prefix) == 0) { push(@syn_dirs, $edir . "/syntax"); }
        push(@syn_dirs, "/usr/local/share/smacs/syntax");
        push(@syn_dirs, "/usr/share/smacs/syntax");
        if (length($prefix) == 0) { push(@syn_dirs, "./syntax"); }
        my int $sdi = 0;
        while ($sdi < scalar(@syn_dirs)) {
            my str $sd = $syn_dirs[$sdi];
            my array @test_syn = core::readdir($sd . "/syntax");
            if (scalar(@test_syn) > 0) {
                load_syntax_dir($sd);
                last;
            }
            my array @test_flat = core::readdir($sd);
            if (scalar(@test_flat) > 0) {
                load_syntax_dir($sd);
                last;
            }
            $sdi = $sdi + 1;
        }
    }

    # Auto-load completions from standard locations (if not already loaded via config)
    if (length($COMP_DIR) == 0) {
        my str $home = core::getenv("HOME");
        my array @comp_dirs = ();
        if (length($home) > 0) {
            push(@comp_dirs, $home . "/.smacs/complete");
        }
        my str $data_env = core::getenv("SMACS_DATADIR");
        if (length($data_env) > 0) { push(@comp_dirs, expand_tilde($data_env) . "/complete"); }
        my str $prefix = runtime_prefix();
        if (length($prefix) > 0) { push(@comp_dirs, $prefix . "/share/smacs/complete"); }
        my str $edir = exe_dir();
        if (length($edir) > 0 && length($prefix) == 0) { push(@comp_dirs, $edir . "/complete"); }
        push(@comp_dirs, "/usr/local/share/smacs/complete");
        push(@comp_dirs, "/usr/share/smacs/complete");
        if (length($prefix) == 0) { push(@comp_dirs, "./complete"); }
        my int $cdi = 0;
        while ($cdi < scalar(@comp_dirs)) {
            my str $cd = $comp_dirs[$cdi];
            my array @test_comp = core::readdir($cd);
            if (scalar(@test_comp) > 0) {
                $COMP_DIR = $cd;
                comp_load_dir($COMP_DIR);
                last;
            }
            $cdi = $cdi + 1;
        }
    }

    $MSG = "";
    enable_raw();
    update_size();

    # Create initial buffer
    buf_new("*scratch*", "");
    buf_load_state(0);

    # Initialize window system
    win_init();

    my str $startup_msg = "";
    if ($argc > 0) {
        my int $opened_first = 0;
        my int $i = 0;
        my int $positional_only = 0;
        my str $pending_goto = "";
        while ($i < $argc) {
            my str $path = $args[$i];
            if ($positional_only == 0 && $path eq "--") {
                $positional_only = 1;
            } elsif ($positional_only == 0 && $path eq "--completion-mode") {
                $COMP_MODE = 1;
            } elsif ($positional_only == 0 && ($path eq "--large" || $path eq "-L")) {
                $FORCE_LARGE_OPEN = 1;
            } elsif ($positional_only == 0 && $path eq "--chunk-size" && $i + 1 < $argc) {
                $i = $i + 1;
                my int $csz = Smacs::LargeFile::parse_size_spec($args[$i]);
                if ($csz >= 4096) { $LARGE_CHUNK_SIZE = $csz; }
            } elsif ($positional_only == 0 && is_plus_line_arg($path) == 1) {
                $pending_goto = $path;
            } elsif ($positional_only == 0 && $path eq "--syntax" && $i + 1 < $argc) {
                $i = $i + 1;
                vim_syntax_load(expand_tilde($args[$i]));
            } elsif ($positional_only == 0 && $path eq "--complete" && $i + 1 < $argc) {
                $i = $i + 1;
                my str $cpath = expand_tilde($args[$i]);
                my str $cbase = path_basename($cpath);
                my int $cdot = index($cbase, ".");
                my str $clang = $cbase;
                if ($cdot > 0) { $clang = substr($cbase, 0, $cdot); }
                comp_load_file($cpath, $clang);
            } else {
                my str $exp_path = expand_tilde($path);
                # Deduplicate if same file passed multiple times on CLI
                my int $dup_idx = -1;
                my int $di = 0;
                while ($di < buf_count()) {
                    if (same_file_path($BUFFERS->[$di]->{"filename"}, $exp_path) == 1) {
                        $dup_idx = $di;
                        last;
                    }
                    $di = $di + 1;
                }
                if ($dup_idx >= 0) {
                    buf_save_state();
                    buf_load_state($dup_idx);
                } elsif ($opened_first == 0) {
                    file_open($exp_path);
                    $opened_first = 1;
                    $startup_msg = $MSG;
                } else {
                    my str $prev_b = $BNAME;
                    buf_save_state();
                    buf_new(path_basename($exp_path), $exp_path);
                    buf_load_state(buf_count() - 1);
                    file_open($exp_path);
                    $LAST_BUFFER = $prev_b;
                    $startup_msg = $MSG;
                }
                if (length($pending_goto) > 0) {
                    goto_line_spec($pending_goto);
                    $pending_goto = "";
                }
            }
            $i = $i + 1;
        }
        $FORCE_LARGE_OPEN = 0;
    }

    # Sync window with whatever buffer ended up active
    my scalar $init_w = $WINDOWS->[$WIN_IDX];
    $init_w->{"buf_idx"} = $BUF_IDX;

    # Enter alternate screen, enable bracketed paste
    core::write_fd(1, $E . "[?1049h" . $E . "[?2004h");

    # Preserve important file open notices (errors, new file, mixed line endings)
    if (length($startup_msg) > 0 && (index($startup_msg, "Cannot ") == 0 || index($startup_msg, "(New file)") >= 0 || index($startup_msg, "mixed line endings") >= 0)) {
        $MSG = $startup_msg;
    } else {
        set_msg("smacs v" . Smacs::Commands::release_version() . " - C-x C-c to quit, C-h for help, M-x for commands");
    }

    # Initial render; subsequent renders happen only on input, PTY output, or SIGWINCH
    render();
    while ($RUNNING == 1) {
        if ($EXIT_SIGNAL == 1) { $RUNNING = 0; last; }
        if (check_winch() == 1) {
            update_size();
            render();
        }
        if (poll_all_terminals() == 1) {
            render();
        }
        my str $key = "";
        if (stdin_has_pending() == 1) {
            $key = read_key();
        } else {
            my scalar $wfds = collect_watch_fds();
            if (scalar(@$wfds) > 1) {
                my scalar $rdy = core::select_fds($wfds, 200);
                my int $stdin_ready = 0;
                if (defined($rdy)) {
                    my int $ri = 0;
                    while ($ri < scalar(@$rdy)) {
                        if ($rdy->[$ri] == 0) { $stdin_ready = 1; }
                        $ri = $ri + 1;
                    }
                }
                if ($stdin_ready == 1) {
                    $key = read_key();
                }
            } else {
                $key = read_key();
            }
        }
        if ($EXIT_SIGNAL == 1) { $RUNNING = 0; last; }
        if (length($key) > 0) {
            handle_key($key);
            if ($RUNNING == 1) {
                render();
            }
        }
    }

    cleanup_all_terminals();
    disable_raw();
    return 0;
}

END { terminal_restore(); }
