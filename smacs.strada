    push(@$lines, "  C-h l          License / about");
    push(@$lines, "");
    push(@$lines, "Other:");
    push(@$lines, "  M-x            Execute command");
    push(@$lines, "  C-g            Cancel / keyboard quit");
    push(@$lines, "  C-l            Recenter (center/top/bottom)");
    push(@$lines, "  C-z            Suspend");
