package Smacs::Commands;

func release_version() str { return "0.2.0"; }

func mx_commands() array {
    return ("replace-regexp", "refresh-buffer", "revert-buffer",
        "query-replace", "replace-string", "goto-line", "set-syntax",
        "load-vim-syntax", "load-completions", "what-cursor-position", "kill-buffer",
        "find-file", "dired", "dired-jump", "create-terminal", "term-copy-mode",
        "save-buffer", "write-file",
        "switch-buffer", "list-buffers", "buffer-menu",
        "next-buffer", "previous-buffer",
        "split-window", "split-window-right", "delete-window",
        "delete-other-windows", "other-window",
        "undo", "redo", "save-buffers-kill-terminal",
        "line-numbers-mode", "which-function-mode",
        "indent-tabs-mode", "set-tab-width", "tabify", "untabify",
        "count-words", "count-lines", "fill-paragraph", "set-fill-column",
        "hex-mode", "large-file-mode", "find-file-large",
        "large-next-chunk", "large-prev-chunk", "large-goto-offset",
        "large-goto-percent", "large-replace-all",
        "completion-mode", "reload-completions",
        "text-mode", "sql-mode", "strada-mode", "c-mode", "perl-mode", "python-mode",
        "javascript-mode", "html-mode", "css-mode", "shell-mode",
        "makefile-mode", "markdown-mode", "comment-region", "uncomment-region");
}
