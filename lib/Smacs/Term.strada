package Smacs::Term;

__C__ {
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <stdint.h>
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>
#include <signal.h>
#include <termios.h>
#include <sys/ioctl.h>
#include <sys/wait.h>

#define SMACS_VT_MAX_SCROLLBACK 2000
#define SMACS_VT_ATTR_BOLD      0x01
#define SMACS_VT_ATTR_DIM       0x02
#define SMACS_VT_ATTR_ITALIC    0x04
#define SMACS_VT_ATTR_UNDER     0x08
#define SMACS_VT_ATTR_REV       0x10
#define SMACS_VT_ATTR_CONT      0x80  /* right half of wide CJK char */

/* Color encoding:
 * 0            = default color
 * 1..16        = ANSI 16 colors (0..7 normal, 8..15 bright)
 * 0x100..0x1FF = 256-color palette index (val & 0xFF)
 * 0x1000000 | (R<<16) | (G<<8) | B = 24-bit truecolor
 */
typedef struct {
    char bytes[8];     /* UTF-8 grapheme bytes (NUL-terminated; " " when blank) */
    uint32_t fg;
    uint32_t bg;
    uint8_t attr;
} SmacsVtCell;

typedef struct {
    SmacsVtCell *cells;
    int cols;
} SmacsVtLine;

typedef struct {
    int master_fd;
    pid_t child_pid;
    int alive;
    int exit_code;

    int rows;
    int cols;
    int cur_r;
    int cur_c;
    int saved_r;
    int saved_c;
    int scroll_top;
    int scroll_bot;

    uint32_t cur_fg;
    uint32_t cur_bg;
    uint8_t cur_attr;

    int alt_active;
    int app_cursor;
    int bracketed_paste;
    int cursor_hidden;

    SmacsVtCell *grid;       /* rows * cols */
    SmacsVtCell *alt_grid;   /* rows * cols */
    int alt_saved_r;
    int alt_saved_c;

    /* Scrollback ring buffer */
    SmacsVtLine scrollback[SMACS_VT_MAX_SCROLLBACK];
    int sb_head;   /* index of oldest line when full, else 0 */
    int sb_count;  /* number of stored scrollback lines */

    /* Parser state */
    int state;     /* 0=ground, 1=esc, 2=csi, 3=osc, 4=osc_esc, 5=charset */
    char csi_buf[128];
    int csi_len;

    /* UTF-8 multi-byte accumulator */
    unsigned char utf8_buf[4];
    int utf8_len;
    int utf8_need;
} SmacsVt;

static void vt_init_cell(SmacsVtCell *c, uint32_t bg) {
    c->bytes[0] = ' ';
    c->bytes[1] = '\0';
    c->fg = 0;
    c->bg = bg;
    c->attr = 0;
}

static void vt_clear_grid(SmacsVtCell *g, int rows, int cols, uint32_t bg) {
    int total = rows * cols;
    for (int i = 0; i < total; i++) {
        vt_init_cell(&g[i], bg);
    }
}

static int vt_cp_width(uint32_t cp) {
    if (cp < 32 || (cp >= 0x7F && cp < 0xA0)) return 0;
    if ((cp >= 0x0300 && cp <= 0x036F) || (cp >= 0x200B && cp <= 0x200F) ||
        (cp >= 0xFE00 && cp <= 0xFE0F)) return 0;
    if (cp >= 0x1100 && (
        cp <= 0x115F || cp == 0x2329 || cp == 0x232A ||
        (cp >= 0x2E80 && cp <= 0xA4CF && cp != 0x303F) ||
        (cp >= 0xAC00 && cp <= 0xD7A3) ||
        (cp >= 0xF900 && cp <= 0xFAFF) ||
        (cp >= 0xFE10 && cp <= 0xFE6F) ||
        (cp >= 0xFF00 && cp <= 0xFF60) ||
        (cp >= 0xFFE0 && cp <= 0xFFE6) ||
        (cp >= 0x1F300 && cp <= 0x1FAFF) ||
        (cp >= 0x20000 && cp <= 0x3FFFD))) {
        return 2;
    }
    return 1;
}

static void vt_push_scrollback(SmacsVt *vt, const SmacsVtCell *row_cells) {
    if (vt->alt_active) return;
    int idx;
    if (vt->sb_count < SMACS_VT_MAX_SCROLLBACK) {
        idx = (vt->sb_head + vt->sb_count) % SMACS_VT_MAX_SCROLLBACK;
        vt->sb_count++;
    } else {
        idx = vt->sb_head;
        free(vt->scrollback[idx].cells);
        vt->sb_head = (vt->sb_head + 1) % SMACS_VT_MAX_SCROLLBACK;
    }
    vt->scrollback[idx].cols = vt->cols;
    vt->scrollback[idx].cells = (SmacsVtCell *)malloc(sizeof(SmacsVtCell) * (size_t)vt->cols);
    if (vt->scrollback[idx].cells) {
        memcpy(vt->scrollback[idx].cells, row_cells, sizeof(SmacsVtCell) * (size_t)vt->cols);
    }
}

static void vt_scroll_up(SmacsVt *vt, int top, int bot, int n) {
    if (top < 0) top = 0;
    if (bot >= vt->rows) bot = vt->rows - 1;
    if (top > bot || n <= 0) return;
    int span = bot - top + 1;
    if (n > span) n = span;
    if (top == 0 && !vt->alt_active) {
        for (int i = 0; i < n; i++) {
            vt_push_scrollback(vt, &vt->grid[i * vt->cols]);
        }
    }
    if (n < span) {
        memmove(&vt->grid[top * vt->cols],
                &vt->grid[(top + n) * vt->cols],
                sizeof(SmacsVtCell) * (size_t)((span - n) * vt->cols));
    }
    for (int r = bot - n + 1; r <= bot; r++) {
        for (int c = 0; c < vt->cols; c++) {
            vt_init_cell(&vt->grid[r * vt->cols + c], vt->cur_bg);
        }
    }
}

static void vt_scroll_down(SmacsVt *vt, int top, int bot, int n) {
    if (top < 0) top = 0;
    if (bot >= vt->rows) bot = vt->rows - 1;
    if (top > bot || n <= 0) return;
    int span = bot - top + 1;
    if (n > span) n = span;
    if (n < span) {
        memmove(&vt->grid[(top + n) * vt->cols],
                &vt->grid[top * vt->cols],
                sizeof(SmacsVtCell) * (size_t)((span - n) * vt->cols));
    }
    for (int r = top; r < top + n; r++) {
        for (int c = 0; c < vt->cols; c++) {
            vt_init_cell(&vt->grid[r * vt->cols + c], vt->cur_bg);
        }
    }
}

static void vt_newline(SmacsVt *vt) {
    if (vt->cur_r == vt->scroll_bot) {
        vt_scroll_up(vt, vt->scroll_top, vt->scroll_bot, 1);
    } else if (vt->cur_r < vt->rows - 1) {
        vt->cur_r++;
    }
}

static void vt_put_glyph(SmacsVt *vt, const char *utf8, int ulen, int w) {
    if (ulen <= 0 || ulen >= 8) return;
    if (w == 0) {
        /* Attach combining mark to previous cell if space permits */
        if (vt->cur_c > 0 && vt->cur_c <= vt->cols) {
            SmacsVtCell *prev = &vt->grid[vt->cur_r * vt->cols + (vt->cur_c - 1)];
            size_t cur_l = strlen(prev->bytes);
            if (cur_l + (size_t)ulen < sizeof(prev->bytes)) {
                memcpy(prev->bytes + cur_l, utf8, (size_t)ulen);
                prev->bytes[cur_l + (size_t)ulen] = '\0';
            }
        }
        return;
    }
    if (vt->cur_c >= vt->cols || (w == 2 && vt->cur_c == vt->cols - 1)) {
        if (vt->cur_c == vt->cols - 1 && w == 2) {
            vt_init_cell(&vt->grid[vt->cur_r * vt->cols + vt->cur_c], vt->cur_bg);
        }
        vt->cur_c = 0;
        vt_newline(vt);
    }
    SmacsVtCell *cell = &vt->grid[vt->cur_r * vt->cols + vt->cur_c];
    memcpy(cell->bytes, utf8, (size_t)ulen);
    cell->bytes[ulen] = '\0';
    cell->fg = vt->cur_fg;
    cell->bg = vt->cur_bg;
    cell->attr = vt->cur_attr;
    if (w == 2 && vt->cur_c + 1 < vt->cols) {
        SmacsVtCell *right = &vt->grid[vt->cur_r * vt->cols + vt->cur_c + 1];
        right->bytes[0] = '\0';
        right->fg = vt->cur_fg;
        right->bg = vt->cur_bg;
        right->attr = vt->cur_attr | SMACS_VT_ATTR_CONT;
    }
    vt->cur_c += w;
}

static void vt_handle_sgr(SmacsVt *vt, const int *params, int nparams) {
    if (nparams == 0) {
        vt->cur_fg = 0;
        vt->cur_bg = 0;
        vt->cur_attr = 0;
        return;
    }
    for (int i = 0; i < nparams; i++) {
        int p = params[i];
        if (p == 0) {
            vt->cur_fg = 0; vt->cur_bg = 0; vt->cur_attr = 0;
        } else if (p == 1) { vt->cur_attr |= SMACS_VT_ATTR_BOLD; }
        else if (p == 2) { vt->cur_attr |= SMACS_VT_ATTR_DIM; }
        else if (p == 3) { vt->cur_attr |= SMACS_VT_ATTR_ITALIC; }
        else if (p == 4) { vt->cur_attr |= SMACS_VT_ATTR_UNDER; }
        else if (p == 7) { vt->cur_attr |= SMACS_VT_ATTR_REV; }
        else if (p == 22) { vt->cur_attr &= ~(SMACS_VT_ATTR_BOLD | SMACS_VT_ATTR_DIM); }
        else if (p == 23) { vt->cur_attr &= ~SMACS_VT_ATTR_ITALIC; }
        else if (p == 24) { vt->cur_attr &= ~SMACS_VT_ATTR_UNDER; }
        else if (p == 27) { vt->cur_attr &= ~SMACS_VT_ATTR_REV; }
        else if (p >= 30 && p <= 37) { vt->cur_fg = (uint32_t)(p - 30 + 1); }
        else if (p == 39) { vt->cur_fg = 0; }
        else if (p >= 40 && p <= 47) { vt->cur_bg = (uint32_t)(p - 40 + 1); }
        else if (p == 49) { vt->cur_bg = 0; }
        else if (p >= 90 && p <= 97) { vt->cur_fg = (uint32_t)(p - 90 + 9); }
        else if (p >= 100 && p <= 107) { vt->cur_bg = (uint32_t)(p - 100 + 9); }
        else if (p == 38 || p == 48) {
            int is_fg = (p == 38);
            if (i + 2 < nparams && params[i + 1] == 5) {
                uint32_t c256 = 0x100u | ((uint32_t)params[i + 2] & 0xFFu);
                if (is_fg) vt->cur_fg = c256; else vt->cur_bg = c256;
                i += 2;
            } else if (i + 4 < nparams && params[i + 1] == 2) {
                uint32_t rgb = 0x1000000u |
                    (((uint32_t)params[i + 2] & 0xFFu) << 16) |
                    (((uint32_t)params[i + 3] & 0xFFu) << 8) |
                    ((uint32_t)params[i + 4] & 0xFFu);
                if (is_fg) vt->cur_fg = rgb; else vt->cur_bg = rgb;
                i += 4;
            }
        }
    }
}

static void vt_enter_alt(SmacsVt *vt, int clear) {
    if (vt->alt_active) return;
    size_t sz = sizeof(SmacsVtCell) * (size_t)(vt->rows * vt->cols);
    memcpy(vt->alt_grid, vt->grid, sz);
    vt->alt_saved_r = vt->cur_r;
    vt->alt_saved_c = vt->cur_c;
    vt->alt_active = 1;
    if (clear) {
        vt_clear_grid(vt->grid, vt->rows, vt->cols, 0);
        vt->cur_r = 0;
        vt->cur_c = 0;
    }
}

static void vt_leave_alt(SmacsVt *vt) {
    if (!vt->alt_active) return;
    size_t sz = sizeof(SmacsVtCell) * (size_t)(vt->rows * vt->cols);
    memcpy(vt->grid, vt->alt_grid, sz);
    vt->cur_r = vt->alt_saved_r;
    vt->cur_c = vt->alt_saved_c;
    if (vt->cur_r >= vt->rows) vt->cur_r = vt->rows - 1;
    if (vt->cur_c >= vt->cols) vt->cur_c = vt->cols - 1;
    vt->alt_active = 0;
}

static void vt_dispatch_csi(SmacsVt *vt, char final_ch) {
    vt->csi_buf[vt->csi_len] = '\0';
    const char *p = vt->csi_buf;
    int priv_q = 0;
    if (*p == '?') { priv_q = 1; p++; }
    else if (*p == '>' || *p == '!') { return; }

    int params[16];
    int nparams = 0;
    while (*p && nparams < 16) {
        if (*p == ';') {
            params[nparams++] = 0;
            p++;
        } else if (*p >= '0' && *p <= '9') {
            int val = 0;
            while (*p >= '0' && *p <= '9') {
                val = val * 10 + (*p - '0');
                p++;
            }
            params[nparams++] = val;
            if (*p == ';') p++;
        } else {
            p++;
        }
    }

    int p0 = (nparams >= 1 && params[0] > 0) ? params[0] : 1;
    int p0_z = (nparams >= 1) ? params[0] : 0;

    if (priv_q) {
        int set = (final_ch == 'h');
        if (final_ch != 'h' && final_ch != 'l') return;
        for (int i = 0; i < nparams; i++) {
            int mode = params[i];
            if (mode == 1) vt->app_cursor = set;
            else if (mode == 25) vt->cursor_hidden = !set;
            else if (mode == 2004) vt->bracketed_paste = set;
            else if (mode == 1049) {
                if (set) vt_enter_alt(vt, 1); else vt_leave_alt(vt);
            } else if (mode == 47 || mode == 1047) {
                if (set) vt_enter_alt(vt, 0); else vt_leave_alt(vt);
            }
        }
        return;
    }

    if (vt->cur_c >= vt->cols && final_ch != '\0') {
        /* Clamp pending wrap margin before cursor positioning commands */
        if (final_ch == 'D' || final_ch == 'H' || final_ch == 'f' || final_ch == 'G' || final_ch == 'K' || final_ch == 'J') {
            if (vt->cur_c >= vt->cols) vt->cur_c = vt->cols - 1;
        }
    }

    switch (final_ch) {
        case 'A': /* CUU */
            vt->cur_r -= p0;
            if (vt->cur_r < 0) vt->cur_r = 0;
            break;
        case 'B': /* CUD */
            vt->cur_r += p0;
            if (vt->cur_r >= vt->rows) vt->cur_r = vt->rows - 1;
            break;
        case 'C': /* CUF */
            vt->cur_c += p0;
            if (vt->cur_c >= vt->cols) vt->cur_c = vt->cols - 1;
            break;
        case 'D': /* CUB */
            vt->cur_c -= p0;
            if (vt->cur_c < 0) vt->cur_c = 0;
            break;
        case 'E': /* CNL */
            vt->cur_r += p0;
            if (vt->cur_r >= vt->rows) vt->cur_r = vt->rows - 1;
            vt->cur_c = 0;
            break;
        case 'F': /* CPL */
            vt->cur_r -= p0;
            if (vt->cur_r < 0) vt->cur_r = 0;
            vt->cur_c = 0;
            break;
        case 'G':
        case '`': /* CHA */
            vt->cur_c = p0 - 1;
            if (vt->cur_c < 0) vt->cur_c = 0;
            if (vt->cur_c >= vt->cols) vt->cur_c = vt->cols - 1;
            break;
        case 'd': /* VPA */
            vt->cur_r = p0 - 1;
            if (vt->cur_r < 0) vt->cur_r = 0;
            if (vt->cur_r >= vt->rows) vt->cur_r = vt->rows - 1;
            break;
        case 'H':
        case 'f': { /* CUP */
            int r = (nparams >= 1 && params[0] > 0) ? params[0] - 1 : 0;
            int c = (nparams >= 2 && params[1] > 0) ? params[1] - 1 : 0;
            if (r < 0) r = 0;
            if (r >= vt->rows) r = vt->rows - 1;
            if (c < 0) c = 0;
            if (c >= vt->cols) c = vt->cols - 1;
            vt->cur_r = r;
            vt->cur_c = c;
            break;
        }
        case 'J': { /* ED */
            int cur_idx = vt->cur_r * vt->cols + (vt->cur_c < vt->cols ? vt->cur_c : vt->cols - 1);
            int total = vt->rows * vt->cols;
            if (p0_z == 0) {
                for (int i = cur_idx; i < total; i++) vt_init_cell(&vt->grid[i], vt->cur_bg);
            } else if (p0_z == 1) {
                for (int i = 0; i <= cur_idx && i < total; i++) vt_init_cell(&vt->grid[i], vt->cur_bg);
            } else if (p0_z == 2 || p0_z == 3) {
                vt_clear_grid(vt->grid, vt->rows, vt->cols, vt->cur_bg);
            }
            break;
        }
        case 'K': { /* EL */
            int rbase = vt->cur_r * vt->cols;
            int cc = vt->cur_c < vt->cols ? vt->cur_c : vt->cols - 1;
            if (p0_z == 0) {
                for (int c = cc; c < vt->cols; c++) vt_init_cell(&vt->grid[rbase + c], vt->cur_bg);
            } else if (p0_z == 1) {
                for (int c = 0; c <= cc; c++) vt_init_cell(&vt->grid[rbase + c], vt->cur_bg);
            } else if (p0_z == 2) {
                for (int c = 0; c < vt->cols; c++) vt_init_cell(&vt->grid[rbase + c], vt->cur_bg);
            }
            break;
        }
        case 'X': { /* ECH */
            int rbase = vt->cur_r * vt->cols;
            for (int i = 0; i < p0 && vt->cur_c + i < vt->cols; i++) {
                vt_init_cell(&vt->grid[rbase + vt->cur_c + i], vt->cur_bg);
            }
            break;
        }
        case 'L': /* IL */
            if (vt->cur_r >= vt->scroll_top && vt->cur_r <= vt->scroll_bot) {
                vt_scroll_down(vt, vt->cur_r, vt->scroll_bot, p0);
            }
            break;
        case 'M': /* DL */
            if (vt->cur_r >= vt->scroll_top && vt->cur_r <= vt->scroll_bot) {
                vt_scroll_up(vt, vt->cur_r, vt->scroll_bot, p0);
            }
            break;
        case '@': { /* ICH */
            int rbase = vt->cur_r * vt->cols;
            int cc = vt->cur_c < vt->cols ? vt->cur_c : vt->cols - 1;
            int n = p0;
            if (cc + n > vt->cols) n = vt->cols - cc;
            if (cc + n < vt->cols) {
                memmove(&vt->grid[rbase + cc + n], &vt->grid[rbase + cc],
                        sizeof(SmacsVtCell) * (size_t)(vt->cols - cc - n));
            }
            for (int i = 0; i < n; i++) vt_init_cell(&vt->grid[rbase + cc + i], vt->cur_bg);
            break;
        }
        case 'P': { /* DCH */
            int rbase = vt->cur_r * vt->cols;
            int cc = vt->cur_c < vt->cols ? vt->cur_c : vt->cols - 1;
            int n = p0;
            if (cc + n > vt->cols) n = vt->cols - cc;
            if (cc + n < vt->cols) {
                memmove(&vt->grid[rbase + cc], &vt->grid[rbase + cc + n],
                        sizeof(SmacsVtCell) * (size_t)(vt->cols - cc - n));
            }
            for (int c = vt->cols - n; c < vt->cols; c++) vt_init_cell(&vt->grid[rbase + c], vt->cur_bg);
            break;
        }
        case 'S': /* SU */
            vt_scroll_up(vt, vt->scroll_top, vt->scroll_bot, p0);
            break;
        case 'T': /* SD */
            vt_scroll_down(vt, vt->scroll_top, vt->scroll_bot, p0);
            break;
        case 'r': { /* DECSTBM */
            int top = (nparams >= 1 && params[0] > 0) ? params[0] - 1 : 0;
            int bot = (nparams >= 2 && params[1] > 0) ? params[1] - 1 : vt->rows - 1;
            if (top < 0) top = 0;
            if (bot >= vt->rows) bot = vt->rows - 1;
            if (top < bot) {
                vt->scroll_top = top;
                vt->scroll_bot = bot;
                vt->cur_r = 0;
                vt->cur_c = 0;
            }
            break;
        }
        case 's':
            vt->saved_r = vt->cur_r;
            vt->saved_c = vt->cur_c;
            break;
        case 'u':
            vt->cur_r = vt->saved_r < vt->rows ? vt->saved_r : vt->rows - 1;
            vt->cur_c = vt->saved_c < vt->cols ? vt->saved_c : vt->cols - 1;
            break;
        case 'm':
            vt_handle_sgr(vt, params, nparams);
            break;
        default:
            break;
    }
}

static void vt_feed_bytes(SmacsVt *vt, const unsigned char *data, size_t len) {
    for (size_t i = 0; i < len; i++) {
        unsigned char b = data[i];

        if (vt->state == 3) { /* OSC: until BEL (0x07) or ESC \ */
            if (b == 0x07) vt->state = 0;
            else if (b == 0x1B) vt->state = 4;
            continue;
        }
        if (vt->state == 4) {
            vt->state = 0;
            continue;
        }
        if (vt->state == 5) { /* Charset designation ESC ( X */
            vt->state = 0;
            continue;
        }

        if (b == 0x1B) {
            vt->utf8_len = 0;
            vt->state = 1;
            continue;
        }

        if (vt->state == 1) { /* ESC */
            vt->state = 0;
            if (b == '[') {
                vt->state = 2;
                vt->csi_len = 0;
            } else if (b == ']') {
                vt->state = 3;
            } else if (b == '(' || b == ')' || b == '*' || b == '+') {
                vt->state = 5;
            } else if (b == '7') {
                vt->saved_r = vt->cur_r;
                vt->saved_c = vt->cur_c;
            } else if (b == '8') {
                vt->cur_r = vt->saved_r < vt->rows ? vt->saved_r : vt->rows - 1;
                vt->cur_c = vt->saved_c < vt->cols ? vt->saved_c : vt->cols - 1;
            } else if (b == 'M') { /* Reverse Index */
                if (vt->cur_r == vt->scroll_top) {
                    vt_scroll_down(vt, vt->scroll_top, vt->scroll_bot, 1);
                } else if (vt->cur_r > 0) {
                    vt->cur_r--;
                }
            } else if (b == 'D') {
                vt_newline(vt);
            } else if (b == 'E') {
                vt->cur_c = 0;
                vt_newline(vt);
            } else if (b == 'c') { /* Full reset */
                vt_clear_grid(vt->grid, vt->rows, vt->cols, 0);
                vt->cur_r = 0; vt->cur_c = 0;
                vt->cur_fg = 0; vt->cur_bg = 0; vt->cur_attr = 0;
                vt->scroll_top = 0; vt->scroll_bot = vt->rows - 1;
            }
            continue;
        }

        if (vt->state == 2) { /* CSI */
            if (b >= 0x40 && b <= 0x7E) {
                vt->state = 0;
                vt_dispatch_csi(vt, (char)b);
            } else if (b >= 0x20 && b <= 0x3F) {
                if (vt->csi_len < (int)sizeof(vt->csi_buf) - 1) {
                    vt->csi_buf[vt->csi_len++] = (char)b;
                }
            } else if (b == '\r') {
                vt->cur_c = 0;
            } else if (b == '\n') {
                vt_newline(vt);
            } else if (b == '\b') {
                if (vt->cur_c > 0) vt->cur_c--;
            }
            continue;
        }

        /* Ground state */
        if (b < 0x20 || b == 0x7F) {
            vt->utf8_len = 0;
            if (b == '\r') {
                vt->cur_c = 0;
            } else if (b == '\n' || b == '\v' || b == '\f') {
                vt_newline(vt);
            } else if (b == '\b') {
                if (vt->cur_c >= vt->cols) vt->cur_c = vt->cols - 1;
                if (vt->cur_c > 0) vt->cur_c--;
            } else if (b == '\t') {
                int next_tab = ((vt->cur_c / 8) + 1) * 8;
                if (next_tab >= vt->cols) next_tab = vt->cols - 1;
                vt->cur_c = next_tab;
            }
            continue;
        }

        if (b < 0x80) {
            vt->utf8_len = 0;
            char s[2] = { (char)b, '\0' };
            vt_put_glyph(vt, s, 1, 1);
            continue;
        }

        /* Multi-byte UTF-8 */
        if (vt->utf8_len == 0) {
            if (b >= 0xC2 && b <= 0xDF) { vt->utf8_need = 2; vt->utf8_buf[0] = b; vt->utf8_len = 1; }
            else if (b >= 0xE0 && b <= 0xEF) { vt->utf8_need = 3; vt->utf8_buf[0] = b; vt->utf8_len = 1; }
            else if (b >= 0xF0 && b <= 0xF4) { vt->utf8_need = 4; vt->utf8_buf[0] = b; vt->utf8_len = 1; }
            else {
                vt_put_glyph(vt, "\xEF\xBF\xBD", 3, 1);
            }
        } else {
            if ((b & 0xC0) == 0x80) {
                vt->utf8_buf[vt->utf8_len++] = b;
                if (vt->utf8_len == vt->utf8_need) {
                    uint32_t cp = 0;
                    if (vt->utf8_need == 2) {
                        cp = ((uint32_t)(vt->utf8_buf[0] & 0x1F) << 6) | (vt->utf8_buf[1] & 0x3F);
                    } else if (vt->utf8_need == 3) {
                        cp = ((uint32_t)(vt->utf8_buf[0] & 0x0F) << 12) |
                             ((uint32_t)(vt->utf8_buf[1] & 0x3F) << 6) |
                             (vt->utf8_buf[2] & 0x3F);
                    } else {
                        cp = ((uint32_t)(vt->utf8_buf[0] & 0x07) << 18) |
                             ((uint32_t)(vt->utf8_buf[1] & 0x3F) << 12) |
                             ((uint32_t)(vt->utf8_buf[2] & 0x3F) << 6) |
                             (vt->utf8_buf[3] & 0x3F);
                    }
                    int w = vt_cp_width(cp);
                    vt_put_glyph(vt, (const char *)vt->utf8_buf, vt->utf8_need, w);
                    vt->utf8_len = 0;
                }
            } else {
                vt->utf8_len = 0;
                vt_put_glyph(vt, "\xEF\xBF\xBD", 3, 1);
            }
        }
    }
}

static int vt_append_sgr_diff(char *out, int pos, int cap,
                              uint32_t fg, uint32_t bg, uint8_t attr) {
    if (pos + 64 >= cap) return pos;
    pos += snprintf(out + pos, (size_t)(cap - pos), "\x1b[0");
    if (attr & SMACS_VT_ATTR_BOLD)   pos += snprintf(out + pos, (size_t)(cap - pos), ";1");
    if (attr & SMACS_VT_ATTR_DIM)    pos += snprintf(out + pos, (size_t)(cap - pos), ";2");
    if (attr & SMACS_VT_ATTR_ITALIC) pos += snprintf(out + pos, (size_t)(cap - pos), ";3");
    if (attr & SMACS_VT_ATTR_UNDER)  pos += snprintf(out + pos, (size_t)(cap - pos), ";4");
    if (attr & SMACS_VT_ATTR_REV)    pos += snprintf(out + pos, (size_t)(cap - pos), ";7");

    if (fg >= 1 && fg <= 8) {
        pos += snprintf(out + pos, (size_t)(cap - pos), ";%u", 30u + fg - 1u);
    } else if (fg >= 9 && fg <= 16) {
        pos += snprintf(out + pos, (size_t)(cap - pos), ";%u", 90u + fg - 9u);
    } else if ((fg & 0xFF00u) == 0x100u) {
        pos += snprintf(out + pos, (size_t)(cap - pos), ";38;5;%u", fg & 0xFFu);
    } else if (fg & 0x1000000u) {
        pos += snprintf(out + pos, (size_t)(cap - pos), ";38;2;%u;%u;%u",
                        (fg >> 16) & 0xFFu, (fg >> 8) & 0xFFu, fg & 0xFFu);
    }

    if (bg >= 1 && bg <= 8) {
        pos += snprintf(out + pos, (size_t)(cap - pos), ";%u", 40u + bg - 1u);
    } else if (bg >= 9 && bg <= 16) {
        pos += snprintf(out + pos, (size_t)(cap - pos), ";%u", 100u + bg - 9u);
    } else if ((bg & 0xFF00u) == 0x100u) {
        pos += snprintf(out + pos, (size_t)(cap - pos), ";48;5;%u", bg & 0xFFu);
    } else if (bg & 0x1000000u) {
        pos += snprintf(out + pos, (size_t)(cap - pos), ";48;2;%u;%u;%u",
                        (bg >> 16) & 0xFFu, (bg >> 8) & 0xFFu, bg & 0xFFu);
    }

    pos += snprintf(out + pos, (size_t)(cap - pos), "m");
    return pos;
}
}

func spawn(int $rows, int $cols, str $shell_cmd, str $cwd) int {
    if ($rows < 2) { $rows = 24; }
    if ($cols < 4) { $cols = 80; }
    if (length($shell_cmd) < 0 || length($cwd) < 0) { return 0; }
    __C__ {
        int r = (int)strada_to_int(rows);
        int c = (int)strada_to_int(cols);
        if (r < 2) r = 24;
        if (c < 4) c = 80;
        char *cmd_s = strada_to_str(shell_cmd);
        char *cwd_s = strada_to_str(cwd);

        int mfd = posix_openpt(O_RDWR | O_NOCTTY);
        if (mfd < 0) {
            free(cmd_s);
            free(cwd_s);
            return strada_new_int(0);
        }
        if (grantpt(mfd) != 0 || unlockpt(mfd) != 0) {
            close(mfd);
            free(cmd_s);
            free(cwd_s);
            return strada_new_int(0);
        }
        char slave_name[256];
        const char *pts = ptsname(mfd);
        if (!pts) {
            close(mfd);
            free(cmd_s);
            free(cwd_s);
            return strada_new_int(0);
        }
        snprintf(slave_name, sizeof(slave_name), "%s", pts);

        struct winsize ws;
        memset(&ws, 0, sizeof(ws));
        ws.ws_row = (unsigned short)r;
        ws.ws_col = (unsigned short)c;
        ioctl(mfd, TIOCSWINSZ, &ws);

        pid_t pid = fork();
        if (pid < 0) {
            close(mfd);
            free(cmd_s);
            free(cwd_s);
            return strada_new_int(0);
        }

        if (pid == 0) {
            /* Child process */
            close(mfd);
            signal(SIGINT, SIG_DFL);
            signal(SIGTERM, SIG_DFL);
            signal(SIGHUP, SIG_DFL);
            signal(SIGQUIT, SIG_DFL);
            signal(SIGPIPE, SIG_DFL);
            signal(SIGCHLD, SIG_DFL);
            signal(SIGTSTP, SIG_DFL);
            signal(SIGWINCH, SIG_DFL);

            setsid();
            int sfd = open(slave_name, O_RDWR);
            if (sfd < 0) _exit(127);
#ifdef TIOCSCTTY
            ioctl(sfd, TIOCSCTTY, 0);
#endif
            dup2(sfd, 0);
            dup2(sfd, 1);
            dup2(sfd, 2);
            if (sfd > 2) close(sfd);
            for (int fd = 3; fd < 256; fd++) close(fd);

            if (cwd_s && *cwd_s) {
                if (chdir(cwd_s) != 0) { /* ignore */ }
            }
            setenv("TERM", "xterm-256color", 1);
            setenv("COLORTERM", "truecolor", 1);

            const char *sh = getenv("SHELL");
            if (!sh || !*sh) sh = "/bin/sh";
            if (cmd_s && *cmd_s) {
                execl(sh, sh, "-c", cmd_s, (char *)NULL);
            } else {
                execl(sh, sh, "-i", (char *)NULL);
            }
            execl("/bin/sh", "/bin/sh", "-i", (char *)NULL);
            _exit(127);
        }

        free(cmd_s);
        free(cwd_s);

        int fl = fcntl(mfd, F_GETFL, 0);
        if (fl >= 0) fcntl(mfd, F_SETFL, fl | O_NONBLOCK);
        int fdfl = fcntl(mfd, F_GETFD, 0);
        if (fdfl >= 0) fcntl(mfd, F_SETFD, fdfl | FD_CLOEXEC);

        SmacsVt *vt = (SmacsVt *)calloc(1, sizeof(SmacsVt));
        if (!vt) {
            close(mfd);
            kill(pid, SIGHUP);
            return strada_new_int(0);
        }
        vt->master_fd = mfd;
        vt->child_pid = pid;
        vt->alive = 1;
        vt->exit_code = 0;
        vt->rows = r;
        vt->cols = c;
        vt->scroll_top = 0;
        vt->scroll_bot = r - 1;
        vt->grid = (SmacsVtCell *)malloc(sizeof(SmacsVtCell) * (size_t)(r * c));
        vt->alt_grid = (SmacsVtCell *)malloc(sizeof(SmacsVtCell) * (size_t)(r * c));
        vt_clear_grid(vt->grid, r, c, 0);
        vt_clear_grid(vt->alt_grid, r, c, 0);

        return strada_new_int((int64_t)(intptr_t)vt);
    }
}

func master_fd(int $vt_ptr) int {
    if ($vt_ptr == 0) { return -1; }
    __C__ {
        SmacsVt *vt = (SmacsVt *)(intptr_t)strada_to_int(vt_ptr);
        if (!vt) return strada_new_int(-1);
        return strada_new_int(vt->master_fd);
    }
}

func is_alive(int $vt_ptr) int {
    if ($vt_ptr == 0) { return 0; }
    __C__ {
        SmacsVt *vt = (SmacsVt *)(intptr_t)strada_to_int(vt_ptr);
        if (!vt) return strada_new_int(0);
        return strada_new_int(vt->alive);
    }
}

func cursor_row(int $vt_ptr) int {
    if ($vt_ptr == 0) { return 0; }
    __C__ {
        SmacsVt *vt = (SmacsVt *)(intptr_t)strada_to_int(vt_ptr);
        if (!vt) return strada_new_int(0);
        return strada_new_int(vt->cur_r);
    }
}

func cursor_col(int $vt_ptr) int {
    if ($vt_ptr == 0) { return 0; }
    __C__ {
        SmacsVt *vt = (SmacsVt *)(intptr_t)strada_to_int(vt_ptr);
        if (!vt) return strada_new_int(0);
        int c = vt->cur_c;
        if (c >= vt->cols) c = vt->cols - 1;
        if (c < 0) c = 0;
        return strada_new_int(c);
    }
}

func app_cursor_keys(int $vt_ptr) int {
    if ($vt_ptr == 0) { return 0; }
    __C__ {
        SmacsVt *vt = (SmacsVt *)(intptr_t)strada_to_int(vt_ptr);
        if (!vt) return strada_new_int(0);
        return strada_new_int(vt->app_cursor);
    }
}

func bracketed_paste_enabled(int $vt_ptr) int {
    if ($vt_ptr == 0) { return 0; }
    __C__ {
        SmacsVt *vt = (SmacsVt *)(intptr_t)strada_to_int(vt_ptr);
        if (!vt) return strada_new_int(0);
        return strada_new_int(vt->bracketed_paste);
    }
}

# Drain available PTY output into the VT emulator. Returns 1 if display state changed, 0 otherwise.
func poll_output(int $vt_ptr) int {
    if ($vt_ptr == 0) { return 0; }
    __C__ {
        SmacsVt *vt = (SmacsVt *)(intptr_t)strada_to_int(vt_ptr);
        if (!vt || vt->master_fd < 0) return strada_new_int(0);

        unsigned char buf[16384];
        int changed = 0;
        for (int iter = 0; iter < 16; iter++) {
            ssize_t n = read(vt->master_fd, buf, sizeof(buf));
            if (n > 0) {
                vt_feed_bytes(vt, buf, (size_t)n);
                changed = 1;
            } else if (n == 0 || (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) {
                /* Child closed slave PTY (EOF / EIO on Linux) */
                close(vt->master_fd);
                vt->master_fd = -1;
                int st = 0;
                pid_t wp = waitpid(vt->child_pid, &st, WNOHANG);
                if (wp == 0) {
                    wp = waitpid(vt->child_pid, &st, 0);
                }
                if (WIFEXITED(st)) vt->exit_code = WEXITSTATUS(st);
                else if (WIFSIGNALED(st)) vt->exit_code = 128 + WTERMSIG(st);
                vt->alive = 0;
                char msg[128];
                int mlen = snprintf(msg, sizeof(msg),
                    "\r\n\x1b[90m[Process exited with status %d — press q or C-x k to close]\x1b[0m",
                    vt->exit_code);
                if (mlen > 0) vt_feed_bytes(vt, (const unsigned char *)msg, (size_t)mlen);
                changed = 1;
                break;
            } else {
                break;
            }
        }

        if (vt->alive && vt->child_pid > 0) {
            int st = 0;
            pid_t wp = waitpid(vt->child_pid, &st, WNOHANG);
            if (wp == vt->child_pid) {
                /* Drain any final queued bytes before closing */
                for (;;) {
                    ssize_t n = read(vt->master_fd, buf, sizeof(buf));
                    if (n > 0) vt_feed_bytes(vt, buf, (size_t)n);
                    else break;
                }
                close(vt->master_fd);
                vt->master_fd = -1;
                if (WIFEXITED(st)) vt->exit_code = WEXITSTATUS(st);
                else if (WIFSIGNALED(st)) vt->exit_code = 128 + WTERMSIG(st);
                vt->alive = 0;
                char msg[128];
                int mlen = snprintf(msg, sizeof(msg),
                    "\r\n\x1b[90m[Process exited with status %d — press q or C-x k to close]\x1b[0m",
                    vt->exit_code);
                if (mlen > 0) vt_feed_bytes(vt, (const unsigned char *)msg, (size_t)mlen);
                changed = 1;
            }
        }

        return strada_new_int(changed);
    }
}

func send_bytes(int $vt_ptr, str $data) int {
    my int $mfd = Smacs::Term::master_fd($vt_ptr);
    if ($mfd < 0 || Smacs::Term::is_alive($vt_ptr) == 0) { return 0; }
    my int $total = core::byte_length($data);
    my int $off = 0;
    while ($off < $total) {
        my str $chunk = ($off == 0) ? $data : core::byte_substr($data, $off, $total - $off);
        my int $w = core::write_fd($mfd, $chunk);
        if ($w > 0) {
            $off = $off + $w;
        } else {
            my int $err = core::errno();
            if ($err == 11 || $err == 4) {
                core::usleep(1000);
            } else {
                last;
            }
        }
    }
    return $off;
}

func resize(int $vt_ptr, int $new_rows, int $new_cols) void {
    if ($vt_ptr == 0 || $new_rows < 1 || $new_cols < 2) { return; }
    __C__ {
        SmacsVt *vt = (SmacsVt *)(intptr_t)strada_to_int(vt_ptr);
        int nr = (int)strada_to_int(new_rows);
        int nc = (int)strada_to_int(new_cols);
        if (!vt || nr < 1 || nc < 2) return;
        if (nr == vt->rows && nc == vt->cols) return;

        SmacsVtCell *ng = (SmacsVtCell *)malloc(sizeof(SmacsVtCell) * (size_t)(nr * nc));
        SmacsVtCell *nag = (SmacsVtCell *)malloc(sizeof(SmacsVtCell) * (size_t)(nr * nc));
        if (!ng || !nag) { free(ng); free(nag); return; }
        vt_clear_grid(ng, nr, nc, 0);
        vt_clear_grid(nag, nr, nc, 0);

        int copy_r = vt->rows < nr ? vt->rows : nr;
        int copy_c = vt->cols < nc ? vt->cols : nc;
        /* Keep bottom lines around cursor visible if shrinking height */
        int src_r_off = 0;
        if (vt->cur_r >= nr) {
            src_r_off = vt->cur_r - nr + 1;
        }
        for (int r = 0; r < copy_r; r++) {
            int sr = r + src_r_off;
            if (sr < vt->rows) {
                memcpy(&ng[r * nc], &vt->grid[sr * vt->cols], sizeof(SmacsVtCell) * (size_t)copy_c);
            }
            memcpy(&nag[r * nc], &vt->alt_grid[r * vt->cols], sizeof(SmacsVtCell) * (size_t)copy_c);
        }

        free(vt->grid);
        free(vt->alt_grid);
        vt->grid = ng;
        vt->alt_grid = nag;
        vt->rows = nr;
        vt->cols = nc;
        vt->cur_r -= src_r_off;
        if (vt->cur_r < 0) vt->cur_r = 0;
        if (vt->cur_r >= nr) vt->cur_r = nr - 1;
        if (vt->cur_c >= nc) vt->cur_c = nc - 1;
        vt->scroll_top = 0;
        vt->scroll_bot = nr - 1;

        if (vt->master_fd >= 0 && vt->alive) {
            struct winsize ws;
            memset(&ws, 0, sizeof(ws));
            ws.ws_row = (unsigned short)nr;
            ws.ws_col = (unsigned short)nc;
            ioctl(vt->master_fd, TIOCSWINSZ, &ws);
        }
    }
}

# Render row $row (0..rows-1) up to $max_cols display columns as an ANSI-styled string.
func render_row(int $vt_ptr, int $row, int $max_cols) str {
    if ($vt_ptr == 0 || $row < 0 || $max_cols <= 0) { return ""; }
    __C__ {
        SmacsVt *vt = (SmacsVt *)(intptr_t)strada_to_int(vt_ptr);
        int r = (int)strada_to_int(row);
        int mc = (int)strada_to_int(max_cols);
        if (!vt || r < 0 || r >= vt->rows || mc <= 0) return strada_new_str("");

        int lim = vt->cols < mc ? vt->cols : mc;
        int cap = lim * 40 + 128;
        char *out = (char *)malloc((size_t)cap);
        if (!out) return strada_new_str("");
        int pos = 0;

        uint32_t cur_fg = 0;
        uint32_t cur_bg = 0;
        uint8_t cur_attr = 0;
        int styled = 0;

        for (int c = 0; c < lim; c++) {
            const SmacsVtCell *cell = &vt->grid[r * vt->cols + c];
            if (cell->attr & SMACS_VT_ATTR_CONT) {
                continue;
            }
            /* If wide char starts on last column lim-1, emit space */
            int is_wide_next = (c + 1 < vt->cols && (vt->grid[r * vt->cols + c + 1].attr & SMACS_VT_ATTR_CONT));
            const char *glyph = (is_wide_next && c + 1 >= lim) ? " " : cell->bytes;

            uint8_t cattr = cell->attr & ~SMACS_VT_ATTR_CONT;
            if (cell->fg != cur_fg || cell->bg != cur_bg || cattr != cur_attr) {
                if (cell->fg == 0 && cell->bg == 0 && cattr == 0) {
                    if (styled && pos + 8 < cap) {
                        memcpy(out + pos, "\x1b[0m", 4);
                        pos += 4;
                    }
                    styled = 0;
                } else {
                    pos = vt_append_sgr_diff(out, pos, cap, cell->fg, cell->bg, cattr);
                    styled = 1;
                }
                cur_fg = cell->fg;
                cur_bg = cell->bg;
                cur_attr = cattr;
            }
            size_t gl = strlen(glyph);
            if (gl == 0) { glyph = " "; gl = 1; }
            if (pos + (int)gl < cap) {
                memcpy(out + pos, glyph, gl);
                pos += (int)gl;
            }
        }
        /* Pad remaining columns if window is wider than vt->cols */
        if (styled && pos + 8 < cap) {
            memcpy(out + pos, "\x1b[0m", 4);
            pos += 4;
            styled = 0;
        }
        for (int c = lim; c < mc && pos + 1 < cap; c++) {
            out[pos++] = ' ';
        }
        out[pos] = '\0';
        StradaValue *sv = strada_new_str_len(out, (size_t)pos);
        free(out);
        return sv;
    }
}

# Export scrollback + current screen as an array of plain text lines (for Copy/Scroll mode).
func snapshot_lines(int $vt_ptr) scalar {
    if ($vt_ptr == 0) { return []; }
    __C__ {
        SmacsVt *vt = (SmacsVt *)(intptr_t)strada_to_int(vt_ptr);
        StradaValue *arr = strada_new_array();
        if (!vt) return arr;

        int total_lines = vt->sb_count + vt->rows;
        for (int li = 0; li < total_lines; li++) {
            const SmacsVtCell *cells = NULL;
            int ncols = 0;
            if (li < vt->sb_count) {
                int idx = (vt->sb_head + li) % SMACS_VT_MAX_SCROLLBACK;
                cells = vt->scrollback[idx].cells;
                ncols = vt->scrollback[idx].cols;
            } else {
                int r = li - vt->sb_count;
                cells = &vt->grid[r * vt->cols];
                ncols = vt->cols;
            }
            if (!cells || ncols <= 0) {
                strada_array_push(arr->value.av, strada_new_str(""));
                continue;
            }
            char *line = (char *)malloc((size_t)(ncols * 8 + 1));
            int p = 0;
            int last_nonspace = 0;
            for (int c = 0; c < ncols; c++) {
                if (cells[c].attr & SMACS_VT_ATTR_CONT) continue;
                const char *g = cells[c].bytes;
                size_t gl = strlen(g);
                if (gl == 0) { g = " "; gl = 1; }
                memcpy(line + p, g, gl);
                p += (int)gl;
                if (!(gl == 1 && g[0] == ' ')) {
                    last_nonspace = p;
                }
            }
            StradaValue *lsv = strada_new_str_len(line, (size_t)last_nonspace);
            free(line);
            strada_array_push(arr->value.av, lsv);
        }
        return arr;
    }
}

func destroy(int $vt_ptr) void {
    if ($vt_ptr == 0) { return; }
    __C__ {
        SmacsVt *vt = (SmacsVt *)(intptr_t)strada_to_int(vt_ptr);
        if (!vt) return;
        if (vt->master_fd >= 0) {
            close(vt->master_fd);
            vt->master_fd = -1;
        }
        if (vt->alive && vt->child_pid > 0) {
            kill(-vt->child_pid, SIGHUP);
            kill(vt->child_pid, SIGHUP);
            int st = 0;
            for (int i = 0; i < 20; i++) {
                if (waitpid(vt->child_pid, &st, WNOHANG) != 0) break;
                usleep(5000);
            }
            if (waitpid(vt->child_pid, &st, WNOHANG) == 0) {
                kill(-vt->child_pid, SIGKILL);
                kill(vt->child_pid, SIGKILL);
                waitpid(vt->child_pid, &st, 0);
            }
            vt->alive = 0;
        }
        for (int i = 0; i < vt->sb_count; i++) {
            int idx = (vt->sb_head + i) % SMACS_VT_MAX_SCROLLBACK;
            free(vt->scrollback[idx].cells);
        }
        free(vt->grid);
        free(vt->alt_grid);
        free(vt);
    }
}
